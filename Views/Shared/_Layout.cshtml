    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".notif-mark-read").forEach(function (btn) {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    var menu = btn.closest(".notif-menu");
                    if (!menu) return;

                    menu.querySelectorAll(".notif-dot").forEach(function (dot) { dot.style.display = "none"; });
                    menu.querySelectorAll(".notif-header-badge").forEach(function (badge) { badge.textContent = "0"; });

                    var toggle = menu.parentElement ? menu.parentElement.querySelector(".notif-badge") : null;
                    if (toggle) { toggle.style.display = "none"; }
                });
            });

            function setOpBadge(id, text, tone) {
                var badge = document.getElementById(id);
                if (!badge) return;

                badge.textContent = text;
                badge.classList.remove("badge-success", "badge-alert", "badge-danger");
                if (tone === "danger") {
                    badge.classList.add("badge-danger");
                } else if (tone === "alert") {
                    badge.classList.add("badge-alert");
                } else {
                    badge.classList.add("badge-success");
                }
            }

            function normalizeSearchText(value) {
                return (value || "")
                    .toString()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .trim();
            }

            function setupRelaxedDropdownHover() {
                var closeDelayMs = 320;
                document.querySelectorAll(".area-dropdown").forEach(function (dropdown) {
                    var closeTimer = null;

                    function keepOpen() {
                        if (closeTimer) {
                            window.clearTimeout(closeTimer);
                            closeTimer = null;
                        }

                        dropdown.classList.add("is-hover-open");
                    }

                    function closeSoftly() {
                        if (closeTimer) {
                            window.clearTimeout(closeTimer);
                        }

                        closeTimer = window.setTimeout(function () {
                            if (!dropdown.matches(":hover") && !dropdown.matches(":focus-within")) {
                                dropdown.classList.remove("is-hover-open");
                            }
                        }, closeDelayMs);
                    }

                    dropdown.addEventListener("mouseenter", keepOpen);
                    dropdown.addEventListener("mouseleave", closeSoftly);
                    dropdown.addEventListener("focusin", keepOpen);
                    dropdown.addEventListener("focusout", closeSoftly);
                });
            }

