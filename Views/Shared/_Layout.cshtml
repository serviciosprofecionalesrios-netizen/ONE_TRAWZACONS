<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ONE-TRAWZACONS</title>
    <link rel="icon" type="image/png" href="~/images/logo-trawzacons.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/logo-trawzacons.png" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand-blue-900: #0b2f75;
            --brand-blue-800: #11439a;
            --brand-blue-700: #1b55b8;
            --brand-contrast: #f2b84b;
            --brand-contrast-soft: #ffe7b5;
            --brand-cyan: #5fd0e5;
            --brand-menu-shadow: rgba(7, 22, 61, 0.45);
            --menu-chip-bg: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.05) 100%);
            --menu-chip-border: rgba(255,255,255,0.24);
            --menu-chip-shadow: 0 8px 14px rgba(4, 15, 43, 0.25);
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Montserrat', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        

        .navbar {
            background: linear-gradient(100deg, var(--brand-blue-900), var(--brand-blue-700));
            border-bottom: 3px solid var(--brand-contrast);
        }

        .navbar .container-fluid {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            flex-wrap: nowrap;
        }

        .navbar-collapse {
            min-width: 0;
        }
        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.68rem;
            font-weight: 600;
            color: #ffffff !important;
            letter-spacing: 0.45px;
            text-decoration: none;
            flex: 0 0 auto;
        }

        .brand-logo-shell {
            position: relative;
            width: 210px;
            height: 62px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid rgba(255,255,255,0.82);
            box-shadow: 0 10px 18px rgba(0,0,0,0.22), inset 0 0 0 1px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            padding: 5px 8px;
        }

        .brand-logo-shell::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: linear-gradient(120deg, rgba(255,255,255,0) 20%, rgba(255,255,255,0.32) 52%, rgba(255,255,255,0) 85%);
            transform: translateX(-140%);
            transition: transform 0.48s ease;
            pointer-events: none;
        }

        .brand-logo {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 10px;
            transition: transform 0.26s ease;
            filter: contrast(1.03) saturate(1.02);
        }

        .brand-title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 1.3rem;
            font-weight: 700;
            line-height: 1.05;
            color: #fff;
            letter-spacing: 0.015em;
            text-shadow: 0 2px 10px rgba(0,0,0,0.26);
            transition: letter-spacing 0.22s ease, text-shadow 0.22s ease;
            white-space: nowrap;
        }

        .navbar-brand:hover .brand-logo-shell {
            transform: translateY(-1px) scale(1.02);
            box-shadow: 0 12px 24px rgba(0,0,0,0.3), inset 0 0 0 2px rgba(0,0,0,0.08);
        }

        .navbar-brand:hover .brand-logo-shell::after {
            transform: translateX(145%);
        }

        .navbar-brand:hover .brand-logo {
            transform: scale(1.03);
        }

        .navbar-brand:hover .brand-title {
            letter-spacing: 0.022em;
            text-shadow: 0 4px 13px rgba(0,0,0,0.3);
        }

        .nav-link {
            color: #ffffff !important;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .main-menu {
            display: flex;
            align-items: center;
            gap: 0.48rem;
            margin-right: auto;
            min-width: 0;
            flex-wrap: nowrap;
        }

        .main-menu .nav-item {
            position: relative;
            min-width: 0;
        }

        .menu-link {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 0.38rem;
            padding: 0.45rem 0.86rem;
            border: 1px solid var(--menu-chip-border);
            border-radius: 999px;
            background: var(--menu-chip-bg);
            color: #ffffff !important;
            font-weight: 700;
            line-height: 1.15;
            text-decoration: none;
            white-space: nowrap;
            box-shadow: var(--menu-chip-shadow), inset 0 1px 0 rgba(255,255,255,0.22);
            transition: transform 0.2s ease, color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
            overflow: hidden;
        }

        .menu-link::before {
            content: "";
            position: absolute;
            inset: 2px;
            border-radius: inherit;
            background: linear-gradient(135deg, rgba(255,255,255,0.28), rgba(255,255,255,0));
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .menu-link .menu-icon {
            display: none;
        }

        .menu-link .menu-text {
            font-weight: 700;
            font-size: 0.98rem;
            letter-spacing: 0.01em;
        }

        .menu-link .menu-plus {
            color: #b6f4ff;
            width: 20px;
            height: 20px;
            border-radius: 999px;
            border: 1px solid rgba(182, 244, 255, 0.5);
            background: rgba(95, 208, 229, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.92rem;
            line-height: 1;
            margin-left: 0.08rem;
            transform: translateY(-1px);
            transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        .menu-link .menu-plus-toggle {
            cursor: pointer;
            pointer-events: auto;
        }

        .menu-link:hover,
        .menu-link:focus {
            color: #ffffff !important;
            border-color: rgba(95, 208, 229, 0.62);
            background: linear-gradient(135deg, rgba(255,255,255,0.24) 0%, rgba(95,208,229,0.12) 100%);
            box-shadow: 0 12px 20px rgba(4, 15, 43, 0.32), inset 0 1px 0 rgba(255,255,255,0.3);
            transform: translateY(-1px);
        }

        .menu-link:hover::before,
        .menu-link:focus::before,
        .menu-link.active::before {
            opacity: 1;
        }

        .menu-link.active {
            color: #ffffff !important;
            font-weight: 800;
            border-color: rgba(255, 231, 181, 0.75);
            background: linear-gradient(140deg, rgba(242,184,75,0.3) 0%, rgba(255,255,255,0.2) 100%);
            box-shadow: 0 12px 24px rgba(4, 15, 43, 0.35), inset 0 1px 0 rgba(255,255,255,0.38);
        }

        .menu-link:hover .menu-plus,
        .menu-link:focus .menu-plus {
            transform: translateY(-1px) scale(1.05);
            border-color: rgba(255, 231, 181, 0.85);
            background: rgba(242, 184, 75, 0.24);
            color: #fff3cf;
        }

        .menu-link.active .menu-plus {
            border-color: rgba(255, 231, 181, 0.9);
            background: rgba(255, 231, 181, 0.3);
            color: #fff7de;
        }

        .area-dropdown > .dropdown-toggle::after {
            display: none;
        }

        .area-dropdown {
            position: relative;
        }

        .area-dropdown::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 100%;
            height: 18px;
            display: block;
            pointer-events: auto;
        }

        .area-menu {
            min-width: 280px;
            border: 1px solid rgba(189, 223, 255, 0.35);
            border-radius: 14px;
            padding: 0.8rem 0;
            margin-top: 0.32rem !important;
            background: linear-gradient(180deg, #0f3c93 0%, #0a2c67 100%);
            box-shadow: 0 20px 32px var(--brand-menu-shadow);
            z-index: 1300;
        }

        .area-menu .dropdown-item {
            color: #ffffff;
            font-weight: 600;
            font-size: 1.04rem;
            padding: 0.62rem 1.15rem;
            white-space: normal;
            transition: background-color 0.18s ease, padding-left 0.18s ease;
        }

        .area-menu .dropdown-item:hover,
        .area-menu .dropdown-item:focus {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            padding-left: 1.35rem;
        }

        .area-menu .dropdown-divider {
            border-color: rgba(255, 255, 255, 0.22);
            margin: 0.48rem 1.1rem;
        }

        .operations-menu {
            min-width: 360px;
            padding-top: 0.55rem;
            padding-bottom: 0.7rem;
            max-height: min(78vh, 700px);
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.35) rgba(0, 0, 0, 0.15);
        }

        .operations-menu.maintenance-menu {
            min-width: 390px;
            max-height: min(78vh, 700px);
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.35) rgba(0, 0, 0, 0.15);
        }

        .operations-menu .menu-group-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--brand-contrast);
            opacity: 0.95;
            padding: 0.35rem 1.15rem 0.22rem;
        }

        .operations-menu .operations-search {
            padding: 0.2rem 1rem 0.55rem;
        }

        .operations-menu .operations-search .input-group-text {
            border-radius: 12px 0 0 12px;
            border: 1px solid rgba(255,255,255,0.32);
            border-right: none;
            background: rgba(255,255,255,0.14);
            color: #ffffff;
        }

        .operations-menu .operations-search .form-control {
            border-radius: 0 12px 12px 0;
            border: 1px solid rgba(255,255,255,0.32);
            border-left: none;
            background: rgba(255,255,255,0.14);
            color: #ffffff;
            font-weight: 600;
            font-size: 0.89rem;
        }

        .operations-menu .operations-search .form-control::placeholder {
            color: rgba(255,255,255,0.78);
        }

        .operations-menu .operations-search .form-control:focus {
            box-shadow: 0 0 0 0.15rem rgba(255,255,255,0.18);
        }

        .operations-menu .dropdown-item.op-menu-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.6rem;
            font-size: 1rem;
            font-weight: 700;
            border-left: 3px solid transparent;
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .operations-menu .dropdown-item.op-menu-item:hover,
        .operations-menu .dropdown-item.op-menu-item:focus {
            padding-left: 1rem;
            border-left-color: var(--brand-contrast);
        }

        .operations-menu .dropdown-item.op-menu-item.is-active {
            background: linear-gradient(90deg, rgba(255,255,255,0.23) 0%, rgba(255,255,255,0.14) 100%);
            border-left-color: var(--brand-contrast-soft);
            color: #fff9e8;
            box-shadow: inset 0 0 0 1px rgba(255, 241, 197, 0.22);
        }

        .operations-menu .op-item-main {
            display: inline-flex;
            align-items: center;
            gap: 0.52rem;
            min-width: 0;
        }

        .operations-menu .op-item-right {
            display: inline-flex;
            align-items: center;
            gap: 0.36rem;
            margin-left: auto;
            flex-shrink: 0;
        }

        .operations-menu .op-item-main i {
            font-size: 1rem;
            color: var(--brand-cyan);
            opacity: 0.95;
        }

        .operations-menu .op-item-badge {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.02em;
            border-radius: 999px;
            padding: 0.18rem 0.48rem;
            border: 1px solid rgba(255,255,255,0.32);
            background: rgba(255,255,255,0.1);
            color: var(--brand-contrast-soft);
            white-space: nowrap;
        }

        .operations-menu .op-item-badge.badge-alert {
            background: rgba(255, 193, 7, 0.24);
            border-color: rgba(255, 225, 130, 0.48);
            color: #ffe8a6;
        }

        .operations-menu .op-item-badge.badge-danger {
            background: rgba(248, 113, 113, 0.24);
            border-color: rgba(252, 165, 165, 0.5);
            color: #ffd0d0;
        }

        .operations-menu .op-item-badge.badge-success {
            background: rgba(74, 222, 128, 0.2);
            border-color: rgba(134, 239, 172, 0.45);
            color: #d1fae5;
        }

        .operations-menu .operations-no-results {
            color: rgba(255, 255, 255, 0.88);
            font-size: 0.88rem;
            padding: 0.45rem 1rem 0.2rem;
        }

        #mantenimientoAreaMenu .menu-group-label.mnt-label-quick {
            color: #fef08a;
        }

        #mantenimientoAreaMenu .menu-group-label.mnt-label-monitor {
            color: #86efac;
        }

        #mantenimientoAreaMenu .menu-group-label.mnt-label-manage {
            color: #6ee7f9;
        }

        #mantenimientoAreaMenu .menu-group-label.mnt-label-analysis {
            color: #fdba74;
        }

        #mantenimientoAreaMenu .js-mnt-item[data-mnt-group="accesos"] .op-item-main i {
            color: #fef08a;
        }

        #mantenimientoAreaMenu .js-mnt-item[data-mnt-group="monitoreo"] .op-item-main i {
            color: #86efac;
        }

        #mantenimientoAreaMenu .js-mnt-item[data-mnt-group="gestion"] .op-item-main i {
            color: #6ee7f9;
        }

        #mantenimientoAreaMenu .js-mnt-item[data-mnt-group="analisis"] .op-item-main i {
            color: #fdba74;
        }

        #mantenimientoAreaMenu .mnt-submenu-toggle {
            cursor: pointer;
            user-select: none;
        }

        #mantenimientoAreaMenu .mnt-submenu-toggle .submenu-caret {
            font-size: 0.88rem;
            transition: transform 0.2s ease;
            opacity: 0.92;
        }

        #mantenimientoAreaMenu .mnt-submenu-toggle.is-open .submenu-caret {
            transform: rotate(180deg);
        }

        #mantenimientoAreaMenu [data-mnt-subitem] .op-menu-item {
            padding-left: 2.1rem;
        }

        #mantenimientoAreaMenu .mnt-quick-tip {
            font-size: 0.76rem;
            color: rgba(255, 244, 220, 0.82);
            padding: 0 1rem 0.45rem;
        }

        #mantenimientoAreaMenu .mnt-favorites-host {
            padding: 0.1rem 1rem 0.4rem;
        }

        #mantenimientoAreaMenu .mnt-favorites-empty {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.68);
            border: 1px dashed rgba(255,255,255,0.25);
            border-radius: 10px;
            padding: 0.38rem 0.55rem;
        }

        #mantenimientoAreaMenu .mnt-favorites-list {
            display: grid;
            gap: 0.34rem;
        }

        #mantenimientoAreaMenu .mnt-favorite-link {
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.09);
            padding: 0.45rem 0.72rem;
        }

        #mantenimientoAreaMenu .mnt-fav-toggle {
            border: 1px solid rgba(255,255,255,0.35);
            background: rgba(0,0,0,0.2);
            color: rgba(255,255,255,0.78);
            border-radius: 999px;
            width: 22px;
            height: 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            padding: 0;
            transition: all 0.2s ease;
        }

        #mantenimientoAreaMenu .mnt-fav-toggle:hover {
            color: #ffffff;
            border-color: rgba(255,255,255,0.58);
        }

        #mantenimientoAreaMenu .mnt-fav-toggle.mnt-fav-on {
            color: #facc15;
            border-color: rgba(250, 204, 21, 0.72);
            background: rgba(250, 204, 21, 0.2);
        }

        @@keyframes menuPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.12); }
        }

        .navbar-toggler {
            border-color: rgba(255,255,255,0.6);
        }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        .navbar-expand-lg .navbar-nav.account-strip {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 0.34rem;
            flex-wrap: nowrap;
            min-width: 0;
            margin-left: auto;
        }

        .account-stack {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-end !important;
            gap: 0.26rem;
            min-width: 0;
            flex: 0 0 auto;
        }

        .account-stack .nav-link {
            padding: 0;
        }

        .account-stack form {
            margin: 0;
            width: 100%;
            display: flex;
            justify-content: flex-end;
        }

        .account-strip .nav-item {
            margin-right: 0 !important;
        }

        .account-strip .notif-slot {
            width: 68px;
            min-width: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .account-strip .notif-slot .notif-toggle {
            margin: 0;
        }

        .user-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.34rem 0.58rem;
            border-radius: 999px;
            font-weight: 600;
            color: #ffffff !important;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.23);
            backdrop-filter: blur(4px);
            max-width: 188px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
            font-size: 0.9rem;
        }

        .user-chip i {
            font-size: 1rem;
            flex: 0 0 auto;
        }

        .user-chip .user-name {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-chip:hover {
            background: rgba(0, 0, 0, 0.38);
            border-color: rgba(255, 255, 255, 0.36);
            transform: translateY(-1px);
        }

        .logout-btn {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #ffffff;
            background: linear-gradient(135deg, rgba(255,255,255,0.2), rgba(11,47,117,0.42));
            border-radius: 11px;
            font-weight: 700;
            letter-spacing: 0.01em;
            padding: 0.34rem 0.58rem;
            display: inline-flex;
            align-items: center;
            gap: 0.38rem;
            white-space: nowrap;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2), inset 0 1px 1px rgba(255,255,255,0.22);
            transition: transform 0.22s ease, box-shadow 0.22s ease, background-color 0.22s ease, border-color 0.22s ease;
            font-size: 0.9rem;
            line-height: 1.15;
        }

        .logout-btn::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(255,255,255,0) 20%, rgba(255,255,255,0.28) 50%, rgba(255,255,255,0) 80%);
            transform: translateX(-140%);
            transition: transform 0.45s ease;
            pointer-events: none;
        }

        .logout-btn i {
            transition: transform 0.2s ease;
            flex: 0 0 auto;
        }

        .logout-btn:hover {
            background-color: rgba(11,47,117,0.52);
            color: #ffffff;
            border-color: rgba(255,255,255,0.5);
            box-shadow: 0 10px 20px rgba(0,0,0,0.28), inset 0 1px 1px rgba(255,255,255,0.28);
            transform: translateY(-1px);
        }

        .logout-btn:hover::after {
            transform: translateX(145%);
        }

        .logout-btn:hover i {
            transform: translateX(2px);
        }

        .notif-toggle {
            color: #ffffff !important;
            border: 1px solid rgba(255,255,255,0.18) !important;
            border-radius: 12px;
            padding: 0.38rem 0.52rem !important;
            background: rgba(0,0,0,0.16);
            text-decoration: none !important;
            line-height: 1;
        }

        .notif-toggle:hover,
        .notif-toggle:focus {
            color: #ffffff !important;
            background: rgba(0,0,0,0.28);
            border-color: rgba(255,255,255,0.34) !important;
            box-shadow: none !important;
            text-decoration: none !important;
        }

        .notif-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background: #ef4444;
            color: #fff;
            border-radius: 999px;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            font-size: 0.72rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #b00000;
            box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        }

        .notif-menu {
            width: min(430px, calc(100vw - 24px));
            max-width: calc(100vw - 24px);
            border: 1px solid rgba(15, 23, 42, 0.12);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 18px 35px rgba(0,0,0,0.22);
            background: #f8fafc;
            margin-top: 10px !important;
        }

        .notif-header {
            padding: 0.8rem 0.95rem;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            gap: 0.7rem;
        }

        .notif-header .d-flex {
            min-width: 0;
        }

        .notif-header strong {
            font-size: 1.08rem;
            color: #1f2937;
        }

        .notif-header-badge {
            background: #ef4444;
            color: #fff;
            font-size: 0.76rem;
            font-weight: 800;
            border-radius: 999px;
            padding: 0.14rem 0.5rem;
            line-height: 1.2;
        }

        .notif-mark-read {
            font-weight: 700;
            color: #0f766e !important;
            text-decoration: none !important;
            white-space: nowrap;
            font-size: 0.92rem;
            flex: 0 0 auto;
        }

        .notif-mark-read:hover {
            color: #0a5b55 !important;
            text-decoration: underline !important;
        }

        .notif-list {
            max-height: min(62vh, 530px);
            overflow-y: auto;
            background: #f8fafc;
        }

        .notif-link {
            display: block;
            color: inherit !important;
            text-decoration: none !important;
            outline: none;
        }

        .notif-link:hover,
        .notif-link:focus {
            color: inherit !important;
            text-decoration: none !important;
        }

        .notif-item {
            position: relative;
            padding: 0.82rem 0.92rem;
            border-left: 4px solid #e5e7eb;
            border-bottom: 1px solid #e5e7eb;
            background: #ffffff;
            transition: background-color 0.2s ease;
        }

        .notif-link:hover .notif-item {
            background: #f8fafc;
        }

        .notif-item--breached { border-left-color: #ef4444; }
        .notif-item--near { border-left-color: #f59e0b; }
        .notif-item--critical { border-left-color: #06b6d4; }

        .notif-main {
            display: grid;
            grid-template-columns: 46px 1fr;
            gap: 0.72rem;
            align-items: flex-start;
        }

        .notif-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.22rem;
            border: 1px solid transparent;
        }

        .notif-icon--breached {
            background: #fee2e2;
            color: #dc2626;
            border-color: #fecaca;
        }

        .notif-icon--near {
            background: #fef3c7;
            color: #d97706;
            border-color: #fde68a;
        }

        .notif-icon--critical {
            background: #cffafe;
            color: #0891b2;
            border-color: #a5f3fc;
        }

        .notif-content {
            min-width: 0;
        }

        .notif-title-row {
            display: flex;
            align-items: center;
            gap: 0.42rem;
            flex-wrap: wrap;
            margin-bottom: 0.18rem;
        }

        .notif-title {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 800;
            color: #1f2937;
            line-height: 1.2;
            word-break: break-word;
        }

        .notif-priority {
            border-radius: 8px;
            padding: 0.08rem 0.45rem;
            font-size: 0.76rem;
            font-weight: 800;
            line-height: 1.2;
        }

        .notif-priority--critical { background: #fee2e2; color: #b91c1c; }
        .notif-priority--high { background: #ffedd5; color: #c2410c; }
        .notif-priority--medium { background: #fef3c7; color: #b45309; }
        .notif-priority--low { background: #dcfce7; color: #15803d; }

        .notif-summary {
            margin: 0 0 0.28rem 0;
            color: #475569;
            font-size: 0.93rem;
            line-height: 1.35;
            word-break: break-word;
        }

        .notif-meta {
            display: flex;
            align-items: center;
            gap: 0.72rem;
            flex-wrap: wrap;
            color: #64748b;
            font-size: 0.88rem;
        }

        .notif-ticket {
            color: #0f766e;
            font-weight: 800;
        }

        .notif-dot {
            position: absolute;
            top: 14px;
            right: 14px;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #14b8a6;
        }

        .notif-footer {
            padding: 0.72rem 0.95rem;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
            color: #6b7280;
            font-size: 0.92rem;
            text-align: center;
        }

        .notif-empty {
            padding: 1rem 0.95rem;
            text-align: center;
            color: #6b7280;
            display: flex;
            gap: 0.45rem;
            justify-content: center;
            align-items: center;
            background: #ffffff;
        }

        @@media (max-width: 575.98px) {
            .notif-menu {
                width: min(360px, calc(100vw - 16px));
                max-width: calc(100vw - 16px);
                margin-top: 8px !important;
            }

            .notif-header {
                padding: 0.72rem 0.78rem;
                align-items: flex-start !important;
            }

            .notif-header strong {
                font-size: 1rem;
            }

            .notif-mark-read {
                font-size: 0.84rem;
            }

            .notif-item {
                padding: 0.74rem 0.76rem;
            }

            .notif-main {
                grid-template-columns: 40px 1fr;
                gap: 0.62rem;
            }

            .notif-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                font-size: 1.05rem;
            }
        }
        @@media (min-width: 992px) {
            .navbar-expand-lg .navbar-collapse {
                display: flex !important;
                align-items: center;
                min-width: 0;
            }

            .main-menu {
                flex: 1 1 auto;
                overflow: visible;
                flex-wrap: wrap;
                row-gap: 0.45rem;
                padding-bottom: 0;
            }

            .area-dropdown .dropdown-menu {
                display: block;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transform: translateY(8px);
                transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.24s;
            }

            .area-dropdown:hover .dropdown-menu,
            .area-dropdown.is-hover-open .dropdown-menu,
            .area-dropdown:focus-within .dropdown-menu,
            .area-dropdown .dropdown-menu.show {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
                transform: translateY(0);
                transition-delay: 0s;
            }

            .main-menu .nav-item,
            .menu-link,
            .account-strip {
                flex: 0 0 auto;
            }
        }

        @@media (max-width: 1480px) {
            .menu-link {
                min-width: 0;
                padding: 0.4rem 0.72rem;
            }

            .menu-link .menu-text {
                font-size: 0.91rem;
            }

            .brand-title {
                font-size: 1.15rem;
            }

            .brand-logo-shell {
                width: 185px;
                height: 56px;
            }

            .user-chip {
                max-width: min(165px, 13vw);
                font-size: 0.92rem;
                padding: 0.34rem 0.56rem;
            }

            .logout-btn {
                font-size: 0.9rem;
                padding: 0.34rem 0.52rem;
            }
        }

        @@media (max-width: 1260px) {
            .menu-link {
                min-width: 0;
                padding: 0.38rem 0.62rem;
            }

            .menu-link .menu-text {
                font-size: 0.86rem;
            }

            .brand-title {
                display: none;
            }

            .brand-logo-shell {
                width: 160px;
                height: 50px;
            }

            .user-chip {
                max-width: min(145px, 12vw);
                font-size: 0.86rem;
            }

            .logout-btn {
                font-size: 0.86rem;
                padding: 0.3rem 0.45rem;
            }
        }

        @@media (max-width: 991.98px) {
            .navbar-brand {
                gap: 0.58rem;
            }

            .brand-logo-shell {
                width: 148px;
                height: 46px;
                border-radius: 12px;
            }

            .brand-title {
                display: none;
            }

            .main-menu {
                display: block;
                width: 100%;
                gap: 0;
                overflow: visible;
            }

            .main-menu .nav-item {
                width: 100%;
                display: block;
                margin-bottom: 0.25rem;
            }

            .menu-link {
                width: 100%;
                justify-content: flex-start;
                padding: 0.52rem 0.75rem;
                gap: 0.55rem;
                border-radius: 12px;
            }

            .menu-link .menu-plus {
                margin-left: auto;
            }

            .area-menu {
                width: 100%;
                min-width: 0;
                margin-top: 0.3rem !important;
                padding: 0.45rem 0;
            }

            .operations-menu {
                width: 100%;
                min-width: 0;
            }

            .operations-menu.maintenance-menu {
                max-height: 70vh;
            }

            .account-strip {
                width: 100%;
                margin-top: 0.45rem;
                gap: 0.45rem;
                flex-wrap: nowrap;
                flex-direction: column;
                align-items: stretch;
            }

            .account-stack {
                width: 100%;
                align-items: stretch;
            }

            .account-stack form {
                display: block;
            }

            .user-chip {
                max-width: 100%;
                width: 100%;
                justify-content: center;
            }

            .logout-btn {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 768px) {
            .content-wrapper {
                padding: 20px;
            }

            h2 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var canSeeUsersMenu =
        User.Identity?.IsAuthenticated == true && (
            User.IsInRole("Administrator") ||
            User.IsInRole("CoordinadorIT") ||
            User.IsInRole("Technician") ||
            User.IsInRole("GerenciaGeneral"));

    var canSeeCredentialsMenu =
        User.Identity?.IsAuthenticated == true && (
            User.IsInRole("Administrator") ||
            User.IsInRole("Technician") ||
            User.IsInRole("GerenciaGeneral"));

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isFinanceRequester = isAuthenticated;
    var isFinanceApprover =
        isAuthenticated &&
        (User.IsInRole("Administrator") ||
         User.IsInRole("CoordinadorIT") ||
         User.IsInRole("GerenciaGeneral"));
    var isFinanceAdmin =
        isAuthenticated &&
        (User.IsInRole("Administrator") ||
         User.IsInRole("CoordinadorIT") ||
         User.IsInRole("GerenciaGeneral"));

    var queryDepartment = Context.Request.Query["department"].ToString();
    var queryArea = Context.Request.Query["area"].ToString();
    var queryAreaFilter = Context.Request.Query["areaFilter"].ToString();
    var queryQuick = Context.Request.Query["quick"].ToString();
    var queryScope = Context.Request.Query["scope"].ToString();
    var queryIncidentType = Context.Request.Query["incidentType"].ToString();
    var queryMaintenanceView = Context.Request.Query["maintenanceView"].ToString();
    var queryRequestType = Context.Request.Query["requestType"].ToString();
    var queryOcStage = Context.Request.Query["ocStage"].ToString();
    var querySourceOcTicketId = Context.Request.Query["sourceOcTicketId"].ToString();
    var isOcCreateFinanceContext =
        currentController == "Tickets" &&
        currentAction == "CreateFinance" &&
        (
            string.Equals(queryRequestType, "Orden de compra", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(queryRequestType, "Solicitud de OC", StringComparison.OrdinalIgnoreCase) ||
            !string.IsNullOrWhiteSpace(queryOcStage) ||
            !string.IsNullOrWhiteSpace(querySourceOcTicketId)
        );
    var isMaintenanceTicketsContext =
        currentController == "Tickets" &&
        string.Equals(queryDepartment, "Mantenimiento", StringComparison.OrdinalIgnoreCase);

    var isUsuariosMenuActive =
        currentController == "Users" ||
        currentController == "Credentials";

    var hsControlDocumentosActive =
        currentController == "Operaciones" &&
        currentAction == "ControlDocumentos";

    var isOperacionesMenuActive =
        currentController == "Operaciones" &&
        !hsControlDocumentosActive;

    var isMantenimientoMenuActive =
        isMaintenanceTicketsContext ||
        (currentController == "Tickets" && currentAction == "MaintenanceBoard") ||
        (currentController == "Tickets" && currentAction == "CreateMaintenance") ||
        currentController == "MaintenanceAppointments" ||
        currentController == "MaintenanceReports" ||
        currentController == "MaintenanceTechnicians" ||
        currentController == "MaintenanceInventory" ||
        ((currentController == "Calendar" || currentController == "Reports") &&
         string.Equals(queryScope, "maintenance", StringComparison.OrdinalIgnoreCase));

    var isInventarioMenuActive =
        currentController == "InventoryHub" ||
        currentController == "Inventory" ||
        currentController == "MaintenanceInventory" ||
        (currentController == "Tickets" &&
         (
            isOcCreateFinanceContext ||
            (currentAction == "Index" && string.Equals(queryDepartment, "Inventario", StringComparison.OrdinalIgnoreCase)) ||
            currentAction == "CreateArticleOutput"
         ));

    var isFinanceMenuActive =
        currentController == "Finance" ||
        (currentController == "Tickets" &&
         (
             (currentAction == "CreateFinance" && !isOcCreateFinanceContext) ||
             currentAction == "FinanceAccounting"
         )) ||
        (currentController == "Tickets" &&
         string.Equals(queryDepartment, "Finanzas", StringComparison.OrdinalIgnoreCase)) ||
        currentController == "FinanceDocuments" ||
        currentController == "FinanceCostCenters" ||
        (currentController == "Reports" &&
         (string.Equals(queryDepartment, "Finanzas", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(queryArea, "Finanzas", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(queryAreaFilter, "Finanzas", StringComparison.OrdinalIgnoreCase)));

    var isHsMenuActive = currentController == "Hs" || hsControlDocumentosActive;

    var usersListActive = currentController == "Users" && currentAction == "Index";
    var credentialsListActive = currentController == "Credentials" && currentAction == "Index";

    var opDashboardActive = currentController == "Operaciones" && currentAction == "Dashboard";
    var opCalendarioActive = currentController == "Operaciones" && currentAction == "CalendarioOperativo";
    var opToneladasActive = currentController == "Operaciones" && currentAction == "SeguimientoToneladas";
    var opDieselActive = currentController == "Operaciones" && currentAction == "SeguimientoDiesel";
    var opReportesActive = currentController == "Operaciones" && currentAction == "Reportes";

    var mntDashboardActive =
        currentController == "Tickets" &&
        currentAction == "Index" &&
        isMaintenanceTicketsContext &&
        !string.Equals(queryMaintenanceView, "detail", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(queryMaintenanceView, "detalle", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(queryMaintenanceView, "board", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(queryMaintenanceView, "pizarra", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(queryQuick, "today", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(queryQuick, "overdue", StringComparison.OrdinalIgnoreCase);

    var mntDetalleOrdenesActive =
        currentController == "Tickets" &&
        currentAction == "Index" &&
        isMaintenanceTicketsContext &&
        (string.Equals(queryMaintenanceView, "detail", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(queryMaintenanceView, "detalle", StringComparison.OrdinalIgnoreCase));

    var mntPizarraOperativaActive =
        (currentController == "Tickets" && currentAction == "MaintenanceBoard") ||
        (currentController == "Tickets" &&
         currentAction == "Index" &&
         isMaintenanceTicketsContext &&
         (string.Equals(queryMaintenanceView, "board", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(queryMaintenanceView, "pizarra", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(queryMaintenanceView, "airport", StringComparison.OrdinalIgnoreCase)));

    var mntCitasActive =
        currentController == "MaintenanceAppointments";
    var mntCitasNuevaActive =
        currentController == "MaintenanceAppointments" &&
        currentAction == "Create";
    var mntCitasListaActive =
        currentController == "MaintenanceAppointments" &&
        (currentAction == "Index" || currentAction == "Details");

    var mntVencidasActive =
        currentController == "Tickets" &&
        currentAction == "Index" &&
        isMaintenanceTicketsContext &&
        string.Equals(queryQuick, "overdue", StringComparison.OrdinalIgnoreCase);

    var mntSinAsignarActive =
        currentController == "Tickets" &&
        currentAction == "Index" &&
        isMaintenanceTicketsContext &&
        string.Equals(queryQuick, "unassigned", StringComparison.OrdinalIgnoreCase);

    var mntSeguimientoActive = currentController == "Tickets" && currentAction == "Index" && isMaintenanceTicketsContext;
    var mntNuevaOrdenActive = currentController == "Tickets" && currentAction == "CreateMaintenance";
    var mntInventarioActive = currentController == "MaintenanceInventory";
    var mntInventarioNuevoActive =
        currentController == "MaintenanceInventory" &&
        currentAction == "Create";
    var mntInventarioListaActive =
        currentController == "MaintenanceInventory" &&
        currentAction == "Index";
    var mntInventarioDetalleActive =
        currentController == "MaintenanceInventory" &&
        currentAction == "Detalle";
    var mntInventarioTransitoActive =
        currentController == "MaintenanceInventory" &&
        currentAction == "Transito";
    var mntTecnicosActive = currentController == "MaintenanceTechnicians";
    var mntTecnicosNuevoActive =
        currentController == "MaintenanceTechnicians" &&
        currentAction == "Create";
    var mntTecnicosListaActive =
        currentController == "MaintenanceTechnicians" &&
        currentAction == "Index";
    var mntCalendarioActive =
        currentController == "Calendar" &&
        currentAction == "Index" &&
        string.Equals(queryScope, "maintenance", StringComparison.OrdinalIgnoreCase);
    var mntReporteriaActive =
        currentController == "MaintenanceReports" &&
        currentAction == "Index";
    var mntCroquisCamionActive =
        currentController == "MaintenanceReports" &&
        currentAction == "CroquisCamion";
    var mntCitasSubmenuActive = mntCitasNuevaActive || mntCitasListaActive;
    var mntInventarioSubmenuActive = mntInventarioNuevoActive || mntInventarioListaActive || mntInventarioDetalleActive || mntInventarioTransitoActive;
    var mntTecnicosSubmenuActive = mntTecnicosNuevoActive || mntTecnicosListaActive;

    var invHubActive = currentController == "InventoryHub" && currentAction == "Index";
    var invTiListActive = currentController == "Inventory" && currentAction == "Index";
    var invTiNewActive = currentController == "Inventory" && currentAction == "Create";
    var invSpareListActive = currentController == "MaintenanceInventory" && (currentAction == "Index" || currentAction == "Detalle" || currentAction == "Transito");
    var invSpareNewActive = currentController == "MaintenanceInventory" && currentAction == "Create";
    var invPurchaseOrderActive = isOcCreateFinanceContext;
    var invPurchaseRequestsActive =
        currentController == "Tickets" &&
        currentAction == "Index" &&
        string.Equals(queryDepartment, "Inventario", StringComparison.OrdinalIgnoreCase);
    var invArticleOutputActive =
        currentController == "Tickets" &&
        currentAction == "CreateArticleOutput";

    var financeDashboardActive =
        currentController == "Finance" &&
        currentAction == "Dashboard";
    var financeCreateActive =
        currentController == "Tickets" &&
        currentAction == "CreateFinance" &&
        !isOcCreateFinanceContext;
    var financePendingActive =
        currentController == "Tickets" &&
        currentAction == "Index" &&
        string.Equals(queryDepartment, "Finanzas", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(queryQuick, "finance_pending_approval", StringComparison.OrdinalIgnoreCase);
    var financeCostCentersActive = currentController == "FinanceCostCenters";
    var financeInvoiceFormActive =
        currentController == "FinanceDocuments" &&
        (currentAction == "InvoiceCreate" || currentAction == "InvoiceDetails");
    var financeReceiptFormActive =
        currentController == "FinanceDocuments" &&
        (currentAction == "ReceiptCreate" || currentAction == "ReceiptDetails");
    var financeReportsActive =
        currentController == "Reports" &&
        (
            string.Equals(queryAreaFilter, "Finanzas", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(queryArea, "Finanzas", StringComparison.OrdinalIgnoreCase)
        );
    var financeCounterpartiesActive =
        currentController == "Finance" &&
        (currentAction == "Counterparties" || currentAction == "CounterpartyCreate" || currentAction == "CounterpartyEdit");
    var financeSettingsActive =
        currentController == "Finance" &&
        currentAction == "Settings";

    var hsDashboardActive = currentController == "Hs" && currentAction == "Dashboard";
    var hsIncidentsActive = currentController == "Hs" && (currentAction == "Incidents" || currentAction == "IncidentCreate" || currentAction == "IncidentEdit" || currentAction == "IncidentDetails");
    var hsInspectionsActive = currentController == "Hs" && (currentAction == "Inspections" || currentAction == "InspectionCreate");
    var hsActionsActive = currentController == "Hs" && (currentAction == "Actions" || currentAction == "ActionCreate" || currentAction == "ActionEdit");
    var hsTrainingsActive = currentController == "Hs" && (currentAction == "Trainings" || currentAction == "TrainingCreate");
    var hsPermitsActive = currentController == "Hs" && (currentAction == "Permits" || currentAction == "PermitCreate");
    var hsCalendarActive = currentController == "Hs" && currentAction == "Calendar";
    var hsDocumentsActive = currentController == "Hs" && (currentAction == "Documents" || currentAction == "DocumentCreate");

    var todayIso = DateTime.Now.ToString("yyyy-MM-dd");
}
<body>

    <nav class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container-fluid">

            <a class="navbar-brand"
               asp-controller="Dashboard"
               asp-action="Index">

                <span class="brand-logo-shell">
                    <img class="brand-logo"
                         src="@Url.Content("~/images/logo-trawzacons.png")"
                         alt="Grupo Trawzacons Logo" />
                </span>

                <span class="brand-title">ONE-TRAWZACONS</span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-2 main-menu">
                    @if (canSeeUsersMenu || canSeeCredentialsMenu)
                    {
                        <li class="nav-item dropdown area-dropdown">
                            <a id="usuariosMenuTrigger"
                               class="nav-link menu-link dropdown-toggle @(isUsuariosMenuActive ? "active fw-bold" : "")"
                               href="@(canSeeUsersMenu ? Url.Action("Index", "Users") : Url.Action("Index", "Credentials"))"
                               role="button"
                               data-bs-toggle="dropdown"
                               data-dashboard-url="@(canSeeUsersMenu ? Url.Action("Index", "Users") : Url.Action("Index", "Credentials"))"
                               aria-expanded="false">
                                <span class="menu-text">Usuarios</span><span class="menu-plus menu-plus-toggle">+</span>
                            </a>
                            <ul class="dropdown-menu area-menu operations-menu">
                                @if (canSeeUsersMenu)
                                {
                                    <li>
                                        <a class="dropdown-item op-menu-item @(usersListActive ? "is-active" : "")"
                                           asp-controller="Users"
                                           asp-action="Index">
                                            <span class="op-item-main"><i class="bi bi-people-fill"></i>Usuarios</span>
                                            <span class="op-item-badge badge-success">Admin</span>
                                        </a>
                                    </li>
                                }
                                @if (canSeeCredentialsMenu)
                                {
                                    <li>
                                        <a class="dropdown-item op-menu-item @(credentialsListActive ? "is-active" : "")"
                                           asp-controller="Credentials"
                                           asp-action="Index">
                                            <span class="op-item-main"><i class="bi bi-shield-lock-fill"></i>Credenciales</span>
                                            <span class="op-item-badge">Secure</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    <li class="nav-item dropdown area-dropdown">
                        <a id="operacionesMenuTrigger"
                           class="nav-link menu-link dropdown-toggle @(isOperacionesMenuActive ? "active fw-bold" : "")"
                           href="@Url.Action("Dashboard", "Operaciones")"
                           role="button"
                           data-bs-toggle="dropdown"
                           data-dashboard-url="@Url.Action("Dashboard", "Operaciones")"
                           aria-expanded="false">
                            <span class="menu-text">Operaciones</span><span class="menu-plus menu-plus-toggle">+</span>
                        </a>
                        <ul class="dropdown-menu area-menu operations-menu" id="operacionesAreaMenu">
                            <li class="operations-search px-3">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text"
                                           class="form-control"
                                           id="operacionesMenuSearch"
                                           placeholder="Buscar opción..."
                                           autocomplete="off" />
                                </div>
                            </li>

                            <li><span class="menu-group-label" data-group-label="monitoreo">Monitoreo</span></li>
                            <li class="js-op-item" data-group="monitoreo" data-search="dashboard operaciones tablero resumen">
                                <a class="dropdown-item op-menu-item @(opDashboardActive ? "is-active" : "")"
                                   asp-controller="Operaciones"
                                   asp-action="Dashboard">
                                    <span class="op-item-main"><i class="bi bi-grid-1x2-fill"></i>Dashboard</span>
