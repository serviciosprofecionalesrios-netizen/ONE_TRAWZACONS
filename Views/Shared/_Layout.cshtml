<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Grupo Transan Service Desk</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* ================= NAVBAR CORPORATIVA ================= */

        .navbar {
            background: linear-gradient(90deg, #c40000, #8b0000);
            border-bottom: 4px solid #000000;
        }

        .navbar-brand img {
            height: 45px;
            margin-right: 12px;
            transition: transform 0.3s ease;
        }

        .navbar-brand:hover img {
            transform: scale(1.05);
        }

        .navbar-brand {
            font-weight: 600;
            color: #ffffff !important;
            letter-spacing: 0.5px;
        }

        .nav-link {
            color: #ffffff !important;
            font-weight: 500;
            padding: 8px 14px;
            transition: all 0.3s ease;
        }

        .nav-link:hover {
            background-color: rgba(0,0,0,0.25);
            border-radius: 6px;
            transform: translateY(-1px);
        }

        .nav-link.active {
            background-color: rgba(0,0,0,0.35);
            border-radius: 6px;
        }

        .navbar-toggler {
            border-color: rgba(255,255,255,0.6);
        }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        /* ================= CONTENIDO ================= */

        .content-wrapper {
            padding: 30px;
        }

        /* ================= CARDS ================= */

        .card {
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

        /* ================= BOTONES CORPORATIVOS ================= */

        .btn-primary {
            background-color: #c40000;
            border-color: #c40000;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #8b0000;
            border-color: #8b0000;
            transform: translateY(-1px);
        }

        /* ================= RESPONSIVE ================= */

        @@media (max-width: 768px) {
            .content-wrapper {
                padding: 20px;
            }

            h2 {
                font-size: 1.5rem;
            }
        }

    </style>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container-fluid">

            <!-- LOGO + NOMBRE -->
            <a class="navbar-brand d-flex align-items-center"
               asp-controller="Dashboard"
               asp-action="Index">

                <img src="@Url.Content("~/images/logo-transan.png")"
                     alt="Grupo Transan Logo" />

                <span>Service Desk</span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-4">

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active fw-bold" : "")"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tickets" ? "active fw-bold" : "")"
                           asp-controller="Tickets"
                           asp-action="Index">
                            <i class="bi bi-ticket-perforated"></i> Incidencias
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-calendar3"></i> Calendario
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-bar-chart"></i> Reportes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active fw-bold" : "")"
                           asp-controller="Users"
                           asp-action="Index">
                            <i class="bi bi-people"></i> Usuarios
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <!-- ================= CONTENIDO ================= -->
    <div class="content-wrapper">
        @RenderBody()
    </div>

    <!-- ================= SCRIPTS ================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>