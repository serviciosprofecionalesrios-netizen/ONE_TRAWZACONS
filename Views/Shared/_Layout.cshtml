            function setupOperacionesMenuSearch() {
                var menu = document.getElementById("operacionesAreaMenu");
                var searchInput = document.getElementById("operacionesMenuSearch");
                if (!menu || !searchInput) return;

                var items = Array.prototype.slice.call(menu.querySelectorAll(".js-op-item"));
                var groups = ["monitoreo", "analisis", "gestion"];
                var noResults = document.getElementById("operacionesMenuNoResults");

                function applyFilter() {
                    var query = normalizeSearchText(searchInput.value);
                    var visibleItems = 0;

                    items.forEach(function (item) {
                        var searchable = normalizeSearchText((item.getAttribute("data-search") || "") + " " + item.textContent);
                        var show = !query || searchable.indexOf(query) >= 0;
                        item.style.display = show ? "" : "none";
                        if (show) {
                            visibleItems += 1;
                        }
                    });

                    groups.forEach(function (groupKey) {
                        var label = menu.querySelector('[data-group-label="' + groupKey + '"]');
                        var divider = menu.querySelector('[data-group-divider="' + groupKey + '"]');
                        var hasVisible = items.some(function (item) {
                            return item.getAttribute("data-group") === groupKey && item.style.display !== "none";
                        });

                        if (label) {
                            label.parentElement.style.display = hasVisible ? "" : "none";
                        }

                        if (divider) {
                            divider.parentElement.style.display = hasVisible ? "" : "none";
                        }
                    });

                    if (noResults) {
                        noResults.classList.toggle("d-none", !query || visibleItems > 0);
                    }
                }

                searchInput.addEventListener("input", applyFilter);
                searchInput.addEventListener("click", function (e) { e.stopPropagation(); });
                searchInput.addEventListener("keydown", function (e) { e.stopPropagation(); });

                var dropdown = menu.closest(".area-dropdown");
                var toggle = dropdown ? dropdown.querySelector('[data-bs-toggle="dropdown"]') : null;
                if (toggle) {
                    toggle.addEventListener("shown.bs.dropdown", function () {
                        applyFilter();
                        searchInput.focus();
                        searchInput.select();
                    });
                    toggle.addEventListener("hide.bs.dropdown", function () {
                        if (searchInput.value) {
                            searchInput.value = "";
                            applyFilter();
                        }
                    });
                }

                applyFilter();
            }

            function setupMantenimientoMenuSearch() {
                var menu = document.getElementById("mantenimientoAreaMenu");
                var searchInput = document.getElementById("mantenimientoMenuSearch");
                if (!menu || !searchInput) return;

                var items = Array.prototype.slice.call(menu.querySelectorAll(".js-mnt-item"));
                var groups = ["accesos", "monitoreo", "gestion", "analisis"];
                var favoritesList = document.getElementById("mntFavoritesList");
                var favoritesEmpty = document.getElementById("mntFavoritesEmpty");
                var favoritesHost = menu.querySelector(".mnt-favorites-host");
                var submenuToggles = Array.prototype.slice.call(menu.querySelectorAll(".mnt-submenu-toggle"));
                var currentQuery = "";
                var submenuState = {};
                var menuUser = (menu.getAttribute("data-user") || "anon").trim().toLowerCase();
                var favoritesStorageKey = "mnt-menu-favorites::" + menuUser;
                var maxFavorites = 5;
                var defaultFavorites = [
                    "mnt-new-order",
                    "mnt-view-appointments",
                    "mnt-view-inventory"
                ];
                var favoriteLinks = Array.prototype.slice.call(menu.querySelectorAll("a.js-mnt-fav-link"));
                var favoriteMap = new Map();

                function safeReadFavorites() {
                    try {
                        var raw = localStorage.getItem(favoritesStorageKey);
                        if (!raw) return [];
                        var parsed = JSON.parse(raw);
                        if (!Array.isArray(parsed)) return [];
                        return parsed
                            .map(function (x) { return (x || "").toString().trim(); })
                            .filter(function (x) { return x.length > 0; });
                    } catch {
                        return [];
                    }
                }

                function safeWriteFavorites(keys) {
                    try {
                        localStorage.setItem(favoritesStorageKey, JSON.stringify(keys.slice(0, maxFavorites)));
                    } catch {
                        // Ignorar almacenamiento no disponible.
                    }
                }

                function ensureDefaultFavorites() {
                    var existing = safeReadFavorites().filter(function (key) { return favoriteMap.has(key); });
                    if (existing.length > 0) {
                        safeWriteFavorites(existing);
                        return;
                    }

                    var defaults = defaultFavorites.filter(function (key) { return favoriteMap.has(key); });
                    safeWriteFavorites(defaults);
                }

                function getFavoriteKeys() {
                    return safeReadFavorites()
                        .filter(function (key) { return favoriteMap.has(key); })
                        .slice(0, maxFavorites);
                }

                function toggleFavorite(key) {
                    var current = getFavoriteKeys();
                    var index = current.indexOf(key);

                    if (index >= 0) {
                        current.splice(index, 1);
                    } else if (current.length < maxFavorites) {
                        current.push(key);
                    } else {
                        current.shift();
                        current.push(key);
                    }

                    safeWriteFavorites(current);
                    syncFavoriteButtons();
                    renderFavorites();
                }

                function syncFavoriteButtons() {
                    var activeKeys = getFavoriteKeys();
                    var activeSet = new Set(activeKeys);
                    menu.querySelectorAll(".mnt-fav-toggle").forEach(function (btn) {
                        var key = btn.getAttribute("data-fav-key") || "";
                        var isOn = activeSet.has(key);
                        btn.classList.toggle("mnt-fav-on", isOn);
                        btn.setAttribute("title", isOn ? "Quitar de favoritos" : "Agregar a favoritos");
                        btn.setAttribute("aria-label", isOn ? "Quitar de favoritos" : "Agregar a favoritos");
                        btn.innerHTML = isOn
                            ? '<i class="bi bi-star-fill"></i>'
                            : '<i class="bi bi-star"></i>';
                    });
                }

                function renderFavorites() {
                    if (!favoritesList || !favoritesEmpty) return;

                    var keys = getFavoriteKeys();
                    favoritesList.innerHTML = "";

                    if (keys.length === 0) {
                        favoritesList.style.display = "none";
                        favoritesEmpty.style.display = "";
                        return;
                    }

                    keys.forEach(function (key) {
                        var meta = favoriteMap.get(key);
                        if (!meta) return;

                        var link = document.createElement("a");
                        link.className = "dropdown-item op-menu-item mnt-favorite-link";
                        link.href = meta.href;
                        link.innerHTML =
                            '<span class="op-item-main"><i class="' + meta.icon + '"></i>' + meta.label + '</span>';

                        var right = document.createElement("span");
                        right.className = "op-item-right";

                        var removeBtn = document.createElement("button");
                        removeBtn.type = "button";
                        removeBtn.className = "mnt-fav-toggle mnt-fav-on";
                        removeBtn.setAttribute("data-fav-key", key);
                        removeBtn.innerHTML = '<i class="bi bi-star-fill"></i>';
                        removeBtn.title = "Quitar de favoritos";
                        removeBtn.addEventListener("click", function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            toggleFavorite(key);
                        });

                        right.appendChild(removeBtn);
                        link.appendChild(right);
                        favoritesList.appendChild(link);
                    });

                    favoritesEmpty.style.display = "none";
                    favoritesList.style.display = "";
                }

                favoriteLinks.forEach(function (link) {
                    var key = (link.getAttribute("data-fav-key") || "").trim();
                    var label = (link.getAttribute("data-fav-label") || "").trim() || (link.textContent || "").trim();
                    if (!key || !label) return;

                    var iconNode = link.querySelector(".op-item-main i");
                    var icon = iconNode ? iconNode.className : "bi bi-star";
                    favoriteMap.set(key, { key: key, label: label, href: link.getAttribute("href") || "#", icon: icon });

                    var right = link.querySelector(".op-item-right");
                    if (!right) {
                        right = document.createElement("span");
                        right.className = "op-item-right";
                        link.appendChild(right);
                    }

                    var favBtn = document.createElement("button");
                    favBtn.type = "button";
                    favBtn.className = "mnt-fav-toggle";
                    favBtn.setAttribute("data-fav-key", key);
                    favBtn.innerHTML = '<i class="bi bi-star"></i>';
                    favBtn.title = "Agregar a favoritos";
                    favBtn.addEventListener("click", function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        toggleFavorite(key);
                    });

                    right.appendChild(favBtn);
                });

                function setSubmenuState(name, expanded) {
                    submenuState[name] = expanded;
                    var toggle = menu.querySelector('.mnt-submenu-toggle[data-mnt-submenu="' + name + '"]');
                    if (toggle) {
                        toggle.classList.toggle("is-open", expanded);
                        toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
                    }

                    if (currentQuery) return;

                    menu.querySelectorAll('[data-mnt-subitem="' + name + '"]').forEach(function (item) {
                        item.style.display = expanded ? "" : "none";
                    });
                }

                submenuToggles.forEach(function (toggle) {
                    var submenu = toggle.getAttribute("data-mnt-submenu");
                    if (!submenu) return;

                    var hasActiveChild = Array.prototype.slice.call(menu.querySelectorAll('[data-mnt-subitem="' + submenu + '"] .is-active')).length > 0;
                    submenuState[submenu] = toggle.classList.contains("is-open") || toggle.classList.contains("is-active") || hasActiveChild;

                    toggle.addEventListener("click", function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var next = !submenuState[submenu];
                        setSubmenuState(submenu, next);
                    });
                });

                function applyFilter() {
                    var query = (searchInput.value || "").trim().toLowerCase();
                    currentQuery = query;

                    items.forEach(function (item) {
                        var searchable = ((item.getAttribute("data-search") || "") + " " + item.textContent).toLowerCase();
                        var show = !query || searchable.indexOf(query) >= 0;
                        item.style.display = show ? "" : "none";
                    });

                    groups.forEach(function (groupKey) {
                        var label = menu.querySelector('[data-mnt-group-label="' + groupKey + '"]');
                        var divider = menu.querySelector('[data-mnt-group-divider="' + groupKey + '"]');
                        var hasVisible = items.some(function (item) {
                            return item.getAttribute("data-mnt-group") === groupKey && item.style.display !== "none";
                        });

                        if (label) {
                            label.parentElement.style.display = hasVisible ? "" : "none";
                        }

                        if (divider) {
                            divider.parentElement.style.display = hasVisible ? "" : "none";
                        }
                    });

                    if (!query) {
                        Object.keys(submenuState).forEach(function (key) {
                            setSubmenuState(key, !!submenuState[key]);
                        });
                    }

                    var showFavorites = !query;
                    var favoritesLabel = menu.querySelector('[data-mnt-group-label="favoritos"]');
                    if (favoritesLabel) {
                        favoritesLabel.parentElement.style.display = showFavorites ? "" : "none";
                    }

                    if (favoritesHost) {
                        favoritesHost.style.display = showFavorites ? "" : "none";
                    }
                }

                searchInput.addEventListener("input", applyFilter);
                searchInput.addEventListener("click", function (e) { e.stopPropagation(); });
                searchInput.addEventListener("keydown", function (e) { e.stopPropagation(); });

                var dropdown = menu.closest(".area-dropdown");
                var toggle = dropdown ? dropdown.querySelector('[data-bs-toggle="dropdown"]') : null;
                if (toggle) {
                    toggle.addEventListener("shown.bs.dropdown", function () {
                        searchInput.focus();
                        searchInput.select();
                    });
                    toggle.addEventListener("hide.bs.dropdown", function () {
                        if (searchInput.value) {
                            searchInput.value = "";
                            applyFilter();
                        }
                    });
                }

                ensureDefaultFavorites();
                syncFavoriteButtons();
                renderFavorites();
                applyFilter();
            }

            function refreshMantenimientoBadges() {
                var url = '@Url.Action("GetMaintenanceMenuMetrics", "Tickets")';

                fetch(url, { method: "GET" })
                    .then(function (response) {
                        return response.ok ? response.json() : null;
                    })
                    .then(function (data) {
                        if (!data) return;

                        var todayText = (data.appointmentsToday || 0) + " hoy";
                        setOpBadge("mntBadgeToday", todayText, (data.appointmentsToday || 0) > 0 ? "success" : "alert");
                        setOpBadge("mntBadgeQuickToday", todayText, (data.appointmentsToday || 0) > 0 ? "success" : "alert");

                        if ((data.overdueOrders || 0) > 0) {
                            setOpBadge("mntBadgeOverdue", data.overdueOrders + " vencida(s)", "danger");
                        } else {
                            setOpBadge("mntBadgeOverdue", "Al dia", "success");
                        }

                        if ((data.unassignedOrders || 0) > 0) {
                            setOpBadge("mntBadgeUnassigned", data.unassignedOrders + " sin asignar", "alert");
                        } else {
                            setOpBadge("mntBadgeUnassigned", "Al dia", "success");
                        }

                        if ((data.lowStock || 0) > 0) {
                            setOpBadge("mntBadgeLowStock", data.lowStock + " bajo", "alert");
                        } else {
                            setOpBadge("mntBadgeLowStock", "Stock OK", "success");
                        }

                        if ((data.inTransit || 0) > 0) {
                            setOpBadge("mntBadgeTransit", data.inTransit + " transito", "alert");
                        } else {
                            setOpBadge("mntBadgeTransit", "Sin transito", "success");
                        }

                        var healthTone = (data.inventoryHealthTone || "success").toLowerCase();
                        var healthLabel = data.inventoryHealthLabel || "Stock estable";
                        setOpBadge("mntBadgeInventoryHealth", healthLabel, healthTone);
                        setOpBadge("mntBadgeInventoryHealthMain", healthLabel, healthTone);
                        setOpBadge("mntBadgeInventoryAlert", healthLabel, healthTone);
                    })
                    .catch(function () {
                        // Si falla la carga, dejamos los badges por defecto.
                    });
            }

            setupOperacionesPrimaryNavigation();
            setupMantenimientoPrimaryNavigation();
            setupFinanzasPrimaryNavigation();
            setupHsPrimaryNavigation();
            setupInventarioPrimaryNavigation();
            setupUsuariosPrimaryNavigation();
            setupRelaxedDropdownHover();
            setupOperacionesMenuSearch();
            setupMantenimientoMenuSearch();
            refreshMantenimientoBadges();
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>









































