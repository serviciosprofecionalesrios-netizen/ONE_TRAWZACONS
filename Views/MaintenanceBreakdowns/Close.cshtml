@model ITServiceDeskApp.Controllers.MaintenanceBreakdownsController.CloseForm
@using ITServiceDeskApp.Services
@{ViewData["Title"]="Gestión y cierre de avería";var record=Model.Record!;}
<link rel="stylesheet" href="~/css/averias.css" asp-append-version="true"/>
<div class="mx-auto" style="max-width:950px"><header class="averias-hero mb-4"><div><small>MANTENIMIENTO · AVERÍA AV-@record.Id</small><h2>Gestión de avería · @record.Equipment</h2></div></header>
@if(TempData["ClosureOk"] is string success){<div class="alert alert-success">@success</div>}
@if(TempData["ClosureConflict"] is string conflict){<div class="alert alert-warning" role="alert">@conflict</div>}
<section class="card card-body mb-3"><p><strong>Inicio:</strong> @record.EventAt.ToString("dd/MM/yyyy HH:mm") · <strong>Conductor:</strong> @record.Driver</p>
<ul>@foreach (var damage in record.GetDamages()) { <li>@damage.Target · @damage.Category · @damage.Element</li> }</ul>
<p class="mb-0">@record.Observation</p></section>
@if(MaintenanceBreakdownBoard.IsOperationallyOpen(record)){
<form asp-action="Close" method="post" class="card card-body">
<input asp-for="Id" type="hidden"/><input asp-for="ReturnToBoard" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3 mb-3">
    <fieldset class="col-md-6">
        <legend class="fs-6 fw-bold">Técnicos asignados</legend>
        @foreach (var technician in Model.Technicians)
        {
            <label class="d-block"><input class="form-check-input me-1" type="checkbox" name="TechnicianIds" value="@technician.Id" checked="@Model.TechnicianIds.Contains(technician.Id)" /> @technician.FullName @(!technician.IsActive ? "(inactivo)" : "")</label>
        }
        @if (Model.Technicians.Count == 0) { <p class="text-muted mb-0">No hay técnicos disponibles.</p> }
    </fieldset>
    <fieldset class="col-md-6">
        <legend class="fs-6 fw-bold">En reparación</legend>
        <div class="form-check"><input asp-for="EquipmentUnderRepair" class="form-check-input"/><label asp-for="EquipmentUnderRepair" class="form-check-label">Equipo</label></div>
        <div class="form-check"><input asp-for="GondolaUnderRepair" class="form-check-input"/><label asp-for="GondolaUnderRepair" class="form-check-label">Góndola</label></div>
    </fieldset>
    <div class="col-md-6"><label asp-for="SlaDeadline" class="form-label fw-bold">Fecha y hora límite de atención</label><input asp-for="SlaDeadline" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control"/><small class="text-muted">Se toma del tiempo estimado de la bitácora cuando está disponible.</small></div>
</div>
<button type="submit" name="operation" value="assign" class="btn btn-primary align-self-start mb-4">Guardar técnicos, plazo y reparación</button>
<label asp-for="ClosedAt" class="form-label fw-bold">Fecha y hora de cierre (obligatoria para cerrar)</label><input asp-for="ClosedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control mb-2"/>
<p class="small text-muted">Hora de Nicaragua. Al cerrar la última avería abierta, el equipo pasará a Equipos descargados.</p><button type="submit" name="operation" value="close" class="btn btn-success align-self-start">Cerrar incidencia y activar equipo</button></form>
}else{<div class="alert alert-info">Estado: @record.Status · Cierre: @(record.EndAt?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha registrada")</div>}
<div class="mt-3">@if(Model.ReturnToBoard){<a class="btn btn-outline-primary" asp-controller="Tickets" asp-action="MaintenanceBoard">Volver a la pizarra</a>}else{<a class="btn btn-outline-primary" asp-controller="Operaciones" asp-action="Averias">Volver a Averías</a>}</div></div>
