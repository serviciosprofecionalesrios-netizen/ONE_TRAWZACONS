@model ITServiceDeskApp.ViewModels.Users.UserEditViewModel
@using System.Linq
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var departmentOptions = ViewBag.DepartmentOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="mb-1">Editar Usuario</h3>
        <small class="text-muted">Actualiza datos del usuario conservando el formulario base.</small>

        <form asp-action="Edit" method="post" class="mt-3" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="FullName" class="form-label">FullName <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <div id="emailFeedback" class="small mt-1"></div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Department" class="form-label">Department <span class="text-danger">*</span></label>
                    <select asp-for="Department" class="form-select" asp-items="departmentOptions">
                        <option value="">Seleccionar departamento</option>
                    </select>
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Role" class="form-label">Role <span class="text-danger">*</span></label>
                    <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<ITServiceDeskApp.Models.UserRole>()"></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Activo</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <label asp-for="CreatedAt" class="form-label">Creado</label>
                    <input asp-for="CreatedAt" class="form-control" readonly />
                </div>

                <div class="col-12">
                    <div class="alert alert-warning mb-1">
                        Por seguridad no es posible ver la contraseña actual. Puedes restablecerla ingresando una nueva.
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="NewPassword" class="form-label">Nueva Contraseña (opcional)</label>
                    <div class="input-group">
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Mínimo 8 caracteres" />
                        <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn">Mostrar</button>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                    </div>
                    <small id="passwordStrengthText" class="text-muted">Fortaleza: pendiente</small>
                    <span asp-validation-for="NewPassword" class="text-danger d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmNewPassword" class="form-label">Confirmar Nueva Contraseña</label>
                    <div class="input-group">
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPasswordBtn">Mostrar</button>
                    </div>
                    <small id="passwordMatchText" class="text-muted d-block mt-1">Coincidencia: pendiente</small>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-warning">Actualizar Usuario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const emailInput = document.getElementById('Email');
            const emailFeedback = document.getElementById('emailFeedback');
            const passwordInput = document.getElementById('NewPassword');
            const confirmInput = document.getElementById('ConfirmNewPassword');
            const strengthBar = document.getElementById('passwordStrengthBar');
            const strengthText = document.getElementById('passwordStrengthText');
            const matchText = document.getElementById('passwordMatchText');
            const togglePasswordBtn = document.getElementById('togglePasswordBtn');
            const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPasswordBtn');

            function scorePassword(value) {
                if (!value) return 0;
                let score = 0;
                if (value.length >= 8) score += 25;
                if (/[A-Z]/.test(value)) score += 25;
                if (/[a-z]/.test(value)) score += 20;
                if (/\d/.test(value)) score += 20;
                if (/[^A-Za-z0-9]/.test(value)) score += 10;
                return Math.min(score, 100);
            }

            function paintStrength(score) {
                strengthBar.style.width = score + '%';
                strengthBar.className = 'progress-bar';
                if (score === 0) {
                    strengthText.textContent = 'Fortaleza: pendiente';
                    return;
                }
                if (score < 40) {
                    strengthBar.classList.add('bg-danger');
                    strengthText.textContent = 'Fortaleza: débil';
                } else if (score < 75) {
                    strengthBar.classList.add('bg-warning');
                    strengthText.textContent = 'Fortaleza: media';
                } else {
                    strengthBar.classList.add('bg-success');
                    strengthText.textContent = 'Fortaleza: fuerte';
                }
            }

            function validateMatch() {
                if (!confirmInput.value && !passwordInput.value) {
                    matchText.textContent = 'Coincidencia: pendiente';
                    matchText.className = 'text-muted d-block mt-1';
                    return;
                }

                if (passwordInput.value === confirmInput.value) {
                    matchText.textContent = 'Coincidencia: correcta';
                    matchText.className = 'text-success d-block mt-1';
                } else {
                    matchText.textContent = 'Coincidencia: no coincide';
                    matchText.className = 'text-danger d-block mt-1';
                }
            }

            async function checkEmailAvailability() {
                const value = (emailInput.value || '').trim();
                const idValue = document.getElementById('Id').value;
                if (!value) {
                    emailFeedback.textContent = '';
                    return;
                }

                try {
                    const response = await fetch(`@Url.Action("CheckEmail", "Users")?email=${encodeURIComponent(value)}&id=${encodeURIComponent(idValue)}`);
                    const result = await response.json();
                    if (result === true) {
                        emailFeedback.textContent = 'Correo disponible';
                        emailFeedback.className = 'small mt-1 text-success';
                    } else {
                        emailFeedback.textContent = typeof result === 'string' ? result : 'Correo no disponible';
                        emailFeedback.className = 'small mt-1 text-danger';
                    }
                } catch {
                    emailFeedback.textContent = 'No se pudo validar el correo en este momento';
                    emailFeedback.className = 'small mt-1 text-warning';
                }
            }

            function toggleVisibility(input, button) {
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
                button.textContent = input.type === 'password' ? 'Mostrar' : 'Ocultar';
            }

            if (passwordInput) {
                passwordInput.addEventListener('input', function () {
                    paintStrength(scorePassword(passwordInput.value));
                    validateMatch();
                });
            }

            if (confirmInput) {
                confirmInput.addEventListener('input', validateMatch);
            }

            if (emailInput) {
                emailInput.addEventListener('blur', checkEmailAvailability);
            }

            if (togglePasswordBtn && passwordInput) {
                togglePasswordBtn.addEventListener('click', function () {
                    toggleVisibility(passwordInput, togglePasswordBtn);
                });
            }

            if (toggleConfirmPasswordBtn && confirmInput) {
                toggleConfirmPasswordBtn.addEventListener('click', function () {
                    toggleVisibility(confirmInput, toggleConfirmPasswordBtn);
                });
            }
        });
    </script>
}
