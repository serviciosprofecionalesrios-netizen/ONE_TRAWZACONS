@model IEnumerable<ITServiceDeskApp.Models.User>
@using ITServiceDeskApp.Models

<h2 class="mb-3">Listado de Usuarios</h2>

<a asp-action="Create" class="btn btn-danger mb-3">
    <i class="bi bi-person-plus"></i> Nuevo Usuario
</a>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No hay usuarios registrados.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th style="width:280px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@Html.DisplayFor(modelItem => user.Role)</td>

                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>

                <td>

                    <!-- EDITAR -->
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Editar
                    </a>

                    <!-- ACTIVAR / DESACTIVAR -->
                    <form asp-action="ToggleStatus"
                          asp-route-id="@user.Id"
                          method="post"
                          style="display:inline-block;"
                          onsubmit="return confirm('¿Desea cambiar el estado de este usuario?');">

                        @Html.AntiForgeryToken()

                        @if (user.IsActive)
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-secondary">
                                <i class="bi bi-toggle-off"></i> Desactivar
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-success">
                                <i class="bi bi-toggle-on"></i> Activar
                            </button>
                        }
                    </form>

                </td>
            </tr>
        }
        </tbody>
    </table>
}