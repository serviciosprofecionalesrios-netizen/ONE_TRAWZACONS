@model List<ITServiceDeskApp.Models.HsIncident>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Incidentes H&S";
    var statusOptions = new SelectList(ViewBag.StatusOptions as string[] ?? Array.Empty<string>(), ViewBag.Status as string ?? string.Empty);
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="mb-1">Incidentes H&S</h2><div class="text-muted">Registro e investigacion de eventos.</div></div>
        <a asp-action="IncidentCreate" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo</a>
    </div>
    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg)) { <div class="alert alert-success">@msg</div> }
    <div class="card shadow-sm mb-3"><div class="card-body"><form method="get" class="row g-2"><div class="col-md-4"><select name="status" class="form-select" asp-items="statusOptions"><option value="">Todos los estados</option></select></div><div class="col-md-2"><button class="btn btn-primary" type="submit">Filtrar</button></div></form></div></div>
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>No.</th><th>Fecha</th><th>Sitio</th><th>Area</th><th>Tipo</th><th>Severidad</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><a asp-action="IncidentDetails" asp-route-id="@item.Id">@item.IncidentNumber</a></td>
                <td>@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Site</td>
                <td>@item.Area</td>
                <td>@item.IncidentType</td>
                <td><span class="badge @(item.Severity == "Critica" ? "text-bg-danger" : item.Severity == "Alta" ? "text-bg-warning" : "text-bg-secondary")">@item.Severity</span></td>
                <td>@item.Status</td>
                <td class="text-end"><a asp-action="IncidentEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
            </tr>
        }
        </tbody>
    </table></div></div>
</div>
