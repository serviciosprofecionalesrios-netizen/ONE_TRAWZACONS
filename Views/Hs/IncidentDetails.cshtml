@model ITServiceDeskApp.Models.HsIncident
@using ITServiceDeskApp.Models

@{
    ViewData["Title"] = "Detalle incidente H&S";
    var actions = ViewBag.Actions as List<HsCorrectiveAction> ?? new List<HsCorrectiveAction>();
}

<div class="container mt-4" style="max-width:1100px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-1">@Model.IncidentNumber</h3><div class="text-muted">@Model.IncidentType - @Model.Site / @Model.Area</div></div>
        <a asp-action="IncidentEdit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
    </div>
    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg)) { <div class="alert alert-success">@msg</div> }
    <div class="row g-3">
        <div class="col-lg-7"><div class="card shadow-sm h-100"><div class="card-body"><dl class="row mb-0">
            <dt class="col-sm-4">Fecha</dt><dd class="col-sm-8">@Model.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Reportado por</dt><dd class="col-sm-8">@Model.ReportedBy</dd>
            <dt class="col-sm-4">Severidad</dt><dd class="col-sm-8">@Model.Severity</dd>
            <dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@Model.Status</dd>
            <dt class="col-sm-4">Descripcion</dt><dd class="col-sm-8">@Model.Description</dd>
            <dt class="col-sm-4">Accion inmediata</dt><dd class="col-sm-8">@(Model.ImmediateAction ?? "N/A")</dd>
            <dt class="col-sm-4">Causa inmediata</dt><dd class="col-sm-8">@(Model.ImmediateCause ?? "N/A")</dd>
            <dt class="col-sm-4">Causa raiz</dt><dd class="col-sm-8">@(Model.RootCause ?? "N/A")</dd>
            <dt class="col-sm-4">5 porques</dt><dd class="col-sm-8">@(Model.FiveWhyAnalysis ?? "N/A")</dd>
            <dt class="col-sm-4">Investigador</dt><dd class="col-sm-8">@(Model.Investigator ?? "N/A")</dd>
            <dt class="col-sm-4">Riesgo inicial</dt><dd class="col-sm-8"><span class="badge @(Model.RiskLevel == "Critico" || Model.RiskLevel == "Alto" ? "text-bg-danger" : Model.RiskLevel == "Medio" ? "text-bg-warning" : "text-bg-success")">@Model.RiskLevel (@Model.RiskScore)</span></dd>
            <dt class="col-sm-4">Riesgo residual</dt><dd class="col-sm-8"><span class="badge @(Model.ResidualRiskLevel == "Critico" || Model.ResidualRiskLevel == "Alto" ? "text-bg-danger" : Model.ResidualRiskLevel == "Medio" ? "text-bg-warning" : "text-bg-success")">@Model.ResidualRiskLevel (@Model.ResidualRiskScore)</span></dd>
            <dt class="col-sm-4">Controles recomendados</dt><dd class="col-sm-8">@(Model.RecommendedControls ?? "N/A")</dd>
            <dt class="col-sm-4">Tiempo perdido</dt><dd class="col-sm-8">@(Model.LostTime ? $"Si, {Model.LostDays} dia(s)" : "No")</dd>
        </dl></div></div></div>
        <div class="col-lg-5"><div class="card shadow-sm h-100"><div class="card-header fw-semibold">Evidencia</div><div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.EvidencePath)) { <a href="@Model.EvidencePath" target="_blank" class="btn btn-outline-secondary">Ver evidencia</a> } else { <div class="text-muted">Sin evidencia adjunta.</div> }
        </div></div></div>
    </div>
    <div class="card shadow-sm mt-3"><div class="card-header fw-semibold">Acciones correctivas relacionadas</div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Accion</th><th>Responsable</th><th>Prioridad</th><th>Fecha</th><th>Estado</th></tr></thead><tbody>
        @foreach (var action in actions) { <tr><td>@action.Title</td><td>@action.Owner</td><td>@action.Priority</td><td>@action.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@action.Status</td></tr> }
    </tbody></table></div></div>
</div>
