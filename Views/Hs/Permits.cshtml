@model List<ITServiceDeskApp.Models.HsWorkPermit>

@{
    ViewData["Title"] = "Permisos de Trabajo H&S";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="mb-1">Permisos de Trabajo</h2><div class="text-muted">Control de permisos de alto riesgo y autorizaciones.</div></div>
        <a asp-action="PermitCreate" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo</a>
    </div>
    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg)) { <div class="alert alert-success">@msg</div> }
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>No.</th><th>Tipo</th><th>Sitio</th><th>Area</th><th>Solicitado por</th><th>Inicio</th><th>Fin</th><th>Vence respuesta</th><th>Checklist</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            var evidencePaths = string.IsNullOrWhiteSpace(item.EvidencePaths)
                ? Array.Empty<string>()
                : item.EvidencePaths.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            <tr>
                <td><span class="badge text-bg-dark">@item.PermitNumber</span></td>
                <td>@item.PermitType</td>
                <td>@item.Site</td>
                <td>@item.Area</td>
                <td>@item.RequestedBy</td>
                <td>@item.StartAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.EndAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (item.ApprovalResponseDueAtUtc.HasValue)
                    {
                        var dueLocal = item.ApprovalResponseDueAtUtc.Value.ToLocalTime();
                        var isOverdue = item.Status == "Solicitado" && item.ApprovalResponseDueAtUtc.Value < DateTime.UtcNow;
                        <span class="badge @(isOverdue ? "text-bg-danger" : "text-bg-info")">@dueLocal.ToString("dd/MM/yyyy HH:mm")</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>@(new[] { item.HasRiskAssessment, item.HasAreaIsolation, item.HasPpe, item.HasEmergencyPlan, item.HasSupervisorApproval }.Count(x => x))/5</td>
                <td><span class="badge @(item.Status == "Aprobado" || item.Status == "En ejecucion" ? "text-bg-success" : item.Status == "Rechazado" ? "text-bg-danger" : "text-bg-warning")">@item.Status</span></td>
                <td class="text-end">
                    @if (evidencePaths.Length > 0)
                    {
                        <a href="@evidencePaths[0]" target="_blank" class="btn btn-sm btn-outline-secondary">Evidencia (@evidencePaths.Length)</a>
                    }
                    <a asp-action="PermitEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
</div>
