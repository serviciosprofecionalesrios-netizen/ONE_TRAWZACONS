@model List<ITServiceDeskApp.Models.HsDocument>

@{
    ViewData["Title"] = "Documentos H&S";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="mb-1">Documentos H&amp;S</h2><div class="text-muted">Politicas, procedimientos, matrices IPER, AST/JSA, actas y reportes.</div></div>
        <a asp-action="DocumentCreate" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo</a>
    </div>
    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg)) { <div class="alert alert-success">@msg</div> }
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Codigo</th><th>Titulo</th><th>Tipo</th><th>Version</th><th>Sitio</th><th>Revision</th><th>Estado</th><th>Archivo</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><span class="badge text-bg-dark">@item.Code</span></td>
                <td>@item.Title</td>
                <td>@item.DocumentType</td>
                <td>@item.Version</td>
                <td>@item.Site</td>
                <td>@(item.ReviewDateUtc?.ToLocalTime().ToString("dd/MM/yyyy") ?? "N/A")</td>
                <td><span class="badge @(item.Status == "Vigente" ? "text-bg-success" : item.Status == "Obsoleto" ? "text-bg-danger" : "text-bg-warning")">@item.Status</span></td>
                <td>@if (!string.IsNullOrWhiteSpace(item.FilePath)) { <a href="@item.FilePath" target="_blank">Ver</a> } else { <span class="text-muted">N/A</span> }</td>
            </tr>
        }
        </tbody>
    </table></div></div>
</div>
