@{
    ViewData["Title"] = "Gestión operativa H&S";
}

<div class="container-fluid mt-3">
    <div class="module-banner mb-3">
        <h2 class="mb-1"><i class="bi bi-clipboard2-check" aria-hidden="true"></i><span>Gestión operativa H&amp;S</span></h2>
        <div class="text-muted">Administra incidentes, inspecciones y permisos de trabajo desde un solo lugar.</div>
    </div>
    <partial name="_OperationalNavigation" />
    <div class="row g-3">
        <div class="col-md-4">
            <a class="card h-100 shadow-sm text-decoration-none" asp-controller="Hs" asp-action="Incidents">
                <div class="card-body">
                    <h3 class="h5"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Incidentes</h3>
                    <p class="text-muted mb-0">Registra e investiga eventos y consulta su seguimiento.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card h-100 shadow-sm text-decoration-none" asp-controller="Hs" asp-action="Inspections">
                <div class="card-body">
                    <h3 class="h5"><i class="bi bi-clipboard2-check me-2" aria-hidden="true"></i>Inspecciones</h3>
                    <p class="text-muted mb-0">Consulta inspecciones, cumplimiento y hallazgos.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card h-100 shadow-sm text-decoration-none" asp-controller="Hs" asp-action="Permits">
                <div class="card-body">
                    <h3 class="h5"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>Permisos de trabajo</h3>
                    <p class="text-muted mb-0">Gestiona permisos de alto riesgo y sus autorizaciones.</p>
                </div>
            </a>
        </div>
    </div>
</div>
