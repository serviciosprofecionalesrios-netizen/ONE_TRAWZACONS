@model List<ITServiceDeskApp.Models.HsInspection>

@{
    ViewData["Title"] = "Inspecciones H&S";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2 class="mb-1">Inspecciones H&S</h2><div class="text-muted">Seguimiento de cumplimiento y hallazgos.</div></div>
        <a asp-action="InspectionCreate" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nueva</a>
    </div>
    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg)) { <div class="alert alert-success">@msg</div> }
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>No.</th><th>Fecha</th><th>Sitio</th><th>Area</th><th>Equipo</th><th>Inspector</th><th>Categoria</th><th class="text-end">Score</th><th class="text-end">Hallazgos</th><th>Estado</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><span class="badge text-bg-dark">@item.InspectionNumber</span></td>
                <td>@item.InspectionDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td>@item.Site</td>
                <td>@item.Area</td>
                <td>@(string.IsNullOrWhiteSpace(item.EquipmentCode) ? "-" : item.EquipmentCode)</td>
                <td>@item.Inspector</td>
                <td>@item.Category</td>
                <td class="text-end"><span class="badge @(item.ScorePercent < 70 ? "text-bg-danger" : item.ScorePercent < 85 ? "text-bg-warning" : "text-bg-success")">@item.ScorePercent.ToString("N2")%</span></td>
                <td class="text-end">@item.FindingsCount (@item.CriticalFindingsCount crit.)</td>
                <td>@item.Status</td>
            </tr>
        }
        </tbody>
    </table></div></div>
</div>
