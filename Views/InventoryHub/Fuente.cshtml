@model ITServiceDeskApp.ViewModels.Inventory.PublishedInventoryViewModel
@{ ViewData["Title"] = Model.Sheet.Name; }
<link rel="stylesheet" href="~/css/inventory-workspace.css" asp-append-version="true" />
<div class="container-fluid inventory-workspace section-@Model.Sheet.Key">
    <a asp-action="Index" class="inventory-back">← Centro de inventario</a>
    <header class="inventory-heading">
        <div class="inventory-symbol"><i class="bi @Model.Icon" aria-hidden="true"></i></div>
        <div><div class="inventory-eyebrow">GESTIÓN DE ALMACÉN</div><h2>@Model.Sheet.Name</h2><p>@Model.Description</p></div>
        <div class="inventory-total"><strong>@(Model.Source.Table?.Rows.Count.ToString("N0") ?? "—")</strong><span>registros</span></div>
    </header>
    <partial name="_PublishedLinks" />
    @if (Model.Source.Warning != null)
    {
        <div class="alert alert-warning" role="alert">No fue posible actualizar la información. @(Model.Source.Table != null ? "Se muestra la última consulta disponible." : "Intenta nuevamente en un momento.")</div>
    }
    @if (Model.Source.Table != null)
    {
        <form method="get" asp-action="Fuente" class="inventory-search" role="search">
            <input type="hidden" name="section" value="@Model.Sheet.Key" />
            <label for="inventory-search" class="visually-hidden">Buscar registros</label>
            <input id="inventory-search" name="q" value="@Model.Query" maxlength="200" class="form-control" placeholder="@(Model.Sheet.Key == "inventario" ? "Buscar artículo, código, número de parte o almacén…" : Model.Sheet.Key == "salidas" ? "Buscar requisición, equipo, destinatario o fecha…" : "Buscar orden, proveedor, descripción o fecha…")" />
            <button class="btn btn-primary" type="submit">Buscar</button>
            @if (!string.IsNullOrEmpty(Model.Query)) { <a class="btn btn-outline-secondary" asp-action="Fuente" asp-route-section="@Model.Sheet.Key">Limpiar</a> }
        </form>
        <div class="inventory-results"><span>@Model.TotalRows resultados</span><span>Página @Model.Page de @Model.TotalPages</span></div>
        @switch (Model.Sheet.Key)
        {
            case "inventario": <partial name="_Stock" model="Model" /> break;
            case "entradas": <partial name="_Receipts" model="Model" /> break;
            case "salidas": <partial name="_Dispatches" model="Model" /> break;
            case "compras": <partial name="_Purchases" model="Model" /> break;
        }
        @if (Model.TotalRows == 0) { <div class="inventory-empty"><h3>No se encontraron registros</h3><p>Prueba con otro código, descripción o fecha.</p></div> }
        <nav aria-label="Páginas de resultados" class="d-flex justify-content-between align-items-center my-4">
            <span class="text-muted small">Página @Model.Page de @Model.TotalPages</span>
            <div class="d-flex gap-2">
                @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Fuente" asp-route-section="@Model.Sheet.Key" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">Anterior</a> }
                @if (Model.Page < Model.TotalPages) { <a class="btn btn-primary" asp-action="Fuente" asp-route-section="@Model.Sheet.Key" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Siguiente</a> }
            </div>
        </nav>
    }
</div>
