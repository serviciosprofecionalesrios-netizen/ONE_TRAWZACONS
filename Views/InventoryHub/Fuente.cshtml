@model ITServiceDeskApp.ViewModels.Inventory.PublishedInventoryViewModel
@using ITServiceDeskApp.Services
@{ ViewData["Title"] = Model.Sheet.Name; }
<div class="container-fluid mt-4">
    <a asp-action="Index">Volver al centro de inventario</a>
    <h2 class="mt-3">@Model.Sheet.Name</h2>
    <partial name="_PublishedLinks" />
    <p class="text-muted">
        Datos de <a href="@(PublishedInventoryService.SourceUrl + "?gid=" + Model.Sheet.Gid)" target="_blank" rel="noopener noreferrer">Google Sheets</a>.
        Consulta de solo lectura. Los cambios se realizan en la hoja y se consultan nuevamente después de cinco minutos al abrir o recargar esta página; la publicación de Google puede demorar.
    </p>
    @if (Model.Source.Warning != null)
    {
        <div class="alert alert-warning" role="alert">@Model.Source.Warning</div>
    }
    @if (Model.Source.Table != null)
    {
        <p>Última consulta: @Model.Source.RetrievedAt?.ToString("yyyy-MM-dd HH:mm 'UTC'"). Registros: @Model.Source.Table.Rows.Count.</p>
        @if (Model.Source.Table.ExcludedRows > 0)
        {
            <p class="small text-muted">@Model.Source.Table.ExcludedRows filas sin @string.Join(", ", Model.Sheet.IdentityColumns) se omiten. No se suman saldos ni se deduplican registros.</p>
        }
        <form method="get" asp-action="Fuente" class="d-flex gap-2 mb-3" role="search">
            <input type="hidden" name="section" value="@Model.Sheet.Key" />
            <label for="inventory-search" class="visually-hidden">Buscar en todas las columnas</label>
            <input id="inventory-search" name="q" value="@Model.Query" maxlength="200" class="form-control" placeholder="Buscar código, descripción, proveedor, orden o fecha" />
            <button class="btn btn-primary" type="submit">Buscar</button>
            <a class="btn btn-outline-secondary" asp-action="Fuente" asp-route-section="@Model.Sheet.Key">Limpiar</a>
        </form>
        <p>@Model.TotalRows resultados. Página @Model.Page de @Model.TotalPages. Las celdas vacías se muestran como —.</p>
        <div class="table-responsive" tabindex="0" aria-label="@Model.Sheet.Name">
            <table class="table table-striped table-bordered table-sm align-middle">
                <thead><tr><th scope="col">Fila de origen</th>@foreach (var header in Model.Source.Table.Headers) { <th scope="col" class="text-nowrap">@header</th> }</tr></thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr><th scope="row">@row.SourceRow</th>@foreach (var cell in row.Cells) { <td style="min-width: 110px; max-width: 380px; overflow-wrap: anywhere;">@(string.IsNullOrEmpty(cell) ? "—" : cell)</td> }</tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalRows == 0) { <p>No se encontraron registros.</p> }
        <nav aria-label="Páginas de resultados" class="d-flex gap-3 my-3">
            @if (Model.Page > 1) { <a asp-action="Fuente" asp-route-section="@Model.Sheet.Key" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">Anterior</a> }
            @if (Model.Page < Model.TotalPages) { <a asp-action="Fuente" asp-route-section="@Model.Sheet.Key" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Siguiente</a> }
        </nav>
    }
</div>
