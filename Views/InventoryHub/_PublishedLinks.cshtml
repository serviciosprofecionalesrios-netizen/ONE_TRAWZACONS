@using ITServiceDeskApp.Services
<nav class="inventory-tabs" aria-label="Secciones de inventario">
    @foreach (var sheet in PublishedInventoryService.Sheets)
    {
        var active = Context.Request.Query["section"].ToString() == sheet.Key || (string.IsNullOrEmpty(Context.Request.Query["section"]) && sheet.Key == "inventario");
        <a class="@(active ? "selected" : "")" aria-current="@(active ? "page" : null)" asp-controller="InventoryHub" asp-action="Fuente" asp-route-section="@sheet.Key">@sheet.Name</a>
    }
</nav>
