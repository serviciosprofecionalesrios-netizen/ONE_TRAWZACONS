@using ITServiceDeskApp.Services
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h3 class="h5">Inventario y movimientos de Google Sheets</h3>
        <p class="text-muted">Consulta existencias, entradas, salidas y compras del archivo publicado.</p>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var sheet in PublishedInventoryService.Sheets)
            {
                <a class="btn btn-outline-primary" asp-controller="InventoryHub" asp-action="Fuente" asp-route-section="@sheet.Key">@sheet.Name</a>
            }
        </div>
    </div>
</div>
