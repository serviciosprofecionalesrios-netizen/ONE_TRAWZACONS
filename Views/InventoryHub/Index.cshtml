@model ITServiceDeskApp.ViewModels.Inventory.InventoryHubViewModel

@{
    ViewData["Title"] = "Inventario";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1">Centro de Inventario</h2>
            <small class="text-muted">Gestion de inventarios, salidas de articulos y flujo de compras.</small>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Inventario TI</div>
                    <div class="h3 mb-1">@Model.ItAssetsTotal</div>
                    <div class="small text-muted">Activos: @Model.ItAssetsActive</div>
                    <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Inventory" asp-action="Index">Ver inventario TI</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Inventario de repuestos</div>
                    <div class="h3 mb-1">@Model.SparePartsTotal</div>
                    <div class="small text-muted">Bajo stock: @Model.SparePartsLowStock | Agotado: @Model.SparePartsOutOfStock</div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="MaintenanceInventory" asp-action="Index">Ver repuestos</a>
                        <a class="btn btn-sm btn-outline-dark" asp-controller="MaintenanceInventory" asp-action="Transito">Ver transito</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Solicitudes de compras</div>
                    <div class="h3 mb-1">@Model.PurchaseRequestsOpen</div>
                    <div class="small text-muted">Pendientes o en proceso</div>
                    <a class="btn btn-sm btn-outline-primary mt-3"
                       asp-controller="Tickets"
                       asp-action="Index"
                       asp-route-department="Inventario">Ver solicitudes</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Accesos rapidos</h5>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-controller="Inventory" asp-action="Create"><i class="bi bi-plus-circle me-1"></i> Nuevo articulo TI</a>
                <a class="btn btn-primary" asp-controller="MaintenanceInventory" asp-action="Create"><i class="bi bi-plus-circle me-1"></i> Nuevo articulo de repuesto</a>
                <a class="btn btn-outline-dark"
                   asp-controller="Tickets"
                   asp-action="CreateFinance"
                   asp-route-requestType="Orden de compra"><i class="bi bi-receipt me-1"></i> Orden de compra</a>
                <a class="btn btn-outline-dark"
                   asp-controller="Tickets"
                   asp-action="CreateArticleOutput"><i class="bi bi-box-arrow-right me-1"></i> Salida de articulos</a>
                <a class="btn btn-outline-dark"
                   asp-controller="Tickets"
                   asp-action="Index"
                   asp-route-department="Inventario"><i class="bi bi-journal-text me-1"></i> Solicitudes de compras</a>
            </div>
        </div>
    </div>
</div>
