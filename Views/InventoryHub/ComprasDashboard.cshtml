@model ITServiceDeskApp.ViewModels.Inventory.PurchaseDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard de compras";
    var categoryTotal = Model.TopCategories.Sum(x => x.Cordobas);
    var palette = new[] { "#2563eb", "#0f9f6e", "#f59e0b", "#8b5cf6", "#ef4444", "#06b6d4", "#64748b" };
    var slices = new List<string>();
    var accumulated = 0m;
    for (var index = 0; index < Model.TopCategories.Count; index++)
    {
        var percentage = categoryTotal > 0m ? Model.TopCategories[index].Cordobas * 100m / categoryTotal : 0m;
        var next = accumulated + percentage;
        slices.Add($"{palette[index % palette.Length]} {accumulated.ToString("0.##", CultureInfo.InvariantCulture)}% {next.ToString("0.##", CultureInfo.InvariantCulture)}%");
        accumulated = next;
    }
    var categoryChart = slices.Any() ? string.Join(", ", slices) : "#e2e8f0 0 100%";
    var monthlyBudget = 500_000m;
    var monthlyMax = Math.Max(monthlyBudget, Math.Max(1m, Model.MonthlySpend.Max(x => x.Cordobas)));
    var monthlyOrdersMax = Math.Max(1, Model.MonthlySpend.Max(x => x.Orders));
    var monthlyCount = Math.Max(1, Model.MonthlySpend.Count);
    var monthlyStep = 870m / monthlyCount;
    var monthlyBarWidth = Math.Min(54m, monthlyStep * .52m);
    string Svg(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    var orderLinePoints = string.Join(" ", Model.MonthlySpend.Select((item, index) =>
        $"{Svg(75m + monthlyStep * index + monthlyStep / 2m)},{Svg(220m - item.Orders * 150m / monthlyOrdersMax)}"));
    var budgetLineY = 220m - monthlyBudget * 150m / monthlyMax;
}
<link rel="stylesheet" href="~/css/inventory-workspace.css" asp-append-version="true" />
<style>
    .purchase-kpi { position: relative; overflow: hidden; }
    .purchase-kpi-icon { position: absolute; right: 16px; top: 16px; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; font-size: 1.35rem; background: #eff6ff; color: #2563eb; }
    .purchase-kpi-icon.success { background: #ecfdf5; color: #0f9f6e; }.purchase-kpi-icon.warning { background: #fff7ed; color: #d97706; }
    .purchase-chart { width: 190px; height: 190px; border-radius: 50%; background: conic-gradient(@Html.Raw(categoryChart)); position: relative; margin: 8px auto; }
    .purchase-chart::after { content: "Gasto C$"; position: absolute; inset: 28px; border-radius: 50%; background: white; display: grid; place-items: center; text-align: center; font-size: .85rem; font-weight: 700; color: #334155; box-shadow: inset 0 0 0 1px #e2e8f0; }
    .chart-legend { list-style: none; padding: 0; margin: 0; }.chart-legend li { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 5px 0; border-bottom: 1px solid #edf2f7; font-size: .9rem; }.legend-name { display: flex; align-items: center; gap: 7px; }.legend-dot { width: 10px; height: 10px; border-radius: 50%; flex: 0 0 10px; }
    .rank-kpi { display: inline-flex; align-items: center; gap: 4px; min-width: 42px; font-weight: 700; }.rank-kpi.top-1 { color: #b7791f; }.rank-kpi.top-2 { color: #64748b; }.rank-kpi.top-3 { color: #b45309; }
    .monthly-combo { width: 100%; min-height: 285px; }.monthly-combo text { font-family: Arial, sans-serif; }.chart-key { display: inline-flex; align-items: center; gap: 6px; margin-right: 18px; font-size: .85rem; color: #475569; }.chart-key span { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }.chart-key .line { height: 3px; border-radius: 2px; }
    .supplier-share { height: 9px; border-radius: 6px; background: #e2e8f0; overflow: hidden; min-width: 100px; }.supplier-share > span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2563eb, #60a5fa); }
</style>
<div class="container-fluid inventory-workspace py-3">
    <a asp-action="Index" class="inventory-back">← Centro de inventario</a>
    <header class="module-banner inventory-heading mb-3">
        <div class="inventory-symbol"><i class="bi bi-graph-up-arrow"></i></div>
        <div><div class="inventory-eyebrow">CONTROL DE COMPRAS</div><h2>Dashboard de órdenes de compra</h2><p>Gasto enviado a compra, órdenes y proveedores según el período seleccionado.</p></div>
    </header>
    <partial name="_PublishedLinks" />
    @if (!string.IsNullOrWhiteSpace(Model.Warning)) { <div class="alert alert-warning">@Model.Warning</div> }
    <form method="get" class="inventory-search mb-3">
        <label class="visually-hidden" for="from">Desde</label><input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
        <label class="visually-hidden" for="to">Hasta</label><input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
        <select class="form-select" name="year" aria-label="Filtrar año"><option value="">Todos los años</option>@foreach (var optionYear in Model.AvailableYears) { <option value="@optionYear" selected="@(Model.SelectedYear == optionYear)">@optionYear</option> }</select>
        <select class="form-select" name="month" aria-label="Filtrar mes"><option value="">Todos los meses</option>@for (var optionMonth = 1; optionMonth <= 12; optionMonth++) { <option value="@optionMonth" selected="@(Model.SelectedMonth == optionMonth)">@(new DateTime(2000, optionMonth, 1).ToString("MMMM", CultureInfo.CurrentCulture))</option> }</select>
        <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Aplicar rango</button>
        <button class="btn btn-outline-primary" type="submit" name="refresh" value="true"><i class="bi bi-arrow-repeat me-1"></i>Actualizar datos</button>
        <a class="btn btn-outline-danger" asp-action="ExportComprasPdf" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF</a>
        <a class="btn btn-outline-secondary" asp-action="ComprasDashboard">Limpiar</a>
    </form>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card shadow-sm h-100 purchase-kpi"><div class="card-body"><span class="purchase-kpi-icon"><i class="bi bi-receipt"></i></span><small class="text-muted">Órdenes de compra</small><div class="display-6 fw-bold">@Model.PurchaseOrders</div><small>@Model.PurchaseLines líneas registradas</small></div></div></div>
        <div class="col-md-3"><div class="card shadow-sm h-100 border-success purchase-kpi"><div class="card-body"><span class="purchase-kpi-icon success"><i class="bi bi-cash-stack"></i></span><small class="text-muted">Gasto total C$</small><div class="h3 fw-bold text-success">C$ @Model.TotalCordobas.ToString("N2", CultureInfo.CurrentCulture)</div><small>Órdenes dentro del rango</small></div></div></div>
        <div class="col-md-3"><div class="card shadow-sm h-100 border-primary purchase-kpi"><div class="card-body"><span class="purchase-kpi-icon"><i class="bi bi-currency-dollar"></i></span><small class="text-muted">Gasto total USD</small><div class="h3 fw-bold text-primary">$ @Model.TotalUsd.ToString("N2", CultureInfo.CurrentCulture)</div><small>Órdenes dentro del rango</small></div></div></div>
        <div class="col-md-3"><div class="card shadow-sm h-100 purchase-kpi"><div class="card-body"><span class="purchase-kpi-icon warning"><i class="bi bi-calendar-check"></i></span><small class="text-muted">Última compra</small><div class="h4 fw-bold">@(Model.LatestPurchaseDate?.ToString("dd/MM/yyyy") ?? "Sin fecha")</div><small>Según la hoja de órdenes de compra</small></div></div></div>
    </div>
    <div class="card shadow-sm mb-4"><div class="card-header d-flex justify-content-between align-items-center"><strong><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Comportamiento mensual de gasto</strong><small class="text-muted">Presupuesto mensual: C$ 500,000 · Año @(Model.SelectedYear?.ToString() ?? (Model.MonthlySpend.FirstOrDefault()?.Year.ToString() ?? "—"))</small></div><div class="card-body"><div class="mb-2"><span class="chart-key"><span style="background:#2563eb"></span>Gasto C$</span><span class="chart-key"><span class="line" style="background:#f59e0b"></span>Órdenes de compra</span><span class="chart-key"><span class="line" style="background:#dc2626"></span>Presupuesto C$500k</span></div>@if (Model.MonthlySpend.Any()) { <svg class="monthly-combo" viewBox="0 0 1000 280" role="img" aria-label="Gráfico combinado de gasto, presupuesto y órdenes"><defs><linearGradient id="spendGradient" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#60a5fa"/><stop offset="100%" stop-color="#1d4ed8"/></linearGradient></defs><line x1="60" y1="220" x2="960" y2="220" stroke="#cbd5e1"/><line x1="60" y1="145" x2="960" y2="145" stroke="#e2e8f0" stroke-dasharray="4 4"/><line x1="60" y1="70" x2="960" y2="70" stroke="#e2e8f0" stroke-dasharray="4 4"/><line x1="60" y1="@Svg(budgetLineY)" x2="960" y2="@Svg(budgetLineY)" stroke="#dc2626" stroke-width="2" stroke-dasharray="7 5"/><text x="8" y="74" fill="#64748b" font-size="11">C$ @monthlyMax.ToString("N0")</text><text x="8" y="149" fill="#64748b" font-size="11">C$ @((monthlyMax / 2m).ToString("N0"))</text><text x="64" y="@Svg(budgetLineY - 5m)" fill="#dc2626" font-size="10">Presupuesto C$500k</text><text x="965" y="74" fill="#d97706" font-size="11">@monthlyOrdersMax OC</text>@for (var index = 0; index < Model.MonthlySpend.Count; index++) { var item = Model.MonthlySpend[index]; var center = 75m + monthlyStep * index + monthlyStep / 2m; var barHeight = item.Cordobas * 150m / monthlyMax; var barX = center - monthlyBarWidth / 2m; var barY = 220m - barHeight; <g><title>@item.Label: C$ @item.Cordobas.ToString("N2") · @item.Orders órdenes · @(item.DifferenceFromBudget > 0 ? "Excede C$ " + item.DifferenceFromBudget.ToString("N2") : "Dentro del presupuesto")</title><rect x="@Svg(barX)" y="@Svg(barY)" width="@Svg(monthlyBarWidth)" height="@Svg(barHeight)" rx="5" fill="url(#spendGradient)"/><text x="@Svg(center)" y="245" text-anchor="middle" fill="#334155" font-size="12" font-weight="700">@item.Label</text></g> }<polyline points="@orderLinePoints" fill="none" stroke="#f59e0b" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>@for (var index = 0; index < Model.MonthlySpend.Count; index++) { var item = Model.MonthlySpend[index]; var pointX = 75m + monthlyStep * index + monthlyStep / 2m; var pointY = 220m - item.Orders * 150m / monthlyOrdersMax; <g><circle cx="@Svg(pointX)" cy="@Svg(pointY)" r="5" fill="#fff" stroke="#f59e0b" stroke-width="3"/><text x="@Svg(pointX)" y="@Svg(pointY - 10m)" text-anchor="middle" fill="#b45309" font-size="11" font-weight="700">@item.Orders</text></g> }</svg> } else { <div class="text-muted py-5 text-center">No hay gasto con fecha para el año seleccionado.</div> }<div class="table-responsive mt-3"><table class="table table-sm mb-0"><thead><tr><th>Mes</th><th>Órdenes</th><th>Gasto C$</th><th>Presupuesto</th><th>Diferencia</th><th>Variación</th><th>USD</th></tr></thead><tbody>@foreach (var item in Model.MonthlySpend) { var variationClass = item.VariationPct > 0 ? "text-danger" : item.VariationPct < 0 ? "text-success" : "text-muted"; var budgetClass = item.DifferenceFromBudget > 0m ? "text-danger fw-bold" : "text-success fw-bold"; <tr class="@(Model.SelectedMonth == item.Month ? "table-success" : "")"><td>@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture))</td><td>@item.Orders</td><td>C$ @item.Cordobas.ToString("N2")</td><td>C$ @item.Budget.ToString("N2")</td><td class="@budgetClass">@(item.DifferenceFromBudget > 0m ? $"+C$ {item.DifferenceFromBudget:N2}" : $"C$ {item.DifferenceFromBudget:N2}")</td><td class="@variationClass">@(item.VariationPct == 0m ? "—" : $"{item.VariationPct:+0.0;-0.0}%")</td><td>$ @item.Usd.ToString("N2")</td></tr> }</tbody></table></div></div></div>
    <div class="row g-3 mb-4">
        <div class="col-lg-8"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Artículos de mayor gasto</div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>#</th><th>Artículo</th><th>Categoría</th><th>Órdenes</th><th>C$</th><th>USD</th></tr></thead><tbody>@for (var index = 0; index < Model.TopItems.Count; index++) { var item = Model.TopItems[index]; var rank = index + 1; <tr><td><span class="rank-kpi @(rank <= 3 ? $"top-{rank}" : "")">@if (rank == 1) { <i class="bi bi-trophy-fill"></i> } else if (rank == 2) { <i class="bi bi-award-fill"></i> } else if (rank == 3) { <i class="bi bi-award"></i> } @rank</span></td><td>@item.Name</td><td><span class="badge text-bg-light border">@item.Category</span></td><td>@item.Orders</td><td>C$ @item.Cordobas.ToString("N2")</td><td>$ @item.Usd.ToString("N2")</td></tr> } @if (!Model.TopItems.Any()) { <tr><td colspan="6" class="text-muted">No hay líneas de compra para este período.</td></tr> }</tbody></table></div></div></div>
        <div class="col-lg-4"><div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Distribución por categoría</div><div class="card-body py-2"><div class="purchase-chart"></div><ul class="chart-legend">@for (var index = 0; index < Model.TopCategories.Count; index++) { var item = Model.TopCategories[index]; var percentage = categoryTotal > 0m ? item.Cordobas * 100m / categoryTotal : 0m; <li><span class="legend-name"><span class="legend-dot" style="background:@palette[index % palette.Length]"></span>@item.Name</span><strong>@percentage.ToString("N1")%</strong></li> } @if (!Model.TopCategories.Any()) { <li class="text-muted">Sin categorías.</li> }</ul></div></div></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-lg-5"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Gasto por estado</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Estado</th><th>Órdenes</th><th>C$</th><th>USD</th></tr></thead><tbody>@foreach (var item in Model.ByStatus) { <tr><td>@item.Name</td><td>@item.Orders</td><td>C$ @item.Cordobas.ToString("N2")</td><td>$ @item.Usd.ToString("N2")</td></tr> } @if (!Model.ByStatus.Any()) { <tr><td colspan="4" class="text-muted">No hay órdenes para este rango.</td></tr> }</tbody></table></div></div></div>
        <div class="col-lg-7"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Principales proveedores por gasto</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>#</th><th>Proveedor</th><th>Órdenes</th><th>C$</th><th>USD</th></tr></thead><tbody>@for (var index = 0; index < Model.TopSuppliers.Count; index++) { var item = Model.TopSuppliers[index]; var rank = index + 1; <tr><td><span class="rank-kpi @(rank <= 3 ? $"top-{rank}" : "")">@if (rank == 1) { <i class="bi bi-trophy-fill"></i> } else if (rank == 2) { <i class="bi bi-award-fill"></i> } else if (rank == 3) { <i class="bi bi-award"></i> } @rank</span></td><td>@item.Name</td><td>@item.Orders</td><td>C$ @item.Cordobas.ToString("N2")</td><td>$ @item.Usd.ToString("N2")</td></tr> } @if (!Model.TopSuppliers.Any()) { <tr><td colspan="5" class="text-muted">No hay compras para mostrar.</td></tr> }</tbody></table></div></div></div>
    </div>
    <div class="row g-3 mb-4"><div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-buildings me-2 text-primary"></i>Concentración por proveedor</div><div class="card-body">@foreach (var supplier in Model.TopSuppliers.Take(6)) { var share = Model.TotalCordobas > 0m ? supplier.Cordobas * 100m / Model.TotalCordobas : 0m; <div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span>@supplier.Name</span><strong>@share.ToString("N1")%</strong></div><div class="supplier-share"><span style="width:@share.ToString("0.##", CultureInfo.InvariantCulture)%"></span></div></div> }</div></div></div><div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-arrow-up-right-circle text-danger me-2"></i>Artículos con mayor aumento de precio</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Artículo</th><th>Antes</th><th>Actual</th><th>Variación</th></tr></thead><tbody>@foreach (var item in Model.PriceIncreases) { <tr><td>@item.Item</td><td>C$ @item.PreviousPrice.ToString("N2")</td><td>C$ @item.CurrentPrice.ToString("N2")</td><td class="text-danger fw-bold">+@item.VariationPct.ToString("N1")%</td></tr> } @if (!Model.PriceIncreases.Any()) { <tr><td colspan="4" class="text-muted">No hay aumentos comparables en el historial.</td></tr> }</tbody></table></div></div></div></div>
    <div class="card shadow-sm"><div class="card-header d-flex justify-content-between"><strong>Órdenes de mayor gasto</strong><a asp-action="Fuente" asp-route-section="compras">Ver todas</a></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>#</th><th>Fecha</th><th>Orden</th><th>Proveedor</th><th>Estado</th><th>Descripción</th><th>C$</th><th>USD</th></tr></thead><tbody>@for (var index = 0; index < Model.RecentOrders.Count; index++) { var item = Model.RecentOrders[index]; var rank = index + 1; <tr><td><span class="rank-kpi @(rank <= 3 ? $"top-{rank}" : "")">@if (rank == 1) { <i class="bi bi-trophy-fill"></i> } else if (rank == 2) { <i class="bi bi-award-fill"></i> } else if (rank == 3) { <i class="bi bi-award"></i> } @rank</span></td><td>@(item.Date?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.OrderNumber</td><td>@item.Supplier</td><td>@item.Status</td><td>@item.Description</td><td>C$ @item.Cordobas.ToString("N2")</td><td>$ @item.Usd.ToString("N2")</td></tr> } @if (!Model.RecentOrders.Any()) { <tr><td colspan="8" class="text-muted">No hay órdenes de compra en el período seleccionado.</td></tr> }</tbody></table></div></div>
    @if (Model.OrdersWithoutAmountDetail.Any())
    {
        <div class="card shadow-sm mt-4"><div class="card-header fw-bold">Órdenes que requieren registrar monto</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Fecha</th><th>Orden</th><th>Proveedor</th><th>Descripción</th></tr></thead><tbody>@foreach (var item in Model.OrdersWithoutAmountDetail) { <tr><td>@(item.Date?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.OrderNumber</td><td>@item.Supplier</td><td>@item.Description</td></tr> }</tbody></table></div></div>
    }
</div>
