@model IEnumerable<ITServiceDeskApp.Models.MaintenanceInventoryPart>
@{
    ViewData["Title"] = "Maestro de Inventarios";
    var search = ViewBag.Search as string; var includeInactive = (bool?)ViewBag.IncludeInactive ?? false;
    var warehouses = ViewBag.Warehouses as IEnumerable<string> ?? Enumerable.Empty<string>(); var categories = ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>(); var statuses = ViewBag.StockStatuses as IEnumerable<string> ?? Enumerable.Empty<string>();
    var warehouse = ViewBag.Warehouse as string; var category = ViewBag.Category as string; var stockStatus = ViewBag.StockStatus as string;
}
<div class="container-fluid mt-4">
 <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3"><div><h2 class="fw-bold mb-0">Maestro de Inventarios</h2><small class="text-muted">Catálogo unificado de consulta y conteo físico.</small></div><div class="d-flex gap-2"><a asp-action="ExportExcel" asp-route-search="@search" asp-route-warehouse="@warehouse" asp-route-category="@category" asp-route-stockStatus="@stockStatus" asp-route-includeInactive="@includeInactive" class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel físico</a><a asp-action="ExportPdf" asp-route-search="@search" asp-route-warehouse="@warehouse" asp-route-category="@category" asp-route-stockStatus="@stockStatus" asp-route-includeInactive="@includeInactive" class="btn btn-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF físico</a></div></div>
 @if (User.IsInRole("Administrator") || User.IsInRole("CoordinadorIT") || User.IsInRole("Technician")) { <form method="post" asp-controller="MaintenanceInventory" asp-action="SyncFromGoogleSheet" class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2"><div><strong>Inventario existente:</strong> use esta sincronización para cargar o actualizar las filas del Maestro desde la hoja de origen.</div>@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Sincronizar inventario existente</button></form> }
 <form method="get" class="card card-body shadow-sm mb-3"><div class="row g-2"><div class="col-lg-4"><input name="search" value="@search" class="form-control" placeholder="Ítem, código, artículo, parte, marca o ubicación" /></div><div class="col-md-3 col-lg-2"><select name="warehouse" class="form-select"><option value="">Todos los almacenes</option>@foreach (var option in warehouses) { <option value="@option" selected="@(option == warehouse)">@option</option> }</select></div><div class="col-md-3 col-lg-2"><select name="category" class="form-select"><option value="">Todas las categorías</option>@foreach (var option in categories) { <option value="@option" selected="@(option == category)">@option</option> }</select></div><div class="col-md-3 col-lg-2"><select name="stockStatus" class="form-select"><option value="">Todo estado</option>@foreach (var option in statuses) { <option value="@option" selected="@(option == stockStatus)">@option</option> }</select></div><div class="col-md-3 col-lg-2 d-flex align-items-center"><div class="form-check"><input class="form-check-input" type="checkbox" name="includeInactive" value="true" checked="@includeInactive" id="inactive" /><label class="form-check-label" for="inactive">Incluir inactivos</label></div></div><div class="col-auto"><button class="btn btn-outline-primary">Filtrar</button></div></div></form>
 <div class="table-responsive"><table class="table table-hover table-sm align-middle"><thead><tr><th>Ítem</th><th>Código</th><th>Artículo / descripción</th><th>N.º parte</th><th>Almacén</th><th>Ubicación</th><th>U/M</th><th class="text-end">Stock</th><th class="text-end">Mínimo</th><th>Estado</th><th>Proveedor</th><th>Actualizado</th></tr></thead><tbody>@foreach (var item in Model) { <tr class="@(item.IsActive ? "" : "table-secondary")"><td>@item.ItemCode</td><td>@item.PartCode</td><td><div class="fw-semibold">@item.PartName</div><small class="text-muted">@item.Category · @item.ItemType</small></td><td>@item.ManufacturerPartNumber</td><td>@item.Site</td><td>@item.ShelfLocation</td><td>@item.UnitOfMeasure</td><td class="text-end">@item.QuantityOnHand</td><td class="text-end">@item.MinimumStock</td><td>@item.StockStatus</td><td>@item.Supplier</td><td>@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td></tr> } @if (!Model.Any()) { <tr><td colspan="12" class="text-center text-muted py-4">No hay artículos para los filtros seleccionados.</td></tr> }</tbody></table></div>
</div>
