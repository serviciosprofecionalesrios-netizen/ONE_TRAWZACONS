@model IEnumerable<ITServiceDeskApp.Models.InventoryMasterArticle>
@{ ViewData["Title"] = "Maestro de artículos"; var search = ViewBag.Search as string; var includeInactive = (bool?)ViewBag.IncludeInactive ?? false; }
<div class="container mt-4">
 <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="fw-bold mb-0">Maestro de artículos</h2><small class="text-muted">Catálogo base de inventario</small></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nuevo artículo</a></div>
 @if (TempData["InventoryMasterMessage"] is string message) { <div class="alert alert-success">@message</div> }
 <form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="search" value="@search" class="form-control" placeholder="Buscar por ID, ítem, descripción o almacén" /></div><div class="col-auto form-check mt-2"><input class="form-check-input" type="checkbox" name="includeInactive" value="true" checked="@includeInactive" id="inactive" /><label class="form-check-label" for="inactive">Incluir inactivos</label></div><div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div></form>
 <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>ID producto</th><th>Almacén</th><th>Ítem</th><th>N.º parte</th><th>Descripción</th><th>U/M</th><th>Estante</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr class="@(item.IsActive ? "" : "table-secondary")"><td>@item.ProductCode</td><td>@item.Warehouse</td><td>@item.Item</td><td>@item.PartNumber</td><td>@item.Description</td><td>@item.UnitOfMeasure</td><td>@item.Shelf @item.Position</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr> }</tbody></table></div>
</div>
