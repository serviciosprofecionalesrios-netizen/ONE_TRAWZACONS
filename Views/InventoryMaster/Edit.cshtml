@model ITServiceDeskApp.Models.InventoryMasterArticle
@{ ViewData["Title"] = "Editar artículo Maestro"; }
<div class="container mt-4"><div class="card shadow"><div class="card-header bg-dark text-white"><h4 class="mb-0">Editar artículo Maestro</h4></div><div class="card-body"><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><partial name="_Form" model="Model" /><div class="text-end mt-4"><a asp-action="Index" class="btn btn-secondary">Cancelar</a><button class="btn btn-primary" type="submit">Guardar cambios</button></div></form></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
