@model ITServiceDeskApp.ViewModels.SiteActivityViewModel
@using ITServiceDeskApp.ViewModels
@{var names=Model.Choices.ToDictionary(x=>x.Id,x=>x);}
<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card p-3 h-100"><span class="text-muted small">Usuarios conectados ahora</span><strong class="fs-3 text-success">@Model.Online</strong></div></div>
    <div class="col-md-3"><div class="card p-3 h-100"><span class="text-muted small">Usuarios con actividad registrada</span><strong class="fs-3">@Model.TrackedUsers</strong></div></div>
    <div class="col-md-3"><div class="card p-3 h-100"><span class="text-muted small">Tiempo activo acumulado · todos los usuarios</span><strong class="fs-4">@SiteActivityViewModel.Duration(Model.TotalActiveSeconds)</strong></div></div>
    <div class="col-md-3"><div class="card p-3 h-100"><span class="text-muted small">Eventos en el historial filtrado</span><strong class="fs-3">@Model.EventCount</strong></div></div>
</div>
<p class="small text-muted">Corte: @SiteActivityViewModel.Local(Model.GeneratedAtUtc) · Hora de Nicaragua (UTC−6). El tiempo por usuario corresponde al acumulado desde el inicio del seguimiento; las fechas filtran el historial de eventos.</p>
<div class="card mb-4"><div class="card-header fw-semibold">Presencia y última conexión</div><div class="table-responsive" style="max-height:580px;overflow:auto"><table class="table table-hover align-middle mb-0" style="min-width:1250px"><thead class="table-light" style="position:sticky;top:0;z-index:1"><tr><th>Usuario</th><th>Estado</th><th>Última conexión registrada</th><th>Última actividad</th><th>Última señal</th><th>Tiempo activo acumulado</th><th>Sesiones</th><th>Última página / acción</th></tr></thead><tbody>
@foreach(var row in Model.Users){<tr><td><strong>@row.Name</strong><div class="small text-muted">@row.Email</div></td><td><span class="badge @(row.Status=="En línea" ? "bg-success" : row.Status=="Ausente" ? "bg-warning text-dark" : "bg-secondary")">@row.Status</span></td><td class="text-nowrap">@SiteActivityViewModel.Local(row.LastLogin)</td><td class="text-nowrap">@SiteActivityViewModel.Local(row.LastActivity)</td><td class="text-nowrap">@SiteActivityViewModel.Local(row.LastSeen)</td><td class="text-nowrap">@SiteActivityViewModel.Duration(row.ActiveSeconds)</td><td>@row.Sessions</td><td>@row.Page</td></tr>}
@if(Model.Users.Count==0){<tr><td colspan="8" class="text-muted p-4">No hay usuarios para este filtro.</td></tr>}
</tbody></table></div><div class="card-footer d-flex flex-wrap justify-content-between gap-2"><span>@Model.UserPage.First–@Model.UserPage.Last de @Model.UserPage.Total usuarios</span><div class="d-flex gap-2">@if(Model.UserPage.Page>1){<a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-userId="@Model.UserId" asp-route-userPage="@(Model.UserPage.Page-1)" asp-route-eventPage="@Model.EventPage.Page">Anterior</a>}@if(Model.UserPage.Page<Model.UserPage.Pages){<a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-userId="@Model.UserId" asp-route-userPage="@(Model.UserPage.Page+1)" asp-route-eventPage="@Model.EventPage.Page">Siguiente</a>}</div></div></div>
<div class="card"><div class="card-header fw-semibold">Historial de páginas y acciones</div><p class="small text-muted px-3 pt-3 mb-0">Se registran pantallas, descargas, formularios enviados y conexiones. Un formulario enviado no implica que su operación haya sido aprobada. No se almacenan contraseñas, contenido de formularios ni pulsaciones de teclas.</p><div class="table-responsive" style="max-height:580px;overflow:auto"><table class="table table-hover align-middle mb-0" style="min-width:1000px"><thead class="table-light" style="position:sticky;top:0;z-index:1"><tr><th>Fecha y hora</th><th>Usuario</th><th>Tipo</th><th>Página / acción</th><th>Módulo</th><th>Respuesta HTTP</th></tr></thead><tbody>
@foreach(var item in Model.Events){<tr><td class="text-nowrap">@SiteActivityViewModel.Local(item.OccurredAtUtc)</td><td>@(names.TryGetValue(item.UserId,out var person) ? person.Name+" · "+person.Email : "Usuario #"+item.UserId)</td><td>@item.Kind</td><td>@item.Title<div class="small text-muted">@item.Action</div></td><td>@item.Controller</td><td>@item.ResponseStatus</td></tr>}
@if(Model.Events.Count==0){<tr><td colspan="6" class="text-muted p-4">No hay eventos registrados para estas fechas.</td></tr>}
</tbody></table></div><div class="card-footer d-flex flex-wrap justify-content-between gap-2"><span>@Model.EventPage.First–@Model.EventPage.Last de @Model.EventPage.Total eventos</span><div class="d-flex gap-2">@if(Model.EventPage.Page>1){<a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-userId="@Model.UserId" asp-route-userPage="@Model.UserPage.Page" asp-route-eventPage="@(Model.EventPage.Page-1)">Anterior</a>}@if(Model.EventPage.Page<Model.EventPage.Pages){<a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-userId="@Model.UserId" asp-route-userPage="@Model.UserPage.Page" asp-route-eventPage="@(Model.EventPage.Page+1)">Siguiente</a>}</div></div></div>
