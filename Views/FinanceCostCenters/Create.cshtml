@model ITServiceDeskApp.ViewModels.FinanceCostCenters.FinanceCostCenterEditViewModel
@using System.Linq
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nuevo #CC por Area";
    var areaOptions = ViewBag.AreaOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Nuevo Centro de Costo</h4>
                <small class="text-muted">Configura presupuesto, alertas y reglas de sobregiro por area.</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Area" class="form-label"></label>
                        <select asp-for="Area" class="form-select" asp-items="areaOptions">
                            <option value="">Seleccionar area</option>
                        </select>
                        <span asp-validation-for="Area" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CostCenterNumber" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="CostCenterNumber" class="form-control" placeholder="Ejemplo: CC-OP-001" />
                            <button type="button" id="btnGenerateNumber" class="btn btn-outline-primary">Generar</button>
                        </div>
                        <div class="form-text">Si lo dejas vacio, el sistema lo genera automaticamente.</div>
                        <span asp-validation-for="CostCenterNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CostCenterName" class="form-label"></label>
                        <input asp-for="CostCenterName" class="form-control" placeholder="Ejemplo: Compras operativas regionales" />
                        <span asp-validation-for="CostCenterName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MonthlyBudgetCordoba" class="form-label"></label>
                        <input asp-for="MonthlyBudgetCordoba" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="MonthlyBudgetCordoba" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AlertThresholdPercent" class="form-label"></label>
                        <input asp-for="AlertThresholdPercent" type="number" min="1" max="100" class="form-control" />
                        <span asp-validation-for="AlertThresholdPercent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="HardStopOnOverrun" class="form-check-input" />
                            <label asp-for="HardStopOnOverrun" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="RequireAuthorizationOnOverrun" class="form-check-input" />
                            <label asp-for="RequireAuthorizationOnOverrun" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Guardar #CC</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var areaInput = document.getElementById("Area");
            var numberInput = document.getElementById("CostCenterNumber");
            var generateButton = document.getElementById("btnGenerateNumber");

            if (!generateButton || !numberInput) {
                return;
            }

            generateButton.addEventListener("click", function () {
                var area = areaInput ? (areaInput.value || "").trim() : "";
                var url = '@Url.Action("GenerateNumber", "FinanceCostCenters")' + '?area=' + encodeURIComponent(area);

                fetch(url, { method: "GET" })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (data) {
                        if (!data || !data.number) return;
                        numberInput.value = data.number;
                    })
                    .catch(function () {
                        // Ignorado
                    });
            });
        });
    </script>
}
