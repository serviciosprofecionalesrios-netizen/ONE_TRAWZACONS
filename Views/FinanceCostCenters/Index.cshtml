@model ITServiceDeskApp.ViewModels.FinanceCostCenters.FinanceCostCenterIndexViewModel

@{
    ViewData["Title"] = "#CC por Area";
}

<div class="container-fluid mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1">#CC por Area</h2>
            <div class="text-muted">Control de presupuesto, alertas y sobregiros por centro de costo.</div>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo #CC
        </a>
    </div>

    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success">@msg</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Periodo</label>
                        <select name="periodPreset" id="periodPreset" class="form-select">
                            @if (Model.PeriodPreset == "month")
                            {
                                <option value="month" selected>Mes actual</option>
                            }
                            else
                            {
                                <option value="month">Mes actual</option>
                            }

                            @if (Model.PeriodPreset == "week")
                            {
                                <option value="week" selected>Ultimos 7 dias</option>
                            }
                            else
                            {
                                <option value="week">Ultimos 7 dias</option>
                            }

                            @if (Model.PeriodPreset == "fortnight")
                            {
                                <option value="fortnight" selected>Quincena actual</option>
                            }
                            else
                            {
                                <option value="fortnight">Quincena actual</option>
                            }

                            @if (Model.PeriodPreset == "custom")
                            {
                                <option value="custom" selected>Rango personalizado</option>
                            }
                            else
                            {
                                <option value="custom">Rango personalizado</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 js-custom-date">
                        <label class="form-label">Fecha inicio</label>
                        <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-md-2 js-custom-date">
                        <label class="form-label">Fecha fin</label>
                        <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Area</label>
                        <select name="area" class="form-select">
                            @foreach (var option in Model.AreaOptions)
                            {
                                if (string.Equals(option.Value, Model.SelectedArea, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@option.Value" selected>@option.Label</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">#CC</label>
                        <select name="costCenterNumber" class="form-select">
                            @foreach (var option in Model.CostCenterOptions)
                            {
                                if (string.Equals(option.Value, Model.SelectedCostCenterNumber, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@option.Value" selected>@option.Label</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel"></i> Aplicar filtros
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Presupuesto total</div>
                    <div class="fs-4 fw-bold">C$ @Model.TotalBudgetCordoba.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Ejecutado</div>
                    <div class="fs-4 fw-bold text-danger">C$ @Model.TotalSpentCordoba.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Disponible</div>
                    <div class="fs-4 fw-bold @(Model.TotalAvailableCordoba < 0 ? "text-danger" : "text-success")">C$ @Model.TotalAvailableCordoba.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Uso total</div>
                    <div class="fs-4 fw-bold">@Model.UsagePercent.ToString("0.##")%</div>
                    <div class="small text-muted">
                        Cerca de umbral: @Model.NearThresholdCount | Excedidos: @Model.OverBudgetCount
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Alertas</div>
        <div class="card-body">
            @foreach (var alert in Model.Alerts)
            {
                var tone = alert.Severity == "danger" ? "danger" : alert.Severity == "warning" ? "warning" : "success";
                <div class="alert alert-@tone py-2 mb-2">@alert.Message</div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-semibold">Centros de costo configurados</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Area</th>
                            <th>#CC</th>
                            <th>Nombre</th>
                            <th class="text-end">Presupuesto</th>
                            <th class="text-end">Ejecutado</th>
                            <th class="text-end">Disponible</th>
                            <th class="text-end">Uso %</th>
                            <th>Reglas</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">No hay centros de costo para los filtros seleccionados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Area</td>
                                <td><span class="badge text-bg-dark">@row.CostCenterNumber</span></td>
                                <td>@row.CostCenterName</td>
                                <td class="text-end">C$ @row.BudgetCordoba.ToString("N2")</td>
                                <td class="text-end">C$ @row.SpentCordoba.ToString("N2")</td>
                                <td class="text-end @(row.AvailableCordoba < 0 ? "text-danger fw-semibold" : "")">C$ @row.AvailableCordoba.ToString("N2")</td>
                                <td class="text-end">
                                    <span class="badge @(row.IsOverBudget ? "text-bg-danger" : row.IsNearThreshold ? "text-bg-warning" : "text-bg-success")">
                                        @row.UsagePercent.ToString("0.##")%
                                    </span>
                                </td>
                                <td class="small">
                                    Umbral: @row.AlertThresholdPercent%<br />
                                    Bloqueo: @(row.HardStopOnOverrun ? "Si" : "No")<br />
                                    Autorizar sobregiro: @(row.RequireAuthorizationOnOverrun ? "Si" : "No")
                                </td>
                                <td>
                                    <span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">@(row.IsActive ? "Activo" : "Inactivo")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                        <form asp-action="ToggleStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <button type="submit" class="btn btn-sm @(row.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(row.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var preset = document.getElementById("periodPreset");

            function refreshCustomDateVisibility() {
                var showCustom = preset && preset.value === "custom";
                document.querySelectorAll(".js-custom-date").forEach(function (el) {
                    el.style.display = showCustom ? "" : "none";
                });
            }

            if (preset) {
                preset.addEventListener("change", refreshCustomDateVisibility);
            }

            refreshCustomDateVisibility();
        });
    </script>
}
