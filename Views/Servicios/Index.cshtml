<style>
    :root {
        --ink: #0f172a;
        --muted: #475569;
        --panel: #f8fafc;
        --usr: #0f766e;
        --ops: #0ea5e9;
        --mnt: #b45309;
        --inv: #2563eb;
    }

    .portal-wrap {
        max-width: 1240px;
        margin: 1rem auto 1.4rem;
        display: grid;
        grid-template-columns: 270px 1fr;
        gap: 1rem;
    }

    .portal-aside {
        position: sticky;
        top: 1rem;
        align-self: start;
        background: linear-gradient(170deg, #ffffff 0%, #f5f9ff 68%, #eef5ff 100%);
        border: 1px solid #d2deeb;
        border-radius: 16px;
        padding: 1rem;
        box-shadow: 0 6px 14px rgba(30, 58, 138, 0.08);
    }

    .portal-aside h4 {
        font-weight: 800;
        margin-bottom: 0.75rem;
        color: var(--ink);
    }

    .portal-nav {
        display: grid;
        gap: 0.45rem;
    }

    .portal-nav a {
        text-decoration: none;
        color: #0b1220;
        font-weight: 700;
        background: #fff;
        border: 1px solid #d9e3ee;
        border-radius: 11px;
        padding: 0.56rem 0.72rem;
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .portal-nav a:hover {
        transform: translateX(3px);
        box-shadow: 0 8px 16px rgba(15, 23, 42, 0.12);
    }

    .portal-main {
        display: grid;
        gap: 0.9rem;
    }

    .portal-hero {
        background: linear-gradient(120deg, #0f172a 0%, #1e3a8a 55%, #0f766e 100%);
        color: #fff;
        border-radius: 18px;
        padding: 1.2rem 1.25rem;
        border: 1px solid rgba(147, 197, 253, 0.35);
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.24);
    }

    .portal-hero h2 {
        margin: 0;
        font-weight: 800;
        font-size: 1.65rem;
    }

    .portal-hero p {
        margin: 0.45rem 0 0;
        color: #e0f2fe;
        font-weight: 500;
    }

    .area-card {
        background: #fff;
        border: 1px solid #dce6f0;
        border-radius: 16px;
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .area-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.9rem 1rem;
        border-bottom: 1px solid #e6edf5;
        background: var(--panel);
    }

    .area-title {
        font-weight: 800;
        margin: 0;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.48rem;
    }

    .area-dot {
        width: 11px;
        height: 11px;
        border-radius: 999px;
        background: var(--dot);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--dot), transparent 74%);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
        padding: 0.85rem;
    }

    .service-item {
        border: 1px solid #dce7f2;
        border-radius: 13px;
        padding: 0.7rem;
        background: #fff;
        display: grid;
        gap: 0.34rem;
    }

    .service-item h6 {
        margin: 0;
        font-size: 0.96rem;
        font-weight: 800;
        color: #111827;
    }

    .service-item p {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
    }

    .service-link {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.85rem;
        padding: 0.34rem 0.55rem;
        border-radius: 9px;
        border: 1px solid #d0e0f0;
        background: #f8fafc;
        color: #0f172a;
    }

    .service-link:hover {
        background: #edf4fb;
    }

    .service-link--off {
        background: #f1f5f9;
        border-color: #e2e8f0;
        color: #6b7280;
        cursor: not-allowed;
    }

    @@media (max-width: 992px) {
        .portal-wrap {
            grid-template-columns: 1fr;
        }

        .portal-aside {
            position: static;
        }
    }

    @@media (max-width: 700px) {
        .services-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="portal-wrap">
    <aside class="portal-aside">
        <h4>Areas</h4>
        <div class="portal-nav">
            @foreach (var area in areas)
            {
                <a href="#@area.Id">@area.Nombre</a>
            }
        </div>
    </aside>

    <main class="portal-main">
        <section class="portal-hero">
            <h2>Portal de Servicios Empresariales</h2>
            <p>One page para toda la empresa con servicios por area y accesos rapidos a sus submenus de trabajo.</p>
        </section>

        @foreach (var area in areas)
        {
            <section id="@area.Id" class="area-card" style="--dot:@area.Color;">
                <div class="area-header">
                    <h5 class="area-title"><span class="area-dot"></span>@area.Nombre</h5>
                    <span class="badge text-bg-light">@area.Servicios.Length servicios</span>
                </div>

                <div class="services-grid">
                    @foreach (var servicio in area.Servicios)
                    {
                        <article class="service-item">
                            <h6>@servicio.Titulo</h6>
                            <p>@servicio.Descripcion</p>

                            @if (servicio.Activo)
                            {
                                <a class="service-link" href="@servicio.Url">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    Abrir submenu
                                </a>
                            }
                            else
                            {
                                <span class="service-link service-link--off">
                                    <i class="bi bi-hourglass-split"></i>
                                    Proximamente
                                </span>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </main>
</div>
