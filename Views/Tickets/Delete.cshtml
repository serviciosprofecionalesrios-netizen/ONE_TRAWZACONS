@model global::ITServiceDeskApp.Models.Ticket

@{
    ViewData["Title"] = "Eliminar";
    var returnDepartment = ViewBag.ReturnDepartment as string;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4>¿Eliminar Incidencia?</h4>
        </div>

        <div class="card-body">
            <p><strong>Ticket:</strong> @Model.TicketNumber</p>
            <p><strong>Usuario:</strong> @Model.RequestingUser</p>
            <p><strong>Técnico:</strong> @Model.AssignedTechnician</p>
            <p><strong>Estado:</strong> @Model.Status</p>
        </div>

        <div class="card-footer text-end">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="department" value="@returnDepartment" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" asp-route-department="@returnDepartment" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
