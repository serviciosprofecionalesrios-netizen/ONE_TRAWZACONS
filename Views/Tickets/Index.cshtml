            </form>

            @if (hasActiveFilters)
            {
                <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
                    <small class="text-muted">Filtros activos:</small>

                    @if (!string.IsNullOrWhiteSpace(Model.Search))
