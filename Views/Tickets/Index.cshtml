    @if (Model.IsMaintenanceView && maintenanceViewMode == "detail")
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0 fw-bold">Tabla Detalle de Ordenes de Mantenimiento</h6>
                <small class="text-muted">Mostrando hasta 300 ordenes del filtro actual.</small>
            </div>
            <div class="card-body p-0">
                @if (!maintenanceDetailRows.Any())
                {
                    <div class="p-4">
                        <div class="alert alert-info mb-0">No hay ordenes en el filtro actual.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 maintenance-detail-grid">
                            <thead class="table-light">
                                <tr>
                                    <th>Orden</th>
                                    <th>Creada</th>
                                    <th>Sitio</th>
                                    <th>Unidad / Equipo</th>
                                    <th>Tipo</th>
                                    <th>Falla</th>
                                    <th>Etapa</th>
                                    <th>Tecnico</th>
                                    <th>Estado</th>
                                    <th>SLA</th>
                                    <th class="text-end">Costo C$</th>
                                    <th class="text-end">Costo $</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in maintenanceDetailRows)
                                {
                                    var slaClass = row.RemainingHoursToSla < 0
                                        ? "bg-danger"
                                        : row.RemainingHoursToSla <= 4
                                            ? "bg-warning text-dark"
                                            : "bg-success";
                                    var statusClass = StatusClass(row.Status);
                                    var localCreated = row.CreatedDateUtc.ToLocalTime();
                                    var localSla = row.SlaDeadlineUtc.ToLocalTime();
                                    <tr>
                                        <td class="fw-semibold">@row.TicketNumber</td>
                                        <td>
                                            <div class="date-main">@localCreated.ToString("yyyy-MM-dd")</div>
                                            <div class="date-sub">@localCreated.ToString("HH:mm")</div>
                                        </td>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@row.Site</span></td>
                                        <td>@row.UnitCode</td>
                                        <td>@row.IncidentType</td>
                                        <td>@row.FailureCategory</td>
                                        <td>@row.MaintenanceStage</td>
                                        <td>@row.AssignedTechnician</td>
                                        <td>
                                            <span class="badge @statusClass">@StatusLabel(row.Status)</span>
                                            @if (row.RequiresCostApproval && !row.CostApproved)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Costo pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @slaClass">@FormatDurationHours(row.RemainingHoursToSla)</span>
                                            <div class="small text-muted mt-1">@localSla.ToString("yyyy-MM-dd HH:mm")</div>
                                        </td>
                                        <td class="text-end fw-semibold">C$ @row.TotalCostCordoba.ToString("N2")</td>
                                        <td class="text-end">$ @row.TotalCostUsd.ToString("N2")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-action="Details"
                                                   asp-route-id="@row.TicketId"
                                                   asp-route-department="@Model.Department"
                                                   class="btn btn-sm btn-outline-info">Ver</a>
                                                @if (canEditTicket)
                                                {
                                                    <a asp-action="Edit"
                                                       asp-route-id="@row.TicketId"
                                                       asp-route-department="@Model.Department"
                                                       class="btn btn-sm btn-outline-primary">Editar</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.IsMaintenanceView && maintenanceViewMode == "board")
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0 fw-bold">Pizarra Operativa (estilo aeropuerto)</h6>
                <small class="text-muted">Actualiza automaticamente cada 60 segundos.</small>
            </div>
            <div class="card-body p-0">
                @if (!maintenanceBoardRows.Any())
                {
                    <div class="p-4">
                        <div class="alert alert-info mb-0">No hay ordenes activas para mostrar en la pizarra.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0 airport-board-grid">
                            <thead class="table-dark">
                                <tr>
                                    <th>Semaforo</th>
                                    <th>Tecnico</th>
                                    <th>Orden</th>
                                    <th>Equipo</th>
                                    <th>Sitio</th>
                                    <th>Tipo</th>
                                    <th>Etapa actual</th>
                                    <th>Desde</th>
                                    <th>Transcurrido</th>
                                    <th>Tiempo restante</th>
                                    <th>SLA limite</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in maintenanceBoardRows)
                                {
                                    var startedLocal = row.StartedAtUtc.ToLocalTime();
                                    var slaLocal = row.SlaDeadlineUtc.ToLocalTime();
                                    var toneClass = row.SemaphoreTone switch
                                    {
                                        "danger" => "bg-danger",
                                        "warning" => "bg-warning text-dark",
                                        "info" => "bg-info text-dark",
                                        "secondary" => "bg-secondary",
                                        _ => "bg-success"
                                    };
                                    <tr>
                                        <td><span class="badge @toneClass">@row.SemaphoreLabel</span></td>
                                        <td class="fw-semibold">@row.Technician</td>
                                        <td>
                                            <div class="airport-ticket">@row.TicketNumber</div>
                                            <div class="small text-muted">@StatusLabel(row.Status)</div>
                                        </td>
                                        <td>@row.UnitCode</td>
                                        <td>@row.Site</td>
                                        <td>@row.IncidentType</td>
                                        <td>@row.MaintenanceStage</td>
                                        <td>@startedLocal.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="airport-timer">@FormatDurationHours(row.ElapsedHours)</td>
                                        <td class="airport-timer">@FormatDurationHours(row.RemainingHoursToSla)</td>
                                        <td>@slaLocal.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (!(Model.IsMaintenanceView && (maintenanceViewMode == "detail" || maintenanceViewMode == "board")))
    {
    <div class="card shadow">
        <div class="card-body p-0">
            @if (!tickets.Any())
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No hay incidencias registradas para este filtro.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 tickets-grid">
                        <thead class="table-light">
                            <tr>
                                <th class="col-ticket">Ticket</th>
                                <th class="col-date">Fecha</th>
                                <th class="col-user">Usuario</th>
                                <th class="col-priority">Prioridad</th>
                                <th class="col-status">Estado</th>
                                @if (Model.IsMaintenanceView)
                                {
                                    <th class="col-stage">Etapa</th>
                                }
                                <th class="col-sla">SLA</th>
                                <th class="col-age">Edad</th>
                                <th class="col-tech">Técnico</th>
                                <th class="col-observations">Observaciones</th>
                                <th class="col-audit">Auditoría</th>
                                <th class="text-center col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in tickets)
                            {
                                var isOverdue = item.Status != TicketStatus.Closed && item.SLADeadline < nowUtc;
                                var isNear = item.Status != TicketStatus.Closed && !isOverdue && item.SLADeadline < nowUtc.AddHours(4);
                                var hoursToSla = (item.SLADeadline - nowUtc).TotalHours;
                                var ageDays = (nowUtc - item.CreatedDate).TotalDays;
                                var obsText = string.IsNullOrWhiteSpace(item.Observations)
                                    ? "Sin observaciones"
                                    : item.Observations!;
                                var obsPreview = obsText.Length > 95 ? obsText.Substring(0, 95) + "..." : obsText;
                                var obsModalId = $"obsModal_{item.Id}";

                                var ageClass = ageDays switch
                                {
                                    <= 2 => "bg-success-subtle text-success-emphasis",
                                    <= 7 => "bg-warning-subtle text-warning-emphasis",
                                    _ => "bg-danger-subtle text-danger-emphasis"
                                };

                                var ageLabel = ageDays switch
                                {
                                    <= 2 => "0-2 días",
                                    <= 7 => "3-7 días",
                                    _ => "8+ días"
                                };

                                Model.LatestAuditByTicket.TryGetValue(item.Id, out var latestAudit);

                                <tr class="@(isOverdue ? "table-danger" : "")">
                                    <td class="ticket-number-cell">@item.TicketNumber</td>
                                    <td>
                                        <span class="date-main">@item.CreatedDate.ToString("yyyy-MM-dd")</span>
                                        <span class="date-sub">@item.CreatedDate.ToString("HH:mm")</span>
                                    </td>
                                    <td>@item.RequestingUser</td>

                                    <td>
                                        <span class="badge @PriorityClass(item.Priority)">@PriorityLabel(item.Priority)</span>
                                    </td>

                                    <td>
                                        <span class="badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span>
                                        @if (isFinanceView && item.FinanceReturnedForCorrection && item.Status != TicketStatus.Closed)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Devuelta</span>
                                        }
                                        @if (isFinanceView && item.FinanceEscalatedAtUtc.HasValue && item.Status != TicketStatus.Closed)
                                        {
                                            <span class="badge bg-danger ms-1">Escalada</span>
                                        }
                                    </td>

                                    @if (Model.IsMaintenanceView)
                                    {
                                        <td>
                                            @{
                                                var stageValue = string.IsNullOrWhiteSpace(item.MaintenanceStage) ? "Sin etapa" : item.MaintenanceStage;
                                                var stageBadgeClass = stageValue switch
                                                {
                                                    "Recibida" => "bg-secondary",
                                                    "Diagnostico" => "bg-info text-dark",
                                                    "En reparacion" => "bg-primary",
                                                    "Prueba tecnica" => "bg-warning text-dark",
                                                    "Lista para entrega" => "bg-success",
                                                    "Cerrada" => "bg-dark",
                                                    _ => "bg-light text-dark"
                                                };
                                            }
                                            <span class="badge @stageBadgeClass">@stageValue</span>
                                        </td>
                                    }

                                    <td>
                                        @if (item.Status == TicketStatus.Closed)
                                        {
                                            <span class="badge bg-secondary">Cerrado</span>
                                            <span class="sla-detail">@item.SLADeadline.ToString("yyyy-MM-dd HH:mm")</span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="sla-state"><span class="badge bg-danger">Vencido</span></span>
                                            <span class="sla-detail">Hace @Math.Abs(hoursToSla).ToString("0.0") h</span>
                                        }
                                        else if (isNear)
                                        {
                                            <span class="sla-state"><span class="badge bg-warning text-dark">Por vencer</span></span>
                                            <span class="sla-detail">En @hoursToSla.ToString("0.0") h</span>
                                        }
                                        else
                                        {
                                            <span class="sla-state"><span class="badge bg-success">En tiempo</span></span>
                                            <span class="sla-detail">@item.SLADeadline.ToString("yyyy-MM-dd HH:mm")</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="age-badge @ageClass">@ageLabel</span>
                                        <div class="small text-muted mt-1">@ageDays.ToString("0.0") días</div>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.AssignedTechnician)
                                            ? "Sin asignar"
                                            : item.AssignedTechnician)
                                    </td>

                                    <td class="obs-cell">
                                        <span class="obs-preview">@obsPreview</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Observations) && item.Observations.Length > 95)
                                        {
                                            <button type="button"
                                                    class="btn btn-link btn-sm p-0 mt-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#@obsModalId">
                                                Ver más
                                            </button>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.Observations))
                                        {
                                            <div class="modal fade" id="@obsModalId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-scrollable">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Observaciones - @item.TicketNumber</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                        </div>
                                                        <div class="modal-body">@item.Observations</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>

                                    <td class="audit-cell col-audit">
                                        @if (latestAudit != null)
                                        {
                                            <div class="fw-semibold">@latestAudit.FieldLabel: @(string.IsNullOrWhiteSpace(latestAudit.NewValue) ? "Sin valor" : latestAudit.NewValue)</div>
                                            <div class="small text-muted">@latestAudit.ChangedBy</div>
                                            <div class="small text-muted">@latestAudit.ChangeDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin cambios recientes</span>
                                        }

                                        @if (canEditTicket && item.Status != TicketStatus.Closed && !isFinanceView)
                                        {
                                            <div class="quick-actions d-flex flex-column gap-1">
                                                <form method="post" asp-action="QuickTake" class="d-grid">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="search" value="@Model.Search" />
                                                    <input type="hidden" name="status" value="@Model.Status" />
                                                    <input type="hidden" name="priority" value="@Model.Priority" />
                                                    <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                    <input type="hidden" name="department" value="@Model.Department" />
                                                    <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                    <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                    <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                    <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                    <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                    <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Tomar ticket</button>
                                                </form>

                                                <form method="post" asp-action="QuickAssign" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="search" value="@Model.Search" />
                                                    <input type="hidden" name="status" value="@Model.Status" />
                                                    <input type="hidden" name="priority" value="@Model.Priority" />
                                                    <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                    <input type="hidden" name="department" value="@Model.Department" />
                                                    <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                    <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                    <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                    <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                    <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                    <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                                    <select name="assignedTechnician" class="form-select form-select-sm">
                                                        <option value="">Sin asignar</option>
                                                        @foreach (var tech in (Model.TechnicianOptions ?? Array.Empty<string>()))
                                                        {
                                                            if (string.Equals(item.AssignedTechnician, tech, StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <option value="@tech" selected>@tech</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@tech">@tech</option>
                                                            }
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Asignar</button>
                                                </form>

                                                <form method="post" asp-action="QuickStatus" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="search" value="@Model.Search" />
                                                    <input type="hidden" name="status" value="@Model.Status" />
                                                    <input type="hidden" name="priority" value="@Model.Priority" />
                                                    <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                    <input type="hidden" name="department" value="@Model.Department" />
                                                    <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                    <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                    <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                    <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                    <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                    <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                                    <select name="newStatus" class="form-select form-select-sm">
                                                        @foreach (TicketStatus s in Enum.GetValues(typeof(TicketStatus)))
                                                        {
                                                            if (item.Status == s)
                                                            {
                                                                <option value="@s" selected>@StatusLabel(s)</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@s">@StatusLabel(s)</option>
                                                            }
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-dark">Estado</button>
                                                </form>
                                            </div>
                                        }
                                    </td>

                                    <td class="text-center col-actions">
                                        <div class="ticket-actions">
                                            @if (canEditTicket)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   asp-route-department="@Model.Department"
                                                   class="btn btn-sm btn-outline-primary btn-icon"
                                                   title="Editar"
                                                   aria-label="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="btn btn-sm btn-outline-primary btn-icon disabled-placeholder"
                                                      title="Editar (sin permiso)"
                                                      aria-label="Editar (sin permiso)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </span>
                                            }

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               asp-route-department="@Model.Department"
                                               class="btn btn-sm btn-outline-info btn-icon"
                                               title="Detalles"
                                               aria-label="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="DownloadPdf"
                                               asp-route-id="@item.Id"
                                               asp-route-department="@Model.Department"
                                               class="btn btn-sm btn-outline-danger btn-icon"
                                               title="Descargar PDF"
                                               aria-label="Descargar PDF">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>

                                            @if (Model.IsMaintenanceView &&
                                                 item.RequiresCostApproval &&
                                                 !item.CostApproved &&
                                                 (User.IsInRole(nameof(UserRole.Administrator)) ||
                                                  User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
                                                  User.IsInRole(nameof(UserRole.GerenciaGeneral))))
                                            {
                                                <form method="post" asp-action="ApproveMaintenanceCost" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="search" value="@Model.Search" />
                                                    <input type="hidden" name="status" value="@Model.Status" />
                                                    <input type="hidden" name="priority" value="@Model.Priority" />
                                                    <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                    <input type="hidden" name="department" value="@Model.Department" />
                                                    <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                    <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                    <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                    <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                    <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                    <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                    <input type="hidden" name="approvalNotes" value="Aprobado desde dashboard de mantenimiento" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success btn-icon"
                                                            title="Aprobar costos"
                                                            aria-label="Aprobar costos">
                                                        <i class="bi bi-check2-circle"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (isFinanceView && canFinanceWorkflow)
                                            {
                                                var canApproveOrReject = (item.Status == TicketStatus.Open || item.Status == TicketStatus.InProgress) && !item.CostApproved;
                                                var canCloseFinance = item.Status == TicketStatus.Resolved && item.CostApproved;
                                                var canReturnFinance = item.Status != TicketStatus.Closed &&
                                                                       (item.Status == TicketStatus.Open ||
                                                                        item.Status == TicketStatus.InProgress ||
                                                                        item.Status == TicketStatus.Resolved);

                                                if (item.Status != TicketStatus.Closed)
                                                {
                                                    <a asp-action="FinanceAccounting"
                                                       asp-route-id="@item.Id"
                                                       asp-route-mine="@(Model.IsMineFinanceView ? "true" : "false")"
                                                       asp-route-search="@Model.Search"
                                                       asp-route-status="@Model.Status"
                                                       asp-route-priority="@Model.Priority"
                                                       asp-route-quick="@Model.QuickFilter"
                                                       asp-route-department="@Model.Department"
                                                       asp-route-site="@Model.SelectedSite"
                                                       asp-route-tenencia="@Model.SelectedTenencia"
                                                       asp-route-technician="@Model.SelectedAssignedTechnician"
                                                       asp-route-incidentType="@Model.SelectedIncidentType"
                                                       asp-route-maintenanceStage="@Model.SelectedMaintenanceStage"
                                                       asp-route-overdueBand="@Model.SelectedOverdueBand"
                                                       asp-route-page="@Model.Page"
                                                       asp-route-pageSize="@Model.PageSize"
                                                       class="btn btn-sm btn-outline-secondary btn-icon"
                                                       title="Trazabilidad contable"
                                                       aria-label="Trazabilidad contable">
                                                        <i class="bi bi-journal-check"></i>
                                                    </a>
                                                }

                                                if (canApproveOrReject)
                                                {
                                                    <form method="post" asp-action="ApproveFinanceRequest" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="mine" value="@(Model.IsMineFinanceView ? "true" : "false")" />
                                                        <input type="hidden" name="search" value="@Model.Search" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="priority" value="@Model.Priority" />
                                                        <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                        <input type="hidden" name="department" value="@Model.Department" />
                                                        <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                        <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                        <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                        <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                        <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                        <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                        <input type="hidden" name="page" value="@Model.Page" />
                                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                        <input type="hidden" name="approvalNotes" value="Aprobacion registrada desde dashboard de finanzas." />
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success btn-icon"
                                                                title="Aprobar solicitud"
                                                                aria-label="Aprobar solicitud">
                                                            <i class="bi bi-check2-circle"></i>
                                                        </button>
                                                    </form>

                                                    <form method="post" asp-action="RejectFinanceRequest" class="d-inline js-finance-note-form" data-note-message="Motivo de rechazo" data-note-field="rejectionReason">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="mine" value="@(Model.IsMineFinanceView ? "true" : "false")" />
                                                        <input type="hidden" name="search" value="@Model.Search" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="priority" value="@Model.Priority" />
                                                        <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                        <input type="hidden" name="department" value="@Model.Department" />
                                                        <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                        <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                        <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                        <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                        <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                        <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                        <input type="hidden" name="page" value="@Model.Page" />
                                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                        <input type="hidden" name="rejectionReason" value="" />
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-warning btn-icon"
                                                                title="Rechazar solicitud"
                                                                aria-label="Rechazar solicitud">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </form>
                                                }

                                                if (canReturnFinance)
                                                {
                                                    <form method="post" asp-action="ReturnFinanceRequest" class="d-inline js-finance-note-form" data-note-message="Motivo de devolución" data-note-field="returnReason">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="mine" value="@(Model.IsMineFinanceView ? "true" : "false")" />
                                                        <input type="hidden" name="search" value="@Model.Search" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="priority" value="@Model.Priority" />
                                                        <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                        <input type="hidden" name="department" value="@Model.Department" />
                                                        <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                        <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                        <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                        <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                        <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                        <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                        <input type="hidden" name="page" value="@Model.Page" />
                                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                        <input type="hidden" name="returnReason" value="" />
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-warning btn-icon"
                                                                title="Devolver para corrección"
                                                                aria-label="Devolver para corrección">
                                                            <i class="bi bi-arrow-return-left"></i>
                                                        </button>
                                                    </form>
                                                }

                                                if (canCloseFinance)
                                                {
                                                    <form method="post" asp-action="CloseFinanceRequest" class="d-inline js-finance-note-form" data-note-message="Notas de cierre" data-note-field="closureNotes">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="mine" value="@(Model.IsMineFinanceView ? "true" : "false")" />
                                                        <input type="hidden" name="search" value="@Model.Search" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="priority" value="@Model.Priority" />
                                                        <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                        <input type="hidden" name="department" value="@Model.Department" />
                                                        <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                        <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                        <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                        <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                        <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                        <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                        <input type="hidden" name="page" value="@Model.Page" />
                                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                        <input type="hidden" name="closureNotes" value="" />
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-dark btn-icon"
                                                                title="Cerrar solicitud"
                                                                aria-label="Cerrar solicitud">
                                                            <i class="bi bi-lock"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }

                                            @if (isFinanceView &&
                                                 item.FinanceReturnedForCorrection &&
                                                 item.Status != TicketStatus.Closed &&
                                                 (isMineFinanceView || canFinanceWorkflow))
                                            {
                                                <form method="post" asp-action="SubmitFinanceCorrection" class="d-inline js-finance-note-form" data-note-message="Notas de corrección" data-note-field="correctionNotes">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="mine" value="@(Model.IsMineFinanceView ? "true" : "false")" />
                                                    <input type="hidden" name="search" value="@Model.Search" />
                                                    <input type="hidden" name="status" value="@Model.Status" />
                                                    <input type="hidden" name="priority" value="@Model.Priority" />
                                                    <input type="hidden" name="quick" value="@Model.QuickFilter" />
                                                    <input type="hidden" name="department" value="@Model.Department" />
                                                    <input type="hidden" name="site" value="@Model.SelectedSite" />
                                                    <input type="hidden" name="tenencia" value="@Model.SelectedTenencia" />
                                                    <input type="hidden" name="technician" value="@Model.SelectedAssignedTechnician" />
                                                    <input type="hidden" name="incidentType" value="@Model.SelectedIncidentType" />
                                                    <input type="hidden" name="maintenanceStage" value="@Model.SelectedMaintenanceStage" />
                                                    <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                    <input type="hidden" name="correctionNotes" value="" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-primary btn-icon"
                                                            title="Enviar corrección"
                                                            aria-label="Enviar corrección">
                                                        <i class="bi bi-send-check"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (canDeleteTicket)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   asp-route-department="@Model.Department"
                                                   class="btn btn-sm btn-outline-danger btn-icon"
                                                   title="Eliminar"
                                                   aria-label="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="btn btn-sm btn-outline-danger btn-icon disabled-placeholder"
                                                      title="Eliminar (sin permiso)"
                                                      aria-label="Eliminar (sin permiso)">
                                                    <i class="bi bi-trash"></i>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 border-top flex-wrap gap-2">
                        <small class="text-muted">
                            Mostrando página @Model.Page de @Model.TotalPages - @Model.TotalItems registro(s)
                        </small>

                        <nav aria-label="Paginación de tickets">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link"
                                       href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, Math.Max(1, Model.Page - 1), Model.PageSize)">Anterior</a>
                                </li>

                                @{
                                    var startPage = Math.Max(1, Model.Page - 2);
                                    var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                                }

                                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                                        <a class="page-link"
                                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, pageNumber, Model.PageSize)">@pageNumber</a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link"
                                       href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, Math.Min(Model.TotalPages, Model.Page + 1), Model.PageSize)">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
    }
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("ticketFiltersForm");
    const searchBox = document.getElementById("searchBox");
    const statusFilter = document.getElementById("statusFilter");
    const priorityFilter = document.getElementById("priorityFilter");
    const pageSizeFilter = document.getElementById("pageSizeFilter");
    const siteFilter = document.getElementById("siteFilter");
    const tenenciaFilter = document.getElementById("tenenciaFilter");
    const technicianFilter = document.getElementById("technicianFilter");
    const incidentTypeFilter = document.getElementById("incidentTypeFilter");
    const maintenanceStageFilter = document.getElementById("maintenanceStageFilter");

    if (form && searchBox && statusFilter && priorityFilter && pageSizeFilter) {
        let typingTimer;

        searchBox.addEventListener("keyup", function () {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(function () {
                form.submit();
            }, 450);
        });

        statusFilter.addEventListener("change", function () { form.submit(); });
        priorityFilter.addEventListener("change", function () { form.submit(); });
        pageSizeFilter.addEventListener("change", function () { form.submit(); });
        if (siteFilter) siteFilter.addEventListener("change", function () { form.submit(); });
        if (tenenciaFilter) tenenciaFilter.addEventListener("change", function () { form.submit(); });
        if (technicianFilter) technicianFilter.addEventListener("change", function () { form.submit(); });
        if (incidentTypeFilter) incidentTypeFilter.addEventListener("change", function () { form.submit(); });
        if (maintenanceStageFilter) maintenanceStageFilter.addEventListener("change", function () { form.submit(); });
    }

    const maintenanceMode = "@maintenanceViewMode";
    const isMaintenanceView = @Model.IsMaintenanceView.ToString().ToLowerInvariant();
    if (isMaintenanceView && maintenanceMode === "board") {
        window.setTimeout(function () {
            window.location.reload();
        }, 60000);
    }

    document.querySelectorAll(".js-finance-note-form").forEach(function (formEl) {
        formEl.addEventListener("submit", function (evt) {
            var fieldName = formEl.getAttribute("data-note-field");
            if (!fieldName) return;

            var input = formEl.querySelector('input[name="' + fieldName + '"]');
            if (!input) return;

            var message = formEl.getAttribute("data-note-message") || "Ingrese una nota";
            var value = window.prompt(message, (input.value || "").trim());
            if (value === null) {
                evt.preventDefault();
                return;
            }

            var normalized = value.trim();
            if (!normalized) {
                evt.preventDefault();
                window.alert("Este campo es obligatorio.");
                return;
            }

            input.value = normalized;
        });
    });

    const trendCanvas = document.getElementById("ticketsTrendChart");
    if (trendCanvas) {
        const labels = @Html.Raw(trendLabelsJson);
        const created = @Html.Raw(trendCreatedJson);
        const closed = @Html.Raw(trendClosedJson);

        new Chart(trendCanvas, {
            type: "line",
            data: {
                labels: labels,
                datasets: [
                    {
                        label: "Creados",
                        data: created,
                        borderColor: "#2563eb",
                        backgroundColor: "rgba(37, 99, 235, 0.12)",
                        fill: true,
                        tension: 0.25
                    },
                    {
                        label: "Cerrados",
                        data: closed,
                        borderColor: "#16a34a",
                        backgroundColor: "rgba(22, 163, 74, 0.1)",
                        fill: true,
                        tension: 0.25
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                resizeDelay: 120,
                plugins: {
                    legend: { position: "bottom" }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    }
});
</script>
}
