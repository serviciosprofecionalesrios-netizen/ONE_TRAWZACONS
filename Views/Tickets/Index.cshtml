<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">@pageTitle</h2>
            <small class="text-muted">@pageSubtitle</small>
        </div>

        @if (canCreateTicket)
        {
            if (Model.IsMaintenanceView)
            {
                <a asp-action="CreateMaintenance" class="btn btn-success shadow-sm">
                    <i class="bi bi-plus-lg"></i> Nueva Orden de Mantenimiento
                </a>
            }
            else
            {
                if (isFinanceView)
                {
                    <a asp-action="CreateFinance" class="btn btn-success shadow-sm">
                        <i class="bi bi-plus-lg"></i> Nueva Solicitud Financiera
                    </a>
                }
                else
                {
                    <a asp-action="Create" class="btn btn-success shadow-sm">
                        <i class="bi bi-plus-lg"></i> Nueva Incidencia
                    </a>
                }
            }
        }
    </div>

    @if (Model.IsMaintenanceView)
    {
        <div class="alert alert-info shadow-sm">
            Vista dedicada a <strong>Mantenimiento</strong>. Los filtros y acciones aplican solo a ese departamento.
            <a class="ms-2 fw-semibold" href="@BuildUrl(null, null, null, null, 1, Model.PageSize, Model.Department, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, maintenanceStage: string.Empty)">Ver todo</a>
        </div>
    }
    else if (isFinanceView)
    {
        <div class="alert alert-info shadow-sm">
            Dashboard dedicado a <strong>Finanzas</strong>.
            @if (isMineFinanceView)
            {
                <span> Aquí solo ves solicitudes registradas por tu usuario.</span>
            }
            else
            {
                <span> Aquí ves la operación completa del departamento.</span>
            }
            <a class="ms-2 fw-semibold" href="@BuildUrl(null, null, null, null, 1, Model.PageSize, Model.Department, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, mine: isMineFinanceView)">Ver todo</a>
        </div>
    }

    @if (Model.IsMaintenanceView)
    {
        <div class="card shadow-sm mb-3 border-0">
            <div class="card-body py-2">
                <div class="d-flex flex-wrap gap-2 maintenance-workspace-tabs">
                    <a class="quick-tab @(maintenanceViewMode == "overview" ? "active" : "")"
                       href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: Model.SelectedOverdueBand, maintenanceStage: Model.SelectedMaintenanceStage, maintenanceView: "overview")">
                        Resumen
                    </a>
                    <a class="quick-tab @(maintenanceViewMode == "detail" ? "active" : "")"
                       href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: Model.SelectedOverdueBand, maintenanceStage: Model.SelectedMaintenanceStage, maintenanceView: "detail")">
                        Tabla Detalle
                    </a>
                    <a class="quick-tab @(maintenanceViewMode == "board" ? "active" : "")"
                       href="@Url.Action("MaintenanceBoard", "Tickets", new { site = Model.SelectedSite, technician = Model.SelectedAssignedTechnician, stage = Model.SelectedMaintenanceStage })">
                        Pizarra Operativa
                    </a>
                </div>
                <small class="text-muted d-block mt-2">
                    Vistas de trabajo para Mantenimiento. Ultima actualizacion: @Model.DashboardGeneratedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </small>
            </div>
        </div>
    }

    @if (TempData["TicketsMessage"] is string successMessage)
    {
        <div class="alert alert-success shadow-sm">@successMessage</div>
    }

    @if (TempData["TicketsError"] is string errorMessage)
    {
        <div class="alert alert-danger shadow-sm">@errorMessage</div>
    }

    @if (isFinanceView)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="quick-tab @(!Model.Status.HasValue && string.IsNullOrWhiteSpace(Model.QuickFilter) ? "active" : "")"
               href="@BuildUrl(Model.Search, null, Model.Priority, null, 1, Model.PageSize, mine: isMineFinanceView)">Todas</a>
            <a class="quick-tab @(Model.Status == TicketStatus.Open ? "active" : "")"
               href="@BuildUrl(Model.Search, TicketStatus.Open, Model.Priority, null, 1, Model.PageSize, mine: isMineFinanceView)">Pendientes</a>
            <a class="quick-tab @(Model.Status == TicketStatus.InProgress ? "active" : "")"
               href="@BuildUrl(Model.Search, TicketStatus.InProgress, Model.Priority, null, 1, Model.PageSize, mine: isMineFinanceView)">En evaluación</a>
            <a class="quick-tab @(Model.Status == TicketStatus.Resolved ? "active" : "")"
               href="@BuildUrl(Model.Search, TicketStatus.Resolved, Model.Priority, null, 1, Model.PageSize, mine: isMineFinanceView)">Listas para cierre</a>
            <a class="quick-tab @(Model.Status == TicketStatus.Closed ? "active" : "")"
               href="@BuildUrl(Model.Search, TicketStatus.Closed, Model.Priority, null, 1, Model.PageSize, mine: isMineFinanceView)">Cerradas</a>
            <a class="quick-tab @(Model.QuickFilter == "finance_returned" ? "active" : "")"
               href="@BuildUrl(Model.Search, null, Model.Priority, "finance_returned", 1, Model.PageSize, mine: isMineFinanceView)">Devueltas</a>
            <a class="quick-tab @(Model.QuickFilter == "finance_escalated" ? "active" : "")"
               href="@BuildUrl(Model.Search, null, Model.Priority, "finance_escalated", 1, Model.PageSize, mine: isMineFinanceView)">Escaladas</a>
            <a class="quick-tab @(Model.QuickFilter == "overdue" ? "active" : "")"
               href="@BuildUrl(Model.Search, null, Model.Priority, "overdue", 1, Model.PageSize, mine: isMineFinanceView)">Vencidas</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="quick-tab @(string.IsNullOrWhiteSpace(Model.QuickFilter) ? "active" : "")"
               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, null, 1, Model.PageSize)">Todos</a>
            <a class="quick-tab @(Model.QuickFilter == "today" ? "active" : "")"
               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "today", 1, Model.PageSize)">Hoy</a>
            <a class="quick-tab @(Model.QuickFilter == "overdue" ? "active" : "")"
               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "overdue", 1, Model.PageSize)">Vencidos</a>
            @if (Model.IsMaintenanceView)
            {
                <a class="quick-tab @(Model.QuickFilter == "overdue_unassigned" ? "active" : "")"
                   href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "overdue_unassigned", 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: Model.SelectedOverdueBand)">
                    Vencidos sin técnico
                </a>
            }
            <a class="quick-tab @(Model.QuickFilter == "unassigned" ? "active" : "")"
               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "unassigned", 1, Model.PageSize)">Sin asignar</a>
            <a class="quick-tab @(Model.QuickFilter == "critical" ? "active" : "")"
               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "critical", 1, Model.PageSize)">Críticos</a>
            <a class="quick-tab @(Model.QuickFilter == "myload" ? "active" : "")"
               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "myload", 1, Model.PageSize)">Mi carga</a>
        </div>
    }

    @if (Model.OverdueTickets > 0)
    {
        <div class="alert alert-danger shadow-sm">
            <strong>@Model.OverdueTickets</strong> ticket(s) vencido(s) requieren atención inmediata.
        </div>
    }

    @if (Model.IsMaintenanceView && maintenanceViewMode == "overview")
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h6 class="fw-bold mb-0">Órdenes vencidas por tramo</h6>
                    <a class="btn btn-sm btn-outline-primary"
                       href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "overdue_unassigned", 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: string.Empty)">
                        Asignar técnico rápido
                    </a>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <div class="overdue-band-card @(Model.SelectedOverdueBand == "0_24" ? "active" : string.Empty)">
                            <div class="small text-muted">Atraso 0-24h</div>
                            <div class="overdue-band-badge text-warning">@Model.OverdueBand0To24Count</div>
                            <a class="small fw-semibold"
                               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "overdue", 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: "0_24")">
                                Ver órdenes
                            </a>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="overdue-band-card @(Model.SelectedOverdueBand == "24_72" ? "active" : string.Empty)">
                            <div class="small text-muted">Atraso 24-72h</div>
                            <div class="overdue-band-badge text-danger">@Model.OverdueBand24To72Count</div>
                            <a class="small fw-semibold"
                               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "overdue", 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: "24_72")">
                                Ver órdenes
                            </a>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="overdue-band-card @(Model.SelectedOverdueBand == "72_plus" ? "active" : string.Empty)">
                            <div class="small text-muted">Atraso &gt; 72h</div>
                            <div class="overdue-band-badge text-danger-emphasis">@Model.OverdueBandOver72Count</div>
                            <a class="small fw-semibold"
                               href="@BuildUrl(Model.Search, Model.Status, Model.Priority, "overdue", 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: "72_plus")">
                                Ver órdenes
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.IsMaintenanceView && maintenanceViewMode == "overview")
    {
        var inventoryAlertClass = Model.InventoryHealthTone switch
        {
            "danger" => "alert-danger",
            "warning" => "alert-warning",
            _ => "alert-success"
        };

        var inventoryToneClass = Model.InventoryHealthTone switch
        {
