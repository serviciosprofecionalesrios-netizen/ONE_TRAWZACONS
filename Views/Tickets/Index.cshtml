                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(null, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType)">
