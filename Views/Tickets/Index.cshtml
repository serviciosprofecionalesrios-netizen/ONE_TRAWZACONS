                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.QuickFilter))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, null, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType)">
