@model ITServiceDeskApp.ViewModels.Tickets.TicketsIndexViewModel
@using ITServiceDeskApp.Models
@using System.Text.Json

@{
    var isFinanceView = Model.IsFinanceView || string.Equals(Model.Department, "Finanzas", StringComparison.OrdinalIgnoreCase);
    var isMineFinanceView = Model.IsMineFinanceView;
    var pageTitle = Model.IsMaintenanceView
        ? "Seguimiento de Ordenes de Mantenimiento"
        : isFinanceView
            ? (isMineFinanceView ? "Mis Solicitudes Financieras" : "Dashboard de Solicitudes Financieras")
            : "Gestión de Incidencias";
    var pageSubtitle = Model.IsMaintenanceView
        ? "Control operativo de ordenes correctivas y preventivas"
        : isFinanceView
            ? (isMineFinanceView
                ? "Vista personal de tus solicitudes del área de Finanzas"
                : "Monitoreo de requerimientos y aprobaciones del área de Finanzas")
            : "Administra y da seguimiento a todos los tickets del sistema";
    ViewData["Title"] = pageTitle;
    var tickets = Model.Tickets ?? Array.Empty<Ticket>();
    var nowUtc = DateTime.UtcNow;

    var canCreateTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
        User.IsInRole(nameof(UserRole.Technician)) ||
        User.IsInRole(nameof(UserRole.EndUser)) ||
        User.IsInRole(nameof(UserRole.GerenciaGeneral));

    var canEditTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
        User.IsInRole(nameof(UserRole.Technician));

    var canDeleteTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT));

    var canFinanceWorkflow =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
        User.IsInRole(nameof(UserRole.GerenciaGeneral));

    string QuickLabel(string? quick) => quick switch
    {
        "today" => "Hoy",
        "overdue" => "Vencidos",
        "overdue_unassigned" => "Vencidos sin tecnico",
        "unassigned" => "Sin asignar",
        "critical" => "Críticos",
        "myload" => "Mi carga",
        "finance_pending_approval" => "Aprobaciones pendientes",
        "finance_close_ready" => "Listas para cierre",
        "finance_rejected" => "Rechazadas",
        "finance_returned" => "Devueltas para corrección",
        "finance_escalated" => "Escaladas",
        _ => "Todos"
    };

    string PriorityClass(PriorityLevel priority) => priority switch
    {
        PriorityLevel.Low => "bg-success",
        PriorityLevel.Medium => "bg-warning text-dark",
        PriorityLevel.High => "bg-danger",
        PriorityLevel.Critical => "bg-dark",
        _ => "bg-secondary"
    };

    string PriorityLabel(PriorityLevel priority) => priority switch
    {
        PriorityLevel.Low => "Baja",
        PriorityLevel.Medium => "Media",
        PriorityLevel.High => "Alta",
        PriorityLevel.Critical => "Critica",
        _ => priority.ToString()
    };

    string StatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "bg-primary",
        TicketStatus.InProgress => "bg-info text-dark",
        TicketStatus.Resolved => "bg-warning text-dark",
        TicketStatus.Closed => "bg-success",
        _ => "bg-secondary"
    };

    string StatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Open => "Abierto",
        TicketStatus.InProgress => "En progreso",
        TicketStatus.Resolved => "Resuelto",
        TicketStatus.Closed => "Cerrado",
        _ => status.ToString()
    };

    string FormatDurationHours(double hours)
    {
        var absHours = Math.Abs(hours);
        var span = TimeSpan.FromHours(absHours);
        var dayPart = span.TotalDays >= 1 ? $"{(int)span.TotalDays}d " : string.Empty;
        var hourPart = $"{span.Hours}h";
        var minutePart = $"{span.Minutes}m";
        var compact = $"{dayPart}{hourPart} {minutePart}".Trim();
        return hours < 0 ? $"-{compact}" : compact;
    }

    string BuildUrl(
        string? search,
        TicketStatus? status,
        PriorityLevel? priority,
        string? quick,
        int page,
        int pageSize,
        string? department = null,
        string? site = null,
        string? tenencia = null,
        string? technician = null,
        string? incidentType = null,
        string? overdueBand = null,
        string? maintenanceStage = null,
        string? maintenanceView = null,
        bool? mine = null) =>
        Url.Action("Index", "Tickets", new
        {
            search,
            status,
            priority,
            quick,
            mine = mine ?? Model.IsMineFinanceView,
            page,
            pageSize,
            department = department ?? Model.Department,
            site = site ?? Model.SelectedSite,
            tenencia = tenencia ?? Model.SelectedTenencia,
            technician = technician ?? Model.SelectedAssignedTechnician,
            incidentType = incidentType ?? Model.SelectedIncidentType,
            maintenanceStage = maintenanceStage ?? Model.SelectedMaintenanceStage,
            overdueBand = overdueBand ?? Model.SelectedOverdueBand,
            maintenanceView = maintenanceView ?? Model.MaintenanceViewMode
        }) ?? "#";

    var hasActiveFilters =
        !string.IsNullOrWhiteSpace(Model.Search) ||
        Model.Status.HasValue ||
        Model.Priority.HasValue ||
        !string.IsNullOrWhiteSpace(Model.QuickFilter) ||
        !string.IsNullOrWhiteSpace(Model.Department) ||
        !string.IsNullOrWhiteSpace(Model.SelectedSite) ||
        !string.IsNullOrWhiteSpace(Model.SelectedTenencia) ||
        !string.IsNullOrWhiteSpace(Model.SelectedAssignedTechnician) ||
        !string.IsNullOrWhiteSpace(Model.SelectedIncidentType) ||
        !string.IsNullOrWhiteSpace(Model.SelectedMaintenanceStage) ||
        !string.IsNullOrWhiteSpace(Model.SelectedOverdueBand);

    var trendLabelsJson = JsonSerializer.Serialize(Model.TrendLabels);
    var trendCreatedJson = JsonSerializer.Serialize(Model.TrendCreated);
    var trendClosedJson = JsonSerializer.Serialize(Model.TrendClosed);
    var maintenanceSiteOptions = Model.SiteOptions ?? Array.Empty<string>();
    var maintenanceTenenciaOptions = Model.TenenciaOptions ?? Array.Empty<string>();
    var maintenanceIncidentTypeOptions = Model.IncidentTypeOptions ?? Array.Empty<string>();
    var maintenanceStageOptions = Model.MaintenanceStageOptions ?? Array.Empty<string>();
    var maintenanceTechnicianOptions = Model.TechnicianOptions ?? Array.Empty<string>();
    var maintenanceSiteCostRanking = Model.MaintenanceSiteCostRanking ?? Array.Empty<ITServiceDeskApp.ViewModels.Tickets.MaintenanceSiteCostRankItem>();
    var maintenanceReincidenceRanking = Model.MaintenanceReincidenceRanking ?? Array.Empty<ITServiceDeskApp.ViewModels.Tickets.MaintenanceReincidenceItem>();
    var maintenanceDetailRows = Model.MaintenanceDetailRows ?? Array.Empty<ITServiceDeskApp.ViewModels.Tickets.MaintenanceOrderDetailItem>();
    var maintenanceBoardRows = Model.MaintenanceBoardRows ?? Array.Empty<ITServiceDeskApp.ViewModels.Tickets.MaintenanceAirportBoardItem>();
    var maintenanceViewMode = string.IsNullOrWhiteSpace(Model.MaintenanceViewMode) ? "overview" : Model.MaintenanceViewMode;
}

