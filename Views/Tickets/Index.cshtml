                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, null, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType)">
