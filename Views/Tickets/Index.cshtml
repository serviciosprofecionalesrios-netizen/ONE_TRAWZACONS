@model IEnumerable<ITServiceDeskApp.Models.Ticket>
@using ITServiceDeskApp.Models

@{
    ViewData["Title"] = "Gestión de Incidencias";
    var tickets = Model ?? new List<Ticket>();

    var canCreateTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
        User.IsInRole(nameof(UserRole.Technician)) ||
        User.IsInRole(nameof(UserRole.EndUser)) ||
        User.IsInRole(nameof(UserRole.GerenciaGeneral));

    var canEditTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
        User.IsInRole(nameof(UserRole.Technician));

    var canDeleteTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT));
}

<style>
    .tickets-grid {
        min-width: 1080px;
    }

    .tickets-grid th {
        white-space: nowrap;
        font-weight: 700;
    }

    .ticket-number-cell {
        white-space: nowrap;
        font-weight: 700;
        color: #198754;
    }

    .date-main {
        display: block;
        font-weight: 500;
    }

    .date-sub {
        display: block;
        color: #6c757d;
    }

    .obs-cell {
        max-width: 240px;
        color: #334155;
        line-height: 1.35;
    }

    .obs-preview {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }

    .col-actions {
        width: 150px;
    }

    .ticket-actions {
        display: flex;
        gap: 0.35rem;
        justify-content: center;
        align-items: center;
        flex-wrap: nowrap;
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .btn-icon i {
        font-size: 0.95rem;
    }
</style>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Gestión de Incidencias</h2>
            <small class="text-muted">
                Administra y da seguimiento a todos los tickets del sistema
            </small>
        </div>

        @if (canCreateTicket)
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-lg"></i> Nueva Incidencia
            </a>
        }
    </div>

    @if (ViewBag.OverdueCount != null && ViewBag.OverdueCount > 0)
    {
        <div class="alert alert-danger shadow-sm">
            <strong>@ViewBag.OverdueCount</strong> ticket(s) vencido(s) requieren atención inmediata.
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <input type="text"
                           id="searchBox"
                           class="form-control"
                           placeholder="Buscar por ticket, usuario o descripción..."
                           value="@ViewBag.CurrentSearch" />
                </div>

                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">Todos los Estados</option>
                        @foreach (TicketStatus s in Enum.GetValues(typeof(TicketStatus)))
                        {
                            <option value="@s"
                                    selected="@(ViewBag.CurrentStatus?.ToString() == s.ToString())">
                                @s
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select id="priorityFilter" class="form-select">
                        <option value="">Todas las Prioridades</option>
                        @foreach (PriorityLevel p in Enum.GetValues(typeof(PriorityLevel)))
                        {
                            <option value="@p"
                                    selected="@(ViewBag.CurrentPriority?.ToString() == p.ToString())">
                                @p
                            </option>
                        }
                    </select>
                </div>

            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">

            @if (!tickets.Any())
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">
                        No hay incidencias registradas.
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 tickets-grid">
                        <thead class="table-light">
                            <tr>
                                <th>Ticket</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Prioridad</th>
                                <th>Estado</th>
                                <th>SLA</th>
                                <th>Técnico</th>
                                <th>Observaciones</th>
                                <th class="text-center col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in tickets)
                            {
                                var now = DateTime.UtcNow;
                                var isOverdue = item.SLADeadline < now && item.Status != TicketStatus.Closed;
                                var isNear = item.SLADeadline < now.AddHours(4) && !isOverdue && item.Status != TicketStatus.Closed;

                                <tr class="@(isOverdue ? "table-danger" : "")">
                                    <td class="ticket-number-cell">@item.TicketNumber</td>
                                    <td>
                                        <span class="date-main">@item.CreatedDate.ToString("yyyy-MM-dd")</span>
                                        <span class="date-sub">@item.CreatedDate.ToString("HH:mm")</span>
                                    </td>
                                    <td>@item.RequestingUser</td>

                                    <td>
                                        @{
                                            var priorityClass = item.Priority switch
                                            {
                                                PriorityLevel.Low => "bg-success",
                                                PriorityLevel.Medium => "bg-warning text-dark",
                                                PriorityLevel.High => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @priorityClass">@item.Priority</span>
                                    </td>

                                    <td>
                                        @{
                                            var statusClass = item.Status switch
                                            {
                                                TicketStatus.Open => "bg-primary",
                                                TicketStatus.InProgress => "bg-info text-dark",
                                                TicketStatus.Resolved => "bg-warning text-dark",
                                                TicketStatus.Closed => "bg-success",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">@item.Status</span>
                                    </td>

                                    <td>
                                        @if (item.Status == TicketStatus.Closed)
                                        {
                                            <span class="badge bg-secondary">Cerrado</span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="badge bg-danger">Vencido</span>
                                        }
                                        else if (isNear)
                                        {
                                            <span class="badge bg-warning text-dark">Por vencer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">En tiempo</span>
                                        }

                                        <div class="small text-muted mt-1">
                                            @item.SLADeadline.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.AssignedTechnician)
                                            ? "Sin asignar"
                                            : item.AssignedTechnician)
                                    </td>

                                    <td class="obs-cell">
                                        @if (string.IsNullOrWhiteSpace(item.Observations))
                                        {
                                            <span class="text-muted">Sin observaciones</span>
                                        }
                                        else
                                        {
                                            <span class="obs-preview" title="@item.Observations">@item.Observations</span>
                                        }
                                    </td>

                                    <td class="text-center col-actions">
                                        <div class="ticket-actions">
                                            @if (canEditTicket)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary btn-icon"
                                                   title="Editar"
                                                   aria-label="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                            }

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info btn-icon"
                                               title="Detalles"
                                               aria-label="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="DownloadPdf"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger btn-icon"
                                               title="Descargar PDF"
                                               aria-label="Descargar PDF">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>

                                            @if (canDeleteTicket)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger btn-icon"
                                                   title="Eliminar"
                                                   aria-label="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchBox = document.getElementById("searchBox");
    const statusFilter = document.getElementById("statusFilter");
    const priorityFilter = document.getElementById("priorityFilter");

    function applyFilters() {
        const search = searchBox.value;
        const status = statusFilter.value;
        const priority = priorityFilter.value;

        const params = new URLSearchParams();

        if (search) params.append("search", search);
        if (status) params.append("status", status);
        if (priority) params.append("priority", priority);

        window.location.href = "/Tickets?" + params.toString();
    }

    let typingTimer;

    searchBox.addEventListener("keyup", function () {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(applyFilters, 400);
    });

    statusFilter.addEventListener("change", applyFilters);
    priorityFilter.addEventListener("change", applyFilters);
});
</script>
}
