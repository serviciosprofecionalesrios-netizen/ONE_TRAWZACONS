                    @if (!string.IsNullOrWhiteSpace(Model.Department))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, string.Empty, Model.SelectedSite, Model.SelectedTenencia, Model.SelectedAssignedTechnician, Model.SelectedIncidentType)">
                            departamento: @Model.Department  x
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedSite))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: string.Empty, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType)">
                            sitio: @Model.SelectedSite  x
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedTenencia))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: string.Empty, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType)">
                            tenencia: @Model.SelectedTenencia  x
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedAssignedTechnician))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: string.Empty, incidentType: Model.SelectedIncidentType)">
                            técnico: @Model.SelectedAssignedTechnician  x
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedIncidentType))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: string.Empty)">
                            tipo: @Model.SelectedIncidentType  x
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedMaintenanceStage))
                    {
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, maintenanceStage: string.Empty)">
                            etapa: @Model.SelectedMaintenanceStage  x
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedOverdueBand))
                    {
                        var overdueBandLabel = Model.SelectedOverdueBand switch
                        {
                            "0_24" => "0-24h",
                            "24_72" => "24-72h",
                            "72_plus" => ">72h",
                            _ => Model.SelectedOverdueBand
                        };
                        <a class="chip-link badge rounded-pill text-bg-light"
                           href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: string.Empty)">
                            tramo vencido: @overdueBandLabel  x
