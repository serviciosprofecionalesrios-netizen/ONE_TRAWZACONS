    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Tendencia 7 días (creados vs cerrados)</h6>
                        <small class="text-muted">Backlog neto: @Model.BacklogDelta7Days.ToString("+0;-0;0")</small>
                    </div>
                    <div class="chart-shell">
                        <canvas id="ticketsTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Semáforo SLA por técnico</h6>
                    @if (Model.TechnicianLoads.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Técnico</th>
                                        <th>Activos</th>
                                        <th>Vencidos</th>
                                        <th>Riesgo</th>
                                        <th>En tiempo</th>
                                        <th>SLA %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.TechnicianLoads)
                                    {
                                        var slaClass = row.SlaOnTimeRate switch
                                        {
                                            >= 90 => "bg-success-subtle text-success-emphasis",
                                            >= 70 => "bg-warning-subtle text-warning-emphasis",
                                            _ => "bg-danger-subtle text-danger-emphasis"
                                        };
                                        <tr>
                                            <td>@row.Technician</td>
                                            <td><span class="badge bg-primary-subtle text-primary-emphasis">@row.ActiveTickets</span></td>
                                            <td><span class="badge bg-danger-subtle text-danger-emphasis">@row.OverdueTickets</span></td>
                                            <td><span class="badge bg-warning-subtle text-warning-emphasis">@row.NearDueTickets</span></td>
                                            <td><span class="badge bg-success-subtle text-success-emphasis">@row.OnTimeTickets</span></td>
                                            <td><span class="badge @slaClass">@row.SlaOnTimeRate.ToString("0.#")%</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <small class="text-muted">No hay tickets activos para los filtros aplicados.</small>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsMaintenanceView && maintenanceViewMode == "overview")
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Backlog por etapa de taller</h6>
                        @if (Model.StageKpis.Any())
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var stageRow in Model.StageKpis)
                                {
                                    var isActiveStage = string.Equals(Model.SelectedMaintenanceStage, stageRow.Stage, StringComparison.OrdinalIgnoreCase);
                                    <a class="text-decoration-none"
                                       href="@BuildUrl(Model.Search, Model.Status, Model.Priority, Model.QuickFilter, 1, Model.PageSize, site: Model.SelectedSite, tenencia: Model.SelectedTenencia, technician: Model.SelectedAssignedTechnician, incidentType: Model.SelectedIncidentType, overdueBand: Model.SelectedOverdueBand, maintenanceStage: isActiveStage ? string.Empty : stageRow.Stage)">
                                        <div class="d-flex justify-content-between align-items-center border rounded px-3 py-2 @(isActiveStage ? "bg-primary-subtle border-primary" : "bg-light")">
                                            <span class="fw-semibold text-dark">@stageRow.Stage</span>
                                            <span class="badge bg-dark">@stageRow.Total</span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">No hay ordenes para distribuir por etapa.</small>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Capacidad por tecnico (turno)</h6>
                        @if (Model.TechnicianCapacityItems.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Tecnico</th>
                                            <th>Categoria</th>
                                            <th>Turno</th>
                                            <th class="text-end">Carga</th>
                                            <th class="text-end">Uso</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var techRow in Model.TechnicianCapacityItems)
                                        {
                                            var utilizationClass = techRow.UtilizationRate switch
                                            {
                                                >= 100 => "bg-danger-subtle text-danger-emphasis",
                                                >= 80 => "bg-warning-subtle text-warning-emphasis",
                                                _ => "bg-success-subtle text-success-emphasis"
                                            };
                                            <tr>
                                                <td>@techRow.Technician</td>
                                                <td>@techRow.Category</td>
                                                <td>@techRow.Shift</td>
                                                <td class="text-end">
                                                    <span class="badge @(techRow.IsOverCapacity ? "bg-danger-subtle text-danger-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                                        @techRow.ActiveOrders/@techRow.Capacity
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <span class="badge @utilizationClass">@techRow.UtilizationRate.ToString("0.#")%</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">No hay tecnicos activos para calcular capacidad.</small>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Model.PendingCostApprovalOrders > 0 &&
             (User.IsInRole(nameof(UserRole.Administrator)) ||
              User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
              User.IsInRole(nameof(UserRole.GerenciaGeneral))))
        {
            <div class="alert alert-warning shadow-sm">
                Hay <strong>@Model.PendingCostApprovalOrders</strong> orden(es) con costo pendiente de aprobacion.
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Ranking de costo por sitio/taller</h6>
                        @if (maintenanceSiteCostRanking.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sitio</th>
                                            <th class="text-end">Órdenes</th>
                                            <th class="text-end">Total C$</th>
                                            <th class="text-end">Prom. C$</th>
                                            <th class="text-end">Reincid.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in maintenanceSiteCostRanking)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@row.Site</div>
                                                    <div class="small text-muted">$ @row.TotalCostUsd.ToString("N2")</div>
                                                </td>
                                                <td class="text-end">@row.Orders</td>
                                                <td class="text-end fw-semibold">C$ @row.TotalCostCordoba.ToString("N2")</td>
                                                <td class="text-end">C$ @row.AverageCostCordoba.ToString("N2")</td>
                                                <td class="text-end">
                                                    <span class="badge @(row.ReincidenceOrders > 0 ? "bg-danger-subtle text-danger-emphasis" : "bg-success-subtle text-success-emphasis")">
                                                        @row.ReincidenceOrders
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">No hay datos suficientes para ranking de costo.</small>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Reincidencia por unidad/equipo</h6>
                        @if (maintenanceReincidenceRanking.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Unidad</th>
                                            <th class="text-end">Órdenes</th>
                                            <th class="text-end">Reincid.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in maintenanceReincidenceRanking)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@row.UnitCode</div>
                                                    <div class="small text-muted">@row.TopFailureCategory · @row.MainSite</div>
                                                </td>
                                                <td class="text-end">@row.Orders</td>
                                                <td class="text-end">
                                                    <span class="badge bg-danger-subtle text-danger-emphasis">@row.ReincidenceCount</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">No hay reincidencias en el filtro actual.</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="ticketFiltersForm" method="get" asp-controller="Tickets" asp-action="Index">
                <input type="hidden" name="quick" value="@Model.QuickFilter" />
                <input type="hidden" name="department" value="@Model.Department" />
                <input type="hidden" name="mine" value="@(Model.IsMineFinanceView ? "true" : "false")" />
                <input type="hidden" name="overdueBand" value="@Model.SelectedOverdueBand" />
                <input type="hidden" name="maintenanceView" value="@maintenanceViewMode" />
                <input type="hidden" name="page" value="1" />

                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text"
                               id="searchBox"
                               name="search"
                               class="form-control"
                               placeholder="Buscar por ticket, usuario o descripción..."
                               value="@Model.Search" />
                    </div>

                    <div class="col-md-3">
                        <select id="statusFilter" name="status" class="form-select">
                            <option value="">Todos los Estados</option>
                            @foreach (TicketStatus s in Enum.GetValues(typeof(TicketStatus)))
                            {
                                if (Model.Status == s)
                                {
                                    <option value="@s" selected>@StatusLabel(s)</option>
                                }
                                else
                                {
                                    <option value="@s">@StatusLabel(s)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <select id="priorityFilter" name="priority" class="form-select">
                            <option value="">Todas las Prioridades</option>
                            @foreach (PriorityLevel p in Enum.GetValues(typeof(PriorityLevel)))
                            {
                                if (Model.Priority == p)
                                {
                                    <option value="@p" selected>@PriorityLabel(p)</option>
                                }
                                else
                                {
                                    <option value="@p">@PriorityLabel(p)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <select id="pageSizeFilter" name="pageSize" class="form-select">
                            @foreach (var size in new[] { 10, 25, 50, 100 })
                            {
                                if (Model.PageSize == size)
                                {
                                    <option value="@size" selected>@size por página</option>
                                }
                                else
                                {
                                    <option value="@size">@size por página</option>
                                }
                            }
                        </select>
                    </div>

                    @if (Model.IsMaintenanceView)
                    {
                        <div class="col-md-3">
                            <select id="siteFilter" name="site" class="form-select">
                                <option value="">Todos los Sitios</option>
                                @foreach (var opt in maintenanceSiteOptions)
                                {
                                    if (string.Equals(Model.SelectedSite, opt, StringComparison.OrdinalIgnoreCase))
                                    {
