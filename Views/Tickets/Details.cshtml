@model ITServiceDeskApp.Models.Ticket
@using ITServiceDeskApp.Models

@{
    ViewData["Title"] = "Detalle del Ticket";
    const string quickAuditPrefix = "QA::";
    var returnDepartment = ViewBag.ReturnDepartment as string;

    var canEditTicket =
        User.IsInRole(nameof(UserRole.Administrator)) ||
        User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
        User.IsInRole(nameof(UserRole.Technician));

    string DisplayAuditUser(string? changedBy)
    {
        if (string.IsNullOrWhiteSpace(changedBy))
        {
            return "Sistema";
        }

        return changedBy.StartsWith(quickAuditPrefix, StringComparison.Ordinal)
            ? changedBy.Substring(quickAuditPrefix.Length)
            : changedBy;
    }

    string DisplayAuditField(string? fieldChanged)
    {
        return fieldChanged switch
        {
            "Creacion" => "Creacion",
            "Status" => "Estado",
            "Priority" => "Prioridad",
            "AssignedTechnician" => "Tecnico asignado",
            "TechnicianCategory" => "Categoria tecnica",
            "MaintenanceStage" => "Etapa de taller",
            "RequestingUser" => "Solicitante",
            "Site" => "Sitio",
            "Tenencia" => "Tenencia",
            "IncidentType" => "Tipo de mantenimiento",
            "UnitCode" => "Unidad / Equipo / Area",
            "FailureCategory" => "Categoria de falla",
            "DamagedElement" => "Elemento danado",
            "FailureOdometerKm" => "KM ingreso falla",
            "ExitOdometerKm" => "KM salida taller",
            "Description" => "Descripcion",
            "SparePartDetails" => "Detalle de repuestos",
            "ChangedComponentName" => "Componente cambiado",
            "ChangedComponentCostCordoba" => "Costo componente C$",
            "ChangedComponentCostUsd" => "Costo componente $",
            "LaborCostCordoba" => "Mano de obra C$",
            "LaborCostUsd" => "Mano de obra $",
            "ExternalCostCordoba" => "Costo externo C$",
            "ExternalCostUsd" => "Costo externo $",
            "RequiresCostApproval" => "Requiere aprobacion de costos",
            "CostApproved" => "Aprobacion de costos",
            "CostApprovedBy" => "Aprobado por",
            "CostApprovedAtUtc" => "Fecha aprobacion",
            "CostApprovalNotes" => "Notas aprobacion",
            "UserConformityConfirmed" => "Conformidad usuario",
            "PreventiveRecommendations" => "Recomendaciones preventivas",
            "Observations" => "Observaciones",
            "SLADeadline" => "Fecha limite SLA",
            "ClosedDate" => "Fecha cierre",
            _ => string.IsNullOrWhiteSpace(fieldChanged) ? "Campo" : fieldChanged
        };
    }
}

<div class="container mt-4">

    <div class="card shadow-lg mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
            <h4 class="mb-0">Detalle de Incidencia</h4>
            <span class="fw-bold">@Model.TicketNumber</span>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Fecha Creacion:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</p>
                    <p><strong>Usuario:</strong> @Model.RequestingUser</p>
                    <p><strong>Sitio:</strong> @Model.Site</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Tenencia))
                    {
                        <p><strong>Tenencia:</strong> @Model.Tenencia</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.UnitCode))
                    {
                        <p><strong>Unidad / Equipo:</strong> @Model.UnitCode</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FailureCategory))
                    {
                        <p><strong>Categoria de falla:</strong> @Model.FailureCategory</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DamagedElement))
                    {
                        <p><strong>Elemento danado:</strong> @Model.DamagedElement</p>
                    }
                    <p><strong>Departamento:</strong> @Model.Department</p>
                    <p><strong>Tipo Incidencia:</strong> @Model.IncidentType</p>
                </div>

                <div class="col-md-6">
                    @{
                        string priorityClass = Model.Priority switch
                        {
                            PriorityLevel.Low => "bg-success",
                            PriorityLevel.Medium => "bg-warning text-dark",
                            PriorityLevel.High => "bg-danger",
                            PriorityLevel.Critical => "bg-dark",
                            _ => "bg-secondary"
                        };

                        string statusClass = Model.Status switch
                        {
                            TicketStatus.Open => "bg-primary",
                            TicketStatus.InProgress => "bg-info text-dark",
                            TicketStatus.Resolved => "bg-warning text-dark",
                            TicketStatus.Closed => "bg-success",
                            _ => "bg-secondary"
                        };
                    }

                    <p><strong>Prioridad:</strong> <span class="badge @priorityClass">@Model.Priority</span></p>
                    <p><strong>Estado:</strong> <span class="badge @statusClass">@Model.Status</span></p>
                    <p><strong>Tecnico Asignado:</strong> @(string.IsNullOrWhiteSpace(Model.AssignedTechnician) ? "Sin asignar" : Model.AssignedTechnician)</p>
                    <p><strong>SLA:</strong> @Model.SLADeadline.ToString("yyyy-MM-dd HH:mm")</p>
                    @if (Model.FailureOdometerKm.HasValue)
                    {
                        <p><strong>KM ingreso falla:</strong> @Model.FailureOdometerKm.Value.ToString("N2")</p>
                    }
                    @if (Model.ExitOdometerKm.HasValue)
                    {
                        <p><strong>KM salida taller:</strong> @Model.ExitOdometerKm.Value.ToString("N2")</p>
                    }
                </div>
            </div>

            <hr />
            <h5>Descripcion</h5>
            <p>@Model.Description</p>

            <hr />
            <h5>Evidencia del Tecnico</h5>
            <div class="row">
                <div class="col-md-4">
                    <strong>Evidencia inicial:</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.BeforeEvidencePath))
                    {
                        <div><a href="@Model.BeforeEvidencePath" target="_blank">Ver archivo</a></div>
                    }
                    else
                    {
                        <div class="text-muted">No cargada</div>
                    }
                </div>

                <div class="col-md-4">
                    <strong>Evidencia final:</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.AfterEvidencePath))
                    {
                        <div><a href="@Model.AfterEvidencePath" target="_blank">Ver archivo</a></div>
                    }
                    else
                    {
                        <div class="text-muted">No cargada</div>
                    }
                </div>

                <div class="col-md-4">
                    <strong>Evidencia adicional:</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
                    {
                        <div><a href="@Model.AttachmentPath" target="_blank">Ver archivo</a></div>
                    }
                    else
                    {
                        <div class="text-muted">No cargada</div>
                    }
                </div>
            </div>

            <hr />
            <h5>Formulario Tecnico</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Condicion inicial del equipo</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.InitialConditionNotes) ? "Sin detalle" : Model.InitialConditionNotes)</div>
                </div>
                <div class="col-md-6">
                    <strong>Reparaciones realizadas</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.RepairActionsPerformed) ? "Sin detalle" : Model.RepairActionsPerformed)</div>
                </div>
                <div class="col-md-6">
                    <strong>Causa raiz</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.RootCause) ? "Sin detalle" : Model.RootCause)</div>
                </div>
                <div class="col-md-6">
                    <strong>Pruebas tecnicas</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.TechnicalTestsPerformed) ? "Sin detalle" : Model.TechnicalTestsPerformed)</div>
                </div>
                <div class="col-md-4">
                    <strong>Requirio repuesto:</strong> @(Model.SparePartRequired ? "Si" : "No")
                </div>
                <div class="col-md-4">
                    <strong>Se compro repuesto:</strong> @(Model.SparePartPurchased ? "Si" : "No")
                </div>
                <div class="col-md-4">
                    <strong>Detalle repuesto:</strong> @(string.IsNullOrWhiteSpace(Model.SparePartDetails) ? "N/A" : Model.SparePartDetails)
                </div>
                <div class="col-md-4">
                    <strong>Cambio de componente:</strong> @(Model.ComponentChanged ? "Si" : "No")
                </div>
                <div class="col-md-4">
                    <strong>Componente cambiado:</strong> @(string.IsNullOrWhiteSpace(Model.ChangedComponentName) ? "N/A" : Model.ChangedComponentName)
                </div>
                <div class="col-md-4">
                    <strong>Costo del componente (C$):</strong> @(Model.ChangedComponentCostCordoba.HasValue ? $"C$ {Model.ChangedComponentCostCordoba.Value:N2}" : "N/A")
                </div>
                <div class="col-md-4">
                    <strong>Costo del componente ($):</strong> @(Model.ChangedComponentCostUsd.HasValue ? $"$ {Model.ChangedComponentCostUsd.Value:N2}" : "N/A")
                </div>
                <div class="col-md-6">
                    <strong>Usuario confirma solucion:</strong> @(Model.UserConformityConfirmed ? "Si" : "No")
                </div>
                <div class="col-md-6">
                    <strong>Recomendaciones preventivas</strong>
                    <div>@(string.IsNullOrWhiteSpace(Model.PreventiveRecommendations) ? "Sin detalle" : Model.PreventiveRecommendations)</div>
                </div>
            </div>

            <hr />
            <h5>Detalle de Repuestos Despachados</h5>
            @if (Model.SparePartDispatches == null || !Model.SparePartDispatches.Any())
            {
                <div class="text-muted">No hay repuestos despachados para esta orden.</div>
            }
            else
            {
                var orderedDispatches = Model.SparePartDispatches
                    .OrderBy(x => x.PartName)
                    .ToList();

                var totalCordoba = orderedDispatches.Sum(x => x.TotalCostCordoba ?? 0m);
                var totalUsd = orderedDispatches.Sum(x => x.TotalCostUsd ?? 0m);

                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Articulo</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Unitario C$</th>
                                <th class="text-end">Total C$</th>
                                <th class="text-end">Unitario $</th>
                                <th class="text-end">Total $</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in orderedDispatches)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@line.PartName</div>
                                        <div class="text-muted small">@line.PartCode @(string.IsNullOrWhiteSpace(line.UnitOfMeasure) ? string.Empty : $"| {line.UnitOfMeasure}")</div>
                                    </td>
                                    <td class="text-end">@line.QuantityDispatched</td>
                                    <td class="text-end">@((line.UnitCostCordoba ?? 0m).ToString("N2"))</td>
                                    <td class="text-end">@((line.TotalCostCordoba ?? 0m).ToString("N2"))</td>
                                    <td class="text-end">@((line.UnitCostUsd ?? 0m).ToString("N2"))</td>
                                    <td class="text-end">@((line.TotalCostUsd ?? 0m).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Total orden</th>
                                <th class="text-end">C$ @totalCordoba.ToString("N2")</th>
                                <th></th>
                                <th class="text-end">$ @totalUsd.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-dark text-white">Historial auditable de cambios</div>

        <div class="card-body">
            @if (!Model.HistoryEntries.Any())
            {
                <div class="alert alert-info">No hay cambios registrados.</div>
            }
            else
            {
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Campo</th>
                            <th>Antes</th>
                            <th>Despues</th>
                            <th>Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.HistoryEntries.OrderByDescending(h => h.ChangeDate))
                        {
                            <tr>
                                <td>@item.ChangeDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@DisplayAuditField(item.FieldChanged)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.OldValue) ? "-" : item.OldValue)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.NewValue) ? "-" : item.NewValue)</td>
                                <td>@DisplayAuditUser(item.ChangedBy)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="mt-4 text-end">
        @if (canEditTicket)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-department="@returnDepartment" class="btn btn-primary">Editar</a>
        }
        <a asp-action="DownloadPdf" asp-route-id="@Model.Id" asp-route-department="@returnDepartment" class="btn btn-danger">Descargar PDF</a>
        <a asp-action="Index" asp-route-department="@returnDepartment" class="btn btn-secondary">Volver</a>
    </div>

</div>





