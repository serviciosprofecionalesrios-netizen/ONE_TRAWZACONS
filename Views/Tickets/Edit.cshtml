@model ITServiceDeskApp.Models.Ticket
@using ITServiceDeskApp.Models

@{
    ViewData["Title"] = "Editar Incidencia";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Editar Incidencia</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- 🔥 CLAVES PARA CONCURRENCIA -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="TicketNumber" class="form-label"></label>
                        <input asp-for="TicketNumber" class="form-control" />
                        <span asp-validation-for="TicketNumber" class="text-danger"></span>
                    </div>

                    <!-- 🔥 CreatedDate mejor solo lectura -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CreatedDate" class="form-label"></label>
                        <input asp-for="CreatedDate" class="form-control" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RequestingUser" class="form-label"></label>
                        <input asp-for="RequestingUser" class="form-control" />
                        <span asp-validation-for="RequestingUser" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Site" class="form-label"></label>
                        <input asp-for="Site" class="form-control" />
                        <span asp-validation-for="Site" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IncidentType" class="form-label"></label>
                        <input asp-for="IncidentType" class="form-control" />
                        <span asp-validation-for="IncidentType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<PriorityLevel>()">
                        </select>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<TicketStatus>()">
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AssignedTechnician" class="form-label"></label>
                        <input asp-for="AssignedTechnician" class="form-control" />
                        <span asp-validation-for="AssignedTechnician" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SLADeadline" class="form-label"></label>
                        <input asp-for="SLADeadline" type="datetime-local" class="form-control" />
                        <span asp-validation-for="SLADeadline" class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                </div>

                <div class="text-end">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}