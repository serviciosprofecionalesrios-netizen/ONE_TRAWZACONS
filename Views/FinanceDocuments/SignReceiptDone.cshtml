@model ITServiceDeskApp.Models.FinanceReceipt
@{
    Layout = null;
    var pdfByTokenUrl = ViewBag.PdfByTokenUrl as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recibo firmado</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f5f7fb; }
        .shell { max-width: 760px; margin: 2rem auto; padding: 0 0.8rem; }
    </style>
</head>
<body>
    <div class="shell">
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">Firma registrada correctamente</h3>
                <p class="text-muted mb-4">
                    Recibo <strong>@Model.ReceiptNumber</strong>
                    @if (Model.SignedAtUtc.HasValue)
                    {
                        <span>firmado el @Model.SignedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(pdfByTokenUrl))
                {
                    <a href="@pdfByTokenUrl" class="btn btn-danger">
                        Descargar PDF del recibo
                    </a>
                }
            </div>
        </div>
    </div>
</body>
</html>
