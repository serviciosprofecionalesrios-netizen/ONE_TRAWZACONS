@model ITServiceDeskApp.Models.DashboardViewModel
@using ITServiceDeskApp.Models
@using System.Text.Json
@using System.Linq

@{
    ViewData["Title"] = "Dashboard IT Service Desk";

    string PriorityClass(PriorityLevel p) => p switch
    {
        PriorityLevel.Critical => "bg-danger-subtle text-danger-emphasis",
        PriorityLevel.High => "bg-warning-subtle text-warning-emphasis",
        PriorityLevel.Medium => "bg-info-subtle text-info-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    string StatusClass(TicketStatus s) => s switch
    {
        TicketStatus.Open => "bg-primary-subtle text-primary-emphasis",
        TicketStatus.InProgress => "bg-warning-subtle text-warning-emphasis",
        TicketStatus.Resolved => "bg-success-subtle text-success-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    string PriorityLabel(PriorityLevel p) => p switch
    {
        PriorityLevel.Low => "Baja",
        PriorityLevel.Medium => "Media",
        PriorityLevel.High => "Alta",
        PriorityLevel.Critical => "Critica",
        _ => p.ToString()
    };

    string StatusLabel(TicketStatus s) => s switch
    {
        TicketStatus.Open => "Abierto",
        TicketStatus.InProgress => "En progreso",
        TicketStatus.Resolved => "Resuelto",
        TicketStatus.Closed => "Cerrado",
        _ => s.ToString()
    };

    string TrendClass = Model.CreatedTrendPercentage switch
    {
        > 0 => "text-success",
        < 0 => "text-danger",
        _ => "text-muted"
    };

    string FormatSlaWindow(double hours) =>
        hours < 0
            ? $"Vencido hace {Math.Abs(hours):0.0}h"
            : $"Faltan {hours:0.0}h";

    var monthLabels = new[]
    {
        "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"
    };

    var currentYearSeries = Enumerable.Range(1, 12)
        .Select(m => Model.TicketsByMonthCurrent.TryGetValue(m, out var value) ? value : 0)
        .ToArray();

    var previousYearSeries = Enumerable.Range(1, 12)
        .Select(m => Model.TicketsByMonthPrevious.TryGetValue(m, out var value) ? value : 0)
        .ToArray();

    var typeTopLabels = Model.TicketsByType
        .OrderByDescending(x => x.Value)
        .Take(8)
        .Select(x => x.Key)
        .ToArray();

    var typeTopValues = typeTopLabels
        .Select(label => Model.TicketsByType.TryGetValue(label, out var value) ? value : 0)
        .ToArray();

    var statusKeys = Enum.GetValues<TicketStatus>()
        .Select(x => x.ToString())
        .ToArray();

    var statusLabels = Enum.GetValues<TicketStatus>()
        .Select(x => StatusLabel(x))
        .ToArray();

    var statusValues = statusKeys
        .Select(label => Model.TicketsByStatus.TryGetValue(label, out var value) ? value : 0)
        .ToArray();
}

<style>
    .dashboard-chart-shell {
        position: relative;
        width: 100%;
        height: 260px;
        min-height: 260px;
        max-height: 260px;
    }

    .dashboard-chart-shell--lg {
        height: 340px;
        min-height: 340px;
        max-height: 340px;
    }

    @@media (max-width: 992px) {
        .dashboard-chart-shell--lg {
            height: 280px;
            min-height: 280px;
            max-height: 280px;
        }
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard Operativo IT</h2>
            <p class="text-muted mb-0">Vista accionable para SLA, backlog, capacidad y tendencia</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tickets" asp-action="Create" class="btn btn-danger">
                <i class="bi bi-plus-circle me-1"></i> Nuevo ticket
            </a>
            <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-list-task me-1"></i> Ver tickets
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-controller="Dashboard" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" name="fromDate" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="toDate" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Estado</label>
                    <select name="status" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var item in Enum.GetValues<TicketStatus>())
                        {
                            if (Model.FilterStatus == item)
                            {
                                <option value="@item" selected>@StatusLabel(item)</option>
                            }
                            else
                            {
                                <option value="@item">@StatusLabel(item)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Prioridad</label>
                    <select name="priority" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var item in Enum.GetValues<PriorityLevel>())
                        {
                            if (Model.FilterPriority == item)
                            {
                                <option value="@item" selected>@PriorityLabel(item)</option>
                            }
                            else
                            {
                                <option value="@item">@PriorityLabel(item)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Sitio</label>
                    <select name="site" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var item in Model.SiteOptions)
                        {
                            if (Model.FilterSite == item)
                            {
                                <option value="@item" selected>@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Area</label>
                    <select name="department" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var item in Model.DepartmentOptions)
                        {
                            if (Model.FilterDepartment == item)
                            {
                                <option value="@item" selected>@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Tecnico</label>
                    <select name="technician" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var item in Model.TechnicianOptions)
                        {
                            if (Model.FilterTechnician == item)
                            {
                                <option value="@item" selected>@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-9 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-funnel me-1"></i> Aplicar filtros
                    </button>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Tickets activos</div>
                    <div class="display-6 fw-bold">@Model.ActiveTickets</div>
                    <div class="small text-muted">Abiertos + en progreso + resueltos</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Cumplimiento SLA</div>
                    <div class="display-6 fw-bold">@Model.SlaComplianceRate.ToString("0.#")%</div>
                    <div class="small text-muted">Dentro de ventana segura</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">MTTR</div>
                    <div class="display-6 fw-bold">@Model.MttrHours.ToString("0.##") h</div>
                    <div class="small text-muted">Promedio de cierre del periodo</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Creacion de tickets</div>
                    <div class="h3 fw-bold mb-1">@Model.TicketsCreatedCurrentPeriod</div>
                    <div class="small @TrendClass">
                        @Model.CreatedTrendPercentage.ToString("+0.#;-0.#;0")% vs periodo previo
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Tendencia mensual</h5>
                        <span class="small text-muted">@Model.CurrentYear vs @(Model.CurrentYear - 1)</span>
                    </div>
                    <div class="dashboard-chart-shell dashboard-chart-shell--lg">
                        <canvas id="monthlyTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">Backlog por antiguedad</h5>
                    @foreach (var bucket in Model.BacklogAgingBuckets)
                    {
                        var total = Math.Max(1, Model.ActiveTickets);
                        var width = Math.Round((double)bucket.Value * 100 / total, 1);

                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@bucket.Key</span>
                                <strong>@bucket.Value</strong>
                            </div>
                            <div class="progress" style="height: 9px;">
                                <div class="progress-bar bg-dark" role="progressbar" style="width:@width%"></div>
                            </div>
                        </div>
                    }
                    <hr />
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="p-2 rounded bg-danger-subtle">
                                <div class="small text-muted">Vencidos SLA</div>
                                <div class="fw-bold text-danger">@Model.OverdueTickets</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded bg-warning-subtle">
                                <div class="small text-muted">Sin asignar</div>
                                <div class="fw-bold text-warning">@Model.UnassignedActiveTickets</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded bg-info-subtle">
                                <div class="small text-muted">Criticos</div>
                                <div class="fw-bold text-info">@Model.CriticalActiveTickets</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">Semaforo SLA</h5>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-success">Cumplido</span>
                            <strong>@Model.SlaCompliant (@Model.SlaCompliantPercentage.ToString("0.#")%)</strong>
                        </div>
                        <div class="progress" style="height:9px;">
                            <div class="progress-bar bg-success" style="width:@Model.SlaCompliantPercentage%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-warning">Por vencer (<= 4h)</span>
                            <strong>@Model.SlaNearDue (@Model.SlaNearDuePercentage.ToString("0.#")%)</strong>
                        </div>
                        <div class="progress" style="height:9px;">
                            <div class="progress-bar bg-warning" style="width:@Model.SlaNearDuePercentage%"></div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-danger">Vencido</span>
                            <strong>@Model.SlaBreached (@Model.SlaBreachedPercentage.ToString("0.#")%)</strong>
                        </div>
                        <div class="progress" style="height:9px;">
                            <div class="progress-bar bg-danger" style="width:@Model.SlaBreachedPercentage%"></div>
                        </div>
                    </div>

                    <hr />
                    <div class="dashboard-chart-shell">
                        <canvas id="statusDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">Tickets en riesgo SLA</h5>

                    @if (Model.AtRiskTickets.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Ticket</th>
                                        <th>Prioridad</th>
                                        <th>Estado</th>
                                        <th>Tecnico</th>
                                        <th>Ventana SLA</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.AtRiskTickets)
                                    {
                                        var toneClass = item.HoursToSla < 0 ? "text-danger" : "text-warning";

                                        <tr>
                                            <td>
                                                <a asp-controller="Tickets" asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">
                                                    @item.TicketNumber
                                                </a>
                                                <div class="small text-muted">@item.Department - @item.Site</div>
                                            </td>
                                            <td><span class="badge rounded-pill @PriorityClass(item.Priority)">@PriorityLabel(item.Priority)</span></td>
                                            <td><span class="badge rounded-pill @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                                            <td class="small">@item.AssignedTechnician</td>
                                            <td class="small fw-semibold @toneClass">@FormatSlaWindow(item.HoursToSla)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mb-0">Sin tickets en ventana de riesgo inmediata.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">Carga por tecnico</h5>
                    @if (Model.TechnicianLoads.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Tecnico</th>
                                        <th>Activos</th>
                                        <th>Criticos</th>
                                        <th>Vencidos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.TechnicianLoads)
                                    {
                                        <tr>
                                            <td>@row.Technician</td>
                                            <td><span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@row.ActiveTickets</span></td>
                                            <td><span class="badge bg-info-subtle text-info-emphasis rounded-pill">@row.CriticalTickets</span></td>
                                            <td><span class="badge bg-danger-subtle text-danger-emphasis rounded-pill">@row.OverdueTickets</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay tickets activos para los filtros seleccionados.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">Top categorias de incidente</h5>
                    <div class="dashboard-chart-shell">
                        <canvas id="incidentTypeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Ultimos tickets del periodo</h5>
                <span class="small text-muted">Total: @Model.TotalTickets</span>
            </div>

            @if (Model.RecentTickets.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Area</th>
                                <th>Tipo</th>
                                <th>Prioridad</th>
                                <th>Estado</th>
                                <th>Tecnico</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentTickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">
                                            @(item.TicketNumber ?? $"TK-{item.Id}")
                                        </a>
                                    </td>
                                    <td>@item.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.RequestingUser</td>
                                    <td>@item.Department</td>
                                    <td>@item.IncidentType</td>
                                    <td><span class="badge rounded-pill @PriorityClass(item.Priority)">@PriorityLabel(item.Priority)</span></td>
                                    <td><span class="badge rounded-pill @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.AssignedTechnician) ? "Sin asignar" : item.AssignedTechnician)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No hay tickets para los filtros seleccionados.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function createOrReplaceChart(canvas, config) {
                if (!canvas) return null;
                if (canvas._chartInstance) {
                    canvas._chartInstance.destroy();
                }
                canvas._chartInstance = new Chart(canvas, config);
                return canvas._chartInstance;
            }

            const monthLabels = @Html.Raw(JsonSerializer.Serialize(monthLabels));
            const currentYearSeries = @Html.Raw(JsonSerializer.Serialize(currentYearSeries));
            const previousYearSeries = @Html.Raw(JsonSerializer.Serialize(previousYearSeries));
            const statusLabels = @Html.Raw(JsonSerializer.Serialize(statusLabels));
            const statusValues = @Html.Raw(JsonSerializer.Serialize(statusValues));
            const typeLabels = @Html.Raw(JsonSerializer.Serialize(typeTopLabels));
            const typeValues = @Html.Raw(JsonSerializer.Serialize(typeTopValues));

            const trendCtx = document.getElementById("monthlyTrendChart");
            if (trendCtx) {
                createOrReplaceChart(trendCtx, {
                    type: "line",
                    data: {
                        labels: monthLabels,
                        datasets: [
                            {
                                label: "@Model.CurrentYear",
                                data: currentYearSeries,
                                borderColor: "#dc2626",
                                backgroundColor: "rgba(220, 38, 38, 0.12)",
                                fill: true,
                                tension: 0.3
                            },
                            {
                                label: "@(Model.CurrentYear - 1)",
                                data: previousYearSeries,
                                borderColor: "#0f172a",
                                backgroundColor: "rgba(15, 23, 42, 0.08)",
                                fill: false,
                                tension: 0.3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        resizeDelay: 120,
                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });
            }

            const statusCtx = document.getElementById("statusDistributionChart");
            if (statusCtx) {
                createOrReplaceChart(statusCtx, {
                    type: "doughnut",
                    data: {
                        labels: statusLabels,
                        datasets: [
                            {
                                data: statusValues,
                                backgroundColor: ["#2563eb", "#f59e0b", "#16a34a", "#6b7280"],
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        resizeDelay: 120,
                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        }
                    }
                });
            }

            const typeCtx = document.getElementById("incidentTypeChart");
            if (typeCtx) {
                createOrReplaceChart(typeCtx, {
                    type: "bar",
                    data: {
                        labels: typeLabels,
                        datasets: [
                            {
                                label: "Tickets",
                                data: typeValues,
                                backgroundColor: "rgba(15, 23, 42, 0.85)",
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        indexAxis: "y",
                        responsive: true,
                        maintainAspectRatio: false,
                        resizeDelay: 120,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
