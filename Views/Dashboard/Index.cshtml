@model ITServiceDeskApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Ejecutivo";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-1">Dashboard Ejecutivo</h2>
    <p class="text-muted mb-4">
        Resumen general del sistema de gestión de incidencias
    </p>

    <!-- ================= KPI PRINCIPALES ================= -->
    <div class="row g-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Incidencias Abiertas</small>
                        <h3 class="fw-bold text-primary">@Model.OpenTickets</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded">
                        <i class="bi bi-folder2-open text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Incidencias Cerradas</small>
                        <h3 class="fw-bold text-success">@Model.ClosedTickets</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">En Proceso</small>
                        <h3 class="fw-bold text-warning">@Model.InProgressTickets</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Vencidas (SLA)</small>
                        <h3 class="fw-bold text-danger">@Model.OverdueTickets</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded">
                        <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <!-- ================= DISTRIBUCIONES ================= -->
    <div class="row g-4">

        <!-- POR SITIO -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Incidencias por Sitio</h6>

                    @foreach (var item in Model.TicketsBySite)
                    {
                        var percentage = Model.TotalTickets > 0
                            ? (item.Value * 100 / Model.TotalTickets)
                            : 0;

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <small>@item.Key</small>
                                <small>@item.Value</small>
                            </div>

                            <div class="progress" style="height:8px;">
                                <div class="progress-bar bg-primary"
                                     style="width:@percentage%">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- POR ÁREA -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Incidencias por Área</h6>

                    @foreach (var item in Model.TicketsByDepartment)
                    {
                        var percentage = Model.TotalTickets > 0
                            ? (item.Value * 100 / Model.TotalTickets)
                            : 0;

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <small>@item.Key</small>
                                <small>@item.Value</small>
                            </div>

                            <div class="progress" style="height:8px;">
                                <div class="progress-bar bg-success"
                                     style="width:@percentage%">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- POR TIPO -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Incidencias por Tipo</h6>

                    @foreach (var item in Model.TicketsByType)
                    {
                        var percentage = Model.TotalTickets > 0
                            ? (item.Value * 100 / Model.TotalTickets)
                            : 0;

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <small>@item.Key</small>
                                <small>@item.Value</small>
                            </div>

                            <div class="progress" style="height:8px;">
                                <div class="progress-bar bg-warning"
                                     style="width:@percentage%">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <!-- ================= INDICADOR SLA ================= -->
    <div class="card shadow-sm mb-5">
        <div class="card-body">
            <h6 class="fw-bold mb-4">Indicador KPI - SLA</h6>

            <div class="mb-3">
                <small class="fw-semibold text-success">
                    SLA Cumplido (@Model.SlaCompliant)
                </small>
                <div class="progress" style="height:8px;">
                    <div class="progress-bar bg-success"
                         style="width:@Model.SlaCompliantPercentage%">
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <small class="fw-semibold text-warning">
                    Próximo a Vencer (@Model.SlaNearDue)
                </small>
                <div class="progress" style="height:8px;">
                    <div class="progress-bar bg-warning"
                         style="width:@Model.SlaNearDuePercentage%">
                    </div>
                </div>
            </div>

            <div>
                <small class="fw-semibold text-danger">
                    SLA Vencido (@Model.SlaBreached)
                </small>
                <div class="progress" style="height:8px;">
                    <div class="progress-bar bg-danger"
                         style="width:@Model.SlaBreachedPercentage%">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= ÚLTIMOS TICKETS ================= -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            Últimos Tickets Creados
        </div>
        <div class="card-body p-0">

            @if (Model.RecentTickets.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket</th>
                            <th>Usuario</th>
                            <th>Área</th>
                            <th>Tipo</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Técnico</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentTickets)
                        {
                            <tr>
                                <td class="fw-bold">@item.TicketNumber</td>
                                <td>@item.RequestingUser</td>
                                <td>@item.Department</td>
                                <td>@item.IncidentType</td>
                                <td>@item.Priority</td>
                                <td>@item.Status</td>
                                <td>@item.AssignedTechnician</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 text-muted">
                    No hay tickets recientes.
                </div>
            }

        </div>
    </div>

</div>