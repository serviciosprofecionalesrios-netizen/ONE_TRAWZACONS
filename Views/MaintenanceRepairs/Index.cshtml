@model ITServiceDeskApp.ViewModels.Inventory.PublishedRepairsViewModel
@using ITServiceDeskApp.Models
@{
    ViewData["Title"] = "Reparaciones";
    var systemRepairs = ViewBag.SystemRepairs as IReadOnlyList<Ticket> ?? Array.Empty<Ticket>();
    var canEditRepairs = User.IsInRole(nameof(UserRole.Administrator)) ||
                         User.IsInRole(nameof(UserRole.CoordinadorIT)) ||
                         User.IsInRole(nameof(UserRole.Technician));
    var externalOverrides = ViewBag.ExternalRepairOverrides as IReadOnlyDictionary<string, MaintenanceExternalRepair>
        ?? new Dictionary<string, MaintenanceExternalRepair>();
}
<link rel="stylesheet" href="~/css/inventory-workspace.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/maintenance-repairs.css" asp-append-version="true" />
<div class="container-fluid inventory-workspace repairs-workspace">
    <header class="inventory-heading module-banner">

        <div><div class="inventory-eyebrow">MANTENIMIENTO</div><h2 class=""><i class="bi bi-tools" aria-hidden="true"></i><span>Reparaciones</span></h2><p>Seguimiento de equipos, trabajos de taller y entregas.</p></div>
        <div class="inventory-total"><strong>@(Model.Source.Table?.Rows.Count.ToString("N0") ?? "—")</strong><span>reparaciones registradas</span></div>
    </header>
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div><div class="inventory-eyebrow">ÓRDENES DEL SISTEMA</div><h3 class="mb-0">Órdenes creadas desde Alta de reparaciones</h3></div>
            <span class="badge text-bg-primary">@systemRepairs.Count orden(es)</span>
        </div>
        @if (systemRepairs.Count == 0)
        {
            <div class="inventory-empty"><h3>No hay órdenes registradas</h3><p>Las órdenes creadas desde el formulario aparecerán aquí.</p></div>
        }
        else
        {
            <div class="repair-list">
            @foreach (var repair in systemRepairs)
            {
                var delivered = repair.Status == TicketStatus.Closed && !string.IsNullOrWhiteSpace(repair.ExitOrderPath);
                var label = delivered ? "Entregado" : repair.MaintenanceStage ?? repair.Status.ToString();
                var style = delivered ? "delivered" : repair.Status == TicketStatus.Resolved ? "completed" : "pending";
                <article class="repair-card">
                    <header class="repair-card-header"><div><span class="inventory-code">@repair.TicketNumber</span><h3><i class="bi bi-truck" aria-hidden="true"></i> @(repair.UnitCode ?? "Equipo sin código")</h3></div><span class="repair-badge @style">@label</span></header>
                    <dl class="inventory-facts"><div><dt>Mecánico asignado</dt><dd>@(repair.AssignedTechnician ?? "Sin asignar")</dd></div><div><dt>Entrada</dt><dd>@repair.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy")</dd></div><div><dt>Sitio</dt><dd>@repair.Site</dd></div><div><dt>Estado</dt><dd>@repair.Status</dd></div></dl>
                    <div class="repair-problem"><h4>Problema reportado</h4><p>@repair.Description</p></div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        @if (canEditRepairs)
                        {
                            <a class="btn btn-primary btn-sm" asp-controller="Tickets" asp-action="Edit" asp-route-id="@repair.Id"><i class="bi bi-pencil-square"></i> Editar y cambiar estado</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(repair.ExitOrderPath))
                        {
                            <a class="btn btn-outline-success btn-sm" href="@repair.ExitOrderPath" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Documento de entrega</a>
                        }
                        else
                        {
                            <span class="text-muted small align-self-center">Falta PDF de entrega para marcar como Entregado.</span>
                        }
                    </div>
                </article>
            }
            </div>
        }
    </section>
    <hr class="my-4" />
    <h3 class="mb-3">Historial de reparaciones publicado</h3>
    @if (TempData["ExternalRepairMessage"] is string externalRepairMessage)
    {
        <div class="alert alert-success">@externalRepairMessage</div>
    }
    @if (Model.Source.Warning != null)
    {
        <div class="alert alert-warning" role="alert">No fue posible actualizar la información. @(Model.Source.Table != null ? "Se muestra la última consulta disponible." : "Intenta nuevamente en un momento.")</div>
    }
    @if (Model.Source.Table != null)
    {
        <nav class="repair-states" aria-label="Estado de las reparaciones">
            <a class="repair-state @(Model.Status == "" ? "selected" : "")" asp-action="Index" asp-route-q="@Model.Query"><span>Todas</span><strong>@Model.Source.Table.Rows.Count</strong></a>
            @foreach (var state in Model.StatusCounts)
            {
                <a class="repair-state @(Model.Status.Equals(state.Key, StringComparison.OrdinalIgnoreCase) ? "selected" : "")" asp-action="Index" asp-route-status="@state.Key" asp-route-q="@Model.Query"><span>@state.Key</span><strong>@state.Value</strong></a>
            }
        </nav>
        <form method="get" class="inventory-search" role="search">
            <input type="hidden" name="status" value="@Model.Status" />
            <label class="visually-hidden" for="repairs-query">Buscar reparaciones</label>
            <input class="form-control" id="repairs-query" name="q" maxlength="200" value="@Model.Query" placeholder="Buscar folio, equipo, mecánico, problema o cliente…" />
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" title="Desde" aria-label="Fecha desde" /><input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" title="Hasta" aria-label="Fecha hasta" />
            <button class="btn btn-primary">Buscar</button>
            @if (Model.Query.Length > 0 || Model.Status.Length > 0) { <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a> }
        </form>
        <div class="inventory-results"><span>@Model.TotalRows resultados</span><span>Página @Model.Page de @Model.TotalPages</span></div>
        <div class="repair-list">
        @foreach (var row in Model.Rows)
        {
            var repairNumber = Model.Value(row, "N° Gestion");
            externalOverrides.TryGetValue(repairNumber, out var localOverride);
            var state = localOverride?.Status ?? ITServiceDeskApp.ViewModels.Inventory.PublishedRepairsViewModel.State(Model.Source.Table, row);
            var stateStyle = state.Equals("Entregado", StringComparison.OrdinalIgnoreCase) ? "delivered" : state.Equals("Terminado", StringComparison.OrdinalIgnoreCase) ? "completed" : state.Equals("Pendiente", StringComparison.OrdinalIgnoreCase) ? "pending" : "unknown";
            <article class="repair-card">
                <header class="repair-card-header"><div><span class="inventory-code">@Model.Value(row, "N° Gestion")</span><h3><i class="bi bi-truck" aria-hidden="true"></i> @Model.Value(row, "Codigo de Equipo")</h3></div><span class="repair-badge @stateStyle">@state</span></header>
                <dl class="inventory-facts"><div><dt>Mecánico asignado</dt><dd>@Model.Value(row, "Mecanico Asignado")</dd></div><div><dt>Entrada</dt><dd>@Model.Value(row, "Fecha de entrada")</dd></div><div><dt>Salida</dt><dd>@Model.Value(row, "Fecha de salida")</dd></div><div><dt>Sitio</dt><dd>@Model.Value(row, "Sitio")</dd></div></dl>
                <div class="repair-problem"><h4>Problema reportado</h4><p>@Model.Value(row, "Descripción del problema")</p></div>
                <details><summary>Ver diagnóstico y trabajo realizado</summary>
                    <div class="repair-detail-grid"><section><h4>Diagnóstico</h4><p>@Model.Value(row, "Diagnóstico")</p></section><section><h4>Trabajo realizado</h4><p>@Model.Value(row, "Descripción del trabajo realizado")</p></section><section><h4>Elemento</h4><p>@Model.Value(row, "Elemento")</p></section></div>
                    <dl class="inventory-facts"><div><dt>Cliente</dt><dd>@Model.Value(row, "Cliente")</dd></div><div><dt>Responsable</dt><dd>@Model.Value(row, "Responsable")</dd></div><div><dt>Kilometraje de entrada</dt><dd>@Model.Value(row, "Km Entrada")</dd></div><div><dt>Kilometraje de salida</dt><dd>@Model.Value(row, "Km Salida")</dd></div></dl>
                </details>
                <div class="d-flex gap-2 flex-wrap mt-3">
                    @if (canEditRepairs)
                    {
                        <a class="btn btn-primary btn-sm" asp-action="EditExternal" asp-route-repairNumber="@repairNumber"><i class="bi bi-pencil-square"></i> Editar reparación</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(localOverride?.DeliveryDocumentPath))
                    {
                        <a class="btn btn-outline-success btn-sm" href="@localOverride.DeliveryDocumentPath" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Documento de entrega</a>
                    }
                </div>
            </article>
        }
        </div>
        @if (Model.TotalRows == 0) { <div class="inventory-empty"><h3>No se encontraron reparaciones</h3><p>Prueba con otro filtro o término de búsqueda.</p></div> }
        <nav class="d-flex justify-content-between my-4" aria-label="Páginas de reparaciones"><span>Página @Model.Page de @Model.TotalPages</span><div class="d-flex gap-2">
            @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page - 1)">Anterior</a> }
            @if (Model.Page < Model.TotalPages) { <a class="btn btn-primary" asp-action="Index" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page + 1)">Siguiente</a> }
        </div></nav>
    }
</div>
