@model List<ITServiceDeskApp.Models.FinanceCounterparty>

@{
    ViewData["Title"] = "Contrapartes";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Contrapartes</h2>
            <div class="text-muted">Catalogo de proveedores, clientes y beneficiarios.</div>
        </div>
        <a asp-action="CounterpartyCreate" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nueva</a>
    </div>
    @if (TempData["TicketsMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success">@msg</div>
    }
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Nombre</th><th>Tipo</th><th>RUC / ID</th><th>Telefono</th><th>Correo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Type</td>
                        <td>@item.TaxId</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end"><a asp-action="CounterpartyEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
