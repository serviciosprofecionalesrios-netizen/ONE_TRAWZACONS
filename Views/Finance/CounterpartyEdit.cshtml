@model ITServiceDeskApp.ViewModels.Finance.FinanceCounterpartyEditViewModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar Contraparte" : "Nueva Contraparte";
}

<div class="container mt-4" style="max-width:900px;">
    <h3>@ViewData["Title"]</h3>
    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="CounterpartyEdit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-8"><label asp-for="Name" class="form-label fw-semibold"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="Type" class="form-label fw-semibold"></label><select asp-for="Type" class="form-select"><option>Proveedor</option><option>Cliente</option><option>Colaborador</option><option>Otro</option></select></div>
                    <div class="col-md-4"><label asp-for="TaxId" class="form-label fw-semibold"></label><input asp-for="TaxId" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Phone" class="form-label fw-semibold"></label><input asp-for="Phone" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Address" class="form-label fw-semibold"></label><textarea asp-for="Address" class="form-control" rows="3"></textarea></div>
                    <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Counterparties" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
