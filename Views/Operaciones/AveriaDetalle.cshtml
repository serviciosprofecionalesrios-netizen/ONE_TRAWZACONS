@model ITServiceDeskApp.Models.OperationalBreakdown
@using System.Text.Json
@{ViewData["Title"]="Detalle de avería";}
<link rel="stylesheet" href="~/css/averias.css" asp-append-version="true"/>
@if(TempData["AveriasOk"] is string message){<div class="alert alert-success">@message</div>}
<header class="averias-hero mb-4"><div><small>OPERACIONES · AVERÍA #@Model.Id</small><h2><i class="bi bi-tools me-2"></i>@Model.Equipment</h2><p class="mb-0">@Model.EventAt.ToString("dd/MM/yyyy HH:mm") · @Model.Status</p></div><a class="btn btn-light" asp-action="Averias">Volver a Averías</a></header>
<section class="card card-body"><dl class="row"><dt class="col-sm-3">Conductor</dt><dd class="col-sm-9">@Model.Driver</dd><dt class="col-sm-3">Circuito</dt><dd class="col-sm-9">@Model.Circuit</dd><dt class="col-sm-3">Estatus del equipo</dt><dd class="col-sm-9">@Model.EquipmentStatus</dd><dt class="col-sm-3">Daños registrados</dt><dd class="col-sm-9"><ul class="mb-0">@foreach (var damage in Model.GetDamages()) { <li>@damage.Target · @damage.Category · @damage.Element</li> }</ul></dd><dt class="col-sm-3">Técnicos asignados</dt><dd class="col-sm-9">@(ViewData["BreakdownTechnicians"] is string { Length: > 0 } names ? names : "Sin asignar")</dd><dt class="col-sm-3">En reparación</dt><dd class="col-sm-9">@Model.RepairSummary</dd><dt class="col-sm-3">Observación</dt><dd class="col-sm-9" style="white-space:pre-wrap">@Model.Observation</dd><dt class="col-sm-3">Fin del evento</dt><dd class="col-sm-9">@(Model.EndAt?.ToString("dd/MM/yyyy HH:mm") ?? "Sin cierre registrado")</dd><dt class="col-sm-3">Registrado por</dt><dd class="col-sm-9">@Model.RegisteredBy</dd></dl>
@if(ITServiceDeskApp.Services.OperationalBreakdownClosure.CanClose(User) && ITServiceDeskApp.Services.MaintenanceBreakdownBoard.IsOperationallyOpen(Model)){<a class="btn btn-success align-self-start mb-3" asp-controller="MaintenanceBreakdowns" asp-action="Close" asp-route-id="@Model.Id">Gestionar reparación o cerrar avería</a>}
@if(Model.SourceJson!=null){var fields=JsonSerializer.Deserialize<Dictionary<string,string>>(Model.SourceJson) ?? []; <details><summary class="fw-bold">Ver todos los datos originales de Google Sheets</summary><dl class="row mt-3">@foreach(var item in fields){<dt class="col-sm-3">@item.Key</dt><dd class="col-sm-9" style="overflow-wrap:anywhere">@item.Value</dd>}</dl></details>}
</section>
