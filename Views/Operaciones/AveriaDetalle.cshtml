@model ITServiceDeskApp.Models.OperationalBreakdown
@using System.Text.Json
@{ViewData["Title"]="Detalle de avería";}
<link rel="stylesheet" href="~/css/averias.css" asp-append-version="true"/>
@if(TempData["AveriasOk"] is string message){<div class="alert alert-success">@message</div>}
<header class="averias-hero mb-4"><div><small>OPERACIONES · AVERÍA #@Model.Id</small><h2><i class="bi bi-tools me-2"></i>@Model.Equipment</h2><p class="mb-0">@Model.EventAt.ToString("dd/MM/yyyy HH:mm") · @Model.Status</p></div><a class="btn btn-light" asp-action="Averias">Volver a Averías</a></header>
<section class="card card-body"><dl class="row"><dt class="col-sm-3">Conductor</dt><dd class="col-sm-9">@Model.Driver</dd><dt class="col-sm-3">Circuito</dt><dd class="col-sm-9">@Model.Circuit</dd><dt class="col-sm-3">Estatus del equipo</dt><dd class="col-sm-9">@Model.EquipmentStatus</dd><dt class="col-sm-3">Categoría de daño</dt><dd class="col-sm-9">@Model.Category</dd><dt class="col-sm-3">Elemento de daño</dt><dd class="col-sm-9">@Model.Element</dd><dt class="col-sm-3">Daño en</dt><dd class="col-sm-9">@Model.DamageTarget</dd><dt class="col-sm-3">Observación</dt><dd class="col-sm-9" style="white-space:pre-wrap">@Model.Observation</dd><dt class="col-sm-3">Fin del evento</dt><dd class="col-sm-9">@(Model.EndAt?.ToString("dd/MM/yyyy HH:mm") ?? "Sin cierre registrado")</dd><dt class="col-sm-3">Registrado por</dt><dd class="col-sm-9">@Model.RegisteredBy</dd></dl>
@if(Model.SourceJson!=null){var fields=JsonSerializer.Deserialize<Dictionary<string,string>>(Model.SourceJson) ?? []; <details><summary class="fw-bold">Ver todos los datos originales de Google Sheets</summary><dl class="row mt-3">@foreach(var item in fields){<dt class="col-sm-3">@item.Key</dt><dd class="col-sm-9" style="overflow-wrap:anywhere">@item.Value</dd>}</dl></details>}
</section>
