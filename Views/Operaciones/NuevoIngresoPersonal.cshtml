@{
    ViewData["Title"] = "Nuevo ingreso de personal";
}

<style>
    .card .btn-primary {
        background-color: #0f3d8c;
        border-color: #0f3d8c;
    }

    .card .btn-primary:hover,
    .card .btn-primary:focus {
        background-color: #0b2f6d;
        border-color: #0b2f6d;
    }

    .card .btn-outline-primary {
        color: #0f3d8c;
        border-color: #0f3d8c;
    }

    .card .btn-outline-primary:hover,
    .card .btn-outline-primary:focus {
        color: #ffffff;
        background-color: #0f3d8c;
        border-color: #0f3d8c;
    }

    .card .form-label .text-danger {
        color: #0f3d8c !important;
    }

    .ingreso-insight-card {
        border: 1px solid #dbe3ef;
        border-radius: 0.85rem;
        background: #f8fafc;
        padding: 0.9rem;
        height: 100%;
    }

    .ingreso-insight-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1f3555;
        margin-bottom: 0.5rem;
    }

    .checklist-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.45rem;
    }

    .checklist-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #dbe3ef;
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        font-size: 0.85rem;
        background: #ffffff;
    }

    .checklist-item strong {
        font-size: 0.8rem;
    }

    .checklist-item.done {
        border-color: #86efac;
        background: #ecfdf3;
    }

    .checklist-item.pending {
        border-color: #fecaca;
        background: #fff5f5;
    }

    .timeline-compact {
        max-height: 200px;
        overflow: auto;
        display: grid;
        gap: 0.45rem;
    }

    .timeline-row {
        border: 1px solid #dbe3ef;
        border-radius: 0.65rem;
        background: #fff;
        padding: 0.45rem 0.6rem;
        font-size: 0.82rem;
    }

    .timeline-row-date {
        color: #64748b;
        font-size: 0.76rem;
    }

    .sla-mini-progress {
        height: 10px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .sla-mini-bar {
        height: 100%;
        border-radius: 999px;
        transition: width .25s ease;
    }

    .sla-badge {
        font-size: 0.74rem;
        font-weight: 700;
        padding: 0.3rem 0.55rem;
        border-radius: 999px;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .sla-badge.success {
        color: #0f5132;
        background: #dcfce7;
        border-color: #86efac;
    }

    .sla-badge.warning {
        color: #92400e;
        background: #fef3c7;
        border-color: #fcd34d;
    }

    .sla-badge.danger {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fca5a5;
    }

    .solicitudes-sla-col {
        min-width: 165px;
    }

    .sla-dashboard-grid {
        display: grid;
        gap: 0.65rem;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    }

    .sla-kpi-card {
        border: 1px solid #dbe3ef;
        border-radius: 0.8rem;
        background: #f8fafc;
        padding: 0.6rem 0.75rem;
    }

    .sla-kpi-label {
        font-size: 0.76rem;
        color: #64748b;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 700;
    }

    .sla-kpi-value {
        font-size: 1.3rem;
        line-height: 1;
        font-weight: 800;
        color: #1f2937;
    }

    .sla-kpi-value.success {
        color: #15803d;
    }

    .sla-kpi-value.warning {
        color: #b45309;
    }

    .sla-kpi-value.danger {
        color: #b91c1c;
    }

    .sla-tipo-grid {
        display: grid;
        gap: 0.65rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .sla-tipo-card {
        border: 1px solid #dbe3ef;
        border-radius: 0.8rem;
        background: #ffffff;
        padding: 0.6rem 0.75rem;
    }

    .sla-tipo-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #1f3555;
        margin-bottom: 0.45rem;
    }

    .sla-tipo-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.76rem;
        color: #475569;
        margin-bottom: 0.35rem;
    }

    .sla-tipo-pill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .sla-tipo-pill {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.45rem;
        border-radius: 999px;
        border: 1px solid transparent;
    }

    .sla-tipo-pill.success {
        color: #0f5132;
        background: #dcfce7;
        border-color: #86efac;
    }

    .sla-tipo-pill.warning {
        color: #92400e;
        background: #fef3c7;
        border-color: #fcd34d;
    }

    .sla-tipo-pill.danger {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fca5a5;
    }
</style>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="fw-bold mb-2">Nuevo ingreso de personal</h2>
        <p class="text-muted mb-4">Captura de solicitud con el mismo formato operativo.</p>

        @if (TempData["NuevoIngresoPersonalOk"] is string okMessage)
        {
            <div class="alert alert-success">@okMessage</div>
        }
        @if (TempData["NuevoIngresoPersonalError"] is string errorMessage)
        {
            <div class="alert alert-warning">@errorMessage</div>
        }

        <div class="mb-4">
            <label class="form-label fw-semibold d-block mb-2">Selecciona el tipo de solicitud</label>
            <div class="d-flex flex-wrap gap-2" id="tipoIngresoButtons">
                <button type="button" class="btn btn-outline-primary js-tipo-ingreso" data-tipo="1. Solicitud Ingreso">1. Solicitud Ingreso</button>
                <button type="button" class="btn btn-outline-primary js-tipo-ingreso" data-tipo="1.1 Clinica">1.1 Clinica</button>
                <button type="button" class="btn btn-outline-primary js-tipo-ingreso" data-tipo="1.2 RRHH">1.2 RRHH</button>
                <button type="button" class="btn btn-outline-primary js-tipo-ingreso" data-tipo="1.3 H&amp;S">1.3 H&amp;S</button>
                <button type="button" class="btn btn-outline-primary js-tipo-ingreso" data-tipo="1.4 Viaje de Reconocimiento">1.4 Viaje de Reconocimiento</button>
            </div>
            <div class="form-text mt-2">El formulario se habilita al seleccionar uno de los filtros.</div>
        </div>

        <form id="formNuevoIngresoPersonal" class="d-none" asp-controller="Operaciones" asp-action="NuevoIngresoPersonal" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="solicitud_id" id="solicitudIdInput" />
            <input type="hidden" name="tipo" id="tipoSeleccionadoInput" required />

            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnMenuPrincipalIngreso">
                    <i class="bi bi-house-door me-1"></i>
                    Menu principal
                </button>
            </div>

            <div class="row g-3 mb-2">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Tipo seleccionado</label>
                    <input type="text" id="tipoSeleccionadoLabel" class="form-control" readonly />
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Asunto <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="asunto" required />
                    <div id="tareaPadreHint" class="form-text"></div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Descripcion</label>
                <textarea class="form-control" name="descripcion" rows="4"></textarea>
            </div>

            <div id="panelIngresoInsights" class="row g-3 mb-4 d-none">
                <div class="col-lg-4">
                    <div class="ingreso-insight-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="ingreso-insight-title mb-0">Checklist por etapa</div>
                            <span id="checklistSummaryBadge" class="badge text-bg-light border">0/0</span>
                        </div>
                        <ul id="checklistStageList" class="checklist-list">
                            <li class="text-muted small">Selecciona un tipo para iniciar.</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="ingreso-insight-card">
                        <div class="ingreso-insight-title">SLA operativo (48 h laborales)</div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span id="slaStatusBadgePreview" class="sla-badge success">
                                <span class="rounded-circle bg-success" style="width:8px;height:8px;display:inline-block;"></span>
                                Cumplido
                            </span>
                            <span id="slaDeadlinePreview" class="small text-muted">-</span>
                        </div>
                        <div id="slaRemainingPreview" class="small mb-2">Restan - h laborales.</div>
                        <div class="sla-mini-progress mb-2">
                            <div id="slaProgressBarPreview" class="sla-mini-bar" style="width:0%; background:#16a34a;"></div>
                        </div>
                        <div class="small text-muted">Horario: Lunes a Viernes, 07:30 a.m. - 05:00 p.m.</div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="ingreso-insight-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="ingreso-insight-title mb-0">Linea de tiempo</div>
                            <span id="timelineCountBadge" class="badge text-bg-light border">0 eventos</span>
                        </div>
                        <div id="ingresoTimelineCompact" class="timeline-compact">
                            <div class="text-muted small">Aun no hay eventos para mostrar.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="sectionNoClinica" class="row g-4">
                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h5 class="fw-bold mb-3">Datos del colaborador</h5>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">ID Empleado</label>
                                <input type="text" class="form-control" name="id_empleado" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Nombres y Apellidos <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="nombres_apellidos" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Numero INSS <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="numero_inss" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Genero <span class="text-danger">*</span></label>
                                <select class="form-select" name="genero" required>
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>Masculino</option>
                                    <option>Femenino</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Superintendencia <span class="text-danger">*</span></label>
                                <select class="form-select" name="superintendencia" required>
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>Operacion Mina</option>
                                    <option>Transporte</option>
                                    <option>Planta</option>
                                    <option>Mantenimiento</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Area <span class="text-danger">*</span></label>
                                <select class="form-select" name="area" required>
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>Patio</option>
                                    <option>Bascula</option>
                                    <option>Logistica</option>
                                    <option>Operaciones</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Empresa <span class="text-danger">*</span></label>
                                <select class="form-select" name="empresa" required>
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>TRITON</option>
                                    <option>PAVON ASM</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ubicacion de Trabajo <span class="text-danger">*</span></label>
                                <select class="form-select" name="ubicacion_trabajo" required>
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>El Limon</option>
                                    <option>Pavon Norte</option>
                                    <option>Pavon ASM</option>
                                    <option>Tajo La Tigra</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cargo <span class="text-danger">*</span></label>
                                <select class="form-select" name="cargo" required>
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>Conductor</option>
                                    <option>Operador</option>
                                    <option>Supervisor</option>
                                    <option>Ayudante</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nombre Supervisor <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="nombre_supervisor" required />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h5 class="fw-bold mb-3">Control administrativo</h5>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Estado <span class="text-danger">*</span></label>
                                <select class="form-select" name="estado" required>
                                    <option>New</option>
                                    <option>En revision</option>
                                    <option>Aprobado</option>
                                    <option>Rechazado</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Prioridad <span class="text-danger">*</span></label>
                                <select class="form-select" name="prioridad" required>
                                    <option>Alta</option>
                                    <option>Media</option>
                                    <option>Baja</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Asignado a</label>
                                <input type="text" class="form-control" name="asignado_a" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Tarea padre</label>
                                <input type="text" class="form-control js-tarea-padre" name="tarea_padre" readonly required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fecha de inicio</label>
                                <input type="date" class="form-control" name="fecha_inicio" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fecha fin</label>
                                <input type="date" class="form-control" name="fecha_fin" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Tiempo estimado</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="tiempo_estimado" min="0" step="1" />
                                    <span class="input-group-text">Horas</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">% Realizado</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="porcentaje_realizado" min="0" max="100" value="0" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Reingreso a Equinox?</label>
                                <select class="form-select" name="reingreso_equinox">
                                    <option value="">--- Por favor seleccione ---</option>
                                    <option>Si</option>
                                    <option>No</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha de Baja</label>
                                <input type="date" class="form-control" name="fecha_baja" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contratista Anterior</label>
                                <input type="text" class="form-control" name="contratista_anterior" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">VB Contratista Ant.</label>
                                <input type="file" class="form-control" name="vb_contratista_anterior" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Foto tamano Carnet</label>
                                <input type="file" class="form-control" name="foto_tamano_carnet" accept=".jpg,.jpeg,.png,.pdf" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Constancia Judicial</label>
                                <input type="file" class="form-control" name="constancia_judicial" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Record Policial Ley 510</label>
                                <input type="file" class="form-control" name="record_policial_510" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha Vencimiento</label>
                                <input type="date" class="form-control" name="fecha_vencimiento" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Licencia de Conducir</label>
                                <input type="file" class="form-control" name="licencia_conducir_archivo" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Categorias de Licencia</label>
                                <div class="border rounded p-2 bg-light">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="1" id="cat1" name="categorias_licencia">
                                        <label class="form-check-label" for="cat1">1</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="2" id="cat2" name="categorias_licencia">
                                        <label class="form-check-label" for="cat2">2</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="3" id="cat3" name="categorias_licencia">
                                        <label class="form-check-label" for="cat3">3</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="4A" id="cat4a" name="categorias_licencia">
                                        <label class="form-check-label" for="cat4a">4A</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="4B" id="cat4b" name="categorias_licencia">
                                        <label class="form-check-label" for="cat4b">4B</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="5A" id="cat5a" name="categorias_licencia">
                                        <label class="form-check-label" for="cat5a">5A</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="5B" id="cat5b" name="categorias_licencia">
                                        <label class="form-check-label" for="cat5b">5B</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="6A" id="cat6a" name="categorias_licencia">
                                        <label class="form-check-label" for="cat6a">6A</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="6B" id="cat6b" name="categorias_licencia">
                                        <label class="form-check-label" for="cat6b">6B</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="7" id="cat7" name="categorias_licencia">
                                        <label class="form-check-label" for="cat7">7</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="8" id="cat8" name="categorias_licencia">
                                        <label class="form-check-label" for="cat8">8</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="sectionClinica" class="d-none">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h5 class="fw-bold mb-3">Clinica - Control de solicitud</h5>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Estado <span class="text-danger">*</span></label>
                                    <select class="form-select" name="estado" required>
                                        <option>New</option>
                                        <option>En revision</option>
                                        <option>Aprobado</option>
                                        <option>Rechazado</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Prioridad <span class="text-danger">*</span></label>
                                    <select class="form-select" name="prioridad" required>
                                        <option>Alta</option>
                                        <option>Media</option>
                                        <option>Baja</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Asignado a</label>
                                    <input type="text" class="form-control" name="asignado_a" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Tarea padre</label>
                                    <input type="text" class="form-control js-tarea-padre" name="tarea_padre" readonly required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Fecha de inicio</label>
                                    <input type="date" class="form-control" name="fecha_inicio" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Fecha fin</label>
                                    <input type="date" class="form-control" name="fecha_fin" />
