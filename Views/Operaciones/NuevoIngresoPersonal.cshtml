                            <th class="solicitudes-sla-col">SLA limite</th>
                            <th class="solicitudes-sla-col">Semaforo SLA</th>
                            <th class="solicitudes-sla-col">Restante</th>
                            <th>Actualizado</th>
                            <th style="width: 170px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="solicitudesIngresoBody">
                        <tr>
                            <td colspan="12" class="text-muted text-center py-3">Cargando solicitudes...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="historialTrazabilidadPanel" class="mt-4 border rounded p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold mb-0">Historial de trazabilidad</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRefreshHistory">
                    <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                </button>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <input type="text"
                           id="traceSearchInput"
                           class="form-control form-control-sm"
                           placeholder="Buscar por nombre del solicitante..." />
                </div>
                <div class="col-md-6">
                    <select id="traceTypeFilter" class="form-select form-select-sm">
                        <option value="">Todos los tipos</option>
                        <option value="1. Solicitud Ingreso">1. Solicitud Ingreso</option>
                        <option value="1.1 Clinica">1.1 Clinica</option>
                        <option value="1.2 RRHH">1.2 RRHH</option>
                        <option value="1.3 H&S">1.3 H&S</option>
                        <option value="1.4 Viaje de Reconocimiento">1.4 Viaje de Reconocimiento</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Solicitante</th>
                            <th>Tarea padre</th>
                            <th>Tipo origen</th>
                            <th>Ultimo tipo</th>
                            <th>Ultimo asunto</th>
                            <th>Creado</th>
                            <th>Actualizado</th>
                        </tr>
                    </thead>
                    <tbody id="traceHistoryBody">
                        <tr>
                            <td colspan="7" class="text-muted text-center py-3">Cargando historial...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const SLA_TOTAL_HOURS = 48;
            const SLA_NEAR_HOURS = 8;
            const WORK_START_MINUTES = 7 * 60 + 30;
            const WORK_END_MINUTES = 17 * 60;
            const buttons = document.querySelectorAll('.js-tipo-ingreso');
            const form = document.getElementById('formNuevoIngresoPersonal');
            const hiddenTipo = document.getElementById('tipoSeleccionadoInput');
            const labelTipo = document.getElementById('tipoSeleccionadoLabel');
            const sectionNoClinica = document.getElementById('sectionNoClinica');
            const sectionClinica = document.getElementById('sectionClinica');
            const sectionRrhh = document.getElementById('sectionRrhh');
            const sectionHs = document.getElementById('sectionHs');
            const sectionReconocimiento = document.getElementById('sectionReconocimiento');
            const asuntoInput = form ? form.querySelector('input[name="asunto"]') : null;
            const hint = document.getElementById('tareaPadreHint');
            const tareaPadreInputs = form ? form.querySelectorAll('.js-tarea-padre') : [];
            const resolveUrl = '@Url.Action("ResolveTareaPadreIngresoPersonal", "Operaciones")';
            const historyUrl = '@Url.Action("GetIngresoPersonalTraceHistory", "Operaciones")';
            const historyBody = document.getElementById('traceHistoryBody');
            const refreshHistoryBtn = document.getElementById('btnRefreshHistory');
            const btnMenuPrincipal = document.getElementById('btnMenuPrincipalIngreso');
            const historialPanel = document.getElementById('historialTrazabilidadPanel');
            const searchInput = document.getElementById('traceSearchInput');
            const typeFilter = document.getElementById('traceTypeFilter');
            const solicitudesUrl = '@Url.Action("GetIngresoPersonalRequests", "Operaciones")';
            const solicitudByIdTemplate = '@Url.Action("GetIngresoPersonalRequestById", "Operaciones", new { id = "__id__" })';
            const deleteSolicitudUrl = '@Url.Action("DeleteIngresoPersonalRequest", "Operaciones")';
            const solicitudesBody = document.getElementById('solicitudesIngresoBody');
            const btnRefreshSolicitudes = document.getElementById('btnRefreshSolicitudes');
            const solicitudIdInput = document.getElementById('solicitudIdInput');
            const btnGuardarSolicitud = document.getElementById('btnGuardarSolicitudIngresoPersonal');
            const btnCancelarEdicion = document.getElementById('btnCancelarEdicionSolicitud');
            const insightsPanel = document.getElementById('panelIngresoInsights');
            const checklistStageList = document.getElementById('checklistStageList');
            const checklistSummaryBadge = document.getElementById('checklistSummaryBadge');
            const slaStatusBadgePreview = document.getElementById('slaStatusBadgePreview');
            const slaDeadlinePreview = document.getElementById('slaDeadlinePreview');
            const slaRemainingPreview = document.getElementById('slaRemainingPreview');
            const slaProgressBarPreview = document.getElementById('slaProgressBarPreview');
            const timelineCompact = document.getElementById('ingresoTimelineCompact');
            const timelineCountBadge = document.getElementById('timelineCountBadge');
            const solicitudesSlaGlobalCards = document.getElementById('solicitudesSlaGlobalCards');
            const solicitudesSlaByTipo = document.getElementById('solicitudesSlaByTipo');
            let allHistoryRows = [];
            let allSolicitudesRows = [];
            let anchorCreatedAt = null;
            let anchorUpdatedAt = null;

            if (!buttons.length || !form || !hiddenTipo || !labelTipo || !asuntoInput) return;

            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function formatDate(date) {
                if (!(date instanceof Date) || Number.isNaN(date.getTime())) {
                    return '-';
                }

                return date.toLocaleString('es-NI', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                });
            }

            function toDate(dateValue) {
                const parsed = new Date(dateValue);
                return Number.isNaN(parsed.getTime()) ? null : parsed;
            }

            function parseDateInputValue(value) {
                if (!value || typeof value !== 'string') {
                    return null;
                }

                const iso = /^(\d{4})-(\d{2})-(\d{2})$/;
                const match = value.match(iso);
                if (!match) {
                    return null;
                }

                const year = Number(match[1]);
                const month = Number(match[2]) - 1;
                const day = Number(match[3]);
                return new Date(year, month, day, 7, 30, 0, 0);
            }

            function isBusinessDay(date) {
                const day = date.getDay();
                return day >= 1 && day <= 5;
            }

            function normalizeBusinessMoment(date) {
                if (!(date instanceof Date) || Number.isNaN(date.getTime())) {
                    return null;
                }

                const current = new Date(date.getTime());
                while (!isBusinessDay(current)) {
                    current.setDate(current.getDate() + 1);
                    current.setHours(7, 30, 0, 0);
                }

                const minutes = current.getHours() * 60 + current.getMinutes();
                if (minutes < WORK_START_MINUTES) {
                    current.setHours(7, 30, 0, 0);
                    return current;
                }

                if (minutes >= WORK_END_MINUTES) {
                    return nextBusinessStart(current);
                }

                return current;
            }

            function nextBusinessStart(date) {
                const current = new Date(date.getTime());
                current.setHours(0, 0, 0, 0);
                do {
                    current.setDate(current.getDate() + 1);
                } while (!isBusinessDay(current));

                current.setHours(7, 30, 0, 0);
                return current;
            }

            function addBusinessHours(start, hours) {
                let current = normalizeBusinessMoment(start);
                if (!current || !Number.isFinite(hours) || hours <= 0) {
                    return current;
                }

                let remaining = hours;
                while (remaining > 0) {
                    const endDay = new Date(current.getTime());
                    endDay.setHours(17, 0, 0, 0);
                    const available = (endDay.getTime() - current.getTime()) / 3600000;
                    if (available <= 0) {
                        current = nextBusinessStart(current);
                        continue;
                    }

                    const used = Math.min(remaining, available);
                    current = new Date(current.getTime() + used * 3600000);
                    remaining -= used;

                    if (remaining > 0) {
                        current = nextBusinessStart(current);
                    }
                }

                return current;
            }

            function businessHoursBetween(from, to) {
                if (!(from instanceof Date) || !(to instanceof Date)) {
                    return 0;
                }

                if (to <= from) {
                    return 0;
                }

                let total = 0;
                let cursor = new Date(from.getTime());
                while (cursor < to) {
                    if (!isBusinessDay(cursor)) {
                        cursor = nextBusinessStart(cursor);
                        continue;
                    }

                    const dayStart = new Date(cursor.getTime());
                    dayStart.setHours(7, 30, 0, 0);
                    const dayEnd = new Date(cursor.getTime());
                    dayEnd.setHours(17, 0, 0, 0);

                    if (cursor < dayStart) {
                        cursor = dayStart;
                    }

                    if (cursor >= dayEnd) {
                        cursor = nextBusinessStart(cursor);
                        continue;
                    }

                    const segmentEnd = to < dayEnd ? to : dayEnd;
                    if (segmentEnd > cursor) {
                        total += (segmentEnd.getTime() - cursor.getTime()) / 3600000;
                    }

                    cursor = segmentEnd;
                    if (cursor >= dayEnd) {
                        cursor = nextBusinessStart(cursor);
                    }
                }

                return total;
            }

            function isClosedStatus(status) {
                const raw = String(status ?? '').trim().toLowerCase();
                return raw === 'aprobado' || raw === 'rechazado' || raw === 'cerrado' || raw === 'finalizado';
            }

            function getSlaColor(statusClass) {
                if (statusClass === 'warning') return '#f59e0b';
                if (statusClass === 'danger') return '#ef4444';
                return '#16a34a';
            }

            function computeSlaSnapshot() {
                const status = (form.querySelector('[name="estado"]') || {}).value || '';
                const baseStart = anchorCreatedAt instanceof Date ? anchorCreatedAt : new Date();
                const deadline = addBusinessHours(baseStart, SLA_TOTAL_HOURS);
                const reference =
                    isClosedStatus(status) && anchorUpdatedAt instanceof Date
                        ? anchorUpdatedAt
                        : new Date();

                const consumedHours = Math.max(0, businessHoursBetween(baseStart, reference));
                const remainingHours = SLA_TOTAL_HOURS - consumedHours;
                const progress = Math.max(0, Math.min(100, (consumedHours / SLA_TOTAL_HOURS) * 100));

                let statusLabel = 'Cumplido';
                let statusClass = 'success';
                let remainingLabel = `Restan ${remainingHours.toFixed(1)} h laborales.`;

                if (remainingHours <= 0) {
                    statusLabel = 'Vencido';
                    statusClass = 'danger';
                    remainingLabel = `Vencido por ${Math.abs(remainingHours).toFixed(1)} h laborales.`;
                } else if (remainingHours <= SLA_NEAR_HOURS) {
                    statusLabel = 'Por vencer';
                    statusClass = 'warning';
                    remainingLabel = `Restan ${remainingHours.toFixed(1)} h laborales.`;
                }

                return {
                    deadline,
                    statusLabel,
                    statusClass,
                    remainingLabel,
                    progress
                };
            }

            function renderSlaBadge(statusLabel, statusClass) {
                const dotClass = statusClass === 'warning'
                    ? 'bg-warning'
                    : (statusClass === 'danger' ? 'bg-danger' : 'bg-success');
                return `<span class="sla-badge ${statusClass}"><span class="rounded-circle ${dotClass}" style="width:8px;height:8px;display:inline-block;"></span>${escapeHtml(statusLabel)}</span>`;
            }

            function renderSlaPreview() {
                if (!slaStatusBadgePreview || !slaDeadlinePreview || !slaRemainingPreview || !slaProgressBarPreview) {
                    return;
                }

                const sla = computeSlaSnapshot();
                slaStatusBadgePreview.className = `sla-badge ${sla.statusClass}`;
                slaStatusBadgePreview.innerHTML = `<span class="rounded-circle ${sla.statusClass === 'warning' ? 'bg-warning' : (sla.statusClass === 'danger' ? 'bg-danger' : 'bg-success')}" style="width:8px;height:8px;display:inline-block;"></span>${escapeHtml(sla.statusLabel)}`;
                slaDeadlinePreview.textContent = `Limite: ${formatDate(sla.deadline)}`;
                slaRemainingPreview.textContent = sla.remainingLabel;
                slaProgressBarPreview.style.width = `${sla.progress.toFixed(1)}%`;
                slaProgressBarPreview.style.background = getSlaColor(sla.statusClass);
            }

            function getField(name) {
                return form.querySelector(`[name="${name}"]`);
            }

            function hasValue(name) {
                const field = getField(name);
                if (!field || field.disabled) return false;

                if (field.type === 'checkbox') {
                    const checked = form.querySelectorAll(`[name="${name}"]:checked`);
                    return checked.length > 0;
                }

                const value = (field.value || '').trim();
                return value.length > 0;
            }

            function hasPositiveNumber(name) {
                const field = getField(name);
                if (!field || field.disabled) return false;
                const value = Number(field.value);
                return Number.isFinite(value) && value > 0;
            }

            function getChecklistDefinition() {
                const tipo = (hiddenTipo.value || '').trim();
                const isClinica = tipo.startsWith('1.1');
                const isRrhh = tipo.startsWith('1.2');
                const isHs = tipo.startsWith('1.3');
                const isReconocimiento = tipo.startsWith('1.4');

                const etapa2Special = isClinica
                    ? () => hasValue('estado') && hasValue('prioridad') && hasValue('asignado_a')
                    : isRrhh
                        ? () => hasValue('correo_personal') && hasValue('tipo_sangre') && hasValue('num_fam_cercano')
                        : isHs
                            ? () => hasValue('induccion_general_fecha') && hasValue('iper_fecha') && hasValue('sistema_5_puntos_fecha')
                            : isReconocimiento
                                ? () => hasValue('conductor_reconocimiento') && hasValue('conductor_instructor_1') && hasValue('equipo_1')
                                : () => hasValue('nombres_apellidos') && hasValue('numero_inss') && hasValue('empresa');

                return [
                    {
                        title: 'Registro base',
                        done: () => hasValue('tipo') && hasValue('asunto') && hasValue('tarea_padre')
                    },
                    {
                        title: 'Datos por etapa',
                        done: etapa2Special
                    },
                    {
                        title: 'Asignacion y plan',
                        done: () => hasValue('estado') && hasValue('prioridad') && hasPositiveNumber('tiempo_estimado')
                    },
                    {
                        title: 'Cierre',
                        done: () => isClosedStatus((getField('estado') || {}).value || '') || hasValue('fecha_fin') || Number((getField('porcentaje_realizado') || {}).value || 0) >= 100
                    }
                ];
            }

            function renderChecklist() {
                if (!checklistStageList || !checklistSummaryBadge) return;

                const stages = getChecklistDefinition();
                const rows = stages.map(stage => {
                    const done = stage.done();
                    return {
                        title: stage.title,
                        done
                    };
                });

                const doneCount = rows.filter(x => x.done).length;
                checklistSummaryBadge.textContent = `${doneCount}/${rows.length}`;
                checklistStageList.innerHTML = rows.map(row => `
                    <li class="checklist-item ${row.done ? 'done' : 'pending'}">
                        <strong>${escapeHtml(row.title)}</strong>
                        <span class="badge ${row.done ? 'text-bg-success' : 'text-bg-secondary'}">${row.done ? 'Completo' : 'Pendiente'}</span>
                    </li>
                `).join('');
            }

            function getDateInputLabel(input) {
                if (!(input instanceof HTMLElement)) return 'Fecha';
                const wrapper = input.closest('.col-md-4, .col-md-6, .col-md-8, .col-12');
                if (!wrapper) return input.name || 'Fecha';
                const label = wrapper.querySelector('label');
                return (label ? label.textContent : input.name || 'Fecha')?.trim() || 'Fecha';
            }

            function renderTimeline() {
                if (!timelineCompact || !timelineCountBadge) return;

                const events = [];
                const createdDate = anchorCreatedAt instanceof Date ? anchorCreatedAt : new Date();
                const updatedDate = anchorUpdatedAt instanceof Date ? anchorUpdatedAt : null;
                const sla = computeSlaSnapshot();

                events.push({
                    date: createdDate,
                    title: 'Solicitud registrada',
                    subtitle: 'Inicio de flujo'
                });

                events.push({
                    date: sla.deadline,
                    title: 'Limite SLA',
                    subtitle: '48 h laborales'
                });

                if (updatedDate) {
                    events.push({
                        date: updatedDate,
                        title: 'Ultima actualizacion',
                        subtitle: 'Bitacora de solicitud'
                    });
                }

                const dateInputs = form.querySelectorAll('input[type="date"]');
                dateInputs.forEach(input => {
                    if (!input || input.disabled || !input.value) return;
                    const eventDate = parseDateInputValue(input.value);
                    if (!eventDate) return;

                    events.push({
                        date: eventDate,
                        title: getDateInputLabel(input),
                        subtitle: 'Fecha capturada en formulario'
                    });
                });

                const ordered = events
                    .filter(x => x.date instanceof Date && !Number.isNaN(x.date.getTime()))
                    .sort((a, b) => a.date.getTime() - b.date.getTime());

                timelineCountBadge.textContent = `${ordered.length} evento${ordered.length === 1 ? '' : 's'}`;
                if (!ordered.length) {
                    timelineCompact.innerHTML = '<div class="text-muted small">Aun no hay eventos para mostrar.</div>';
                    return;
                }

                timelineCompact.innerHTML = ordered.map(eventItem => `
                    <div class="timeline-row">
                        <div class="timeline-row-date">${escapeHtml(formatDate(eventItem.date))}</div>
                        <div class="fw-semibold">${escapeHtml(eventItem.title)}</div>
                        <div class="text-muted">${escapeHtml(eventItem.subtitle || '')}</div>
                    </div>
                `).join('');
            }

            function refreshInsights() {
                if (insightsPanel && insightsPanel.classList.contains('d-none') && !form.classList.contains('d-none')) {
                    insightsPanel.classList.remove('d-none');
                }
                renderChecklist();
                renderSlaPreview();
                renderTimeline();
            }

            function renderSolicitudesSlaDashboard(rows) {
                if (!solicitudesSlaGlobalCards || !solicitudesSlaByTipo) {
                    return;
                }

                const items = Array.isArray(rows) ? rows : [];
                const total = items.length;
                const cumplidas = items.filter(r => (r.slaStatusClass || '').toLowerCase() === 'success').length;
                const porVencer = items.filter(r => (r.slaStatusClass || '').toLowerCase() === 'warning').length;
                const vencidas = items.filter(r => (r.slaStatusClass || '').toLowerCase() === 'danger').length;
                const cumplimientoPct = total > 0 ? Math.round((cumplidas / total) * 100) : 0;

                solicitudesSlaGlobalCards.innerHTML = `
                    <div class="sla-kpi-card">
                        <div class="sla-kpi-label">Solicitudes</div>
                        <div class="sla-kpi-value">${total}</div>
                    </div>
                    <div class="sla-kpi-card">
                        <div class="sla-kpi-label">Cumplidas</div>
                        <div class="sla-kpi-value success">${cumplidas}</div>
                    </div>
                    <div class="sla-kpi-card">
                        <div class="sla-kpi-label">Por vencer</div>
                        <div class="sla-kpi-value warning">${porVencer}</div>
                    </div>
                    <div class="sla-kpi-card">
                        <div class="sla-kpi-label">Vencidas</div>
                        <div class="sla-kpi-value danger">${vencidas}</div>
                    </div>
                    <div class="sla-kpi-card">
                        <div class="sla-kpi-label">% Cumplimiento</div>
                        <div class="sla-kpi-value">${cumplimientoPct}%</div>
                    </div>
                `;

                if (!total) {
                    solicitudesSlaByTipo.innerHTML = '<div class="text-muted small">Sin datos de solicitudes para calcular SLA por tipo.</div>';
                    return;
                }

                const grouped = new Map();
                items.forEach(item => {
                    const key = (item.tipo || 'Sin tipo').trim() || 'Sin tipo';
                    if (!grouped.has(key)) {
                        grouped.set(key, { total: 0, success: 0, warning: 0, danger: 0 });
                    }

                    const bucket = grouped.get(key);
                    bucket.total += 1;
                    const status = (item.slaStatusClass || '').toLowerCase();
                    if (status === 'danger') bucket.danger += 1;
                    else if (status === 'warning') bucket.warning += 1;
                    else bucket.success += 1;
                });

                const ordered = Array.from(grouped.entries())
                    .sort((a, b) => b[1].total - a[1].total || a[0].localeCompare(b[0], 'es'));

                solicitudesSlaByTipo.innerHTML = ordered.map(([tipo, data]) => {
                    const pct = data.total > 0 ? Math.round((data.success / data.total) * 100) : 0;
                    return `
                        <div class="sla-tipo-card">
                            <div class="sla-tipo-title">${escapeHtml(tipo)}</div>
                            <div class="sla-tipo-meta">
                                <span>Total: ${data.total}</span>
                                <strong>${pct}% cumplido</strong>
                            </div>
                            <div class="sla-tipo-pill-list">
                                <span class="sla-tipo-pill success">Cumplidas: ${data.success}</span>
                                <span class="sla-tipo-pill warning">Por vencer: ${data.warning}</span>
                                <span class="sla-tipo-pill danger">Vencidas: ${data.danger}</span>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            function setSectionState(section, enabled) {
                if (!section) return;

                section.classList.toggle('d-none', !enabled);
                section.querySelectorAll('input, select, textarea').forEach(field => {
                    if (enabled) {
                        field.disabled = false;
                        if (field.dataset.wasRequired === '1') {
                            field.required = true;
                        }
                    } else {
                        if (field.required) {
                            field.dataset.wasRequired = '1';
                            field.required = false;
                        }
                        field.disabled = true;
                    }
                });
            }

            function setTareaPadreValue(value) {
                tareaPadreInputs.forEach(input => {
                    input.value = value || '';
                });
                refreshInsights();
            }

            function setEditMode(enabled) {
                if (!solicitudIdInput || !btnGuardarSolicitud || !btnCancelarEdicion) return;

                if (enabled) {
                    btnGuardarSolicitud.innerHTML = '<i class="bi bi-save me-1"></i>Actualizar solicitud';
                    btnCancelarEdicion.classList.remove('d-none');
                } else {
                    solicitudIdInput.value = '';
                    btnGuardarSolicitud.innerHTML = '<i class="bi bi-save me-1"></i>Guardar solicitud';
                    btnCancelarEdicion.classList.add('d-none');
                }
            }

            function renderSolicitudes(rows) {
                if (!solicitudesBody) return;
                renderSolicitudesSlaDashboard(rows);

                if (!rows || !rows.length) {
                    solicitudesBody.innerHTML = '<tr><td colspan="12" class="text-muted text-center py-3">No hay solicitudes registradas.</td></tr>';
                    return;
                }

                solicitudesBody.innerHTML = rows.map(row => `
                    <tr>
                        <td>${row.id}</td>
                        <td>${row.tipo || ''}</td>
                        <td>${row.asunto || ''}</td>
                        <td>${row.solicitante || ''}</td>
                        <td><span class="badge text-bg-light border">${row.tareaPadre || ''}</span></td>
                        <td>${row.estado || ''}</td>
                        <td>${row.prioridad || ''}</td>
                        <td>${row.slaDeadline || '-'}</td>
                        <td>${renderSlaBadge(row.slaStatus || 'Cumplido', row.slaStatusClass || 'success')}</td>
                        <td>
                            <div>${escapeHtml(row.slaRemainingLabel || '-')}</div>
                            <div class="sla-mini-progress mt-1">
                                <div class="sla-mini-bar" style="width:${Math.max(0, Math.min(100, Number(row.slaProgress || 0))).toFixed(1)}%; background:${getSlaColor(row.slaStatusClass || 'success')};"></div>
                            </div>
                        </td>
                        <td>${row.updatedAt || ''}</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary js-edit-solicitud" data-id="${row.id}">Editar</button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-delete-solicitud" data-id="${row.id}">Eliminar</button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            }

            async function loadSolicitudes() {
                if (!solicitudesBody) return;
                try {
                    const response = await fetch(`${solicitudesUrl}?take=100`, { method: 'GET' });
                    if (!response.ok) throw new Error('Requests error');
                    const result = await response.json();
                    allSolicitudesRows = (result && result.rows) ? result.rows : [];
                    renderSolicitudes(allSolicitudesRows);
                } catch {
                    solicitudesBody.innerHTML = '<tr><td colspan="12" class="text-danger text-center py-3">No se pudo cargar el listado.</td></tr>';
                    renderSolicitudesSlaDashboard([]);
                }
            }

            function resetFormValuesForEdit() {
                form.querySelectorAll('input, select, textarea').forEach(field => {
                    if (field.name === '__RequestVerificationToken' || field.name === 'solicitud_id' || field.name === 'tipo') {
                        return;
                    }

                    if (field.type === 'file') {
                        return;
                    }

                    if (field.type === 'checkbox' || field.type === 'radio') {
                        field.checked = false;
                        return;
                    }

                    field.value = '';
                });
            }

            function applyPayload(payload) {
                if (!payload) return;

                Object.entries(payload).forEach(([name, values]) => {
                    if (!name || name === '__RequestVerificationToken' || name === 'solicitud_id') {
                        return;
                    }

                    const fields = form.querySelectorAll(`[name="${name}"]`);
                    if (!fields.length) {
                        return;
                    }

                    const valueArray = Array.isArray(values) ? values : [values];

                    fields.forEach(field => {
                        if (field.type === 'file') {
                            return;
                        }

                        if (field.type === 'checkbox' || field.type === 'radio') {
                            field.checked = valueArray.includes(field.value);
                            return;
                        }

                        field.value = valueArray.length ? (valueArray[0] ?? '') : '';
                    });
                });
            }

            async function editSolicitud(id) {
                if (!id || !Number.isInteger(id)) {
                    return;
                }

                try {
                    const url = solicitudByIdTemplate.replace('__id__', String(id));
                    const response = await fetch(url, { method: 'GET' });
                    if (!response.ok) throw new Error('Detail error');
                    const result = await response.json();
                    if (!result || !result.success || !result.detail) {
                        alert((result && result.message) ? result.message : 'No se encontró el detalle de la solicitud.');
                        return;
                    }

                    const detail = result.detail;
                    const button = Array.from(buttons).find(btn => (btn.getAttribute('data-tipo') || '') === (detail.tipo || ''));
                    if (button) {
                        selectTipo(button, false);
                    } else {
                        form.classList.remove('d-none');
                    }

                    resetFormValuesForEdit();
                    applyPayload(detail.payload);

                    if (solicitudIdInput) {
                        solicitudIdInput.value = String(detail.id || '');
                    }

                    if (detail.tareaPadre) {
                        setTareaPadreValue(detail.tareaPadre);
                    }

                    anchorCreatedAt = toDate(detail.createdAtIso) || new Date();
                    anchorUpdatedAt = toDate(detail.updatedAtIso);
                    setEditMode(true);
                    refreshInsights();
                    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } catch {
                    alert('No se pudo cargar la solicitud para editar.');
                }
            }

            async function deleteSolicitud(id) {
                if (!id || !Number.isInteger(id)) {
                    return;
                }

                if (!confirm('¿Deseas eliminar esta solicitud? Esta accion no se puede deshacer.')) {
                    return;
                }

                try {
                    const tokenField = form.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenField ? tokenField.value : '';
                    const body = new URLSearchParams();
                    body.append('id', String(id));
                    body.append('__RequestVerificationToken', token);

                    const response = await fetch(deleteSolicitudUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: body.toString()
                    });

                    if (!response.ok) throw new Error('Delete error');
                    const result = await response.json();
                    if (!result || !result.success) {
                        alert((result && result.message) ? result.message : 'No se pudo eliminar la solicitud.');
                        return;
                    }

                    if (solicitudIdInput && Number(solicitudIdInput.value) === id) {
                        backToMenuPrincipal();
                    }

                    loadSolicitudes();
                } catch {
                    alert('No se pudo eliminar la solicitud en este momento.');
                }
            }

            function renderHistory(rows) {
                if (!historyBody) return;

                if (!rows || !rows.length) {
                    historyBody.innerHTML = '<tr><td colspan="7" class="text-muted text-center py-3">Sin registros de trazabilidad.</td></tr>';
                    return;
                }

                historyBody.innerHTML = rows.map(row => `
                    <tr>
                        <td>${row.solicitante || ''}</td>
                        <td><span class="badge text-bg-light border">${row.tareaPadre || ''}</span></td>
                        <td>${row.tipoOrigen || ''}</td>
                        <td>${row.ultimoTipo || ''}</td>
                        <td>${row.ultimoAsunto || ''}</td>
                        <td>${row.createdAt || ''}</td>
                        <td>${row.updatedAt || ''}</td>
                    </tr>
                `).join('');
            }

            function applyHistoryFilters() {
                const query = ((searchInput && searchInput.value) ? searchInput.value : '').trim().toLowerCase();
                const type = ((typeFilter && typeFilter.value) ? typeFilter.value : '').trim();

                const filtered = allHistoryRows.filter(row => {
                    const byName = !query || ((row.solicitante || '').toLowerCase().includes(query));
                    const byType = !type || row.tipoOrigen === type || row.ultimoTipo === type;
                    return byName && byType;
                });

                renderHistory(filtered);
            }

            async function loadHistory() {
                if (!historyBody) return;
                try {
                    const response = await fetch(`${historyUrl}?take=20`, { method: 'GET' });
                    if (!response.ok) throw new Error('History error');
                    const result = await response.json();
                    allHistoryRows = (result && result.rows) ? result.rows : [];
                    applyHistoryFilters();
                } catch {
                    historyBody.innerHTML = '<tr><td colspan="7" class="text-danger text-center py-3">No se pudo cargar el historial.</td></tr>';
                }
            }

            async function resolveTareaPadre() {
                const tipo = (hiddenTipo.value || '').trim();
                const asunto = (asuntoInput.value || '').trim();

                if (!tipo || !asunto) {
                    setTareaPadreValue('');
                    if (hint) hint.textContent = '';
                    return;
                }

                try {
                    const query = `?tipo=${encodeURIComponent(tipo)}&asunto=${encodeURIComponent(asunto)}`;
                    const response = await fetch(`${resolveUrl}${query}`, { method: 'GET' });
                    if (!response.ok) {
                        throw new Error('Resolve error');
                    }

                    const result = await response.json();
                    if (result && result.success) {
                        setTareaPadreValue(result.tareaPadre || '');
                        if (hint) {
                            hint.textContent = result.message || '';
                            hint.classList.remove('text-danger');
                            hint.classList.add('text-success');
                        }
                        loadHistory();
                    } else {
                        setTareaPadreValue('');
                        if (hint) {
                            hint.textContent = (result && result.message) ? result.message : 'No fue posible generar la tarea padre.';
                            hint.classList.remove('text-success');
                            hint.classList.add('text-danger');
                        }
                    }
                } catch {
                    setTareaPadreValue('');
                    if (hint) {
                        hint.textContent = 'No se pudo validar la trazabilidad en este momento.';
                        hint.classList.remove('text-success');
                        hint.classList.add('text-danger');
                    }
                }
            }

            function selectTipo(button, autoResolve = true) {
                buttons.forEach(btn => {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                });

                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-primary');

                const tipo = button.getAttribute('data-tipo') || '';
                const isClinica = tipo.indexOf('1.1') === 0;
                const isRrhh = tipo.indexOf('1.2') === 0;
                const isHs = tipo.indexOf('1.3') === 0;
                const isReconocimiento = tipo.indexOf('1.4') === 0;

                hiddenTipo.value = tipo;
                labelTipo.value = tipo;
                form.classList.remove('d-none');

                setSectionState(sectionClinica, isClinica);
                setSectionState(sectionRrhh, isRrhh);
                setSectionState(sectionHs, isHs);
                setSectionState(sectionReconocimiento, isReconocimiento);
                setSectionState(sectionNoClinica, !isClinica && !isRrhh && !isHs && !isReconocimiento);

                if (autoResolve && (asuntoInput.value || '').trim()) {
                    resolveTareaPadre();
                } else {
                    setTareaPadreValue('');
                    if (hint) hint.textContent = '';
                }

                anchorCreatedAt = new Date();
                anchorUpdatedAt = null;
                if (insightsPanel) {
                    insightsPanel.classList.remove('d-none');
                }
                refreshInsights();
            }

            function backToMenuPrincipal() {
                buttons.forEach(btn => {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                });

                hiddenTipo.value = '';
                labelTipo.value = '';
                setTareaPadreValue('');
                setEditMode(false);
                if (hint) {
                    hint.textContent = '';
                    hint.classList.remove('text-success', 'text-danger');
                }

                setSectionState(sectionNoClinica, false);
                setSectionState(sectionClinica, false);
                setSectionState(sectionRrhh, false);
                setSectionState(sectionHs, false);
                setSectionState(sectionReconocimiento, false);
                form.classList.add('d-none');
                if (insightsPanel) {
                    insightsPanel.classList.add('d-none');
                }
                anchorCreatedAt = null;
                anchorUpdatedAt = null;

                if (historialPanel) {
                    historialPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }

            setSectionState(sectionNoClinica, false);
            setSectionState(sectionClinica, false);
            setSectionState(sectionRrhh, false);
            setSectionState(sectionHs, false);
            setSectionState(sectionReconocimiento, false);

            buttons.forEach(button => {
                button.addEventListener('click', function () {
                    selectTipo(this);
                });
            });

            asuntoInput.addEventListener('change', resolveTareaPadre);
            asuntoInput.addEventListener('blur', resolveTareaPadre);

            if (refreshHistoryBtn) {
                refreshHistoryBtn.addEventListener('click', loadHistory);
            }

            if (btnMenuPrincipal) {
                btnMenuPrincipal.addEventListener('click', backToMenuPrincipal);
            }

            if (btnCancelarEdicion) {
                btnCancelarEdicion.addEventListener('click', backToMenuPrincipal);
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyHistoryFilters);
            }

            if (typeFilter) {
                typeFilter.addEventListener('change', applyHistoryFilters);
            }

            if (btnRefreshSolicitudes) {
                btnRefreshSolicitudes.addEventListener('click', loadSolicitudes);
            }

            if (solicitudesBody) {
                solicitudesBody.addEventListener('click', function (event) {
                    const target = event.target;
                    if (!(target instanceof HTMLElement)) {
                        return;
                    }

                    const editButton = target.closest('.js-edit-solicitud');
                    if (editButton instanceof HTMLElement) {
                        const id = Number(editButton.getAttribute('data-id'));
                        editSolicitud(id);
                        return;
                    }

                    const deleteButton = target.closest('.js-delete-solicitud');
                    if (deleteButton instanceof HTMLElement) {
                        const id = Number(deleteButton.getAttribute('data-id'));
                        deleteSolicitud(id);
                    }
                });
            }

            form.addEventListener('input', refreshInsights);
            form.addEventListener('change', refreshInsights);

            loadHistory();
            loadSolicitudes();
        })();
    </script>
}
