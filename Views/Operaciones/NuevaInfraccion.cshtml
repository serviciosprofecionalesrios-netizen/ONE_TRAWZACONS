<link rel="stylesheet" href="~/css/driver-score-icons.css" asp-append-version="true" />
@model ITServiceDeskApp.ViewModels.Operaciones.DriverScoreEventCreateViewModel
@{ ViewData["Title"] = "Nueva infracción"; }
<style>.infraction-form{max-width:1050px}.infraction-hero{background:linear-gradient(130deg,#7f1d1d,#dc2626);color:#fff;border-radius:16px;padding:1.5rem}.form-section{border-left:4px solid #2563eb}</style>
<div class="container py-4 infraction-form driver-score-ui"><div class="infraction-hero module-banner mb-4"><h2 class="fw-bold mb-1"><i class="bi bi-exclamation-octagon-fill me-2"></i>Nueva infracción</h2><p class="mb-0">Registra el evento, la unidad y las acciones de seguimiento.</p></div>@if(!string.IsNullOrWhiteSpace(Model.Driver) && !string.IsNullOrWhiteSpace(Model.Vehicle)){<div class="alert alert-primary"><i class="bi bi-truck me-2"></i>Infracción para <strong>@Model.Driver</strong> · Unidad <strong>@Model.Vehicle</strong>. Revisa estos datos antes de registrar.</div>}<div class="card p-3 mb-3"><div class="d-flex justify-content-between mb-2"><strong>Paso 1 · Registro</strong><span>Paso 2 · Seguimiento y cierre</span></div><div id="driverScoreFormProgress" class="progress" role="progressbar" aria-label="Avance del formulario" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:0%"></div></div><small id="driverScoreProgressLabel" class="mt-2">Paso 1 pendiente</small><div id="driverScoreMissingFields" class="alert alert-warning mt-2 mb-0" role="alert" aria-live="polite" hidden></div></div><form id="driverScoreCreateForm" asp-action="NuevaInfraccion" enctype="multipart/form-data" method="post" class="card shadow-sm border-0"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="EventAt" class="form-label fw-bold"></label><input asp-for="EventAt" type="datetime-local" class="form-control"/><span asp-validation-for="EventAt" class="text-danger"></span></div><div class="col-md-6"><label asp-for="EventType" class="form-label fw-bold"></label><select asp-for="EventType" class="form-select"><option value="">Selecciona una infracción</option>@foreach(var item in Model.EventTypes){<option value="@item">@item</option>}</select><span asp-validation-for="EventType" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Driver" class="form-label fw-bold"></label><input asp-for="Driver" class="form-control" list="driverList" placeholder="Selecciona o escribe el conductor"/><datalist id="driverList">@foreach(var item in Model.Drivers){<option value="@item"/>}</datalist><span asp-validation-for="Driver" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Vehicle" class="form-label fw-bold"></label><input asp-for="Vehicle" class="form-control" list="vehicleList" placeholder="Ej. W-0001"/><datalist id="vehicleList">@foreach(var item in Model.Vehicles){<option value="@item"/>}</datalist><span asp-validation-for="Vehicle" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Group" class="form-label"></label><input asp-for="Group" class="form-control" placeholder="Ej. TRAWZACONS PROPIO"/></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" required class="form-control" placeholder="Ej. 12.201884, -85.285695"/><span asp-validation-for="Location" class="text-danger"></span></div><div class="col-12"><label asp-for="Observation" class="form-label"></label><textarea asp-for="Observation" class="form-control" rows="4" placeholder="Describe brevemente lo ocurrido y la acción requerida."></textarea></div><div class="col-md-6"><div class="p-3 border rounded"><div class="fw-bold"><i class="bi bi-clock me-1"></i>Gestionado a tiempo · automático</div><div class="small text-muted">Se calcula al guardar: hasta 10 minutos después del evento, A TIEMPO; después, FUERA DE TIEMPO. Hora de Nicaragua.</div></div></div><div class="col-md-6"><div class="form-check form-switch p-3 border rounded"><input asp-for="CoachingCompleted" class="form-check-input"/><label asp-for="CoachingCompleted" class="form-check-label fw-bold"></label><div class="small text-muted">Marca al completar el coaching al conductor.</div></div></div></div></div><section class="p-4 border-top bg-light">
<h3 class="h5 fw-bold"><i class="bi bi-clipboard-check me-2"></i>Paso 1 · Asignación del seguimiento</h3>
<p class="small text-muted">Selecciona sitio y responsable. Al registrar, el paso 1 queda bloqueado y el responsable podrá completar el paso 2.</p>
@await Html.PartialAsync("~/Views/Operaciones/_DriverScoreAssignment.cshtml", new ITServiceDeskApp.ViewModels.Operaciones.DriverScoreAssignmentFields("Site", "Responsible", Model.Site, Model.Responsible, "new"))
<fieldset disabled><legend class="h6 mt-3">Paso 2 · Pendiente del responsable asignado</legend><div class="row g-3 mt-1">
<div class="col-md-4"><label asp-for="Status" class="form-label">Estado</label><select asp-for="Status" class="form-select"><option>Pendiente</option><option>En seguimiento</option><option>Cerrado</option></select></div>
<div class="col-md-8"><label asp-for="ClosureEvidence" class="form-label">Evidencia de cierre</label><input asp-for="ClosureEvidence" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg"/></div>
<div class="col-12"><label asp-for="CaseNotes" class="form-label">Acciones y observaciones</label><textarea asp-for="CaseNotes" class="form-control" rows="3" maxlength="1000"></textarea><span asp-validation-for="CaseNotes" class="text-danger"></span></div>
</div></fieldset></section><div class="card-footer bg-white d-flex justify-content-end gap-2 p-3"><a class="btn btn-outline-secondary" asp-action="DriverScore">Cancelar</a><button class="btn btn-danger px-4"><i class="bi bi-check2-circle me-1"></i>Registrar infracción</button></div><div id="coachingEvidencePanel" class="p-4" hidden><label class="form-label fw-bold" for="CoachingEvidence">Evidencia del coaching</label><input type="file" name="CoachingEvidence" id="CoachingEvidence" class="form-control" accept=".pdf,.png,.jpg,.jpeg"/><small>PDF o imagen, máximo 10 MB.</small></div></form></div>
<script>const coaching=document.getElementById("CoachingCompleted");const panel=document.getElementById("coachingEvidencePanel");function toggleEvidence(){panel.hidden=!coaching.checked;}coaching.addEventListener("change",toggleEvidence);toggleEvidence();</script>
<script src="~/js/driver-score-assignment.js" asp-append-version="true"></script>

<script src="~/js/driver-score-form-progress.js" asp-append-version="true"></script>
