@model ITServiceDeskApp.ViewModels.Operaciones.DriverScoreViewModel
@using System.Globalization
@using System.Text.Json
@{ ViewData["Title"] = "Driver score"; var maxHeat = Math.Max(1, Model.HeatMap.Max(x => x.Count)); var drivers = Model.HeatMap.Select(x => x.Driver).Distinct().ToList(); var types = Model.HeatMap.Select(x => x.EventType).Distinct().ToList(); var mapJson = JsonSerializer.Serialize(Model.MapPoints); string StatusStyle(string status) => status.Contains("óptima", StringComparison.OrdinalIgnoreCase) || status.Contains("optima", StringComparison.OrdinalIgnoreCase) ? "score-status optimal" : status.Contains("latente", StringComparison.OrdinalIgnoreCase) ? "score-status latent" : "score-status critical"; string StatusIcon(string status) => status.Contains("óptima", StringComparison.OrdinalIgnoreCase) || status.Contains("optima", StringComparison.OrdinalIgnoreCase) ? "bi-check-circle-fill" : status.Contains("latente", StringComparison.OrdinalIgnoreCase) ? "bi-exclamation-triangle-fill" : "bi-stop-circle-fill"; }
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<style>
.score-hero{background:linear-gradient(130deg,#0f2f67,#2563eb);color:#fff;border-radius:16px;padding:1.5rem}.score-kpi{border:0;border-radius:14px;box-shadow:0 .2rem .8rem #1e3a8a18}.score-kpi .value{font-size:2rem;font-weight:800}.heat{min-width:700px}.heat td,.heat th{text-align:center;vertical-align:middle}.heat .label{text-align:left;max-width:220px}.heat-cell{min-width:48px;font-weight:700;color:#0f172a}.heat-0{background:#f1f5f9}.heat-1{background:#dbeafe}.heat-2{background:#93c5fd}.heat-3{background:#60a5fa}.heat-4{background:#2563eb;color:#fff}.heat-5{background:#172554;color:#fff}.rank{font-weight:700;color:#1d4ed8}.score-status{display:inline-flex;align-items:center;gap:.35rem;border-radius:999px;padding:.25rem .55rem;font-size:.78rem;font-weight:700;white-space:nowrap}.score-status.optimal{background:#dcfce7;color:#166534}.score-status.latent{background:#fef3c7;color:#92400e}.score-status.critical{background:#fee2e2;color:#b91c1c}.driver-geo-map{height:430px;border-radius:0 0 .5rem .5rem}.map-legend{display:flex;gap:1rem;flex-wrap:wrap;font-size:.84rem}.map-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:.3rem}.map-dot.low{background:#facc15}.map-dot.high{background:#dc2626}
</style>
<div class="container-fluid py-4">
 <div class="score-hero mb-4 d-flex justify-content-between align-items-center"><div><h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i>Driver score</h2><p class="mb-0">Seguimiento de conductores, infracciones y comportamiento de seguridad.</p></div><a class="btn btn-light" asp-action="DriverScore" asp-route-refresh="true"><i class="bi bi-arrow-clockwise me-1"></i>Actualizar datos</a></div>
 @if (!string.IsNullOrWhiteSpace(Model.Warning)){<div class="alert alert-warning">@Model.Warning</div>}
 <form method="get" class="card shadow-sm border-0 mb-4"><div class="card-body row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Desde</label><input class="form-control" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"/></div><div class="col-md-3"><label class="form-label">Hasta</label><input class="form-control" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"/></div><div class="col-md-4"><label class="form-label">Conductor</label><select class="form-select" name="driver"><option value="">Todos los conductores</option>@foreach(var item in Model.Drivers){<option value="@item" selected="@(Model.SelectedDriver == item)">@item</option>}</select></div><div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1">Aplicar</button><a class="btn btn-outline-secondary" asp-action="DriverScore">Limpiar</a></div></div></form>
 <div class="row g-3 mb-4"><div class="col-md-3"><div class="card score-kpi h-100"><div class="card-body"><small class="text-muted">Infracciones</small><div class="value text-danger">@Model.TotalEvents</div></div></div></div><div class="col-md-3"><div class="card score-kpi h-100"><div class="card-body"><small class="text-muted">Conductores involucrados</small><div class="value text-primary">@Model.DriversWithEvents</div></div></div></div><div class="col-md-3"><div class="card score-kpi h-100"><div class="card-body"><small class="text-muted">Gestionadas a tiempo</small><div class="value text-success">@Model.TimelyManaged</div></div></div></div><div class="col-md-3"><div class="card score-kpi h-100"><div class="card-body"><small class="text-muted">Coaching realizado</small><div class="value text-info">@Model.CoachingCompleted</div></div></div></div></div>
 <div class="card shadow-sm mb-4"><div class="card-header d-flex justify-content-between align-items-center"><strong><i class="bi bi-geo-alt-fill text-danger me-2"></i>Mapa geográfico de calor</strong><div class="map-legend"><span><i class="map-dot low"></i>Menor concentración</span><span><i class="map-dot high"></i>Mayor concentración</span></div></div>@if(Model.MapPoints.Any()){<div id="driverGeoHeatmap" class="driver-geo-map"></div>}else{<div class="card-body text-muted text-center py-5">No hay coordenadas geográficas disponibles para los filtros seleccionados.</div>}</div>
 <div class="row g-4 mb-4"><div class="col-lg-8"><div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-grid-3x3-gap-fill text-danger me-2"></i>Matriz de eventos por conductor</div><div class="card-body table-responsive"><table class="table table-bordered heat mb-0"><thead><tr><th class="label">Conductor</th>@foreach(var type in types){<th title="@type">@(type.Length > 18 ? type[..18] + "…" : type)</th>}</tr></thead><tbody>@foreach(var name in drivers){<tr><th class="label">@name</th>@foreach(var type in types){var cell=Model.HeatMap.First(x=>x.Driver==name && x.EventType==type);<td class="heat-cell heat-@cell.Level" title="@type: @cell.Count">@(cell.Count == 0 ? "—" : cell.Count)</td>}</tr>}</tbody></table></div></div></div><div class="col-lg-4"><div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-trophy-fill text-warning me-2"></i>Mayor número de eventos</div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>#</th><th>Conductor</th><th>Eventos</th><th>Coaching</th></tr></thead><tbody>@for(var i=0;i<Model.Rankings.Count;i++){var r=Model.Rankings[i];<tr><td class="rank">@(i+1)</td><td>@r.Driver<br/><small class="text-muted">@r.Vehicle</small></td><td>@r.Events</td><td>@r.Coaching</td></tr>}</tbody></table></div></div></div></div></div>
 <div class="row g-4"><div class="col-lg-5"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Resumen por conductor</div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Conductor</th><th>Equipo</th><th>Km</th><th>Eventos</th><th>Estado</th></tr></thead><tbody>@foreach(var item in Model.Scorecards){<tr><td>@item.Driver</td><td>@item.Vehicle</td><td>@item.Kilometers.ToString("N0")</td><td>@item.Events.ToString("N0")</td><td><span class="@StatusStyle(item.Status)"><i class="bi @StatusIcon(item.Status)"></i>@item.Status</span></td></tr>}</tbody></table></div></div></div><div class="col-lg-7"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Infracciones recientes</div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Fecha</th><th>Conductor</th><th>Evento</th><th>Unidad</th><th>Gestión</th></tr></thead><tbody>@foreach(var item in Model.Events){<tr><td>@item.Date?.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Driver</td><td>@item.EventType</td><td>@item.Vehicle</td><td><span class="badge @(item.Timely?"text-bg-success":"text-bg-warning")">@(item.Timely?"A tiempo":"Pendiente")</span></td></tr>}@if(!Model.Events.Any()){<tr><td colspan="5" class="text-center text-muted py-4">No hay infracciones para el filtro seleccionado.</td></tr>}</tbody></table></div></div></div></div>
 <div class="small text-muted mt-3">Fuente: Driver Score 2026 · Última consulta: @(Model.RetrievedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "sin datos")</div>
</div>
@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script><script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>
<script>
(() => { const element = document.getElementById('driverGeoHeatmap'); if (!element || !window.L) return; const points = @Html.Raw(mapJson); if (!points.length) return; const map = L.map(element, { scrollWheelZoom: false }).setView([12.25, -85.9], 7); L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap' }).addTo(map); const heat = points.map(p => [p.Latitude, p.Longitude, 0.55]); if (L.heatLayer) L.heatLayer(heat, { radius: 28, blur: 20, maxZoom: 12, gradient: { .25: '#facc15', .55: '#f97316', .8: '#dc2626' } }).addTo(map); const bounds = []; points.forEach(p => { const marker = L.circleMarker([p.Latitude, p.Longitude], { radius: 5, color: '#991b1b', fillColor: '#ef4444', fillOpacity: .8, weight: 1 }).addTo(map); marker.bindPopup(`<strong>${p.Driver}</strong><br>${p.EventType}<br>Unidad: ${p.Vehicle || '—'}<br>${p.Date ? new Date(p.Date).toLocaleString('es-NI') : ''}`); bounds.push([p.Latitude, p.Longitude]); }); if (bounds.length) map.fitBounds(bounds, { padding: [24, 24], maxZoom: 13 }); })();
</script>
}
