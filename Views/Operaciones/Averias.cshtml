@model ITServiceDeskApp.ViewModels.Operaciones.BreakdownListViewModel
@using ITServiceDeskApp.Services
@{ ViewData["Title"]="Averías"; var pages=Math.Max(1,(Model.Total+49)/50); }
<link rel="stylesheet" href="~/css/averias.css" asp-append-version="true"/>
<header class="averias-hero mb-4"><div><small>OPERACIONES · DISPONIBILIDAD DE FLOTA</small><h2><i class="bi bi-tools me-2"></i>Averías</h2><p class="mb-0">Bitácora de daños y eventos de los equipos · Circuito Limón.</p></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-light" href="@OperationalBreakdownCatalog.SourceUrl" target="_blank" rel="noopener">Ver bitácora original</a>@if(Model.CanManage){<a class="btn btn-warning" asp-action="NuevaAveria"><i class="bi bi-plus-circle me-1"></i>Nueva avería</a>}</div></header>
<div class="alert alert-info">Histórico importado de Google Sheets: 1,607 registros con equipo y fecha, corte del 29/10/2026. Los nuevos registros se guardan en este sistema.</div>
<form method="get" class="card card-body mb-3"><div class="d-flex flex-wrap gap-2 align-items-end"><div class="flex-grow-1"><label for="search" class="form-label">Buscar por equipo, conductor, categoría o elemento</label><input id="search" name="search" value="@Model.Search" class="form-control" maxlength="200"/></div><button class="btn btn-primary">Buscar</button><a class="btn btn-outline-secondary" asp-action="Averias">Limpiar</a></div></form>
<section class="card"><div class="card-header fw-bold">@Model.Total.ToString("N0") registros · Página @Model.Page de @pages</div><div class="table-responsive" style="max-height:65vh"><table class="table table-hover align-middle averias-table mb-0"><thead><tr><th>Fecha del evento</th><th>Equipo / conductor</th><th>Circuito</th><th>Estatus equipo</th><th>Categoría</th><th>Elemento de daño</th><th>Daño en</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var row in Model.Records){<tr><td class="text-nowrap">@row.EventAt.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@row.Equipment</strong><div class="small text-muted">@row.Driver</div></td><td>@row.Circuit</td><td>@row.EquipmentStatus</td><td>@row.Category</td><td>@row.Element</td><td>@row.DamageTarget</td><td>@row.Status</td><td><a class="btn btn-sm btn-outline-primary" asp-action="AveriaDetalle" asp-route-id="@row.Id">Detalle</a></td></tr>}
@if(Model.Records.Count==0){<tr><td colspan="9" class="text-center p-4">No se encontraron averías.</td></tr>}
</tbody></table></div><div class="card-footer d-flex justify-content-between"><a class="btn btn-outline-primary @(Model.Page==1?"disabled":"")" asp-action="Averias" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)">Anterior</a><span>@Model.Page / @pages</span><a class="btn btn-outline-primary @(Model.Page==pages?"disabled":"")" asp-action="Averias" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)">Siguiente</a></div></section>
