@section Scripts {
    <script src="~/js/operaciones-seguimiento-toneladas-enhanced.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var carreteraWrap = document.getElementById("varado-carretera-wrap");
            var tallerPctWrap = document.getElementById("varado-taller-pct-wrap");
            var tallerPsbWrap = document.getElementById("varado-taller-psb-wrap");
            var tallerPozWrap = document.getElementById("varado-taller-poz-wrap");
            var tallerWrapByZone = {
                pct: tallerPctWrap,
                psb: tallerPsbWrap,
                poz: tallerPozWrap
            };
            var tallerWraps = [tallerPctWrap, tallerPsbWrap, tallerPozWrap].filter(function (wrap) { return !!wrap; });
            var carreteraCount = document.getElementById("varado-carretera-count");
            var tallerCount = document.getElementById("varado-taller-count");
            var tallerCountByZone = {
                pct: document.getElementById("varado-taller-pct-count"),
                psb: document.getElementById("varado-taller-psb-count"),
                poz: document.getElementById("varado-taller-poz-count")
            };
            var carreteraEmpty = document.getElementById("varado-carretera-empty");
            var tallerEmptyByZone = {
                pct: document.getElementById("varado-taller-pct-empty"),
                psb: document.getElementById("varado-taller-psb-empty"),
                poz: document.getElementById("varado-taller-poz-empty")
            };
            var descargadosCell = document.getElementById("equipos-descargados-cell");
            var rutaCell = document.getElementById("equipos-ruta-cell");
            var descargadosCount = document.getElementById("equipos-descargados-count");
            var rutaCount = document.getElementById("equipos-ruta-count");

            function configureChipDropdowns() {
                if (!window.bootstrap || !bootstrap.Dropdown) {
                    return;
                }

                document.querySelectorAll(".equipo-chip-dropdown [data-bs-toggle='dropdown']").forEach(function (toggle) {
                    bootstrap.Dropdown.getOrCreateInstance(toggle, {
                        boundary: "viewport",
                        offset: [0, 8],
                        popperConfig: function (defaultConfig) {
                            var baseConfig = defaultConfig || {};
                            var baseModifiers = Array.isArray(baseConfig.modifiers)
                                ? baseConfig.modifiers.filter(function (modifier) {
                                    return modifier &&
                                        modifier.name !== "preventOverflow" &&
                                        modifier.name !== "flip" &&
                                        modifier.name !== "offset";
                                })
                                : [];

                            baseModifiers.push(
                                {
                                    name: "offset",
                                    options: { offset: [0, 8] }
                                },
                                {
                                    name: "preventOverflow",
                                    options: { boundary: "viewport", padding: 8 }
                                },
                                {
                                    name: "flip",
                                    options: {
                                        fallbackPlacements: ["top-start", "bottom-start", "top-end", "bottom-end"]
                                    }
                                });

                            return Object.assign({}, baseConfig, {
                                strategy: "fixed",
                                modifiers: baseModifiers
                            });
                        }
                    });
                });
            }

            configureChipDropdowns();

            if (!carreteraWrap || tallerWraps.length === 0) {
                return;
            }

            var origenWrapPorChip = new WeakMap();

            function countChips(container) {
                return container ? container.querySelectorAll(".equipo-chip-dropdown").length : 0;
            }

            function isChipEnVarado(chipContainer) {
                var wrap = chipContainer ? chipContainer.closest(".equipos-chip-wrap") : null;
                if (!wrap) {
                    return false;
                }

                return wrap === carreteraWrap || wrap.classList.contains("varado-taller-wrap");
            }

            function resolveTallerZoneFromChip(chipContainer) {
                var rawText = chipContainer ? chipContainer.textContent || "" : "";
                var normalizedText = rawText.toUpperCase();

                if (normalizedText.indexOf("PSB") !== -1) {
                    return "psb";
                }

                if (normalizedText.indexOf("POZ") !== -1) {
                    return "poz";
                }

                if (normalizedText.indexOf("PCT") !== -1) {
                    return "pct";
                }

                return "pct";
            }

            function resolveTallerWrapForStatus(status, chipContainer) {
                if (status === "taller-pct") {
                    return tallerWrapByZone.pct;
                }

                if (status === "taller-psb") {
                    return tallerWrapByZone.psb;
                }

                if (status === "taller-poz") {
                    return tallerWrapByZone.poz;
                }

                if (status === "taller") {
                    var inferredZone = resolveTallerZoneFromChip(chipContainer);
                    return tallerWrapByZone[inferredZone] || tallerWrapByZone.pct;
                }

                return null;
            }

            function toggleActivoOption(chipContainer) {
                var activoBtn = chipContainer ? chipContainer.querySelector(".js-activar-equipo") : null;
                if (!activoBtn) {
                    return;
                }

                activoBtn.classList.toggle("d-none", !isChipEnVarado(chipContainer));
            }

            function closeDropdown(chipContainer) {
                var toggle = chipContainer ? chipContainer.querySelector("[data-bs-toggle='dropdown']") : null;
                if (!toggle || !window.bootstrap || !bootstrap.Dropdown) {
                    return;
                }

                var dropdownInstance = bootstrap.Dropdown.getOrCreateInstance(toggle);
                dropdownInstance.hide();
            }

            function refreshCounters() {
                var carreteraTotal = countChips(carreteraWrap);
                var tallerTotal = tallerWraps.reduce(function (sum, wrap) {
                    return sum + countChips(wrap);
                }, 0);

                carreteraCount.textContent = carreteraTotal.toString();
                tallerCount.textContent = tallerTotal.toString();

                carreteraEmpty.classList.toggle("d-none", carreteraTotal > 0);

                Object.keys(tallerWrapByZone).forEach(function (zone) {
                    var wrap = tallerWrapByZone[zone];
                    if (!wrap) {
                        return;
                    }

                    var zoneCount = countChips(wrap);
                    var countElement = tallerCountByZone[zone];
                    var emptyElement = tallerEmptyByZone[zone];

                    if (countElement) {
                        countElement.textContent = zoneCount.toString();
                    }

                    if (emptyElement) {
                        emptyElement.classList.toggle("d-none", zoneCount > 0);
                    }
                });

                if (descargadosCell && descargadosCount) {
                    descargadosCount.textContent = countChips(descargadosCell).toString();
                }

                if (rutaCell && rutaCount) {
                    rutaCount.textContent = countChips(rutaCell).toString();
                }

                document.querySelectorAll(".equipo-chip-dropdown").forEach(function (chipContainer) {
                    toggleActivoOption(chipContainer);
                });
            }

            document.querySelectorAll(".js-mover-equipo").forEach(function (actionBtn) {
                actionBtn.addEventListener("click", function () {
                    var status = actionBtn.getAttribute("data-target-status");
                    var chipContainer = actionBtn.closest(".equipo-chip-dropdown");

                    if (!status || !chipContainer) {
                        return;
                    }

                    if (!origenWrapPorChip.has(chipContainer)) {
                        var wrapActual = chipContainer.closest(".equipos-chip-wrap");
                        if (wrapActual && !isChipEnVarado(chipContainer)) {
                            origenWrapPorChip.set(chipContainer, wrapActual);
                        }
                    }

                    if (status === "carretera") {
                        carreteraWrap.appendChild(chipContainer);
                    } else {
                        var tallerDestino = resolveTallerWrapForStatus(status, chipContainer);
                        if (tallerDestino) {
                            tallerDestino.appendChild(chipContainer);
                        }
                    }

                    closeDropdown(chipContainer);
                    configureChipDropdowns();
                    refreshCounters();
                });
            });

            document.querySelectorAll(".js-activar-equipo").forEach(function (actionBtn) {
                actionBtn.addEventListener("click", function () {
                    var chipContainer = actionBtn.closest(".equipo-chip-dropdown");
                    if (!chipContainer) {
                        return;
                    }

                    var origenWrap = origenWrapPorChip.get(chipContainer);
                    if (!origenWrap) {
                        return;
                    }

                    origenWrap.appendChild(chipContainer);
                    closeDropdown(chipContainer);
                    configureChipDropdowns();
                    refreshCounters();
                });
            });

            document.querySelectorAll(".equipo-chip-dropdown").forEach(function (chipContainer) {
                var wrapInicial = chipContainer.closest(".equipos-chip-wrap");
                if (wrapInicial && !isChipEnVarado(chipContainer)) {
                    origenWrapPorChip.set(chipContainer, wrapInicial);
                }
            });

            refreshCounters();
        });
    </script>
}






