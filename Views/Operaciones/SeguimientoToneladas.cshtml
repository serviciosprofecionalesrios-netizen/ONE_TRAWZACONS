    .ops-enhanced__header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.8rem;
        flex-wrap: wrap;
    }

    .ops-enhanced__left {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        min-width: 320px;
        flex: 1 1 520px;
    }

    .ops-enhanced__title {
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 0.2rem;
    }

    .ops-enhanced__subtitle {
        margin: 0;
        color: #64748b;
        font-size: 0.84rem;
    }

    .quick-filter-group {
        display: inline-flex;
        background: #ffffff;
        border: 1px solid #d5e1ee;
        border-radius: 999px;
        padding: 0.2rem;
        gap: 0.2rem;
    }

    .quick-filter-btn {
        border: 0;
        background: transparent;
        color: #475569;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.38rem 0.7rem;
        border-radius: 999px;
        transition: all 0.2s ease;
    }

    .quick-filter-btn.is-active {
        background: linear-gradient(90deg, #0f4aa3 0%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 8px 14px rgba(37, 99, 235, 0.24);
    }

    .ops-enhanced__filters {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.45rem;
    }

    .quick-filter-custom {
        display: flex;
        align-items: flex-end;
        justify-content: flex-start;
        gap: 0.45rem;
        flex-wrap: wrap;
    }

    .quick-filter-field {
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
    }

    .quick-filter-field label {
        font-size: 0.76rem;
        font-weight: 700;
        color: #64748b;
        margin: 0;
        line-height: 1.1;
    }

    .quick-filter-input {
        width: 168px;
        height: 34px;
        padding-top: 0.2rem;
        padding-bottom: 0.2rem;
        font-size: 0.8rem;
    }

    .quick-filter-actions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .quick-filter-actions .btn {
        height: 34px;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.26rem 0.62rem;
    }

    .exec-kpi-grid .card {
        border: 1px solid #d6e2f0;
        border-radius: 14px;
        box-shadow: none;
    }

    .exec-kpi-grid .card-body {
        padding: 0.85rem 0.9rem;
    }

    .exec-kpi-label {
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.72rem;
        font-weight: 800;
        color: #64748b;
        margin-bottom: 0.2rem;
    }

    .exec-kpi-value {
        font-size: clamp(1.55rem, 2.2vw, 2rem);
        font-weight: 800;
        color: #0f172a;
        line-height: 1.08;
    }

    .exec-kpi-help {
        font-size: 0.79rem;
        color: #64748b;
        margin-top: 0.24rem;
    }

    .exec-status {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.3rem 0.6rem;
        font-size: 0.76rem;
        font-weight: 800;
    }

    .exec-status--ok {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

    .exec-status--warn {
        color: #9a3412;
        background: #ffedd5;
        border: 1px solid #fdba74;
    }

    .exec-status--danger {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }

    .ops-panel {
        border: 1px solid #d6e2f0;
        border-radius: 14px;
        background: #ffffff;
        padding: 0.85rem;
        height: 100%;
    }

    .ops-panel__title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 0.55rem;
    }

    .trend-legend {
        display: flex;
        gap: 0.8rem;
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 0.5rem;
    }

    .trend-legend i {
        margin-right: 0.25rem;
    }

    .trend-list {
        display: grid;
        gap: 0.35rem;
    }

    .trend-row {
        display: grid;
        grid-template-columns: 52px 1fr 74px;
        gap: 0.45rem;
        align-items: center;
    }

    .trend-row__date {
        font-size: 0.77rem;
        font-weight: 700;
        color: #475569;
    }

    .trend-row__bars {
        display: grid;
        gap: 0.16rem;
    }

    .trend-track-mini {
        width: 100%;
        height: 7px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .trend-value {
        font-size: 0.76rem;
        text-align: right;
        color: #334155;
        font-weight: 700;
    }

    .trend-bar-triton {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 100%);
    }

    .trend-bar-pavon {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #0ea5e9 0%, #0369a1 100%);
    }

    .progress-group {
        display: grid;
        gap: 0.5rem;
    }

    .progress-item {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.55rem;
        background: #f8fbff;
    }

    .progress-item__head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.45rem;
        margin-bottom: 0.25rem;
    }

    .progress-item__name {
        font-size: 0.8rem;
        font-weight: 800;
        color: #1f2937;
    }

    .progress-item__meta {
        font-size: 0.74rem;
        color: #64748b;
    }

    .progress-item__help {
        margin-top: 0.24rem;
        font-size: 0.74rem;
        color: #64748b;
    }

    .progress-track {
        width: 100%;
        height: 8px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 100%);
    }

    .progress-bar--warn {
        background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
    }

    .progress-bar--danger {
        background: linear-gradient(90deg, #1e40af 0%, #1d4ed8 100%);
    }

    .mini-table th,
    .mini-table td {
        font-size: 0.8rem;
        vertical-align: middle;
    }

    .mini-table thead th {
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 0.7rem;
        color: #64748b;
    }

    .alerts-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.45rem;
    }

    .alerts-list li {
        border: 1px solid #d6e2f0;
        border-radius: 10px;
        background: #f8fafc;
        padding: 0.5rem 0.55rem;
    }

    .alert-tag {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        font-size: 0.67rem;
        font-weight: 800;
        padding: 0.15rem 0.45rem;
        margin-right: 0.35rem;
    }

    .alert-tag--high {
        background: #fee2e2;
        color: #991b1b;
    }

    .alert-tag--medium {
        background: #ffedd5;
        color: #9a3412;
    }

    .alert-tag--low {
        background: #dbeafe;
        color: #1e3a8a;
    }

    .quality-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem;
    }

    .quality-metric {
        border: 1px solid #dce6f3;
        border-radius: 10px;
        background: #f8fbff;
        padding: 0.45rem;
    }

    .quality-metric__label {
        font-size: 0.71rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .quality-metric__value {
        font-size: 1.05rem;
        line-height: 1.15;
        font-weight: 800;
        color: #0f172a;
        margin-top: 0.15rem;
    }

    .ops-note {
        margin-top: 0.55rem;
        font-size: 0.76rem;
        color: #64748b;
    }

    @@media (max-width: 1399.98px) {
        .kpi-grid.row {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1199.98px) {
        .kpi-grid.row {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .trend-row {
            grid-template-columns: 46px 1fr 65px;
        }

        .kpi-grid.row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ops-enhanced__filters {
            width: 100%;
            align-items: flex-start;
        }

        .ops-enhanced__left {
            width: 100%;
            min-width: 0;
            flex-basis: auto;
        }

        .quick-filter-custom {
            justify-content: flex-start;
        }

        .quick-filter-input {
            width: 150px;
        }
    }

    @@media (max-width: 767.98px) {
        .ops-enhanced {
            padding: 0.75rem;
        }

        .quality-grid {
            grid-template-columns: 1fr;
        }

        .kpi-grid.row {
            grid-template-columns: 1fr;
        }

        .kpi-grid .card,
        .kpi-grid .card-body {
            min-height: 158px;
        }

        .quick-filter-field {
            width: 100%;
        }

        .quick-filter-input {
            width: 100%;
        }
    }
</style>

<div class="ops-shell">
    <div class="ops-header">
        <div class="ops-header__title">
            <h2 class="fw-bold mb-2">Seguimiento de toneladas</h2>
            <p class="text-muted mb-0">Control diario de volumen movilizado en operaciones.</p>
        </div>
        <div class="ops-header__actions">
            <a asp-controller="Operaciones"
               asp-action="ExportSeguimientoToneladasPdf"
               id="descargar-seguimiento-pdf"
               class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                Descargar PDF
            </a>
        </div>
    </div>

    @if (TempData["SeguimientoToneladasMetaOk"] is string metaOk && !string.IsNullOrWhiteSpace(metaOk))
    {
        <div class="alert alert-success mb-3" role="alert">@metaOk</div>
    }
    @if (TempData["SeguimientoToneladasMetaError"] is string metaError && !string.IsNullOrWhiteSpace(metaError))
    {
        <div class="alert alert-danger mb-3" role="alert">@metaError</div>
    }

    <div class="meta-config">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
            <div>
                <div class="meta-config__title">Meta mensual de producción</div>
                <div class="meta-config__hint">
                    Periodo: <strong>@metaMesLabel</strong> |
                    Estado: <strong>@(Model.MetaMensualPersonalizada ? "Personalizada" : "Base")</strong>
                </div>
            </div>
            <div class="small text-muted">
                Meta diaria definida por usuario:
                <strong>Total @metaDiaria.ToString("N1", CultureInfo.CurrentCulture) Tn</strong>
                (TRITON @metaDiariaTriton.ToString("N1", CultureInfo.CurrentCulture))
            </div>
        </div>

        <form asp-controller="Operaciones"
              asp-action="ActualizarMetaProduccionMensual"
              method="post"
              class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="metaAnio" value="@Model.MetaAnio" />
            <input type="hidden" name="metaMes" value="@Model.MetaMes" />
            <input type="hidden" name="metaMensualPavonAsm" value="0" />
            <input type="hidden" name="metaDiariaPavonAsmObjetivo" value="0" />

            <div class="col-lg-2 col-md-6">
                <label class="form-label fw-semibold mb-1">Meta TRITON (mes)</label>
                <input type="number"
                       name="metaMensualTriton"
                       class="form-control"
                       min="0"
                       step="0.1"
                       value="@Model.MetaMensualTriton.ToString("0.0", CultureInfo.InvariantCulture)"
                       required />
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-semibold mb-1">Meta diaria TRITON</label>
                <input type="number"
                       name="metaDiariaTritonObjetivo"
                       class="form-control"
                       min="0.1"
                       step="0.1"
                       value="@Model.MetaDiariaTritonObjetivo.ToString("0.0", CultureInfo.InvariantCulture)"
                       required />
            </div>
            <div class="col-lg-2 col-md-8">
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" value="true" id="confirmarCambioMeta" name="confirmarCambioMeta" required>
                    <label class="form-check-label" for="confirmarCambioMeta">
                        Confirmo actualizar la meta operativa.
                    </label>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-save2 me-1"></i>Guardar meta
                </button>
            </div>
        </form>
    </div>

    <div class="ops-enhanced mb-4"
         id="ops-enhanced-report">
        <div class="ops-enhanced__header">
            <div class="ops-enhanced__left">
                <div class="quick-filter-custom">
                    <div class="quick-filter-field">
                        <label for="customRangeFrom">Desde</label>
                        <input type="date" id="customRangeFrom" class="form-control form-control-sm quick-filter-input" />
                    </div>
                    <div class="quick-filter-field">
                        <label for="customRangeTo">Hasta</label>
                        <input type="date" id="customRangeTo" class="form-control form-control-sm quick-filter-input" />
                    </div>
                    <div class="quick-filter-actions">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="applyCustomRange">Aplicar rango</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="resetCustomRange">Limpiar</button>
                    </div>
                </div>
                <div>
                    <div class="ops-enhanced__title">Resumen ejecutivo operativo</div>
                    <p class="ops-enhanced__subtitle">
                        Periodo activo: <strong id="execRangeLabel">Hoy</strong> |
                        Fecha de corte: <strong id="execFechaCorte">@fechaOperativaLabel</strong>
                    </p>
                </div>
            </div>
            <div class="ops-enhanced__filters">
                <div class="quick-filter-group" role="group" aria-label="Filtros rapidos de periodo">
                    <button type="button" class="quick-filter-btn is-active" data-range="hoy">Hoy</button>
                    <button type="button" class="quick-filter-btn" data-range="ayer">Ayer</button>
                    <button type="button" class="quick-filter-btn" data-range="semana">Semana</button>
                    <button type="button" class="quick-filter-btn" data-range="mes">Mes</button>
                    <button type="button" class="quick-filter-btn" data-range="equinox">Corte Equinox</button>
                    <button type="button" class="quick-filter-btn" data-range="custom">Rango</button>
                </div>
            </div>
        </div>

        <div class="row g-3 exec-kpi-grid mb-3">
            <div class="col-lg col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="exec-kpi-label">Toneladas periodo</div>
                        <div class="exec-kpi-value" id="execToneladasPeriodo">0.0</div>
                        <div class="exec-kpi-help" id="execToneladasDetalle">TRITON 0.0</div>
                    </div>
                </div>
            </div>
            <div class="col-lg col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="exec-kpi-label">Cumplimiento</div>
                        <div class="exec-kpi-value" id="execCumplimiento">0.0%</div>
                        <div class="exec-kpi-help" id="execMetaDetalle">Meta periodo 0.0 Tn</div>
                    </div>
                </div>
            </div>
            <div class="col-lg col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="exec-kpi-label">Brecha</div>
                        <div class="exec-kpi-value" id="execBrecha">0.0 Tn</div>
                        <div class="exec-kpi-help" id="execBrechaDetalle">Meta cubierta</div>
                    </div>
                </div>
            </div>
            <div class="col-lg col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="exec-kpi-label">Estado general</div>
                        <div class="exec-kpi-value">
                            <span class="exec-status exec-status--ok" id="execEstadoGeneral">Cumplida</span>
                        </div>
                        <div class="exec-kpi-help">Semaforo operativo consolidado</div>
                    </div>
                </div>
            </div>
            <div class="col-lg col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="exec-kpi-label">Registros del periodo</div>
                        <div class="exec-kpi-value" id="execRegistrosPeriodo">0</div>
                        <div class="exec-kpi-help" id="execEstadosDetalle">Finalizados 0 | En ruta 0</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-xl-4">
                <div class="ops-panel">
                    <div class="ops-panel__title">Comparativo vs ayer</div>
                    <div class="small text-muted" id="cmpTotalVsAyer">Total: 0.0 Tn (0.0%)</div>
                    <div class="small text-muted mt-1" id="cmpTritonVsAyer">TRITON: 0.0 Tn</div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="ops-panel">
                    <div class="ops-panel__title">Comparativo vs promedio 7 dias</div>
                    <div class="small text-muted" id="cmpTotalVsProm7">Total: 0.0 Tn (0.0%)</div>
                    <div class="small text-muted mt-1" id="cmpTritonVsProm7">TRITON: 0.0 Tn</div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="ops-panel">
                    <div class="ops-panel__title">Filtro activo</div>
                    <div class="small text-muted" id="execRangoDetalle">Del --/-- al --/--</div>
                    <div class="small text-muted mt-1">Las alertas, top/bottom y KPIs ejecutivos responden al filtro rapido.</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-xl-7">
                <div class="ops-panel">
                    <div class="ops-panel__title">Tendencia de 7 dias (toneladas finalizadas)</div>
                    <div class="trend-legend">
                        <span><i class="bi bi-dash-lg text-primary"></i>TRITON</span>
                    </div>
                    <div class="trend-list" id="trend7Rows"></div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="ops-panel">
                    <div class="ops-panel__title">Proyeccion de cierre mensual</div>
                    <div class="progress-group" id="monthlyProgressWrap"></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-xl-6">
                <div class="ops-panel">
                    <div class="ops-panel__title">Top 5 equipos</div>
                    <div class="table-responsive">
                        <table class="table table-sm mini-table mb-0">
                            <thead>
                                <tr>
                                    <th>Equipo</th>
                                    <th class="text-end">Toneladas</th>
                                    <th class="text-end">Viajes</th>
                                </tr>
                            </thead>
                            <tbody id="topEquiposBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="ops-panel">
                    <div class="ops-panel__title">Bottom 5 equipos</div>
                    <div class="table-responsive">
                        <table class="table table-sm mini-table mb-0">
                            <thead>
                                <tr>
                                    <th>Equipo</th>
                                    <th class="text-end">Toneladas</th>
                                    <th class="text-end">Viajes</th>
                                </tr>
                            </thead>
                            <tbody id="bottomEquiposBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-xl-7">
                <div class="ops-panel">
                    <div class="ops-panel__title">Alertas operativas accionables</div>
                    <ul class="alerts-list" id="actionableAlertsList"></ul>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="ops-panel">
                    <div class="ops-panel__title">Calidad y trazabilidad de datos</div>
                    <div class="quality-grid">
                        <div class="quality-metric">
                            <div class="quality-metric__label">Ultima fecha en datos</div>
                            <div class="quality-metric__value" id="qualityFecha">--</div>
                        </div>
                        <div class="quality-metric">
                            <div class="quality-metric__label">Registros cargados</div>
                            <div class="quality-metric__value" id="qualityTotalRegistros">0</div>
                        </div>
                        <div class="quality-metric">
                            <div class="quality-metric__label">Registros incompletos</div>
                            <div class="quality-metric__value" id="qualityIncompletos">0</div>
                        </div>
                        <div class="quality-metric">
                            <div class="quality-metric__label">Completitud</div>
                            <div class="quality-metric__value" id="qualityCompletitud">0.0%</div>
                        </div>
                    </div>
                    <div class="ops-note" id="qualityFuente"></div>
                </div>
            </div>
        </div>
    </div>
    <script type="application/json" id="ops-analytics-seed">@Html.Raw(analyticsSeedJson)</script>

    <div class="row g-3 mb-4 kpi-grid">
        <div class="col-lg col-md-6">
            <div class="card border-0 h-100">
                <div class="card-body">
                    <div class="metric-with-status">
                        <div>
                            <div class="text-muted">Toneladas al dia TRITON</div>
                            <div class="display-6 fw-bold">@toneladasTritonHoy.ToString("N1", CultureInfo.CurrentCulture)</div>
                            <div class="barra-meta">
                                <div class="barra-meta__track" title="@($"{tritonMetaVisual.ProgresoMeta.ToString("N1", CultureInfo.CurrentCulture)}% de la meta")">
                                    <div class="barra-meta__value @tritonMetaVisual.BarraMetaCss" style="width:@tritonMetaVisual.ProgresoMetaVisual.ToString(CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <div class="barra-meta__legend">
                                    <span>@tritonMetaVisual.ProgresoMeta.ToString("N1", CultureInfo.CurrentCulture)%</span>
                                    <span>Meta @metaDiariaTriton.ToString("N0", CultureInfo.CurrentCulture)</span>
                                </div>
                            </div>
