@model ITServiceDeskApp.ViewModels.Operaciones.SeguimientoToneladasViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Seguimiento de Toneladas";
    var rowsBase = Model.FechaOperativa.HasValue
        ? Model.Rows.Where(r => r.FechaEvento.HasValue && r.FechaEvento.Value.Date == Model.FechaOperativa.Value).ToList()
        : Model.Rows.ToList();
    var mesReferencia = Model.FechaOperativa
        ?? Model.Rows
            .Where(r => r.FechaEvento.HasValue)
            .Select(r => r.FechaEvento!.Value.Date)
            .DefaultIfEmpty(DateTime.Now.Date)
            .Max();
    var rowsMesAcumuladas = Model.Rows
        .Where(r =>
            r.FechaEvento.HasValue &&
            r.FechaEvento.Value.Year == mesReferencia.Year &&
            r.FechaEvento.Value.Month == mesReferencia.Month)
        .ToList();
    if (!rowsMesAcumuladas.Any())
    {
        rowsMesAcumuladas = Model.Rows.ToList();
    }
    var hasFechaValida = Model.FechaOperativa.HasValue;
    var fechaOperativaLabel = Model.FechaOperativa?.ToString("dd/MM/yyyy", CultureInfo.CurrentCulture) ?? "Sin fecha";
    var metaDiariaTriton = Model.MetaDiariaTritonObjetivo > 0m ? Model.MetaDiariaTritonObjetivo : 0m;
    var metaDiaria = Model.MetaDiariaObjetivo > 0m ? Model.MetaDiariaObjetivo : metaDiariaTriton;
    var metaMesLabel = new DateTime(Model.MetaAnio > 0 ? Model.MetaAnio : mesReferencia.Year, Model.MetaMes > 0 ? Model.MetaMes : mesReferencia.Month, 1)
        .ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    bool IsFinalizado(string? estado) =>
        !string.IsNullOrWhiteSpace(estado) &&
        (estado.Contains("FINALIZAD", StringComparison.OrdinalIgnoreCase) ||
         estado.Contains("DESCARGAD", StringComparison.OrdinalIgnoreCase) ||
         estado.Contains("COMPLETAD", StringComparison.OrdinalIgnoreCase));

    bool IsEnRuta(string? estado) =>
        !string.IsNullOrWhiteSpace(estado) &&
        (estado.Contains("EN RUTA", StringComparison.OrdinalIgnoreCase) ||
         estado.Contains("ENRUTA", StringComparison.OrdinalIgnoreCase) ||
         estado.Contains("ENTRADA", StringComparison.OrdinalIgnoreCase) ||
         estado.Contains("TRANSITO", StringComparison.OrdinalIgnoreCase) ||
         estado.Contains("PENDIENTE", StringComparison.OrdinalIgnoreCase));

    string ResolveEstadoCategoria(string? estado)
    {
        if (IsFinalizado(estado))
        {
            return "FINALIZADO";
        }

        if (IsEnRuta(estado))
        {
            return "EN RUTA";
        }

        return "OTRO";
    }

    bool IsRegistroIncompleto(ITServiceDeskApp.ViewModels.Operaciones.SeguimientoToneladasRowViewModel row)
    {
        return string.IsNullOrWhiteSpace(row.Equipo) ||
               string.IsNullOrWhiteSpace(row.Conductor) ||
               string.IsNullOrWhiteSpace(row.Estado) ||
               string.IsNullOrWhiteSpace(row.Ruta);
    }

    string NormalizeProcedencia(string? procedencia)
    {
        if (string.IsNullOrWhiteSpace(procedencia))
        {
            return string.Empty;
        }

        var tokens = procedencia
            .Trim()
            .ToUpperInvariant()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var normalized = string.Join(" ", tokens);
        return normalized == "PAVON ASM" ? "TRITON" : normalized;
    }

    string ResolveProcedencia(ITServiceDeskApp.ViewModels.Operaciones.SeguimientoToneladasRowViewModel row)
    {
        if (!string.IsNullOrWhiteSpace(row.Procedencia))
        {
            return row.Procedencia;
        }

        var ruta = row.Ruta ?? string.Empty;
        var separatorIndex = ruta.IndexOf(" - ", StringComparison.Ordinal);
        return separatorIndex > 0 ? ruta[..separatorIndex] : ruta;
    }

    var resumenDescargados = Model.EstadoResumen.FirstOrDefault(x => x.Estado == "FINALIZADO");
    var resumenEnRuta = Model.EstadoResumen.FirstOrDefault(x => x.Estado == "EN RUTA");
    var toneladasTritonMes = rowsMesAcumuladas
        .Where(r => NormalizeProcedencia(ResolveProcedencia(r)) == "TRITON")
        .Sum(r => r.Toneladas);
    var toneladasTritonHoy = rowsBase
        .Where(r => IsFinalizado(r.Estado) && NormalizeProcedencia(ResolveProcedencia(r)) == "TRITON")
        .Sum(r => r.Toneladas);
    var toneladasFinalizadasHoy = rowsBase
        .Where(r => IsFinalizado(r.Estado))
        .Sum(r => r.Toneladas);
    var toneladasTotalMes = rowsMesAcumuladas
        .Where(r => IsFinalizado(r.Estado))
        .Sum(r => r.Toneladas);
    var metaMensualTriton = Model.MetaMensualTriton;
    var metaMensualTotal = Model.MetaMensualTotal > 0m ? Model.MetaMensualTotal : metaMensualTriton;
    var cumplimientoMetaTriton = metaMensualTriton > 0m
        ? Math.Round((toneladasTritonMes / metaMensualTriton) * 100m, 1)
        : 0m;
    var cumplimientoMetaTotal = metaMensualTotal > 0m
        ? Math.Round((toneladasTotalMes / metaMensualTotal) * 100m, 1)
        : 0m;
    (string SemaforoCss, string SemaforoIcon, string BarraMetaCss, string SemaforoTitle, decimal ProgresoMeta, decimal ProgresoMetaVisual) ResolveMetaVisual(decimal toneladasActuales, decimal metaObjetivo)
    {
        var faltante = Math.Max(0m, metaObjetivo - toneladasActuales);
        var faltanteRatioLocal = metaObjetivo > 0m ? faltante / metaObjetivo : 0m;
        var faltantePctLocal = Math.Round(faltanteRatioLocal * 100m, 1);
        var progreso = metaObjetivo > 0m
            ? Math.Round((toneladasActuales / metaObjetivo) * 100m, 1)
            : 0m;
        var progresoVisual = Math.Clamp(progreso, 0m, 100m);

        var semaforoCssLocal = "meta-semaforo--danger";
        var semaforoIconLocal = "bi-x-octagon-fill";
        var barraCssLocal = "barra-meta__value--danger";
        var titleLocal = $"Lejos de meta: faltan {faltante.ToString("N1", CultureInfo.CurrentCulture)} Tn ({faltantePctLocal.ToString("N1", CultureInfo.CurrentCulture)}%).";

        if (toneladasActuales >= metaObjetivo && metaObjetivo > 0m)
        {
            semaforoCssLocal = "meta-semaforo--ok";
            semaforoIconLocal = "bi-check2-circle";
            barraCssLocal = "barra-meta__value--ok";
            titleLocal = "Meta diaria cumplida o superada.";
        }
        else if (faltanteRatioLocal <= 0.20m && metaObjetivo > 0m)
        {
            semaforoCssLocal = "meta-semaforo--warn";
            semaforoIconLocal = "bi-exclamation-triangle-fill";
            barraCssLocal = "barra-meta__value--warn";
            titleLocal = $"Advertencia: estas a menos del 20% de la meta. Faltan {faltante.ToString("N1", CultureInfo.CurrentCulture)} Tn.";
        }

        return (semaforoCssLocal, semaforoIconLocal, barraCssLocal, titleLocal, progreso, progresoVisual);
    }

    var tritonMetaVisual = ResolveMetaVisual(toneladasTritonHoy, metaDiariaTriton);
    var totalMetaVisual = ResolveMetaVisual(toneladasFinalizadasHoy, metaDiaria);

    var equiposDescargadosDetalle = rowsBase
        .Where(r => IsFinalizado(r.Estado))
        .GroupBy(r => (r.Equipo ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
        .Where(g => !string.IsNullOrWhiteSpace(g.Key))
        .Select(g => new
        {
            Equipo = g.Key,
            Conductor = g.Select(x => (x.Conductor ?? string.Empty).Trim())
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "Sin conductor",
            Toneladas = g.Sum(x => x.Toneladas),
            Combustible = g.Sum(x => x.CombustibleLitros),
            Procedencia = g.Select(x => NormalizeProcedencia(ResolveProcedencia(x)))
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "OTROS"
        })
        .OrderBy(x => x.Equipo)
        .ToList();

    var equiposEnRutaDetalle = rowsBase
        .Where(r => IsEnRuta(r.Estado))
        .GroupBy(r => (r.Equipo ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
        .Where(g => !string.IsNullOrWhiteSpace(g.Key))
        .Select(g => new
        {
            Equipo = g.Key,
            Conductor = g.Select(x => (x.Conductor ?? string.Empty).Trim())
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "Sin conductor",
            ToneladasRuta = g.Sum(x => x.PesoSugerido > 0 ? x.PesoSugerido : x.Toneladas),
            Procedencia = g.Select(x => NormalizeProcedencia(ResolveProcedencia(x)))
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "OTROS"
        })
        .OrderBy(x => x.Equipo)
        .ToList();

    var descargadosPavon = equiposDescargadosDetalle.Where(x => x.Procedencia == "PAVON ASM").ToList();
    var descargadosTriton = equiposDescargadosDetalle.Where(x => x.Procedencia == "TRITON").ToList();
    var descargadosOtros = equiposDescargadosDetalle
        .Where(x => x.Procedencia != "PAVON ASM" && x.Procedencia != "TRITON")
        .ToList();
    var rutaPavon = equiposEnRutaDetalle.Where(x => x.Procedencia == "PAVON ASM").ToList();
    var rutaTriton = equiposEnRutaDetalle.Where(x => x.Procedencia == "TRITON").ToList();
    var rutaOtros = equiposEnRutaDetalle
        .Where(x => x.Procedencia != "PAVON ASM" && x.Procedencia != "TRITON")
        .ToList();

    var analyticsRowsPayload = Model.Rows.Select(r =>
    {
        var fecha = r.FechaEvento?.Date;
        var procedencia = NormalizeProcedencia(ResolveProcedencia(r));
        var equipo = (r.Equipo ?? string.Empty).Trim();
        var conductor = (r.Conductor ?? string.Empty).Trim();
        var ruta = (r.Ruta ?? string.Empty).Trim();

        return new
        {
            fecha = fecha?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            procedencia,
            estado = ResolveEstadoCategoria(r.Estado),
            equipo,
            conductor,
            ruta,
            toneladas = r.Toneladas,
            toneladasRuta = r.PesoSugerido > 0m ? r.PesoSugerido : r.Toneladas,
            viajes = r.Viajes,
            incompleto = IsRegistroIncompleto(r)
        };
    }).ToList();

    var analyticsSeed = new
    {
        fechaCorte = mesReferencia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        fechaOperativa = Model.FechaOperativa?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        metaDiariaTriton,
        metaDiariaPavonAsm = 0m,
        metaMensualTriton,
        metaMensualPavonAsm = 0m,
        sourceFileName = Model.SourceFileName ?? "Datos operativos",
        rows = analyticsRowsPayload
    };
    var analyticsSeedJson = JsonSerializer.Serialize(analyticsSeed);
}

