@model ITServiceDeskApp.Services.HolcimSourceDetail
<strong>Datos originales · @Model.File</strong>
<p class="small text-muted mb-2">Hoja @Model.Sheet. Las fechas y los resultados se muestran tal como vienen en el archivo. «Sin dato» indica un campo vacío en el origen.</p>
<div class="table-responsive" style="max-height:400px;overflow:auto">
    <table class="table table-sm table-bordered bg-white mb-0" style="min-width:650px">
        <thead class="table-light" style="position:sticky;top:0"><tr><th>Campo de origen</th>@foreach(var source in Model.Rows){<th>Fila @source.Row</th>}</tr></thead>
        <tbody>@foreach(var field in Model.Rows.SelectMany(x=>x.Values.Keys).Distinct()){
            <tr><th style="min-width:170px">@field</th>@foreach(var source in Model.Rows){var value=source.Values.GetValueOrDefault(field);<td style="min-width:220px">@(string.IsNullOrWhiteSpace(value) ? "Sin dato" : value)</td>}</tr>
        }</tbody>
    </table>
</div>
