@model ITServiceDeskApp.ViewModels.Operaciones.OperacionesDashboardViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Operaciones";
    var topConductoresJson = JsonSerializer.Serialize(
        Model.TopConductores.Select(x => new { nombre = x.Nombre, toneladas = x.Toneladas }));
    var topEquiposJson = JsonSerializer.Serialize(
        Model.TopEquipos.Select(x => new { nombre = x.Nombre, toneladas = x.Toneladas }));
    var procedenciaJson = JsonSerializer.Serialize(
        Model.DistribucionProcedencia.Select(x => new { categoria = x.Categoria, toneladas = x.Toneladas }));
    var tendenciaJson = JsonSerializer.Serialize(
        Model.TendenciaDiaria.Select(x => new { fecha = x.Fecha.ToString("dd/MM"), toneladas = x.Toneladas }));
    var comparativoToneladasSitioJson = JsonSerializer.Serialize(
        Model.ComparativoToneladasSitio.Select(x => new { mes = x.Mes, triton = x.Triton }));
    var comparativoDieselSitioJson = JsonSerializer.Serialize(
        Model.ComparativoDieselSitio.Select(x => new { mes = x.Mes, triton = x.Triton }));
    var rangoMesesComparativo = Model.ComparativoToneladasSitio.Count > 1
        ? $"{Model.ComparativoToneladasSitio.First().Mes} a {Model.ComparativoToneladasSitio.Last().Mes}"
        : Model.ComparativoToneladasSitio.FirstOrDefault()?.Mes ?? "Mes actual";
    var proyeccionPct = Model.MetaDiaria > 0
        ? Math.Round((Model.PrediccionToneladasManana / Model.MetaDiaria) * 100m, 1)
        : 0m;
    var proyeccionMensualPct = Model.MetaMensualToneladas > 0
        ? Math.Round((Model.ProyeccionCierreMensualToneladas / Model.MetaMensualToneladas) * 100m, 1)
        : 0m;
}

<style>
    .ops-dash-shell {
        background: #ffffff;
        border: 1px solid #dbe3ef;
        border-radius: 16px;
        padding: 1rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        display: flex;
        flex-direction: column;
    }

    .layout-row {
        width: 100%;
    }

    .row-main {
        order: 1;
    }

    .row-comparativos {
        order: 2;
    }

    .row-bars {
        order: 3;
    }

    .row-tables {
        order: 4;
    }

    .row-main .col-lg-6:first-child .ops-card {
        height: auto;
    }

    .dash-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .dash-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        min-width: 240px;
        padding-top: 0.15rem;
    }

    .ops-kpi {
        border: 1px solid #9bbdea;
        border-radius: 14px;
        background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
        box-shadow: none;
        height: 100%;
    }

    .ops-kpi.p-3 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        gap: 0.2rem;
    }

    .ops-kpi .label {
        color: #5f6f85;
        font-size: 0.84rem;
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ops-kpi .value {
        font-size: clamp(1.95rem, 2.2vw, 2.35rem);
        font-weight: 800;
        color: #1f2937;
        line-height: 1.1;
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ops-kpi .sub {
        color: #6b7280;
        font-size: 0.88rem;
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ops-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: none;
        height: 100%;
    }

    .ops-card__header {
        border-bottom: 1px solid #edf1f6;
        padding: 0.75rem 0.95rem;
        font-weight: 700;
        color: #1d2d44;
    }

    .ops-card__body {
        padding: 0.9rem 0.95rem;
    }

    .ops-card canvas {
        animation: none !important;
        transition: none !important;
    }

    .rank-table td, .rank-table th {
        vertical-align: middle;
        font-size: 0.92rem;
    }

    .rank-table th {
        color: #52627a;
        font-weight: 700;
    }

    .rank-table tr.rank-top10 td {
        background: #eaf3ff;
    }

    .rank-table tr.rank-top10 td:first-child {
        border-left: 4px solid #1d4ed8;
        padding-left: 0.55rem;
    }

    .rank-num {
        font-weight: 800;
        color: #11439A;
        width: 42px;
    }

    .predict-wrap {
        border: 1px solid #e4eaf3;
        border-radius: 12px;
        padding: 0.8rem;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    }

    .predict-meter {
        height: 12px;
        border-radius: 999px;
        background: #e5e7eb;
        overflow: hidden;
        margin-top: 0.45rem;
    }

    .predict-meter__value {
        height: 100%;
        background: linear-gradient(90deg, #22c55e 0%, #0ea5e9 100%);
    }

    .predict-legend-custom {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        margin-bottom: 0.35rem;
        font-size: 0.95rem;
        color: #475569;
        font-weight: 600;
    }

    .predict-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .predict-legend-box {
        width: 34px;
        height: 12px;
        border-radius: 4px;
        display: inline-block;
    }

    .predict-legend-box--ton {
        background: #c8a24a;
    }

    .predict-legend-box--meta {
        border: 3px dashed #11439A;
        background: transparent;
        height: 10px;
    }

    .ops-state-badge {
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        font-size: 0.78rem;
        font-weight: 700;
        border: 1px solid transparent;
    }

    .ops-state-badge.success {
        color: #166534;
        background: #dcfce7;
        border-color: #86efac;
    }

    .ops-state-badge.warning {
        color: #92400e;
        background: #fef3c7;
        border-color: #fcd34d;
    }

    .ops-state-badge.danger {
        color: #0B2F75;
        background: #fee2e2;
        border-color: #fca5a5;
    }

    .ops-state-badge.secondary {
        color: #334155;
        background: #e2e8f0;
        border-color: #cbd5e1;
    }

    .ops-quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .ops-quick-item {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.55rem 0.65rem;
        background: #f8fafc;
    }

    .ops-quick-item .label {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        line-height: 1.2;
        margin-bottom: 0.2rem;
    }

    .ops-quick-item .value {
        font-size: 1.08rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.1;
    }

    .ops-alert-list {
        margin: 0;
        padding-left: 1rem;
        color: #334155;
        font-size: 0.91rem;
    }

    .ops-alert-list li + li {
        margin-top: 0.45rem;
    }

    .ops-desv-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.1rem 0.5rem;
        font-size: 0.74rem;
        font-weight: 800;
        line-height: 1.25;
        border: 1px solid transparent;
    }

    .ops-desv-status.ok {
        color: #166534;
        background: #dcfce7;
        border-color: #86efac;
    }

    .ops-desv-status.vigilar {
        color: #92400e;
        background: #fef3c7;
        border-color: #fcd34d;
    }

    .ops-desv-status.critico {
        color: #0B2F75;
        background: #fee2e2;
        border-color: #fca5a5;
    }

    .ops-turno-row + .ops-turno-row {
        margin-top: 0.75rem;
    }

    .ops-turno-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
        font-size: 0.9rem;
    }

    .ops-turno-title {
        font-weight: 800;
        color: #1e293b;
    }

    .ops-turno-meta {
        color: #64748b;
        font-weight: 600;
        font-size: 0.82rem;
    }

    .ops-turno-meter {
        height: 9px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
        margin-top: 0.3rem;
    }

    .ops-turno-meter > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #0ea5e9 0%, #22c55e 100%);
    }

    .ops-proy-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.92rem;
        margin-bottom: 0.45rem;
    }

    .ops-proy-label {
        color: #64748b;
        font-weight: 600;
    }

    .ops-proy-value {
        color: #0f172a;
        font-weight: 800;
    }

</style>

<div class="ops-dash-shell" id="dashboardCaptureRoot">
    <div class="mb-3 dash-top">
        <div>
            <h2 class="fw-bold mb-1">Dashboard de Operaciones</h2>
            <p class="text-muted mb-0">Analitica operativa con top 10, tendencia y prediccion en base al Excel de seguimiento.</p>
        </div>
        <div class="dash-actions no-export">
            <button type="button"
                    class="btn btn-outline-primary px-4"
                    id="btnExportDashboardPdf">
                <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
            </button>
        </div>
    </div>

    @if (Model.IsFromUpload)
    {
        <div class="alert alert-success mb-3" role="alert">
            Datos cargados desde: <strong>@Model.SourceFileName</strong>
            @if (Model.LastUpdatedAt.HasValue)
            {
                <span class="ms-2 text-muted">Actualizado: @Model.LastUpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-3" role="alert">
            Aun no hay carga real de Excel. El dashboard muestra datos de referencia.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="ops-kpi p-3">
                <div class="label">Tn/H de Hoy</div>
                <div class="value">@Model.ToneladasDescargadasDia.ToString("N1", CultureInfo.CurrentCulture)</div>
                <div class="sub">Cumplimiento: @Model.CumplimientoPlanPorcentaje%</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="ops-kpi p-3">
                <div class="label">Descargadas dia TRITON</div>
                <div class="value">@Model.ToneladasDescargadasDiaTriton.ToString("N1", CultureInfo.CurrentCulture)</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="ops-kpi p-3">
                <div class="label">Toneladas en ruta</div>
                <div class="value">@Model.ToneladasEnRutaActual.ToString("N1", CultureInfo.CurrentCulture)</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="ops-kpi p-3">
                <div class="label">Toneladas mes</div>
                <div class="value">@Model.ToneladasMovilizadas.ToString("N1", CultureInfo.CurrentCulture)</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="ops-kpi p-3">
                <div class="label">Diesel mes</div>
                <div class="value">@Model.DieselConsumidoGalones.ToString("N0", CultureInfo.CurrentCulture)</div>
                <div class="sub">@Model.DieselConsumidoLitros.ToString("N0", CultureInfo.CurrentCulture) L</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="ops-kpi p-3">
                <div class="label">Predicción mañana</div>
                <div class="value">@Model.PrediccionToneladasManana.ToString("N1", CultureInfo.CurrentCulture)</div>
                <div class="sub">@Model.CumplimientoEstimadoMananaPorcentaje% de meta @Model.MetaDiaria.ToString("N0", CultureInfo.CurrentCulture)</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-4">
            <div class="ops-card h-100">
                <div class="ops-card__header d-flex justify-content-between align-items-center">
                    <span>Estado Operativo del Dia</span>
                    <span class="ops-state-badge @Model.EstadoOperativoClase">@Model.EstadoOperativoLabel</span>
                </div>
                <div class="ops-card__body">
                    <div class="ops-quick-grid">
                        <div class="ops-quick-item">
                            <div class="label">Equipos finalizados</div>
                            <div class="value">@Model.EquiposFinalizadosDia</div>
                        </div>
                        <div class="ops-quick-item">
                            <div class="label">Equipos en ruta</div>
                            <div class="value">@Model.EquiposEnRutaDia</div>
                        </div>
                        <div class="ops-quick-item">
                            <div class="label">Brecha meta hoy</div>
                            <div class="value">@(Model.BrechaMetaToneladas > 0 ? $"{Model.BrechaMetaToneladas.ToString("N1", CultureInfo.CurrentCulture)} Tn" : "Meta cubierta")</div>
                        </div>
                        <div class="ops-quick-item">
                            <div class="label">Despachos del dia</div>
                            <div class="value">@Model.DespachosDelDia</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="ops-card h-100">
                <div class="ops-card__header">Eficiencia de Consumo (Mes)</div>
                <div class="ops-card__body">
                    <div class="ops-quick-grid">
                        <div class="ops-quick-item">
                            <div class="label">Rendimiento T/GAL</div>
                            <div class="value">@Model.RendimientoToneladasPorGalonMes.ToString("N3", CultureInfo.CurrentCulture)</div>
                        </div>
                        <div class="ops-quick-item">
                            <div class="label">Intensidad L/T</div>
                            <div class="value">@Model.LitrosPorToneladaMes.ToString("N3", CultureInfo.CurrentCulture)</div>
                        </div>
                        <div class="ops-quick-item">
                            <div class="label">Toneladas mes</div>
                            <div class="value">@Model.ToneladasMovilizadas.ToString("N1", CultureInfo.CurrentCulture)</div>
                        </div>
                        <div class="ops-quick-item">
                            <div class="label">Diesel mes (gal)</div>
                            <div class="value">@Model.DieselConsumidoGalones.ToString("N0", CultureInfo.CurrentCulture)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="ops-card h-100">
                <div class="ops-card__header">Alertas Operativas</div>
                <div class="ops-card__body">
                    <ul class="ops-alert-list">
                        @foreach (var alerta in Model.AlertasOperativas)
                        {
                            <li>@alerta</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-6">
            <div class="ops-card h-100">
                <div class="ops-card__header">Cumplimiento por turno (hoy)</div>
                <div class="ops-card__body">
                    @if (Model.CumplimientoPorTurno.Any())
                    {
                        @foreach (var turno in Model.CumplimientoPorTurno)
                        {
                            <div class="ops-turno-row">
                                <div class="ops-turno-head">
                                    <span class="ops-turno-title">@turno.Turno</span>
                                    <span class="ops-turno-meta">@turno.Toneladas.ToString("N1", CultureInfo.CurrentCulture) / @turno.MetaTurno.ToString("N1", CultureInfo.CurrentCulture) Tn • @turno.Equipos equipos • @turno.CumplimientoPorcentaje%</span>
                                </div>
                                <div class="ops-turno-meter">
                                    <span style="width:@Math.Clamp(turno.CumplimientoPorcentaje, 0, 100)%"></span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">Sin datos para calcular cumplimiento por turno.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="ops-card h-100">
                <div class="ops-card__header d-flex justify-content-between align-items-center">
                    <span>Proyeccion de cierre mensual</span>
                    <span class="ops-state-badge @Model.EstadoProyeccionMensualClase">@Model.EstadoProyeccionMensualLabel</span>
                </div>
                <div class="ops-card__body">
                    <div class="ops-proy-line">
                        <span class="ops-proy-label">Meta mensual</span>
                        <span class="ops-proy-value">@Model.MetaMensualToneladas.ToString("N1", CultureInfo.CurrentCulture) Tn</span>
                    </div>
                    <div class="ops-proy-line">
                        <span class="ops-proy-label">Proyeccion cierre</span>
                        <span class="ops-proy-value">@Model.ProyeccionCierreMensualToneladas.ToString("N1", CultureInfo.CurrentCulture) Tn</span>
                    </div>
                    <div class="ops-proy-line">
                        <span class="ops-proy-label">Brecha proyectada</span>
                        <span class="ops-proy-value @(Model.BrechaProyectadaMensualToneladas > 0 ? "text-danger" : "text-success")">
                            @(Model.BrechaProyectadaMensualToneladas > 0
                                ? $"{Model.BrechaProyectadaMensualToneladas.ToString("N1", CultureInfo.CurrentCulture)} Tn faltantes"
                                : "Meta cubierta")
                        </span>
                    </div>
                    <div class="predict-meter mt-2">
                        <div class="predict-meter__value" style="width:@Math.Clamp(proyeccionMensualPct, 0, 100)%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">Cumplimiento proyectado: @Model.CumplimientoProyectadoMensualPorcentaje%</small>
                        <small class="text-muted">Ritmo al @Model.FechaCorteOperativo.ToString("dd/MM")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="ops-card">
                <div class="ops-card__header">Brechas de rendimiento por equipo (T/GAL vs promedio mensual)</div>
                <div class="ops-card__body table-responsive">
                    <table class="table table-sm rank-table mb-0">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th class="text-end">Toneladas</th>
                                <th class="text-end">Galones</th>
                                <th class="text-end">T/GAL</th>
                                <th class="text-end">Var. vs prom.</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DesviacionesRendimiento.Any())
                            {
                                @foreach (var item in Model.DesviacionesRendimiento)
                                {
                                    var statusClass = item.Estado == "CRITICO"
                                        ? "critico"
                                        : item.Estado == "VIGILAR"
                                            ? "vigilar"
                                            : "ok";
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td class="text-end fw-semibold">@item.Toneladas.ToString("N1", CultureInfo.CurrentCulture)</td>
                                        <td class="text-end fw-semibold">@item.Galones.ToString("N2", CultureInfo.CurrentCulture)</td>
                                        <td class="text-end fw-semibold">@item.ToneladasPorGalon.ToString("N3", CultureInfo.CurrentCulture)</td>
                                        <td class="text-end fw-semibold @(item.VariacionVsPromedioPorcentaje < 0 ? "text-danger" : "text-success")">
                                            @item.VariacionVsPromedioPorcentaje.ToString("N1", CultureInfo.CurrentCulture)%
                                        </td>
                                        <td class="text-center">
                                            <span class="ops-desv-status @statusClass">@item.Estado</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Sin registros suficientes para calcular desviaciones de rendimiento.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3 layout-row row-tables pdf-keep-together">
        <div class="col-lg-6">
            <div class="ops-card">
                <div class="ops-card__header">Conductores por Toneladas (Mes) - Top 10 resaltado</div>
                <div class="ops-card__body table-responsive">
                    <table class="table table-sm rank-table mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px">#</th>
                                <th>Conductor</th>
                                <th class="text-end">Toneladas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ConductoresMes.Any())
                            {
                                @for (var i = 0; i < Model.ConductoresMes.Count; i++)
                                {
                                    var isTop10 = i < 10;
                                    <tr class="@(isTop10 ? "rank-top10" : string.Empty)">
                                        <td class="rank-num">@(i + 1)</td>
                                        <td>@Model.ConductoresMes[i].Nombre</td>
                                        <td class="text-end fw-semibold">@Model.ConductoresMes[i].Toneladas.ToString("N1", CultureInfo.CurrentCulture)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted">Sin datos de conductores del mes.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="ops-card">
                <div class="ops-card__header">Equipos por Toneladas (Mes) - Top 10 resaltado</div>
                <div class="ops-card__body table-responsive">
                    <table class="table table-sm rank-table mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px">#</th>
                                <th>Equipo</th>
                                <th class="text-end">Toneladas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.EquiposMes.Any())
                            {
                                @for (var i = 0; i < Model.EquiposMes.Count; i++)
                                {
                                    var isTop10 = i < 10;
                                    <tr class="@(isTop10 ? "rank-top10" : string.Empty)">
                                        <td class="rank-num">@(i + 1)</td>
