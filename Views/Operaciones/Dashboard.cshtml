    async function waitForDashboardReady() {
        if (document.fonts && document.fonts.ready) {
            try {
                await document.fonts.ready;
            } catch {
                // Ignore font readiness errors.
            }
        }

        await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
        await new Promise(resolve => setTimeout(resolve, 120));
    }

    async function loadImageAsDataUrl(url) {
        const response = await fetch(url, { cache: 'no-store' });
        if (!response.ok) {
            throw new Error(`No se pudo cargar imagen: ${url}`);
        }

        const blob = await response.blob();
        return await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.onerror = reject;
            reader.readAsDataURL(blob);
        });
    }

    async function resolveImageDimensions(dataUrl) {
        return await new Promise((resolve, reject) => {
            const img = new Image();
            img.onload = () => resolve({ width: img.naturalWidth || 0, height: img.naturalHeight || 0 });
            img.onerror = reject;
            img.src = dataUrl;
        });
    }

    async function loadFirstAvailableLogo() {
        const candidates = [
            '@Url.Content("~/images/logo-trawzacons-corporativo.png")',
            '@Url.Content("~/images/logo-trawzacons.png")'
        ];

        for (const url of candidates) {
            try {
                const dataUrl = await loadImageAsDataUrl(url);
                if (!dataUrl) continue;
                const size = await resolveImageDimensions(dataUrl).catch(() => ({ width: 0, height: 0 }));
                return {
                    dataUrl,
                    width: Number(size.width || 0),
                    height: Number(size.height || 0)
                };
            } catch {
                // Sigue con el siguiente candidato.
            }
        }

        return null;
    }

    function drawCorporateFrame(pdf, page, totalPages, generatedAt, logoAsset) {
        const width = pdf.internal.pageSize.getWidth();
        const height = pdf.internal.pageSize.getHeight();
        let textStartX = 34;

        if (logoAsset?.dataUrl) {
            const maxW = 22;
            const maxH = 12;
            const srcW = Math.max(1, Number(logoAsset.width || 1));
            const srcH = Math.max(1, Number(logoAsset.height || 1));
            const ratio = srcW / srcH;

            let drawW = maxW;
            let drawH = drawW / ratio;
            if (drawH > maxH) {
                drawH = maxH;
                drawW = drawH * ratio;
            }

            const x = 8;
            const y = 5 + ((maxH - drawH) / 2);
            pdf.addImage(logoAsset.dataUrl, 'PNG', x, y, drawW, drawH, undefined, 'SLOW');
            textStartX = Math.max(34, x + drawW + 4);
        }

        pdf.setTextColor(17, 67, 154);
        pdf.setFont('helvetica', 'bold');
        pdf.setFontSize(11);
        pdf.text('TRAWZACONS', textStartX, 10);

        pdf.setTextColor(33, 41, 55);
        pdf.setFont('helvetica', 'bold');
        pdf.setFontSize(8);
        pdf.text('Operaciones - Dashboard', textStartX, 14);

        pdf.setFont('helvetica', 'normal');
        pdf.setFontSize(7);
        pdf.text(`Generado: ${generatedAt}`, width - 8, 10, { align: 'right' });

        pdf.setDrawColor(17, 67, 154);
        pdf.setLineWidth(0.4);
        pdf.line(8, 18, width - 8, 18);

        pdf.setDrawColor(220, 220, 220);
        pdf.setLineWidth(0.2);
        pdf.line(8, height - 8, width - 8, height - 8);

        pdf.setFont('helvetica', 'normal');
        pdf.setFontSize(7);
        pdf.setTextColor(107, 114, 128);
        pdf.text(`Confidencial - TRAWZACONS | ${generatedAt}`, 8, height - 4.8);
        pdf.text(`Pagina ${page} de ${totalPages}`, width - 8, height - 4.8, { align: 'right' });
    }

    function applyCorporateFormat(pdf, generatedAt, logoAsset) {
        const total = pdf.getNumberOfPages();
        for (let page = 1; page <= total; page++) {
            pdf.setPage(page);
            drawCorporateFrame(pdf, page, total, generatedAt, logoAsset);
        }
    }

    function drawBlockCanvas(pdf, canvas, marginX, cursorY, usableWidth) {
        const heightMm = (canvas.height * usableWidth) / canvas.width;
        const imageData = canvas.toDataURL('image/png', 1.0);
        pdf.addImage(imageData, 'PNG', marginX, cursorY, usableWidth, heightMm, undefined, 'FAST');
        return heightMm;
    }

    async function exportDashboardAsPdf() {
        const button = document.getElementById('btnExportDashboardPdf');
        const captureRoot = document.getElementById('dashboardCaptureRoot');
        if (!button || !captureRoot || !window.jspdf || !window.html2canvas) return;

        const previousHtml = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Generando...';

        const hiddenNodes = Array
            .from(captureRoot.querySelectorAll('.no-export'))
            .filter(node => !node.contains(button));
        const previousVisibility = hiddenNodes.map(node => node.style.visibility);
        hiddenNodes.forEach(node => node.style.visibility = 'hidden');

        try {
            await waitForDashboardReady();

            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4', compress: true });
            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();
            const marginX = 8;
            const contentTop = 21;
            const contentBottom = 10;
            const sectionGap = 3;
            const usableWidth = pageWidth - (marginX * 2);
            const usableHeight = pageHeight - contentTop - contentBottom;
            const generatedAt = new Date().toLocaleString('es-NI', { hour12: false });
            const logoAsset = await loadFirstAvailableLogo();

            let cursorY = contentTop;
            let page = 1;

            const exportBlocks = Array
                .from(captureRoot.children)
                .filter(node => node instanceof HTMLElement)
                .filter(node => !node.classList.contains('no-export'))
                .filter(node => node.offsetWidth > 0 && node.offsetHeight > 0);
            exportBlocks.sort((a, b) => {
                const ar = a.getBoundingClientRect();
                const br = b.getBoundingClientRect();
                if (Math.abs(ar.top - br.top) > 1) {
                    return ar.top - br.top;
                }

                return ar.left - br.left;
            });

            for (const block of exportBlocks) {
                const blockCanvas = await html2canvas(block, {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: '#ffffff',
                    logging: false
                });

                if (!blockCanvas.width || !blockCanvas.height) {
                    continue;
                }

                const blockHeightMm = (blockCanvas.height * usableWidth) / blockCanvas.width;
                const remainingMm = pageHeight - contentBottom - cursorY;

                if (blockHeightMm <= remainingMm) {
                    const consumed = drawBlockCanvas(pdf, blockCanvas, marginX, cursorY, usableWidth);
                    cursorY += consumed + sectionGap;
                    continue;
                }

                if (blockHeightMm <= usableHeight) {
                    pdf.addPage();
                    page++;
                    cursorY = contentTop;
                    const consumed = drawBlockCanvas(pdf, blockCanvas, marginX, cursorY, usableWidth);
                    cursorY += consumed + sectionGap;
                    continue;
                }

                // Bloque más alto que una página: se divide de forma controlada.
                const pxPerMm = blockCanvas.width / usableWidth;
                let offsetY = 0;
                while (offsetY < blockCanvas.height) {
                    let availableMm = pageHeight - contentBottom - cursorY;
                    if (availableMm < 20) {
                        pdf.addPage();
                        page++;
                        cursorY = contentTop;
                        availableMm = pageHeight - contentBottom - cursorY;
                    }

                    const sliceHeightPx = Math.min(
                        Math.floor(availableMm * pxPerMm),
                        blockCanvas.height - offsetY);

                    if (sliceHeightPx <= 0) {
                        pdf.addPage();
                        page++;
                        cursorY = contentTop;
                        continue;
                    }

                    const sliceCanvas = document.createElement('canvas');
                    sliceCanvas.width = blockCanvas.width;
                    sliceCanvas.height = sliceHeightPx;
                    const sliceCtx = sliceCanvas.getContext('2d');
                    if (!sliceCtx) {
                        break;
                    }

                    sliceCtx.drawImage(
                        blockCanvas,
                        0, offsetY, blockCanvas.width, sliceHeightPx,
                        0, 0, blockCanvas.width, sliceHeightPx
                    );

                    const consumed = drawBlockCanvas(pdf, sliceCanvas, marginX, cursorY, usableWidth);
                    cursorY += consumed + sectionGap;
                    offsetY += sliceHeightPx;

                    if (offsetY < blockCanvas.height) {
                        pdf.addPage();
                        page++;
                        cursorY = contentTop;
                    }
                }
            }

            applyCorporateFormat(pdf, generatedAt, logoAsset);

            const stamp = new Date();
            const fileName = `DashboardOperaciones_${stamp.getFullYear()}${String(stamp.getMonth() + 1).padStart(2, '0')}${String(stamp.getDate()).padStart(2, '0')}_${String(stamp.getHours()).padStart(2, '0')}${String(stamp.getMinutes()).padStart(2, '0')}.pdf`;
            pdf.save(fileName);
        } catch (error) {
            console.error(error);
            alert('No se pudo generar el PDF del dashboard. Intenta nuevamente.');
        } finally {
            hiddenNodes.forEach((node, index) => node.style.visibility = previousVisibility[index] ?? '');
            button.disabled = false;
            button.innerHTML = previousHtml;
        }
    }

    document.getElementById('btnExportDashboardPdf')?.addEventListener('click', exportDashboardAsPdf);
</script>
}


