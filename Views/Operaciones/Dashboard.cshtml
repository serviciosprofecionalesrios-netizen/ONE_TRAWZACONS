@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script>
    Chart.defaults.animation = false;
    Chart.defaults.animations = false;
    Chart.defaults.transitions.active.animation = false;
    Chart.defaults.transitions.resize.animation = false;
    Chart.defaults.transitions.show = { animations: false };
    Chart.defaults.transitions.hide = { animations: false };
    Chart.defaults.responsive = false;

    const topConductores = @Html.Raw(topConductoresJson);
    const topEquipos = @Html.Raw(topEquiposJson);
    const procedencia = @Html.Raw(procedenciaJson);
    const tendencia = @Html.Raw(tendenciaJson);
    const comparativoToneladasSitio = @Html.Raw(comparativoToneladasSitioJson);
    const comparativoDieselSitio = @Html.Raw(comparativoDieselSitioJson);
    const prediccionManana = @Model.PrediccionToneladasManana.ToString(CultureInfo.InvariantCulture);
    const toneladasDescargadasDia = @Model.ToneladasDescargadasDia.ToString(CultureInfo.InvariantCulture);
    const metaDiaria = @Model.MetaDiaria.ToString(CultureInfo.InvariantCulture);
    const paletteOps = {
        rojo: '#11439A',
        azul: '#1d4ed8',
        oro: '#c8a24a',
        verde: '#0f766e',
        gris: '#64748b'
    };

    const commonTooltip = {
        callbacks: {
            label: (ctx) => `${ctx.dataset.label || ctx.label}: ${Number(ctx.raw).toLocaleString('es-NI', { maximumFractionDigits: 1 })} Tn`
        }
    };

    const commonTooltipGal = {
        callbacks: {
            label: (ctx) => `${ctx.dataset.label || ctx.label}: ${Number(ctx.raw).toLocaleString('es-NI', { maximumFractionDigits: 2 })} gal`
        }
    };

    const formatToneladas = (value, decimals = 1, withUnit = true) => {
        const numberText = Number(value || 0).toLocaleString('es-NI', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        return withUnit ? `${numberText} Tn` : numberText;
    };

    const valueLabelsPlugin = {
        id: 'valueLabels',
        afterDatasetsDraw(chart, args, pluginOptions) {
            if (!pluginOptions || pluginOptions.enabled === false) return;

            const { ctx, chartArea } = chart;
            const config = {
                color: pluginOptions.color || '#1f2937',
                font: pluginOptions.font || '700 11px Segoe UI',
                stroke: pluginOptions.stroke || '#ffffff',
                strokeWidth: pluginOptions.strokeWidth ?? 3,
                decimals: pluginOptions.decimals ?? 1,
                withUnit: pluginOptions.withUnit ?? true
            };

            const drawText = (text, x, y, align = 'center', baseline = 'middle') => {
                ctx.save();
                ctx.font = config.font;
                ctx.textAlign = align;
                ctx.textBaseline = baseline;
                ctx.lineJoin = 'round';
                ctx.lineWidth = config.strokeWidth;
                ctx.strokeStyle = config.stroke;
                ctx.strokeText(text, x, y);
                ctx.fillStyle = config.color;
                ctx.fillText(text, x, y);
                ctx.restore();
            };

            if (chart.config.type === 'pie' || chart.config.type === 'doughnut') {
                const dataset = chart.data.datasets[0];
                const meta = chart.getDatasetMeta(0);
                if (!dataset || !meta || !meta.data?.length) return;

                const values = dataset.data.map(v => Number(v || 0));
                const total = values.reduce((acc, val) => acc + val, 0);

                meta.data.forEach((arc, index) => {
                    const value = values[index];
                    if (!(value > 0)) return;
                    const angle = (arc.startAngle + arc.endAngle) / 2;
                    const radius = arc.innerRadius + (arc.outerRadius - arc.innerRadius) * 0.62;
                    const x = arc.x + Math.cos(angle) * radius;
                    const y = arc.y + Math.sin(angle) * radius;
                    const pct = total > 0 ? ((value / total) * 100) : 0;
                    drawText(`${formatToneladas(value, config.decimals, config.withUnit)} (${pct.toFixed(1)}%)`, x, y);
                });

                return;
            }

            chart.data.datasets.forEach((dataset, datasetIndex) => {
                const meta = chart.getDatasetMeta(datasetIndex);
                if (!meta || meta.hidden || !meta.data?.length) return;
                if (dataset.type === 'line' && pluginOptions.skipLine) return;

                meta.data.forEach((element, index) => {
                    const raw = dataset.data[index];
                    const value = Number(raw || 0);
                    if (!Number.isFinite(value)) return;

                    const point = element.getProps(['x', 'y'], true);
                    const label = formatToneladas(value, config.decimals, config.withUnit);

                    if (meta.type === 'bar') {
                        if (chart.options.indexAxis === 'y') {
                            const x = Math.max(point.x - 8, chartArea.left + 36);
                            drawText(label, x, point.y, 'right', 'middle');
                        } else {
                            const y = Math.max(point.y - 8, chartArea.top + 10);
                            drawText(label, point.x, y, 'center', 'bottom');
                        }
                        return;
                    }

                    if (meta.type === 'line') {
                        const y = Math.max(point.y - 10, chartArea.top + 10);
                        drawText(label, point.x, y, 'center', 'bottom');
                    }
                });
            });
        }
    };
    Chart.register(valueLabelsPlugin);

    const staticChartOptions = {
        animation: false,
        animations: false,
        transitions: {
            active: { animation: false },
            resize: { animation: false },
            show: { animations: false },
            hide: { animations: false }
        },
        events: [],
        responsive: false,
        maintainAspectRatio: false
    };

    function lockCanvasSize(canvas) {
        if (!canvas || !canvas.parentElement) return;
        const desiredHeight = Number(canvas.getAttribute('height')) || 220;
        const parentWidth = Math.max(canvas.parentElement.clientWidth - 8, 320);
        canvas.width = parentWidth;
        canvas.height = desiredHeight;
    }

    function createStaticChart(canvasId, config) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return null;
        lockCanvasSize(canvas);
        const mergedOptions = {
            ...staticChartOptions,
            ...(config.options || {})
        };
        const chart = new Chart(canvas, { ...config, options: mergedOptions });
        chart.update('none');
        return chart;
    }

    createStaticChart('chartConductores', {
        type: 'bar',
        data: {
            labels: topConductores.map(x => x.nombre),
            datasets: [{
                label: 'Toneladas',
                data: topConductores.map(x => x.toneladas),
