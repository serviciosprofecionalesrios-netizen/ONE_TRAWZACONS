        options: {
            plugins: {
                legend: { display: true, position: 'top' },
                tooltip: commonTooltipGal,
                valueLabels: {
                    enabled: true,
                    decimals: 2,
                    withUnit: false,
                    skipLine: true
                }
            },
            scales: { y: { beginAtZero: true } }
