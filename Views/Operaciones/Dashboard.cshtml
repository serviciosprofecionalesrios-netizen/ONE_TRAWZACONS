                {
                    label: 'TRITON',
                    data: comparativoToneladasSitio.map(x => x.triton),
                    backgroundColor: paletteOps.rojo,
                    borderRadius: 8
                },
                {
                    type: 'line',
                    label: 'Nivel mensual TRITON',
