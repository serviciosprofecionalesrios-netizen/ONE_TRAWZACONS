    function normalizeMonthText(monthText) {
        return String(monthText || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim()
            .toLowerCase();
    }

    function getNextMonthLabel(monthLabel) {
        const orderedMonths = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
        const current = normalizeMonthText(monthLabel);
        const index = orderedMonths.indexOf(current);
        if (index < 0) {
            return 'Mes siguiente';
        }

        const nextIndex = (index + 1) % orderedMonths.length;
        const nextMonth = orderedMonths[nextIndex];
        return nextMonth.charAt(0).toUpperCase() + nextMonth.slice(1);
    }

    function forecastNextByLinearRegression(values) {
        const cleanValues = (values || []).map(x => Number(x || 0));
        const n = cleanValues.length;
        if (n === 0) return 0;
        if (n === 1) return Math.max(0, cleanValues[0]);

        let sumX = 0;
        let sumY = 0;
        let sumXY = 0;
        let sumXX = 0;

        for (let i = 0; i < n; i++) {
            const x = i + 1;
            const y = cleanValues[i];
            sumX += x;
            sumY += y;
            sumXY += x * y;
            sumXX += x * x;
        }

        const denominator = (n * sumXX) - (sumX * sumX);
        if (denominator === 0) {
            return Math.max(0, cleanValues[n - 1]);
        }

        const slope = ((n * sumXY) - (sumX * sumY)) / denominator;
        const intercept = (sumY - (slope * sumX)) / n;
        const prediction = intercept + (slope * (n + 1));
        return Math.max(0, prediction);
    }

    const historicoMeses = comparativoToneladasSitio.map(x => x.mes);
    const historicoTotales = comparativoToneladasSitio.map(x => Number(x.triton || 0));
    const ultimoMes = historicoMeses.length ? historicoMeses[historicoMeses.length - 1] : '';
    const mesSiguiente = getNextMonthLabel(ultimoMes);
    const prediccionMesSiguiente = forecastNextByLinearRegression(historicoTotales);
    const labelsPrediccionMensual = [...historicoMeses, `${mesSiguiente} (Proy.)`];
    const dataLineaMensual = [...historicoTotales, prediccionMesSiguiente];
    const dataHistoricoMensual = [...historicoTotales, null];
    const dataProyeccionMensual = new Array(historicoTotales.length).fill(null).concat(prediccionMesSiguiente);

    createStaticChart('chartPrediccionMesSiguiente', {
        type: 'bar',
        data: {
            labels: labelsPrediccionMensual,
            datasets: [
                {
                    label: 'Historico mensual',
                    data: dataHistoricoMensual,
                    backgroundColor: paletteOps.oro,
                    borderRadius: 8
                },
                {
                    label: 'Proyeccion mes siguiente',
                    data: dataProyeccionMensual,
                    backgroundColor: paletteOps.verde,
                    borderRadius: 8
                },
                {
                    type: 'line',
                    label: 'Tendencia y proyeccion',
                    data: dataLineaMensual,
                    borderColor: '#1f2937',
                    backgroundColor: '#1f2937',
                    borderWidth: 2.5,
                    tension: 0.25,
                    fill: false,
                    pointRadius: 3,
                    pointHoverRadius: 3
                }
            ]
        },
