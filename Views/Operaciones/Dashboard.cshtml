            plugins: {
                legend: { display: true, position: 'top' },
                tooltip: commonTooltip,
                valueLabels: {
                    enabled: true,
                    decimals: 1,
                    skipLine: true
                }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    const prediccionNota = document.getElementById('prediccionMesSiguienteNota');
    if (prediccionNota) {
        prediccionNota.textContent = `Proyeccion estimada para ${mesSiguiente}: ${prediccionMesSiguiente.toLocaleString('es-NI', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} toneladas, calculada desde el historico mensual cargado.`;
    }

    createStaticChart('chartTendencia', {
        type: 'line',
        data: {
            labels: tendencia.map(x => x.fecha),
            datasets: [{
                label: 'Toneladas finalizadas',
                data: tendencia.map(x => x.toneladas),
                borderColor: paletteOps.azul,
                backgroundColor: 'rgba(29, 78, 216, 0.14)',
