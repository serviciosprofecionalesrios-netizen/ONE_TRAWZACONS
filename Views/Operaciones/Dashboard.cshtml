        },
        options: {
            plugins: {
                legend: { display: true, position: 'top' },
                tooltip: commonTooltip,
                valueLabels: {
                    enabled: true,
                    decimals: 1,
                    skipLine: true
                }
            },
            scales: { y: { beginAtZero: true } }
        }
    });

    createStaticChart('chartComparativoDieselSitio', {
        type: 'bar',
        data: {
            labels: comparativoDieselSitio.map(x => x.mes),
            datasets: [
                {
                    label: 'TRITON',
                    data: comparativoDieselSitio.map(x => x.triton),
                    backgroundColor: paletteOps.azul,
                    borderRadius: 8
                },
                {
                    type: 'line',
                    label: 'Nivel mensual TRITON',
                    data: comparativoDieselSitio.map(x => Number(x.triton || 0)),
                    borderColor: '#1f2937',
                    backgroundColor: '#1f2937',
                    borderWidth: 2.5,
                    tension: 0.25,
                    fill: false,
                    pointRadius: 3,
                    pointHoverRadius: 3
                }
            ]
