@model ITServiceDeskApp.ViewModels.Operaciones.DriverScoreViewModel
@if(!string.IsNullOrWhiteSpace(Model.DistanceWarning)){<div class="alert alert-warning">@Model.DistanceWarning</div>}
<div class="row g-3 mb-4">
@foreach(var kpi in new[] { ("Conductores en rojo", Model.CriticalDrivers.ToString(), "danger"), ("Gestionadas a tiempo", Model.TimelyPercent.ToString("N1") + "%", "success"), ("Coaching pendiente", Model.CoachingPending.ToString(), "warning"), (Model.UsingDateRange ? "Cambio frente al rango del mes anterior" : "Cambio frente al mes anterior", Model.MonthChange.HasValue ? Model.MonthChange.Value.ToString("+0.0;-0.0;0.0") + "%" : "Sin base comparable", Model.TotalEvents > Model.PreviousMonthEvents ? "danger" : "success") }) {
<div class="col-md-3"><div class="card score-kpi h-100"><div class="card-body"><small>@kpi.Item1</small><div class="value text-@kpi.Item3">@kpi.Item2</div></div></div></div>
}
</div>
<div class="card mb-4"><div class="card-body d-flex gap-4 flex-wrap"><span><i class="bi bi-hourglass-split text-warning"></i> Pendientes: <strong>@Model.PendingCases</strong></span><span><i class="bi bi-person-check text-primary"></i> En seguimiento: <strong>@Model.FollowingCases</strong></span><span><i class="bi bi-check-circle text-success"></i> Cerrados: <strong>@Model.ClosedCases</strong></span><a asp-action="DriverScoreCases" asp-route-period="@Model.SelectedPeriod" asp-route-driver="@Model.SelectedDriver" asp-route-from="@(Model.UsingDateRange ? Model.From?.ToString("yyyy-MM-dd") : null)" asp-route-to="@(Model.UsingDateRange ? Model.To?.ToString("yyyy-MM-dd") : null)">Gestionar casos</a></div></div>
<div class="card mb-4"><div class="card-header fw-bold">Reincidencias después del coaching</div><div class="table-responsive recent-events-scroll"><table class="table table-sm mb-0"><thead><tr><th>Conductor</th><th>Unidad</th><th>Evento</th><th>Último coaching registrado</th><th>Eventos posteriores</th></tr></thead><tbody>
@foreach(var item in Model.RepeatedAfterCoaching){<tr><td>@item.Driver</td><td>@item.Vehicle</td><td>@item.EventType</td><td>@item.CoachingAt.ToString("dd/MM/yyyy HH:mm")</td><td class="text-danger fw-bold">@item.Count</td></tr>}
@if(!Model.RepeatedAfterCoaching.Any()){<tr><td colspan="5" class="text-muted p-3">Sin reincidencias detectadas con los registros disponibles.</td></tr>}
</tbody></table></div><div class="card-footer small text-muted">Se usa la fecha del evento que tiene coaching marcado; la fuente no indica la fecha real de la sesión.</div></div>
@if(!string.IsNullOrWhiteSpace(Model.SelectedDriver)) {
<div class="card mb-4"><div class="card-header fw-bold">Historial completo · @Model.SelectedDriver</div><div class="table-responsive recent-events-scroll"><table class="table table-sm mb-0"><thead><tr><th>Fecha</th><th>Unidad</th><th>Evento</th><th>Gestión</th><th>Coaching</th><th>Observación</th></tr></thead><tbody>
@foreach(var item in Model.History){<tr><td>@item.Date?.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Vehicle</td><td>@item.EventType</td><td>@(item.Timely ? "A tiempo" : "Fuera de tiempo")</td><td>@(item.Coaching ? "Realizado" : "Pendiente") @if(item.HasEvidence){<a asp-action="DriverScoreEvidence" asp-route-id="@item.ManualId">Descargar evidencia</a>}</td><td>@item.Observation</td></tr>}
</tbody></table></div></div>
}
