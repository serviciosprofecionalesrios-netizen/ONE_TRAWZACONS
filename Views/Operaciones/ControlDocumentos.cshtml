@model ITServiceDeskApp.ViewModels.Operaciones.ControlDocumentosViewModel
@using System.Globalization
@using System.Linq
@using System.Text.Json
@{
    ViewData["Title"] = "Control de documentos";
    var conductoresAlDia = 0;
    var conductoresPorVencer = 0;
    var conductoresVencidos = 0;
    var conductoresSinFecha = 0;

    foreach (var filaResumen in Model.Filas)
    {
        var estados = filaResumen.Capacitaciones
            .Select(c => (c.EstadoFiltro ?? string.Empty).Trim().ToLowerInvariant())
            .ToList();

        var tieneVencida = estados.Contains("vencida");
        var tieneSinFecha = estados.Contains("sinfecha");
        var tienePorVencer = estados.Contains("porvencer");

        if (tieneVencida)
        {
            conductoresVencidos++;
        }
        else if (tieneSinFecha)
        {
            conductoresSinFecha++;
        }
        else if (tienePorVencer)
        {
            conductoresPorVencer++;
        }
        else
        {
            conductoresAlDia++;
        }
    }

    var conductoresNoOpera = conductoresVencidos + conductoresSinFecha;
    var conductoresOperaConAlerta = conductoresPorVencer;
    var conductoresPuedeOperar = conductoresAlDia;
    var maxTendenciaSemanal = Math.Max(1, Model.TendenciaSemanal.Any() ? Model.TendenciaSemanal.Max(x => x.TotalCambios) : 1);
    var maxTendenciaMensual = Math.Max(1, Model.TendenciaMensual.Any() ? Model.TendenciaMensual.Max(x => x.TotalCambios) : 1);
    var totalIngresosEquipo = Model.EquiposGondolas.Count(x => string.Equals(x.Tipo, "Ingreso de Equipo", StringComparison.OrdinalIgnoreCase));
    var totalIngresosGondola = Model.EquiposGondolas.Count(x => string.Equals(x.Tipo, "Ingreso de Gondola", StringComparison.OrdinalIgnoreCase));
    var totalEquiposConSeguroPorVencer = Model.EquiposGondolas.Count(x => !string.IsNullOrWhiteSpace(x.VencimientoSeguroVehicular) && x.VencimientoSeguroVehicular != "-");

    var drawerRows = Model.Filas
        .Select((filaDrawer, rowIndex) => new
        {
            RowIndex = rowIndex,
            Conductor = filaDrawer.Conductor,
            Capacitaciones = Model.EncabezadosCapacitacion
                .Select((encabezadoDrawer, capIndex) =>
                {
                    var capDrawer = capIndex < filaDrawer.Capacitaciones.Count
                        ? filaDrawer.Capacitaciones[capIndex]
                        : null;
                    var fechaDrawer = capDrawer?.Fecha
                        ?? (capIndex < filaDrawer.FechasCapacitacion.Count ? filaDrawer.FechasCapacitacion[capIndex] : "-");
                    return new
                    {
                        Nombre = encabezadoDrawer,
                        Fecha = string.IsNullOrWhiteSpace(fechaDrawer) ? "-" : fechaDrawer,
                        Estado = capDrawer?.EstadoSemaforo ?? "rojo",
                        EstadoFiltro = capDrawer?.EstadoFiltro ?? "sinfecha",
                        Etiqueta = capDrawer?.EtiquetaSemaforo ?? "Sin fecha",
                        Alerta = capDrawer?.MensajeAlerta ?? "No hay fecha registrada."
                    };
                })
                .ToList()
        })
        .ToList();

    var drawerRowsJson = JsonSerializer.Serialize(drawerRows);
}

