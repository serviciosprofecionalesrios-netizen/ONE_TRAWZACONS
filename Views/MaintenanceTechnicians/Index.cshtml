@model IEnumerable<ITServiceDeskApp.Models.MaintenanceTechnician>
@using ITServiceDeskApp.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Personal tecnico de taller";
    var rows = Model ?? Enumerable.Empty<MaintenanceTechnician>();
    var categoryOptions = ViewBag.CategoryOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var availabilityOptions = ViewBag.AvailabilityOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var includeInactive = ViewBag.IncludeInactive is bool b && b;
    var search = ViewBag.Search as string ?? string.Empty;
    var totalTechnicians = ViewBag.TotalTechnicians is int total ? total : rows.Count();
    var availableCount = ViewBag.AvailableCount is int available ? available : rows.Count(x => x.IsAvailable);
    var unavailableCount = ViewBag.UnavailableCount is int unavailable ? unavailable : rows.Count(x => !x.IsAvailable);
    var activeLoads = ViewBag.ActiveLoads as IDictionary<string, int> ?? new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1">Personal tecnico de taller</h2>
            <p class="text-muted mb-0">Catalogo de mecanicos, electricos, llanteros y demas personal tecnico para asignacion por categoria.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Nuevo tecnico
        </a>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total</div>
                    <div class="h4 mb-0">@totalTechnicians</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Disponibles</div>
                    <div class="h4 mb-0 text-success">@availableCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">No disponibles</div>
                    <div class="h4 mb-0 text-warning">@unavailableCount</div>
                </div>
            </div>
        </div>
    </div>

    <form method="get" asp-action="Index" class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Buscar</label>
                    <input type="text" class="form-control" name="search" value="@search" placeholder="Nombre, celular, contacto emergencia..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Categoria</label>
                    <select class="form-select" name="category" asp-items="categoryOptions">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Disponibilidad</label>
                    <select class="form-select" name="availability">
                        @foreach (var option in availabilityOptions)
                        {
                            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive" @(includeInactive ? "checked" : "") />
                        <label class="form-check-label" for="includeInactive">Incluir inactivos</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tecnico</th>
                        <th>Categoria</th>
                        <th>Turno</th>
                        <th>Carga</th>
                        <th>Celular</th>
                        <th>Contacto emergencia</th>
                        <th>Parentesco</th>
                        <th>Celular emergencia</th>
                        <th>Disponibilidad</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!rows.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">No hay tecnicos registrados con los filtros aplicados.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in rows)
                        {
                            var activeOrders = activeLoads.TryGetValue(row.FullName, out var value) ? value : 0;
                            var capacity = Math.Max(1, row.MaxActiveOrders);
                            var overCapacity = activeOrders >= capacity;
                            <tr class="@(row.IsActive ? string.Empty : "table-secondary")">
                                <td>
                                    <div class="fw-semibold">@row.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(row.Notes))
                                    {
                                        <small class="text-muted">@row.Notes</small>
                                    }
                                </td>
                                <td>@row.Category</td>
                                <td>@row.Shift</td>
                                <td>
                                    <span class="badge @(overCapacity ? "bg-danger-subtle text-danger-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                        @activeOrders/@capacity
                                    </span>
                                </td>
                                <td>@row.PhoneNumber</td>
                                <td>@row.EmergencyContactName</td>
                                <td>@row.EmergencyRelationship</td>
                                <td>@row.EmergencyContactPhone</td>
                                <td>
                                    @if (row.IsAvailable)
                                    {
                                        <span class="badge bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">No disponible</span>
                                    }
                                </td>
                                <td>
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-primary">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    @if (row.IsActive)
                                    {
                                        <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="btn btn-sm @(row.IsAvailable ? "btn-outline-warning" : "btn-outline-success")">
                                                @(row.IsAvailable ? "Marcar no disponible" : "Marcar disponible")
                                            </button>
                                        </form>

                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
