@model ITServiceDeskApp.Models.InventoryItem

@{
    ViewData["Title"] = "Editar Activo";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white module-banner">
            <h4 class="mb-0"><i class="bi bi-box-seam" aria-hidden="true"></i><span>Editar Activo - @Model.AssetCode</span></h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="UpdatedAt" />
                <input type="hidden" asp-for="RowVersion" />

                <partial name="_Form" model="Model" />

                <div class="text-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
