@model ITServiceDeskApp.ViewModels.CalendarViewModel

@{
    ViewData["Title"] = "Calendario";
    var dayHeaders = new[] { "LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM" };
    var selectedSla = string.IsNullOrWhiteSpace(Model.SelectedSla) ? "all" : Model.SelectedSla;
    var selectedTech = string.IsNullOrWhiteSpace(Model.SelectedTechnician) ? "all" : Model.SelectedTechnician;
    var selectedQuick = string.IsNullOrWhiteSpace(Model.SelectedQuick) ? "all" : Model.SelectedQuick;
    var selectedScope = string.IsNullOrWhiteSpace(Model.Scope) ? "it" : Model.Scope;
    var isMaintenanceScope = Model.IsMaintenanceScope;
    var selectedDateIso = string.IsNullOrWhiteSpace(Model.SelectedDateIso)
        ? DateTime.Today.ToString("yyyy-MM-dd")
        : Model.SelectedDateIso;
}

<style>
    .calendar-page {
        --ok-bg: #e6f8ee;
        --ok-text: #159947;
        --near-bg: #fff4d9;
        --near-text: #c57c00;
        --late-bg: #ffe7e7;
        --late-text: #d53b3b;
        --critical-bg: #fff0dd;
        --critical-text: #dd6b20;
    }

    .calendar-summary-card {
        border: 1px solid #e8ebef;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
        background: #ffffff;
    }

    .calendar-summary-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .calendar-summary-title {
        color: #5e6b7d;
        font-size: 0.95rem;
    }

    .calendar-summary-value {
        font-weight: 800;
        color: #13213a;
        line-height: 1;
        font-size: 1.65rem;
    }

    .calendar-toolbar {
        border: 1px solid #e8ebef;
        border-radius: 16px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

    .calendar-nav-btn {
        width: 46px;
        height: 46px;
        border: 1px solid #d6dde8;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #10223f;
        text-decoration: none;
        background-color: #ffffff;
        transition: all 0.2s ease;
    }

    .calendar-nav-btn:hover {
        color: #ffffff;
        background-color: #0f6e9c;
        border-color: #0f6e9c;
    }

    .calendar-month-title {
        font-weight: 800;
        color: #10223f;
        margin: 0;
    }

    .calendar-quick-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .calendar-quick-tab {
        border: 1px solid #d6dde8;
        border-radius: 999px;
        padding: 0.28rem 0.76rem;
        font-weight: 700;
        color: #31435f;
        background: #ffffff;
        text-decoration: none;
        font-size: 0.86rem;
        line-height: 1.35;
    }

    .calendar-quick-tab:hover {
        color: #0f6e9c;
        border-color: #0f6e9c;
        background: #edf6fb;
    }

    .calendar-quick-tab.active {
        color: #ffffff;
        border-color: #0f6e9c;
        background: #0f6e9c;
    }

    .calendar-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        color: #40516b;
        font-weight: 500;
    }

    .calendar-legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 0.5rem;
        vertical-align: middle;
    }

    .calendar-board-wrap {
        overflow-x: auto;
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    }

    .calendar-board {
        min-width: 980px;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .calendar-cell-head {
        background-color: #f8fafc;
        color: #5b6b82;
        text-align: center;
        font-weight: 700;
        padding: 0.9rem 0.5rem;
        border-bottom: 1px solid #e6ebf2;
        border-right: 1px solid #edf2f7;
        letter-spacing: 0.04em;
    }

    .calendar-cell-head:last-child {
        border-right: 0;
    }

    .calendar-day {
        min-height: 145px;
        border-right: 1px solid #edf2f7;
        border-bottom: 1px solid #edf2f7;
        padding: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        background-color: #ffffff;
    }

    .calendar-day:nth-child(7n) {
        border-right: 0;
    }

    .calendar-day--outside {
        background-color: #fafbfc;
        color: #a0aec0;
    }

    .calendar-day--today {
        background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
    }

    .calendar-day--selected {
        box-shadow: inset 0 0 0 2px #0f6e9c;
        background: linear-gradient(180deg, #e9f5ff 0%, #ffffff 100%);
    }

    .calendar-day-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
    }

    .calendar-day-number {
        font-weight: 700;
        color: #1c2f4e;
    }

    .calendar-day--outside .calendar-day-number {
        color: #9aa8bc;
    }

    .calendar-day-count {
        background: #eef2f7;
        color: #607188;
        border-radius: 999px;
        min-width: 1.4rem;
        height: 1.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0 0.35rem;
    }

    .calendar-day-events {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .ticket-chip {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border-radius: 8px;
        text-decoration: none;
        padding: 0.3rem 0.45rem;
        font-size: 0.9rem;
        font-weight: 700;
        border-left: 3px solid transparent;
        transition: transform 0.15s ease;
    }

    .ticket-chip:hover {
        transform: translateY(-1px);
        text-decoration: none;
    }

    .ticket-chip-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        flex: 0 0 auto;
    }

    .ticket-chip--compliant {
        color: var(--ok-text);
        background-color: var(--ok-bg);
        border-left-color: #22c55e;
    }

    .ticket-chip--compliant .ticket-chip-dot {
        background-color: #22c55e;
    }

    .ticket-chip--near {
        color: var(--near-text);
        background-color: var(--near-bg);
        border-left-color: #f59e0b;
    }

    .ticket-chip--near .ticket-chip-dot {
        background-color: #f59e0b;
    }

    .ticket-chip--breached {
        color: var(--late-text);
        background-color: var(--late-bg);
        border-left-color: #ef4444;
    }

    .ticket-chip--breached .ticket-chip-dot {
        background-color: #ef4444;
    }

    .ticket-chip--appointment {
        color: #0f766e;
        background-color: #e6fffa;
        border-left-color: #14b8a6;
    }

    .ticket-chip--appointment .ticket-chip-dot {
        background-color: #14b8a6;
    }

    .ticket-chip--maintenance-active {
        color: #0f172a;
        background-color: #f0f9ff;
        border-left-color: #0ea5e9;
    }

    .ticket-chip--maintenance-active .ticket-chip-dot {
        background-color: #0ea5e9;
    }

    .ticket-chip--maintenance-review {
        color: #1d4ed8;
        background-color: #eff6ff;
        border-left-color: #1d4ed8;
    }

    .ticket-chip--maintenance-review .ticket-chip-dot {
        background-color: #1d4ed8;
    }

    .ticket-chip--maintenance-closed {
        color: #475569;
        background-color: #f1f5f9;
        border-left-color: #64748b;
    }

    .ticket-chip--maintenance-closed .ticket-chip-dot {
        background-color: #64748b;
    }

    .ticket-chip-code {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ticket-chip-critical {
        margin-left: auto;
        font-size: 0.72rem;
        font-weight: 800;
        color: var(--critical-text);
        background: var(--critical-bg);
        border-radius: 999px;
        padding: 0.1rem 0.35rem;
    }

    .calendar-day-more {
        color: #6f7f95;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .calendar-day-select {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dashed transparent;
    }

    .calendar-day-select:hover {
        color: #0f6e9c;
        border-bottom-color: #0f6e9c;
    }

    .maintenance-day-breakdown {
        font-size: 0.72rem;
        color: #51607a;
        margin-top: 0.25rem;
        font-weight: 700;
    }

    .calendar-load-card {
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

    .maintenance-side-panel {
        border: 1px solid #dbe6f3;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
        position: sticky;
        top: 0.75rem;
    }

    .maintenance-side-panel .panel-head {
        border-bottom: 1px solid #e5edf6;
        padding: 0.9rem 1rem;
    }

    .maintenance-side-panel .panel-body {
        padding: 0.9rem 1rem 1rem;
        max-height: 72vh;
        overflow-y: auto;
    }

    .maintenance-side-panel .table {
        font-size: 0.87rem;
    }

    .calendar-load-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        padding: 0.65rem 0;
        border-bottom: 1px dashed #e8edf4;
    }

    .calendar-load-row:last-child {
        border-bottom: 0;
    }

    @@media (max-width: 991.98px) {
        .calendar-summary-value {
            font-size: 1.4rem;
        }

        .calendar-month-title {
            font-size: 1.4rem;
        }
    }
</style>

<div class="container-fluid calendar-page">

    @if (!isMaintenanceScope)
    {
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-2">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: #ecf2ff; color: #1d4ed8;">
                    <i class="bi bi-calendar-week"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.TotalTicketsCount</div>
                    <div class="calendar-summary-title">Tickets visibles</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-2">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: var(--ok-bg); color: var(--ok-text);">
                    <i class="bi bi-check-circle-fill"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.SlaCompliantCount</div>
                    <div class="calendar-summary-title">SLA cumplido</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-2">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: var(--near-bg); color: var(--near-text);">
                    <i class="bi bi-exclamation-circle-fill"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.SlaNearDueCount</div>
                    <div class="calendar-summary-title">Proximo a vencer</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-2">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: var(--late-bg); color: var(--late-text);">
                    <i class="bi bi-x-circle-fill"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.SlaBreachedCount</div>
                    <div class="calendar-summary-title">SLA vencido</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-2">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: var(--critical-bg); color: var(--critical-text);">
                    <i class="bi bi-fire"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.CriticalPriorityCount</div>
                    <div class="calendar-summary-title">Criticos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-2">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: #edf2f7; color: #475569;">
                    <i class="bi bi-person-dash"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.UnassignedCount</div>
                    <div class="calendar-summary-title">Sin asignar</div>
                </div>
            </div>
        </div>
    </div>
    }
    else
    {
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: #e6fffa; color: #0f766e;">
                    <i class="bi bi-calendar2-check"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.MaintenanceAppointmentsCount</div>
                    <div class="calendar-summary-title">Citas del mes</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: #e0f2fe; color: #0369a1;">
                    <i class="bi bi-tools"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.MaintenanceActiveEquipmentCount</div>
                    <div class="calendar-summary-title">Equipos en mantenimiento</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: #fef3c7; color: #b45309;">
                    <i class="bi bi-box-arrow-in-down"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.MaintenanceEnteredThisMonthCount</div>
                    <div class="calendar-summary-title">Entraron este mes</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="calendar-summary-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="calendar-summary-icon" style="background: #fee2e2; color: #b91c1c;">
                    <i class="bi bi-box-arrow-up-right"></i>
                </span>
                <div>
                    <div class="calendar-summary-value">@Model.MaintenanceClosedThisMonthCount</div>
                    <div class="calendar-summary-title">Salieron este mes</div>
                </div>
            </div>
        </div>
    </div>
    }

    <div class="calendar-toolbar p-3 p-lg-4 mb-3">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-start align-items-xl-center gap-3">

            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a class="calendar-nav-btn"
                   asp-action="Index"
                   asp-route-year="@Model.PreviousYear"
                   asp-route-month="@Model.PreviousMonth"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="@selectedQuick"
                   title="Mes anterior">
                    <i class="bi bi-chevron-left"></i>
                </a>

                <h2 class="calendar-month-title">@Model.CurrentMonthLabel</h2>

                <a class="calendar-nav-btn"
                   asp-action="Index"
                   asp-route-year="@Model.NextYear"
                   asp-route-month="@Model.NextMonth"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="@selectedQuick"
                   title="Mes siguiente">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>

            <form method="get" class="row g-2 align-items-center ms-xl-auto">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="scope" value="@selectedScope" />
                <input type="hidden" name="selectedDate" value="@selectedDateIso" />
                @if (!isMaintenanceScope)
                {
                    <input type="hidden" name="quick" value="@selectedQuick" />
                }

                <div class="col-auto">
                    <label for="sla" class="form-label mb-0 fw-semibold text-muted">@(isMaintenanceScope ? "Vista:" : "SLA:")</label>
                </div>
                <div class="col-auto">
                    <select id="sla" name="sla" class="form-select" onchange="this.form.submit()">
                        @foreach (var option in Model.SlaOptions)
                        {
                            @if (option.Value == selectedSla)
                            {
                                <option value="@option.Value" selected="selected">@option.Label</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-auto">
                    <label for="technician" class="form-label mb-0 fw-semibold text-muted">Tecnico:</label>
                </div>
                <div class="col-auto">
                    <select id="technician" name="technician" class="form-select" onchange="this.form.submit()">
                        @foreach (var option in Model.TechnicianOptions)
                        {
                            @if (option.Value == selectedTech)
                            {
                                <option value="@option.Value" selected="selected">@option.Label</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        }
                    </select>
                </div>
            </form>

        </div>

        @if (!isMaintenanceScope)
        {
            <div class="calendar-quick-tabs mt-3">
                <a class="calendar-quick-tab @(selectedQuick == "all" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="all">Todos</a>
                <a class="calendar-quick-tab @(selectedQuick == "today" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="today">Hoy</a>
                <a class="calendar-quick-tab @(selectedQuick == "overdue" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="overdue">Vencidos</a>
                <a class="calendar-quick-tab @(selectedQuick == "unassigned" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="unassigned">Sin asignar</a>
                <a class="calendar-quick-tab @(selectedQuick == "critical" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="critical">Criticos</a>
                <a class="calendar-quick-tab @(selectedQuick == "myload" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.Year"
                   asp-route-month="@Model.Month"
                   asp-route-sla="@selectedSla"
                   asp-route-technician="@selectedTech"
                   asp-route-scope="@selectedScope"
                   asp-route-selectedDate="@selectedDateIso"
                   asp-route-quick="myload">Mi carga (@Model.MyLoadCount)</a>
            </div>

            <div class="calendar-legend mt-3">
                <span><span class="calendar-legend-dot" style="background:#22c55e;"></span>SLA cumplido</span>
                <span><span class="calendar-legend-dot" style="background:#f59e0b;"></span>Proximo a vencer</span>
                <span><span class="calendar-legend-dot" style="background:#ef4444;"></span>SLA vencido</span>
            </div>
        }
        else
        {
            <div class="calendar-legend mt-3">
                <span><span class="calendar-legend-dot" style="background:#14b8a6;"></span>Citas programadas</span>
                <span><span class="calendar-legend-dot" style="background:#0ea5e9;"></span>Equipos en mantenimiento</span>
                <span class="small text-muted">Haz click en la fecha para ver el detalle del dia y equipos activos desde esa fecha.</span>
            </div>
        }
    </div>

    @if (!isMaintenanceScope)
    {
        <div class="calendar-board-wrap">
            <div class="calendar-board">
                @foreach (var day in dayHeaders)
                {
                    <div class="calendar-cell-head">@day</div>
                }

                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var day = Model.Days[i];

                    <div class="calendar-day @(day.IsCurrentMonth ? string.Empty : "calendar-day--outside") @(day.IsToday ? "calendar-day--today" : string.Empty) @(day.IsSelected ? "calendar-day--selected" : string.Empty)">
                        <div class="calendar-day-top">
                            <a class="calendar-day-number calendar-day-select"
                               asp-action="Index"
                               asp-route-year="@Model.Year"
                               asp-route-month="@Model.Month"
                               asp-route-sla="@selectedSla"
                               asp-route-technician="@selectedTech"
                               asp-route-quick="@selectedQuick"
                               asp-route-scope="@selectedScope"
                               asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")">@day.Date.Day</a>
                            @if (day.Tickets.Count > 0)
                            {
                                <span class="calendar-day-count">@day.Tickets.Count</span>
                            }
                        </div>

                        <div class="calendar-day-events">
                            @foreach (var ticket in day.Tickets.Take(4))
                            {
                                <a href="@ticket.DetailUrl"
                                   class="@ticket.CssClass"
                                   title="@($"{ticket.ItemTypeLabel}: {ticket.TicketNumber} - {ticket.SlaLabel}")">
                                    <span class="ticket-chip-dot"></span>
                                    <span class="ticket-chip-code">@ticket.TicketNumber</span>
                                    @if (ticket.IsCritical)
                                    {
                                        <span class="ticket-chip-critical">P1</span>
                                    }
                                </a>
                            }

                            @if (day.Tickets.Count > 4)
                            {
                                <span class="calendar-day-more">+@(day.Tickets.Count - 4) mas...</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-xxl-8">
                <div class="calendar-board-wrap">
                    <div class="calendar-board">
                        @foreach (var day in dayHeaders)
                        {
                            <div class="calendar-cell-head">@day</div>
                        }

                        @for (var i = 0; i < Model.Days.Count; i++)
                        {
                            var day = Model.Days[i];

                            <div class="calendar-day @(day.IsCurrentMonth ? string.Empty : "calendar-day--outside") @(day.IsToday ? "calendar-day--today" : string.Empty) @(day.IsSelected ? "calendar-day--selected" : string.Empty)">
                                <div class="calendar-day-top">
                                    <a class="calendar-day-number calendar-day-select"
                                       asp-action="Index"
                                       asp-route-year="@Model.Year"
                                       asp-route-month="@Model.Month"
                                       asp-route-sla="@selectedSla"
                                       asp-route-technician="@selectedTech"
                                       asp-route-quick="@selectedQuick"
                                       asp-route-scope="@selectedScope"
                                       asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")">@day.Date.Day</a>
                                    @if (day.Tickets.Count > 0)
                                    {
                                        <span class="calendar-day-count">@day.Tickets.Count</span>
                                    }
                                </div>
                                @if (day.AppointmentsCount > 0 || day.EquipmentCount > 0)
                                {
                                    <div class="maintenance-day-breakdown">C:@day.AppointmentsCount | E:@day.EquipmentCount</div>
                                }

                                <div class="calendar-day-events">
                                    @foreach (var ticket in day.Tickets.Take(4))
                                    {
                                        <a href="@ticket.DetailUrl"
                                           class="@ticket.CssClass"
                                           title="@($"{ticket.ItemTypeLabel}: {ticket.TicketNumber} - {ticket.SlaLabel}")">
                                            <span class="ticket-chip-dot"></span>
                                            <span class="ticket-chip-code">@ticket.TicketNumber</span>
                                            @if (ticket.IsCritical)
                                            {
                                                <span class="ticket-chip-critical">P1</span>
                                            }
                                        </a>
                                    }

                                    @if (day.Tickets.Count > 4)
                                    {
                                        <span class="calendar-day-more">+@(day.Tickets.Count - 4) mas...</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-xxl-4">
                <div class="maintenance-side-panel">
                    <div class="panel-head d-flex justify-content-between align-items-center gap-2 flex-wrap">
                        <div>
                            <div class="fw-bold">Detalle del @((Model.SelectedDate ?? DateTime.Today).ToString("dd/MM/yyyy"))</div>
                            <small class="text-muted">@Model.MaintenanceInWorkshopFromDateCount equipo(s) activos desde esa fecha</small>
                        </div>
                    </div>
                    <div class="panel-body">
                        <h6 class="fw-bold mb-2">Citas programadas</h6>
                        @if (Model.SelectedDateAppointments.Any())
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Cita</th>
                                            <th>Hora</th>
                                            <th>Equipo/Area</th>
                                            <th>Accion</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.SelectedDateAppointments)
                                        {
                                            <tr>
                                                <td>@row.Number</td>
                                                <td>@row.StartDate.ToString("HH:mm")</td>
                                                <td>@row.EquipmentOrArea</td>
                                                <td><a class="btn btn-sm btn-outline-primary" href="@row.DetailUrl">Ver</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No hay citas para la fecha seleccionada.</div>
                        }

                        <h6 class="fw-bold mb-2">Equipos en mantenimiento (desde esa fecha)</h6>
                        @if (Model.SelectedDateEquipment.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Orden</th>
                                            <th>Equipo</th>
                                            <th>Ingreso</th>
                                            <th>Dias</th>
                                            <th>Accion</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.SelectedDateEquipment)
                                        {
                                            <tr>
                                                <td>@row.Number</td>
                                                <td>@row.EquipmentOrArea</td>
                                                <td>@row.StartDate.ToString("dd/MM/yyyy")</td>
                                                <td>@row.DaysInWorkshop</td>
                                                <td><a class="btn btn-sm btn-outline-primary" href="@row.DetailUrl">Ver</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">No hay equipos activos para la fecha seleccionada.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="calendar-load-card mt-3 p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 fw-bold">Carga por tecnico (filtro actual)</h6>
            <small class="text-muted">Top 8</small>
        </div>
        @if (Model.TechnicianLoads.Any())
        {
            @foreach (var row in Model.TechnicianLoads)
            {
                <div class="calendar-load-row">
                    <div class="fw-semibold">@row.Technician</div>
                    <div class="small">
                        <span class="badge text-bg-primary me-1">@row.TotalTickets total</span>
                        <span class="badge text-bg-danger me-1">@row.BreachedTickets vencidos</span>
                        <span class="badge text-bg-dark">@row.CriticalTickets criticos</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-muted small">No hay tickets para los filtros actuales.</div>
        }
    </div>

</div>
