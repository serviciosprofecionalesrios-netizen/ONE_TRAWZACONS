@model ITServiceDeskApp.Models.Credential
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nueva Credencial";
    var typeOptions = ViewBag.TypeOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Nueva Credencial</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Nombre del recurso</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Type" class="form-label">Tipo</label>
                        <select asp-for="Type" asp-items="typeOptions" class="form-select">
                            <option value="">Seleccionar tipo</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="EnvironmentOrLocation" class="form-label">Ambiente / Ubicacion</label>
                        <input asp-for="EnvironmentOrLocation" class="form-control" />
                        <span asp-validation-for="EnvironmentOrLocation" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="AccessUrlOrHost" class="form-label">Host / URL de acceso</label>
                        <input asp-for="AccessUrlOrHost" class="form-control" />
                        <span asp-validation-for="AccessUrlOrHost" class="text-danger"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Port" class="form-label">Puerto</label>
                        <input asp-for="Port" class="form-control" />
                        <span asp-validation-for="Port" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Username" class="form-label">Usuario</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Secret" class="form-label">Contrasena / Token</label>
                        <input asp-for="Secret" class="form-control" />
                        <span asp-validation-for="Secret" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Notes" class="form-label">Notas</label>
                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Activa</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
