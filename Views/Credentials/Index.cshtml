@model IEnumerable<ITServiceDeskApp.Models.Credential>
@using ITServiceDeskApp.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    ViewData["Title"] = "Credenciales";

    var items = Model ?? Enumerable.Empty<Credential>();
    var typeOptions = ViewBag.TypeOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var canManage = ViewBag.CanManageCredentials is bool b && b;

    string search = ViewBag.Search as string ?? string.Empty;
    bool includeInactive = ViewBag.IncludeInactive is bool x && x;
    string selectedType = Context.Request.Query["type"].ToString();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Boveda de Credenciales</h2>
            <small class="text-muted">Resguardo de accesos de servidores, correo, CCTV y sistemas criticos</small>
        </div>

        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-key"></i> Nueva Credencial
            </a>
        }
    </div>

    <div class="alert alert-warning">
        <i class="bi bi-shield-lock"></i>
        Informacion sensible: uso exclusivo de personal autorizado.
    </div>

    <form method="get" asp-action="Index" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Buscar</label>
                    <input type="text" class="form-control" name="search" value="@search" placeholder="Nombre, usuario, host, notas..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tipo</label>
                    <select class="form-select" name="type" asp-items="typeOptions">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive" @(includeInactive ? "checked" : "")>
                        <label class="form-check-label" for="includeInactive">Ver inactivos</label>
                    </div>
                </div>

                <div class="col-md-1">
                    <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow">
        <div class="card-body p-0">
            @if (!items.Any())
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No hay credenciales registradas.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Recurso</th>
                                <th>Tipo</th>
                                <th>Usuario</th>
                                <th>Host / URL</th>
                                <th>Estado</th>
                                <th>Actualizado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr class="@(item.IsActive ? string.Empty : "table-secondary")">
                                    <td>
                                        <div class="fw-semibold">@item.Name</div>
                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(item.EnvironmentOrLocation) ? "Sin ubicacion" : item.EnvironmentOrLocation)</small>
                                    </td>
                                    <td>@item.Type</td>
                                    <td>@item.Username</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.AccessUrlOrHost) ? "-" : item.AccessUrlOrHost)</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Ver</a>

                                        @if (canManage)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>

                                            <form asp-action="ToggleStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                                    @(item.IsActive ? "Desactivar" : "Activar")
                                                </button>
                                            </form>

                                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Desea eliminar esta credencial?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted ms-2">Solo lectura</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
