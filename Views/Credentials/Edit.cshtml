@model ITServiceDeskApp.Models.Credential
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar Credencial";
    var typeOptions = ViewBag.TypeOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1">Editar Credencial</h2>
    <p class="text-muted mb-3">Ajusta datos sensibles con validaciones y controles de seguridad.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" class="credential-form" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Nombre del recurso <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ej: Firewall principal, SAP-Produccion" maxlength="120" />
                        <small class="text-muted">Usa un nombre facil de ubicar en busquedas y reportes.</small>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Type" class="form-label">Tipo <span class="text-danger">*</span></label>
                        <select asp-for="Type" asp-items="typeOptions" class="form-select">
                            <option value="">Seleccionar tipo</option>
                        </select>
                        <small id="typeHint" class="text-muted">Selecciona tipo para ver sugerencias de acceso y puerto.</small>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="EnvironmentOrLocation" class="form-label">Ambiente / Ubicacion</label>
                        <input asp-for="EnvironmentOrLocation" class="form-control" placeholder="Produccion, Sede Central, Nube" maxlength="120" />
                        <span asp-validation-for="EnvironmentOrLocation" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="AccessUrlOrHost" class="form-label">Host / URL de acceso</label>
                        <input asp-for="AccessUrlOrHost" class="form-control" placeholder="srv-app-01 o https://vpn.empresa.com" maxlength="200" autocomplete="off" />
                        <span asp-validation-for="AccessUrlOrHost" class="text-danger"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Port" class="form-label">Puerto</label>
                        <input asp-for="Port" class="form-control" inputmode="numeric" placeholder="22, 443, 1433" maxlength="80" list="credentialPortOptions" />
                        <small class="text-muted">Si es numerico, rango valido: 1-65535.</small>
                        <span asp-validation-for="Port" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Username" class="form-label">Usuario <span class="text-danger">*</span></label>
                        <input asp-for="Username" class="form-control" placeholder="admin, svc_sap, root" maxlength="120" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Secret" class="form-label">Contrasena / Token <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Secret" type="password" class="form-control" placeholder="Clave o token de acceso" maxlength="500" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" id="toggleSecretBtn">Mostrar</button>
                            <button type="button" class="btn btn-outline-primary" id="generateSecretBtn">Generar</button>
                            <button type="button" class="btn btn-outline-info" id="copySecretBtn">Copiar</button>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div id="secretStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <small id="secretStrengthText" class="text-muted d-block mt-1">Fortaleza: pendiente</small>
                        <small id="secretCopyStatus" class="d-block"></small>
                        <span asp-validation-for="Secret" class="text-danger d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Notes" class="form-label">Notas</label>
                        <textarea asp-for="Notes" class="form-control" rows="4" maxlength="2000" placeholder="Contexto tecnico, responsable, fecha de rotacion, etc."></textarea>
                        <small id="notesCounter" class="text-muted">0/2000</small>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 d-flex align-items-center">
                        <div class="form-check form-switch mt-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Activa</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

<datalist id="credentialPortOptions">
    <option value="22"></option>
    <option value="25"></option>
    <option value="53"></option>
    <option value="80"></option>
    <option value="110"></option>
    <option value="143"></option>
    <option value="389"></option>
    <option value="443"></option>
    <option value="465"></option>
    <option value="587"></option>
    <option value="993"></option>
    <option value="995"></option>
    <option value="1433"></option>
    <option value="1521"></option>
    <option value="3306"></option>
    <option value="3389"></option>
    <option value="5432"></option>
    <option value="8080"></option>
</datalist>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.credential-form');
            const typeInput = document.getElementById('Type');
            const typeHint = document.getElementById('typeHint');
            const portInput = document.getElementById('Port');
            const secretInput = document.getElementById('Secret');
            const notesInput = document.getElementById('Notes');
            const notesCounter = document.getElementById('notesCounter');
            const toggleSecretBtn = document.getElementById('toggleSecretBtn');
            const generateSecretBtn = document.getElementById('generateSecretBtn');
            const copySecretBtn = document.getElementById('copySecretBtn');
            const secretStrengthBar = document.getElementById('secretStrengthBar');
            const secretStrengthText = document.getElementById('secretStrengthText');
            const secretCopyStatus = document.getElementById('secretCopyStatus');
            const defaultPortPlaceholder = '22, 443, 1433';

            const profiles = {
                'Servidor': { port: '22', hint: 'Sugerido: 22 (SSH) o 3389 (RDP).' },
                'Correo': { port: '587', hint: 'Sugerido: 587 (SMTP), 993 (IMAP) o 995 (POP3).' },
                'CCTV': { port: '554', hint: 'Sugerido: 554 (RTSP) o puerto definido por el DVR/NVR.' },
                'Base de Datos': { port: '1433', hint: 'Sugerido: 1433 (SQL Server), 3306 (MySQL), 5432 (PostgreSQL).' },
                'Firewall': { port: '443', hint: 'Sugerido: 443 para consola web segura.' },
                'Router': { port: '443', hint: 'Sugerido: 443 o 22 para administracion segura.' },
                'Switch': { port: '22', hint: 'Sugerido: 22 para gestion por SSH.' },
                'VPN': { port: '443', hint: 'Sugerido: 443 o puerto definido por el concentrador VPN.' },
                'Sistema Interno': { port: '8080', hint: 'Sugerido: 80/443/8080 segun despliegue.' },
                'Otro': { port: '', hint: 'Completa segun documentacion del servicio.' }
            };

            function updateTypeProfile() {
                if (!typeInput || !typeHint || !portInput) {
                    return;
                }

                const selected = profiles[typeInput.value];
                if (!selected) {
                    typeHint.textContent = 'Selecciona tipo para ver sugerencias de acceso y puerto.';
                    portInput.placeholder = defaultPortPlaceholder;
                    return;
                }

                typeHint.textContent = selected.hint;
                portInput.placeholder = selected.port ? `Ej: ${selected.port}` : defaultPortPlaceholder;
            }

            function validatePort() {
                if (!portInput) {
                    return true;
                }

                const value = (portInput.value || '').trim();
                portInput.setCustomValidity('');

                if (!value) {
                    return true;
                }

                if (/^\d+$/.test(value)) {
                    const parsed = Number(value);
                    if (parsed < 1 || parsed > 65535) {
                        portInput.setCustomValidity('El puerto numerico debe estar entre 1 y 65535.');
                        return false;
                    }
                    return true;
                }

                if (!/^[A-Za-z0-9._/-]+$/.test(value)) {
                    portInput.setCustomValidity('Usa solo numeros o texto tecnico sin espacios.');
                    return false;
                }

                return true;
            }

            function scoreSecret(value) {
                if (!value) {
                    return 0;
                }

                let score = 0;
                if (value.length >= 12) score += 35;
                if (/[A-Z]/.test(value)) score += 20;
                if (/[a-z]/.test(value)) score += 15;
                if (/\d/.test(value)) score += 15;
                if (/[^A-Za-z0-9]/.test(value)) score += 15;
                return Math.min(score, 100);
            }

            function paintSecretStrength() {
                if (!secretInput || !secretStrengthBar || !secretStrengthText) {
                    return;
                }

                const score = scoreSecret(secretInput.value || '');
                secretStrengthBar.style.width = `${score}%`;
                secretStrengthBar.className = 'progress-bar';

                if (!secretInput.value) {
                    secretStrengthText.textContent = 'Fortaleza: pendiente';
                    return;
                }

                if (score < 45) {
                    secretStrengthBar.classList.add('bg-danger');
                    secretStrengthText.textContent = 'Fortaleza: baja';
                } else if (score < 75) {
                    secretStrengthBar.classList.add('bg-warning');
                    secretStrengthText.textContent = 'Fortaleza: media';
                } else {
                    secretStrengthBar.classList.add('bg-success');
                    secretStrengthText.textContent = 'Fortaleza: alta';
                }
            }

            function generateSecret(length) {
                const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!#$%&*+-_=?\\u0040';
                const size = length || 20;
                let output = '';

                if (window.crypto && window.crypto.getRandomValues) {
                    const array = new Uint32Array(size);
                    window.crypto.getRandomValues(array);
                    for (let i = 0; i < size; i += 1) {
                        output += chars[array[i] % chars.length];
                    }
                    return output;
                }

                for (let i = 0; i < size; i += 1) {
                    output += chars.charAt(Math.floor(Math.random() * chars.length));
                }

                return output;
            }

            async function copySecret() {
                if (!secretInput || !secretCopyStatus) {
                    return;
                }

                if (!secretInput.value) {
                    secretCopyStatus.className = 'text-warning d-block';
                    secretCopyStatus.textContent = 'No hay clave para copiar.';
                    return;
                }

                try {
                    await navigator.clipboard.writeText(secretInput.value);
                    secretCopyStatus.className = 'text-success d-block';
                    secretCopyStatus.textContent = 'Clave copiada al portapapeles.';
                    setTimeout(() => {
                        secretCopyStatus.textContent = '';
                    }, 1800);
                } catch {
                    secretCopyStatus.className = 'text-danger d-block';
                    secretCopyStatus.textContent = 'No se pudo copiar automaticamente.';
                }
            }

            function updateNotesCounter() {
                if (!notesInput || !notesCounter) {
                    return;
                }

                const size = (notesInput.value || '').length;
                notesCounter.textContent = `${size}/2000`;
            }

            if (typeInput) {
                typeInput.addEventListener('change', updateTypeProfile);
            }

            if (portInput) {
                portInput.addEventListener('input', validatePort);
                portInput.addEventListener('blur', validatePort);
            }

            if (secretInput) {
                secretInput.addEventListener('input', paintSecretStrength);
            }

            if (toggleSecretBtn && secretInput) {
                toggleSecretBtn.addEventListener('click', function () {
                    const hidden = secretInput.type === 'password';
                    secretInput.type = hidden ? 'text' : 'password';
                    toggleSecretBtn.textContent = hidden ? 'Ocultar' : 'Mostrar';
                });
            }

            if (generateSecretBtn && secretInput) {
                generateSecretBtn.addEventListener('click', function () {
                    secretInput.value = generateSecret(20);
                    paintSecretStrength();
                    secretInput.dispatchEvent(new Event('change', { bubbles: true }));
                    secretInput.focus();
                });
            }

            if (copySecretBtn) {
                copySecretBtn.addEventListener('click', copySecret);
            }

            if (notesInput) {
                notesInput.addEventListener('input', updateNotesCounter);
            }

            if (form) {
                form.addEventListener('submit', function (event) {
                    if (!validatePort()) {
                        event.preventDefault();
                        event.stopPropagation();
                        portInput.reportValidity();
                    }
                });
            }

            updateTypeProfile();
            paintSecretStrength();
            updateNotesCounter();
        });
    </script>
}
