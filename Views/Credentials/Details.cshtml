@model ITServiceDeskApp.Models.Credential

@{
    ViewData["Title"] = "Detalle Credencial";
    var canManage = ViewBag.CanManageCredentials is bool b && b;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">Detalle de Credencial</h2>
        <div class="d-flex gap-2">
            @if (canManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nombre</label>
                    <div class="form-control bg-light">@Model.Name</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tipo</label>
                    <div class="form-control bg-light">@Model.Type</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">@(Model.IsActive ? "Activa" : "Inactiva")</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Ambiente / Ubicacion</label>
                    <div class="form-control bg-light">@(string.IsNullOrWhiteSpace(Model.EnvironmentOrLocation) ? "-" : Model.EnvironmentOrLocation)</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Host / URL</label>
                    <div class="form-control bg-light">@(string.IsNullOrWhiteSpace(Model.AccessUrlOrHost) ? "-" : Model.AccessUrlOrHost)</div>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Puerto</label>
                    <div class="form-control bg-light">@(string.IsNullOrWhiteSpace(Model.Port) ? "-" : Model.Port)</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Usuario</label>
                    <div class="form-control bg-light">@Model.Username</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contrasena / Token</label>
                    <div class="input-group">
                        <input id="secretValue" type="password" class="form-control" readonly value="@Model.Secret" />
                        <button class="btn btn-outline-secondary" type="button" id="toggleSecret">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button class="btn btn-outline-primary" type="button" id="copySecret">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                    <small id="copyStatus" class="text-muted"></small>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold">Notas</label>
                    <textarea class="form-control bg-light" rows="4" readonly>@(string.IsNullOrWhiteSpace(Model.Notes) ? "Sin notas" : Model.Notes)</textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Creado</label>
                    <div class="form-control bg-light">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ultima actualizacion</label>
                    <div class="form-control bg-light">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const secretInput = document.getElementById('secretValue');
        const toggleBtn = document.getElementById('toggleSecret');
        const copyBtn = document.getElementById('copySecret');
        const status = document.getElementById('copyStatus');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                const isHidden = secretInput.type === 'password';
                secretInput.type = isHidden ? 'text' : 'password';
                toggleBtn.innerHTML = isHidden
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';
            });
        }

        if (copyBtn) {
            copyBtn.addEventListener('click', async function () {
                try {
                    await navigator.clipboard.writeText(secretInput.value || '');
                    status.textContent = 'Copiado al portapapeles';
                    setTimeout(() => status.textContent = '', 1500);
                } catch {
                    status.textContent = 'No se pudo copiar';
                }
            });
        }
    })();
</script>
}
